# twow-repo#602 ROT-01 (L1-b finding 19.10.2026, OB-10): the action log's CAST_FAIL line names the reason (reason=SPELL_IN_PROGRESS
# code=0x61 state=preparing) instead of only result=1. Diagnostics only: no behaviour change, no switch.
# Pins: the name table mirrors enum SpellCastResult; Spell keeps the last cast result it sent and finish() passes it with the state it
# ended in; the hook has the same 6-parameter signature in the core call, the stub and the module; CAST_OK lines are unchanged.
# Every check runs once on the real sources and once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/CastResultNames.h" names_h)
read_file("${PB_SOURCE_DIR}/BotActionLog.cpp" log_cpp)
read_file("${PB_SOURCE_DIR}/BotActionLog.h" log_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.h" ai_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${CORE_SOURCE_DIR}/src/game/Spells/SpellDefines.h" defines_h)
read_file("${CORE_SOURCE_DIR}/src/game/Spells/Spell.h" spell_h)
read_file("${CORE_SOURCE_DIR}/src/game/Spells/Spell.cpp" spell_cpp)
read_file("${CORE_SOURCE_DIR}/src/game/PlayerbotStubs.cpp" stubs_cpp)

# body of the function that starts with `signature`, up to the first line that is exactly "}"
function(body text signature out_var)
  string(FIND "${text}" "${signature}" at)
  if(at EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "\n}\n" end)
  if(end EQUAL -1)
    set(end -1)
  endif()
  string(SUBSTRING "${rest}" 0 ${end} b)
  set(${out_var} "${b}" PARENT_SCOPE)
endfunction()

# append to `errors` of the calling function instead of failing, so the probes can expect a failure (functions, not macros:
# macro arguments would re-evaluate the backslashes of the source text)
function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check names_h log_cpp log_h ai_h config_h defines_h spell_h spell_cpp stubs_cpp out_var)
  set(errors "")

  # 1. The name table mirrors enum SpellCastResult, code by code (index = code; the enum counts up from 0x00 without gaps).
  string(FIND "${defines_h}" "enum SpellCastResult" e0)
  string(SUBSTRING "${defines_h}" ${e0} -1 enum_text)
  string(FIND "${enum_text}" "SPELL_CAST_OK" e1)
  string(SUBSTRING "${enum_text}" 0 ${e1} enum_text)
  string(REGEX MATCHALL "SPELL_FAILED_[A-Z0-9_]+" enum_names "${enum_text}")
  string(REGEX MATCHALL "= *0x[0-9A-Fa-f]+|= *[0-9]+" explicit "${enum_text}")
  list(LENGTH explicit n_explicit)
  if(NOT n_explicit EQUAL 1)
    list(APPEND errors "enum SpellCastResult has ${n_explicit} explicit values (the table assumes only the first, 0x00)")
  endif()
  string(FIND "${names_h}" "kNames[] = {" t0)
  string(SUBSTRING "${names_h}" ${t0} -1 table)
  string(FIND "${table}" "};" t1)
  string(SUBSTRING "${table}" 0 ${t1} table)
  string(REGEX MATCHALL "\"[A-Z0-9_]+\"" table_names "${table}")
  list(LENGTH enum_names n_enum)
  list(LENGTH table_names n_table)
  if(NOT n_enum EQUAL n_table OR n_enum LESS 100)
    list(APPEND errors "name table has ${n_table} entries, enum SpellCastResult ${n_enum}")
  else()
    math(EXPR last "${n_enum} - 1")
    foreach(i RANGE ${last})
      list(GET enum_names ${i} en)
      list(GET table_names ${i} tn)
      string(REPLACE "\"" "" tn "${tn}")
      if(NOT "SPELL_FAILED_${tn}" STREQUAL "${en}")
        list(APPEND errors "name table code ${i}: ${tn}, enum: ${en}")
        break()
      endif()
    endforeach()
  endif()
  need("${names_h}" "inline constexpr std::uint8_t kCastOk = 0xFF;" "SPELL_CAST_OK value")
  need("${defines_h}" "SPELL_CAST_OK                               = 0xFF" "core SPELL_CAST_OK = 0xFF")

  # 2. Pure header, not in the botpch chain.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${names_h}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <cstddef>" AND NOT inc STREQUAL "#include <cstdint>")
      list(APPEND errors "CastResultNames.h is not pure: ${inc}")
    endif()
  endforeach()
  ban("${ai_h}" "CastResultNames.h" "include in PlayerbotAI.h (botpch chain)")
  ban("${config_h}" "CastResultNames.h" "include in PlayerbotAIConfig.h (botpch chain)")

  # 3. Spell keeps the last result it sent: set first in the member SendCastResult, before the player-only early returns.
  need("${spell_h}" "uint8 m_botLogResult = SPELL_CAST_OK;" "Spell member, default none sent")
  body("${spell_cpp}" "void Spell::SendCastResult(SpellCastResult result)\n{" send_body)
  before("${send_body}" "m_botLogResult = uint8(result);" "if (!m_caster->IsPlayer())" "SendCastResult: remember the result first")

  # 4. finish() passes the result and the state it ended in; the finished guard stays first, so a cast is logged once.
  body("${spell_cpp}" "void Spell::finish(bool ok)" finish_body)
  before("${finish_body}" "if (m_spellState == SPELL_STATE_FINISHED)\n        return;" "uint32 const stateBefore = m_spellState;" "finish: guard before the state capture")
  before("${finish_body}" "uint32 const stateBefore = m_spellState;" "m_spellState = SPELL_STATE_FINISHED;" "finish: capture before the state change")
  need("${finish_body}" "BotActionLog_LogCastResult(m_caster, m_spellInfo->Id, ok ? 0 : 1, \"finish\", m_botLogResult, uint8(stateBefore));" "finish hook call")

  # 5. One signature in the core declaration, the stub (BUILD_PLAYERBOTS=OFF) and the module definition.
  need("${spell_cpp}" "extern void BotActionLog_LogCastResult(WorldObject* caster, uint32 spellId, uint8 result, const char* phase, uint8 reason, uint8 state);" "core declaration")
  need("${stubs_cpp}" "void BotActionLog_LogCastResult (WorldObject*, uint32, uint8, const char*, uint8, uint8) {}" "stub")
  need("${log_cpp}" "void BotActionLog_LogCastResult(WorldObject* caster, uint32 spellId, uint8 result, const char* phase, uint8 reason, uint8 state)" "module bridge")
  need("${log_h}" "static void LogCastResult(PlayerbotAI* ai, uint32 spellId, uint8 result, const char* phase, uint8 reason, uint8 state);" "BotActionLog API")
  ban("${spell_cpp}" "ok ? 0 : 1, \"finish\");" "old 4-argument hook call")

  # 6. Line formats: CAST_OK unchanged; CAST_FAIL keeps the old prefix (parsers) and adds reason/code/state.
  body("${log_cpp}" "void BotActionLog::LogCastResult(PlayerbotAI* ai, uint32 spellId, uint8 result, const char* phase, uint8 reason, uint8 state)" fmt_body)
  need("${fmt_body}" "Write(ai, \"CAST_OK\", \"spell=%s(%u) result=%u phase=%s\", spellName, spellId, (unsigned)result, phase ? phase : \"?\");" "CAST_OK line unchanged")
  need("${fmt_body}" "\"spell=%s(%u) result=%u phase=%s reason=%s code=0x%02x state=%s\"" "CAST_FAIL line with reason")
  need("${fmt_body}" "name ? name : \"none\"" "reason=none when no result was sent")
  before("${fmt_body}" "if (result == 0)" "\"CAST_FAIL\"" "success branch first")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${names_h}" "${log_cpp}" "${log_h}" "${ai_h}" "${config_h}" "${defines_h}" "${spell_h}" "${spell_cpp}" "${stubs_cpp}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#602 cast result reason contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" _mut "${${var}}")
  if(_mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#602 probe '${label}': mutation did not apply")
  endif()
  set(${var} "${_mut}")
  check("${names_h}" "${log_cpp}" "${log_h}" "${ai_h}" "${config_h}" "${defines_h}" "${spell_h}" "${spell_cpp}" "${stubs_cpp}" _perrs)
  if(NOT _perrs)
    message(FATAL_ERROR "#602 probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("table shifted" names_h "\"LINE_OF_SIGHT\",\n" "")
probe("enum gains a code" defines_h "SPELL_FAILED_UNKNOWN " "SPELL_FAILED_NEWCODE, SPELL_FAILED_UNKNOWN ")
probe("result not remembered" spell_cpp "    m_botLogResult = uint8(result);\n" "")
probe("old hook call" spell_cpp "\"finish\", m_botLogResult, uint8(stateBefore));" "\"finish\");")
probe("state captured too late" spell_cpp "    uint32 const stateBefore = m_spellState;\n    m_spellState = SPELL_STATE_FINISHED;" "    m_spellState = SPELL_STATE_FINISHED;\n    uint32 const stateBefore = m_spellState;")
probe("stub signature" stubs_cpp "const char*, uint8, uint8) {}" "const char*) {}")
probe("CAST_OK line changed" log_cpp "Write(ai, \"CAST_OK\", \"spell=%s(%u) result=%u phase=%s\"" "Write(ai, \"CAST_OK\", \"spell=%s(%u) ok phase=%s\"")
probe("impure header" names_h "#include <cstdint>" "#include <cstdint>\n#include \"Spells/SpellDefines.h\"")

message(STATUS "cast_result_reason source contract passed (${probes} negative probes)")
