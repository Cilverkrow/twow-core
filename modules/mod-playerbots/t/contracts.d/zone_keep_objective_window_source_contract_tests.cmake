# Negative probes: each broken copy must be caught.
set(caught 0)
function(probe what file_var from to)
  string(REPLACE "${from}" "${to}" broken "${${file_var}}")
  if(broken STREQUAL "${${file_var}}")
    message(FATAL_ERROR "${TAG}: probe '${what}' did not change the text")
  endif()
  set(p_config_h "${config_h}")
  set(p_config_cpp "${config_cpp}")
  set(p_conf_dist "${conf_dist}")
  set(p_policy "${policy}")
  set(p_travel_h "${travel_h}")
  set(p_travel "${travel}")
  set(p_mgr "${mgr}")
  set(p_values "${values}")
  set(p_accept "${accept}")
  set(p_${file_var} "${broken}")
  check_all("${p_config_h}" "${p_config_cpp}" "${p_conf_dist}" "${p_policy}" "${p_travel_h}" "${p_travel}" "${p_mgr}" "${p_values}" "${p_accept}" e)
  if(NOT e)
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
  math(EXPR n "${caught} + 1")
  set(caught ${n} PARENT_SCOPE)
endfunction()
probe("dist default 1" conf_dist "StartZoneMinLevel.ObjectiveWindow = 0\n" "StartZoneMinLevel.ObjectiveWindow = 1\n")
probe("snapshot without the switch first" travel "    objectiveWindow = sPlayerbotAIConfig.questFirstProgressionStartZoneObjectiveWindow &&\n" "    objectiveWindow = true &&\n")
probe("window for unheld bots" policy "    if (!held || !inLogIncomplete)\n" "    if (!inLogIncomplete)\n")
probe("book path lifts every reason" travel "!(windowReason == ai::questbook::NoReason::AboveWindow && info.HasObjectiveWindow() &&" "!(info.HasObjectiveWindow() &&")
probe("giver rule widened" travel "(int32)info.GetLevel() + (int32)5)" "(int32)info.GetLevel() + (int32)7)")
probe("old +1 rule replaced" travel "        else if ((int32)GetQuestTemplate()->GetQuestLevel() > (int32)info.GetLevel() + (int32)1)\n" "        else if ((int32)GetQuestTemplate()->GetQuestLevel() > (int32)info.GetLevel() + (int32)2)\n")
probe("minute report not called" mgr "    ai::zone_keep::ReportObjectiveWindowMinute();" "    // gone")
probe("helper logs in the async search" travel "        objectiveWindowPasses[c].fetch_add(1, std::memory_order_relaxed);" "        sLog.outBasic(\"x\");")
if(NOT caught EQUAL 8)
  message(FATAL_ERROR "${TAG}: ${caught} negative probes caught, 8 expected")
endif()
message(STATUS "${TAG}: all checks passed, 8 negative probes caught")
