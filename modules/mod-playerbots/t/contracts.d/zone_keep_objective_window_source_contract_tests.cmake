# Functions, not macros: a macro re-parses its arguments, and source text with quotes and backslashes would break it. Each helper
# sets r in the caller (check_all) only when r is still empty, so the first failure wins.
function(need text needle what)
  if(r)
    return()
  endif()
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(r "missing ${what}" PARENT_SCOPE)
  endif()
endfunction()

function(order text first second what)
  if(r)
    return()
  endif()
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(r "order: ${what}" PARENT_SCOPE)
  endif()
endfunction()

# Returns the first failure in out ("" = all checks passed).
function(check_all config_h config_cpp conf_dist policy travel_h travel mgr values accept out)
  set(r "")

  # 1. Keys: members 0 / 2, clamped reads (logged), sorted echo after .Complete, dist 0 / 2 after .Complete.
  need("${config_h}" "uint32 questFirstProgressionStartZoneObjectiveWindow = 0;" "member mode 0")
  need("${config_h}" "uint32 questFirstProgressionStartZoneObjectiveWindowAbove = 2;" "member above 2")
  need("${config_cpp}" "config.GetIntDefault(\"AiPlayerbot.QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow\", 0);" "mode read default 0")
  need("${config_cpp}" "questFirstProgressionStartZoneObjectiveWindow = ai::zone_keep::ClampObjectiveWindowMode(objectiveWindowRaw);" "mode clamp")
  need("${config_cpp}" "config.GetIntDefault(\"AiPlayerbot.QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow.AboveLevels\",\n        int32(ai::zone_keep::ObjectiveWindowAboveDefault));" "above read default")
  need("${config_cpp}" "questFirstProgressionStartZoneObjectiveWindowAbove = ai::zone_keep::ClampAboveLevels(objectiveWindowAboveRaw);" "above clamp")
  need("${config_cpp}" "[ZoneKeep] config key=StartZoneMinLevel.ObjectiveWindow value=%d result=off" "mode log")
  need("${config_cpp}" "[ZoneKeep] config key=StartZoneMinLevel.ObjectiveWindow.AboveLevels value=%d result=%u (1..3)" "above log")
  need("${config_cpp}" "            {\"QuestFirstProgression.StartZoneMinLevel.Complete\", Value(questFirstProgressionStartZoneComplete)},\n            {\"QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow\", Value(questFirstProgressionStartZoneObjectiveWindow)},\n            {\"QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow.AboveLevels\", Value(questFirstProgressionStartZoneObjectiveWindowAbove)},\n            {\"QuestFirstProgression.T" "[ConfigEcho] entries, sorted")
  need("${conf_dist}" "\nAiPlayerbot.QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow = 0\n" "dist mode 0")
  need("${conf_dist}" "\nAiPlayerbot.QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow.AboveLevels = 2\n" "dist above 2")
  order("${conf_dist}" "AiPlayerbot.QuestFirstProgression.StartZoneMinLevel.Complete = 1" "AiPlayerbot.QuestFirstProgression.StartZoneMinLevel.ObjectiveWindow = 0" "dist after .Complete")
  need("${conf_dist}" "A cohort key with its own meaning (switch audit twow-repo#679)" "dist cohort-key note")
  need("${conf_dist}" "state=objective_window" "dist names the line")

  # 2. Pure rules (std only, no game types).
  need("${policy}" "inline std::uint32_t ClampObjectiveWindowMode(std::int32_t mode)" "ClampObjectiveWindowMode")
  need("${policy}" "inline std::uint32_t ClampAboveLevels(std::int32_t above)" "ClampAboveLevels")
  need("${policy}" "inline bool ObjectiveAllowed(std::int32_t questLevel, std::int32_t botLevel, std::int32_t baseAbove, bool held, bool inLogIncomplete," "ObjectiveAllowed")
  need("${policy}" "    if (!held || !inLogIncomplete)\n        return baseAbove;" "the window only for held + in log")
  need("${policy}" "constexpr std::int32_t ObjectiveOldAboveLevels = 1;" "the old rule +1")

  # 3. Snapshot: on the bot thread, the switch first, then the cohort and StartZoneHolds; the quests from the status map.
  need("${travel}" "    objectiveWindow = sPlayerbotAIConfig.questFirstProgressionStartZoneObjectiveWindow &&\n        ai::cohort::Applies(sPlayerbotAIConfig.questFirstProgressionStartZoneObjectiveWindow, player->GetGUIDLow()) &&\n        ai::zone_keep::StartZoneHolds(player, ai);" "snapshot bit: switch, cohort, held")
  need("${travel}" "            if (!status.m_rewarded && status.m_status == QUEST_STATUS_INCOMPLETE)\n                objectiveWindowQuests.push_back(questId);" "in log, not complete")
  need("${travel_h}" "bool HasObjectiveWindow() const { return objectiveWindow; }" "snapshot accessor")

  # 4. The one helper at both objective-level sites of QuestObjectiveTravelDestination::IsPossible.
  between("${travel}" "bool QuestObjectiveTravelDestination::IsPossible(" "if (info.IsInRaid() != " objective)
  if(NOT r AND objective STREQUAL "")
    set(r "objective IsPossible region not found")
  endif()
  need("${objective}" "!(windowReason == ai::questbook::NoReason::AboveWindow && info.HasObjectiveWindow() &&\n                    ai::zone_keep::ObjectiveLevelAllowed(info, GetQuestTemplate(), int32(sPlayerbotAIConfig.questBookAboveLevels))))" "book path: AboveWindow only")
  need("${objective}" "        else if (info.HasObjectiveWindow())\n        {\n            if (!ai::zone_keep::ObjectiveLevelAllowed(info, GetQuestTemplate(), ai::zone_keep::ObjectiveOldAboveLevels))\n                return false;\n        }\n        else if ((int32)GetQuestTemplate()->GetQuestLevel() > (int32)info.GetLevel() + (int32)1)\n            return false;" "the helper before the unchanged old +1 rule")
  order("${objective}" "if (ai::questbook::Excluded(GetQuestId()))" "windowReason" "QB5 list before the window")
  need("${objective}" "GetQuestTemplate()->GetQuestLevel() + 5 > (int)info.GetLevel() && !info.GetBoolValue(\"can fight equal\")" "capability rule unchanged")
  # Two helper calls in the module, both in this function.
  string(REGEX MATCHALL "ObjectiveLevelAllowed\\(info" calls "${travel}")
  list(LENGTH calls n)
  if(NOT r AND NOT n EQUAL 2)
    set(r "ObjectiveLevelAllowed(info called ${n} times (2 expected: book path, old path)")
  endif()

  # 5. Giver / accept rules unchanged (no new accepts, owner rule D1).
  need("${travel}" "        else if (!forceThisQuest && (int32)quest->GetQuestLevel() >= (int32)info.GetLevel() + (int32)5)\n            return refuse(ai::quest_search::GiverDropQuestLevel);" "giver +5 rule unchanged")
  need("${values}" "(questFirst && (int32)quest->GetQuestLevel() >\n                            (int32)level + sPlayerbotAIConfig.questFirstProgressionMaxAboveLevelDelta)))" "giver value rule unchanged")
  need("${accept}" "return ai::quest_accept::SkipForRosterBot(rosterOnItsOwn, bot->GetLevel(), bot->GetQuestLevelForPlayer(quest)," "accept rule unchanged")
  # (no foreach over the texts: a list would split them at every ';')
  string(FIND "${values}" "ObjectiveWindow" hit_values)
  string(FIND "${accept}" "ObjectiveWindow" hit_accept)
  if(NOT r AND (NOT hit_values EQUAL -1 OR NOT hit_accept EQUAL -1))
    set(r "the window reached a giver / accept file")
  endif()

  # 6. Lines: counted in the helper (no log in the async search), written by the world thread's minute report.
  between("${travel}" "bool ai::zone_keep::ObjectiveLevelAllowed(" "void ai::zone_keep::ReportObjectiveWindowMinute()" helper)
  if(NOT r AND helper STREQUAL "")
    set(r "helper region not found")
  endif()
  string(FIND "${helper}" "sLog." logs)
  if(NOT r AND NOT logs EQUAL -1)
    set(r "the helper logs (it runs in the async travel search)")
  endif()
  need("${helper}" "if (ai::zone_keep::ObjectiveWindowOnly(questLevel, level, baseAbove, held, inLog, above))" "count only window-made passes")
  need("${travel}" "[ZoneKeep] state=objective_window bot=%u quest=%u qlevel=%d level=%u zone=%u" "objective_window line")
  need("${travel}" "[ZoneKeepMin] cohort=%c mode=%u above=%u objective_window=%llu objective_window_new=%llu" "minute line")
  need("${travel}" "    if (!sPlayerbotAIConfig.questFirstProgressionStartZoneObjectiveWindow || now < lastReport + 60)\n        return;" "minute report: mode off writes nothing")
  need("${mgr}" "    ai::zone_keep::ReportObjectiveWindowMinute();" "minute report called")
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

check_all("${config_h}" "${config_cpp}" "${conf_dist}" "${policy}" "${travel_h}" "${travel}" "${mgr}" "${values}" "${accept}" e)
