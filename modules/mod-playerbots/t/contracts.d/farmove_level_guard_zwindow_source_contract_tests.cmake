# Functions, not macros: a macro re-parses its arguments, and source text with quotes and backslashes would break it. Each helper
# sets r in the caller (check_all) only when r is still empty, so the first failure wins.
function(need text needle what)
  if(r)
    return()
  endif()
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(r "missing ${what}" PARENT_SCOPE)
  endif()
endfunction()

function(never text needle what)
  if(r)
    return()
  endif()
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(r "forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()

function(order text first second what)
  if(r)
    return()
  endif()
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(r "order: ${what}" PARENT_SCOPE)
  endif()
endfunction()

# Returns the first failure in out ("" = all checks passed).
function(check_all policy config_h config_cpp conf_dist choose move mgr gem out)
  set(r "")

  # 1. Keys: members 0, clamped reads (logged), sorted echo after .Radius, dist 0 / 0 after .Radius.
  need("${config_h}" "uint32 rosterFarMoveLevelGuardZWindow = 0;" "member ZWindow 0")
  need("${config_h}" "uint32 rosterFarMoveLevelGuardSkipHarmless = 0;" "member SkipHarmless 0")
  need("${config_cpp}" "    rosterFarMoveLevelGuardZWindow = config.GetIntDefault(\"AiPlayerbot.RosterFarMove.LevelGuard.ZWindow\", 0);\n    int32 const levelGuardZWindowRaw = int32(rosterFarMoveLevelGuardZWindow);\n    rosterFarMoveLevelGuardZWindow = ai::level_guard::ClampZWindow(levelGuardZWindowRaw);" "ZWindow read default 0, clamped")
  need("${config_cpp}" "    rosterFarMoveLevelGuardSkipHarmless = config.GetIntDefault(\"AiPlayerbot.RosterFarMove.LevelGuard.SkipHarmless\", 0);\n    int32 const levelGuardSkipHarmlessRaw = int32(rosterFarMoveLevelGuardSkipHarmless);\n    rosterFarMoveLevelGuardSkipHarmless = ai::level_guard::ClampSkipHarmless(levelGuardSkipHarmlessRaw);" "SkipHarmless read default 0, clamped")
  need("${config_cpp}" "[FarMoveGuard] config key=LevelGuard.ZWindow value=%d result=off (0 off, 5..100 yd)" "ZWindow log")
  need("${config_cpp}" "[FarMoveGuard] config key=LevelGuard.SkipHarmless value=%d result=off (0 off, 1 on)" "SkipHarmless log")
  need("${config_cpp}" "            {\"RosterFarMove.LevelGuard.Radius\", Value(rosterFarMoveLevelGuardRadius)},\n            {\"RosterFarMove.LevelGuard.SkipHarmless\", Value(rosterFarMoveLevelGuardSkipHarmless)},\n            {\"RosterFarMove.LevelGuard.ZWindow\", Value(rosterFarMoveLevelGuardZWindow)},\n            {\"Rotation.CastLosGate\"" "[ConfigEcho] entries, sorted")
  need("${conf_dist}" "\nAiPlayerbot.RosterFarMove.LevelGuard.Radius = 50\n" "dist radius")
  need("${conf_dist}" "\nAiPlayerbot.RosterFarMove.LevelGuard.SkipHarmless = 0\nAiPlayerbot.RosterFarMove.LevelGuard.ZWindow = 0\n" "dist sub-keys 0 / 0")
  order("${conf_dist}" "AiPlayerbot.RosterFarMove.LevelGuard.Radius = 50" "AiPlayerbot.RosterFarMove.LevelGuard.SkipHarmless = 0" "dist after .Radius")

  # 2. Pure rules: clamps, zWindow 0 = no z test, the event rule > 0, harmless flags, the slot -> event formula.
  need("${policy}" "inline uint32_t ClampZWindow(int32_t window) { return (window >= ZWindowMin && window <= ZWindowMax) ? uint32_t(window) : 0u; }" "ClampZWindow")
  need("${policy}" "constexpr int32_t ZWindowMin = 5;\n    constexpr int32_t ZWindowMax = 100;" "ZWindow 5..100")
  need("${policy}" "inline uint32_t ClampSkipHarmless(int32_t value) { return value == 1 ? 1u : 0u; }" "ClampSkipHarmless")
  need("${policy}" "inline bool InZWindow(float dz, uint32_t window) { return window == 0 || std::fabs(dz) <= float(window); }" "InZWindow: 0 = no test")
  need("${policy}" "inline bool EventOnly(int32_t eventId) { return eventId > 0; }" "event rule > 0 (OB-10 defect: < 0 is a normal spawn)")
  need("${policy}" "inline bool EventSpawnCounts(int32_t eventId, bool eventActive) { return !EventOnly(eventId) || eventActive; }" "event spawn counts only while active")
  need("${policy}" "constexpr uint32_t FlagExtraNoAggro = 0x00000002;" "NO_AGGRO flag")
  need("${policy}" "constexpr uint32_t FlagExtraInvisible = 0x00000080;" "INVISIBLE flag")
  need("${policy}" "inline bool Harmless(uint32_t flagsExtra) { return (flagsExtra & (FlagExtraNoAggro | FlagExtraInvisible)) != 0; }" "Harmless")
  need("${policy}" "inline int32_t EventIdOfList(uint32_t slot, uint32_t eventCount) { return int32_t(slot) + 1 - int32_t(eventCount); }" "slot -> event as GetGameEventId")
  never("${policy}" "eventId != 0" "event rule != 0")
  never("${policy}" "eventId >= 0" "event rule >= 0")
  # The query: the old signature forwards with zWindow 0 / no event test; the z test only with zWindow; the event test only with skipHarmless.
  need("${policy}" "            return Query(map, x, y, 0.0f, radius, botLevel, margin, sideMask, 0u, false, [](int16_t) { return true; });" "old signature = 2D, no event test")
  need("${policy}" "                        if (zWindow && !InZWindow(dz, zWindow))\n                        {\n                            ++hit.zFiltered;\n                            continue;\n                        }" "z test only with zWindow")
  need("${policy}" "                        if (skipHarmless && !EventSpawnCounts(s.event, EventOnly(s.event) && eventActive(s.event)))\n                        {\n                            ++hit.eventFiltered;\n                            continue;\n                        }" "event test only with skipHarmless, eventActive only for > 0")
  order("${policy}" "if (d > radius)" "if (zWindow && !InZWindow(dz, zWindow))" "z test after the 2D radius (zfiltered = inside 2D, outside z)")
  order("${policy}" "if (skipHarmless && !EventSpawnCounts(" "++hit.hostile;" "filters before the hostile count")

  # 3. LevelGuard 0 = no effect of either sub-key: the grid only with the switch, the one Query site behind the guard's gate.
  need("${config_cpp}" "    if (sPlayerbotAIConfig.rosterFarMoveLevelGuard)\n        ai::level_guard::BuildGrid();" "grid only with LevelGuard")
  string(REGEX MATCHALL "SharedGrid\\(\\)\\.Query\\(" q_choose "${choose}")
  string(REGEX MATCHALL "SharedGrid\\(\\)\\.Query\\(" q_move "${move}")
  string(REGEX MATCHALL "SharedGrid\\(\\)\\.Query\\(" q_mgr "${mgr}")
  list(LENGTH q_choose n_choose)
  list(LENGTH q_move n_move)
  list(LENGTH q_mgr n_mgr)
  if(NOT r AND NOT (n_choose EQUAL 1 AND n_move EQUAL 0 AND n_mgr EQUAL 0))
    set(r "SharedGrid().Query called ${n_choose}/${n_move}/${n_mgr} times (choose/move/mgr; 1/0/0 expected)")
  endif()
  between("${choose}" "PostActiveDeferral PostActiveDeferralOf(" "\n}\n" deferral_fn)
  if(NOT r AND deferral_fn STREQUAL "")
    set(r "PostActiveDeferralOf region not found")
  endif()
  order("${deferral_fn}" "ai::cohort::Applies(sPlayerbotAIConfig.rosterFarMoveLevelGuard, bot->GetGUIDLow())" "SharedGrid().Query(" "Query behind the guard's cohort switch")
  order("${deferral_fn}" "ai::level_guard::Ready() && UsesQuestFirstProgression(bot)" "SharedGrid().Query(" "Query behind Ready (no grid without LevelGuard)")
  order("${deferral_fn}" "SharedGrid().Query(" "rosterFarMoveLevelGuardZWindow" "ZWindow read only in the Query call")
  # the travel point's z (position), never the bot's
  need("${deferral_fn}" "        ai::level_guard::Hit hit = ai::level_guard::SharedGrid().Query(bot->GetMapId(), position->getX(), position->getY(),\n            position->getZ(), sPlayerbotAIConfig.rosterFarMoveLevelGuardRadius, bot->GetLevel()," "the travel point's z")
  need("${deferral_fn}" "            sPlayerbotAIConfig.rosterFarMoveLevelGuardZWindow, sPlayerbotAIConfig.rosterFarMoveLevelGuardSkipHarmless != 0,\n            [](int16_t eventId) { return ai::level_guard::EventActive(eventId); });" "sub-keys and the event snapshot passed")
  never("${deferral_fn}" "GetPositionZ()" "the bot's z in the guard")
  # the refresh: only with SkipHarmless, does nothing before the grid (Ready false with LevelGuard 0)
  need("${mgr}" "    if (sPlayerbotAIConfig.rosterFarMoveLevelGuardSkipHarmless)\n        ai::level_guard::RefreshActiveEvents();" "refresh called from the world update, only with SkipHarmless")
  need("${choose}" "    void RefreshActiveEvents()\n    {\n        if (!Ready() || gridEvents.empty())\n            return;" "refresh needs the grid")
  need("${choose}" "        return eventId > 0 && uint32_t(eventId) < gridEventSlots && gridEventActive[eventId].load(std::memory_order_relaxed);" "EventActive bounded, > 0")
  # the minute counts inside the guard's [FarMove] block, each only with its key
  between("${move}" "                    if (sPlayerbotAIConfig.rosterFarMoveLevelGuard)\n                    {\n                        ai::level_guard::Counters& g = ai::level_guard::SharedCounters();" "                    sLog.outBasic(\"[FarMove] started=" guard_block)
  if(NOT r AND guard_block STREQUAL "")
    set(r "[FarMove] guard block not found")
  endif()
  need("${guard_block}" "                        if (sPlayerbotAIConfig.rosterFarMoveLevelGuardZWindow)\n                        {\n                            snprintf(buf, sizeof(buf), \" guard_zfiltered=%u\", g.zFiltered.exchange(0, std::memory_order_relaxed));" "guard_zfiltered only with ZWindow")
  need("${guard_block}" "                        if (sPlayerbotAIConfig.rosterFarMoveLevelGuardSkipHarmless)\n                        {\n                            snprintf(buf, sizeof(buf), \" guard_eventfiltered=%u\", g.eventFiltered.exchange(0, std::memory_order_relaxed));" "guard_eventfiltered only with SkipHarmless")

  # 4. BuildGrid: the harmless skip and the guid -> event map only behind SkipHarmless; > 0 only; no GetGameEventId scan.
  between("${choose}" "    void BuildGrid()\n" "\ninline std::string GetTravelPurposeName(" build)
  if(NOT r AND build STREQUAL "")
    set(r "BuildGrid region not found")
  endif()
  need("${build}" "            bool const skipHarmless = sPlayerbotAIConfig.rosterFarMoveLevelGuardSkipHarmless != 0;" "SkipHarmless read once")
  need("${build}" "            if (skipHarmless)\n            {\n                auto const& lists = sGameEventMgr.GetCreatureGuidLists();" "event map only with SkipHarmless")
  need("${build}" "                    int32_t const eventId = EventIdOfList(slot, eventCount);\n                    if (!EventOnly(eventId))\n                        continue;" "only events > 0 in the map")
  need("${build}" "                if (skipHarmless && Harmless(info->flags_extra))\n                {\n                    ++skippedHarmless;\n                    continue;\n                }" "harmless skip only with SkipHarmless")
  need("${build}" "                spawn.z = data.position.z;" "spawn z")
  need("${build}" "                if (skipHarmless)\n                {\n                    auto const ev = eventOf.find(itr.first);" "event id only with SkipHarmless")
  order("${build}" "gridEventActive[id].store(sGameEventMgr.IsActiveEvent(uint16(id))" "gridReady.store(true, std::memory_order_release);" "event snapshot before the grid is published")
  never("${choose}" "GetGameEventId<Creature>" "linear GetGameEventId scan per spawn (OB-10: one map)")

  # 5. Lines.
  need("${choose}" "sLog.outBasic(\"[FarMoveGuard] state=grid spawns=%u skipped_harmless=%u event_spawns=%u ms=%u\", sharedGrid.Count()," "grid line")
  need("${choose}" " n_hostile=%u margin=%u radius=%.0f dz=%.0f harmless=%u\"," "skip line dz= harmless=")
  need("${choose}" "                                sPlayerbotAIConfig.rosterFarMoveLevelGuardRadius, guardHit.dz,\n                                sPlayerbotAIConfig.rosterFarMoveLevelGuardSkipHarmless);" "skip line values")
  need("${choose}" "                if (guardHit.zFiltered)\n                    ai::level_guard::SharedCounters().zFiltered.fetch_add(guardHit.zFiltered, std::memory_order_relaxed);" "zfiltered counted in the main loop")
  need("${choose}" "                if (guardHit.eventFiltered)\n                    ai::level_guard::SharedCounters().eventFiltered.fetch_add(guardHit.eventFiltered, std::memory_order_relaxed);" "eventfiltered counted in the main loop")

  # 6. Core accessor (read-only view of GameEventMgr's creature guid lists).
  need("${gem}" "std::vector<std::vector<uint32>> const& GetCreatureGuidLists() const { return mGameEventCreatureGuids; }" "GameEventMgr::GetCreatureGuidLists")
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

check_all("${policy}" "${config_h}" "${config_cpp}" "${conf_dist}" "${choose}" "${move}" "${mgr}" "${gem}" e)
if(e)
  message(FATAL_ERROR "${TAG}: ${e}")
endif()

