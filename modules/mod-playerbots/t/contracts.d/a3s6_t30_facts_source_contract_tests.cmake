# ---- (a) the gate ------------------------------------------------------------------------------------------------------------
function(check_gate ai_cpp all_sources out)
  count_text("${ai_cpp}" "${HOOK}" n)
  # PostManagerStatus( in the module: the declaration, the definition and the hook's call.
  count_text("${all_sources}" "PostManagerStatus(" calls)
  if(NOT n EQUAL 1 OR NOT calls EQUAL 3)
    set(${out} "gate: the status hook (StatusSeconds && (Applies(Manager) || IsManaged)) found ${n} times, PostManagerStatus( ${calls} times (1 and 3 expected)" PARENT_SCOPE)
    return()
  endif()
  # T30-1: OwnsBot, the .Types key, IsManaged and Blocks exist now (design 3.1); the hook names only Applies and IsManaged.
  string(FIND "${HOOK}" "OwnsBot" own_in_hook)
  if(NOT own_in_hook EQUAL -1)
    set(${out} "gate: the status hook must not gate on OwnsBot" PARENT_SCOPE)
    return()
  endif()
  region("${ai_cpp}" "${POST_START}" "\n}\n" body)
  if(body STREQUAL "")
    set(${out} "gate: PostManagerStatus not found" PARENT_SCOPE)
    return()
  endif()
  # Each fact post has its one place: the hook's PostManagerStatus.
  foreach(needle "manager_inbox::MakeEdge(" "manager_inbox::MakeWish(" "manager_inbox::CountKeyOverflow(" "manager_facts::ReadEdge("
      "manager_facts::ReadFlags(" "manager_facts::ReadKey(" "manager_facts::ReadWish(")
    count_text("${all_sources}" "${needle}" n)
    count_text("${body}" "${needle}" nb)
    if(NOT n EQUAL 1 OR NOT nb EQUAL 1)
      set(${out} "gate: ${needle} used ${n} times in the module, ${nb} in PostManagerStatus (1 and 1 expected)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "ai::manager_facts::ReadEdge(bot)" "ai::manager_facts::ReadFlags(bot, this)" "ai::manager_facts::ReadKey(bot)"
      "ai::manager_facts::ReadWish(bot, this, wish)")
    string(FIND "${body}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "gate: PostManagerStatus does not read the bot itself: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

