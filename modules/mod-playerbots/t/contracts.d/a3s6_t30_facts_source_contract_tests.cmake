function(check_op_path ops_policy ops_h ops_cpp all_sources out)
  foreach(needle
      "    Leader,         // PassLeadershipToMasterAction (\"leader\", \"give leader\")\n    Manager,        // A3 step 6 T30-0"
      "constexpr std::uint8_t kJoinManager = 0x01;"
      "constexpr std::uint8_t kJoinQuest = 0x02;"
      "    return std::uint8_t(kJoinManager | (quest ? kJoinQuest : 0));"
      "constexpr std::size_t kKinds = 5;"
      "constexpr std::size_t kVerdicts = 9;"
      "constexpr std::size_t kManagerOutcomesMax = 256;")
    string(FIND "${ops_policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "op path: GroupOpPolicy.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${ops_policy}" "    Manager,        // A3 step 6 T30-0: the world-thread group manager (QueueManagerJoin / QueueManagerLeave; called by GroupManager.cpp)\n};" at)
  if(at EQUAL -1)
    set(${out} "op path: OpSource::Manager is not the last source" PARENT_SCOPE)
    return()
  endif()
  # Declared and defined; T30-1: one caller each (the manager's WorldIo in GroupManager.cpp), ReadManagerOpCounts still none.
  foreach(fn_n "QueueManagerJoin(|3" "QueueManagerLeave(|3" "ReadManagerOpCounts(|2" "TakeManagerOutcomes(|3")
    string(REPLACE "|" ";" fv "${fn_n}")
    list(GET fv 0 fn)
    list(GET fv 1 want)
    count_text("${all_sources}" "${fn}" n)
    count_text("${ops_h}\n${ops_cpp}" "${fn}" n_own)
    if(NOT n EQUAL want OR NOT n_own EQUAL 2)
      set(${out} "op path: ${fn} appears ${n} times in the module (${want} expected: declaration, definition and the GroupManager.cpp caller)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${ops_cpp}" "bool QueueManagerJoin(" "\n}\n" join)
  region("${ops_cpp}" "bool QueueManagerLeave(" "\n}\n" leave)
  foreach(needle "    op.kind = OpKind::Join;" "    op.reason = ManagerJoinReason(type == group_mgr::GroupType::Quest);"
      "type == group_mgr::GroupType::Dungeon" "    if (Enqueue(op, inviteeAi, inviterAi) != Pushed::Queued)")
    string(FIND "${join}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "op path: QueueManagerJoin missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "    op.kind = OpKind::Leave;" "    op.reason = kLeaveQueued;" "    op.groupId = groupId;" "    if (Enqueue(op, ai, nullptr) != Pushed::Queued)")
    string(FIND "${leave}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "op path: QueueManagerLeave missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The outcomes: counted in Drain around Run, never inside a Run* body (m3).
  region("${ops_cpp}" "\nvoid Drain()\n{" "\n}\n" drain)
  string(FIND "${drain}" "std::uint32_t const failedBefore = m.failed[std::size_t(op.kind)];" before)
  string(FIND "${drain}" "Verdict const v = Run(op, transitMs, m);" run)
  string(FIND "${drain}" "                    later.push_back(op);\n                    continue;\n                }\n                if (op.source == std::uint8_t(OpSource::Manager))\n                    NoteManagerOutcome(op, v, ManagerOpResultOf(v, failedBefore, m.failed[std::size_t(op.kind)]));\n                if (v == Verdict::Execute)" after)
  string(FIND "${drain}" "                    DropAcceptInvite(op);\n                    if (op.source == std::uint8_t(OpSource::Manager))\n                        NoteManagerOutcome(op, Verdict::Retry, ManagerOpResult::Superseded);" sup)
  if(before EQUAL -1 OR run EQUAL -1 OR after EQUAL -1 OR sup EQUAL -1 OR NOT before LESS run OR NOT run LESS after)
    set(${out} "op path: Drain does not note the manager outcomes around Run (failed count before, note after the retry branch, superseded)" PARENT_SCOPE)
    return()
  endif()
  count_text("${drain}" "NoteManagerOutcome(" n_drain)
  count_text("${ops_cpp}" "NoteManagerOutcome(" n_all)
  if(NOT n_drain EQUAL 2 OR NOT n_all EQUAL 3)
    set(${out} "op path: NoteManagerOutcome( ${n_drain} times in Drain, ${n_all} in GroupOps.cpp (2 and 3 expected: two notes + the definition)" PARENT_SCOPE)
    return()
  endif()
  # The bounded outcome list.
  string(FIND "${ops_cpp}" "    if (s.outcomes.size() >= kManagerOutcomesMax)\n    {\n        ++s.counts.outcomesDropped;\n        return;\n    }" at)
  if(at EQUAL -1)
    set(${out} "op path: the outcome list is not bounded by kManagerOutcomesMax" PARENT_SCOPE)
    return()
  endif()
  # OpSource::Manager is set only by the two producers and read only by the drain (code of the files that name it, no comments).
  strip_comments("${opsrc_code}${all_sources_extra}" opsrc)
  count_text("${opsrc}" "OpSource::Manager" n)
  count_text("${ops_cpp}" "    op.source = std::uint8_t(OpSource::Manager);" n_set)
  count_text("${ops_cpp}" "if (op.source == std::uint8_t(OpSource::Manager))" n_read)
  if(NOT n EQUAL 4 OR NOT n_set EQUAL 2 OR NOT n_read EQUAL 2)
    set(${out} "op path: OpSource::Manager used ${n} times (4 expected: 2 producers in GroupOps.cpp, 2 outcome notes in Drain)" PARENT_SCOPE)
    return()
  endif()
  foreach(pair "RUN_LEAVE|H_RUN_LEAVE" "RUN_JOIN|H_RUN_JOIN" "RUN_ACCEPT|H_RUN_ACCEPT" "RUN_INVITE|H_RUN_INVITE" "RUN_LEADER|H_RUN_LEADER"
      "RUN_ANY|H_RUN_ANY" "FLUSH|H_FLUSH")
    string(REPLACE "|" ";" pv "${pair}")
    list(GET pv 0 start_var)
    list(GET pv 1 hash_var)
    region("${ops_cpp}" "${${start_var}}" "\n}\n" fbody)
    string(SHA256 h "${fbody}")
    if(fbody STREQUAL "" OR NOT h STREQUAL "${${hash_var}}")
      set(${out} "op path: ${start_var} is no longer byte-identical (m3: Run* bodies, the dispatcher and the minute lines stay as they are)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) the manager: tables and shadow counts, no op, no directive ---------------------------------------------------------
function(check_manager mgr_h mgr_cpp out)
  strip_comments("${mgr_h}\n${mgr_cpp}" code)
  # T30-1: ops only through the BOT-12 manager queue, directives only through the one R10-gated post.
  count_text("${code}" "${R10_POST}" n_post)
  if(NOT n_post EQUAL 1)
    set(${out} "manager: the R10-gated directive post found ${n_post} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  foreach(allowed "${R10_POST}" "group_ops::QueueManagerJoin(" "group_ops::QueueManagerLeave(" "group_ops::TakeManagerOutcomes("
      "group_ops::ManagerOutcome>")
    string(REPLACE "${allowed}" "" code "${code}")
  endforeach()
  foreach(word "group_ops::" "supervisor::Post" "supervisor::Drain" "supervisor::Forget" "PostDirectiveAck"
      "manager_inbox::Post(" "OpSource")
    string(FIND "${code}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "manager: must not use ${word} (only the manager queue and the R10 directive post)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${mgr_cpp}" "void WorldThreadManager::DrainInbox(" "\n}\n" pass)
  string(FIND "${pass}" "manager_inbox::Drain(inboxBuf_, manager_inbox::kDrainMaxPerPass);" p_drain)
  string(FIND "${pass}" "            StoreEvent(event, nowMs);" p_store)
  string(FIND "${pass}" "    DropGone(status_, bots);" p_prune)
  string(FIND "${pass}" "manager_inbox::CountShadow(" p_shadow)
  string(FIND "${pass}" "        manager_inbox::LogMinute(line);" p_log)
  if(p_drain EQUAL -1 OR p_store EQUAL -1 OR p_prune EQUAL -1 OR p_shadow EQUAL -1 OR p_log EQUAL -1)
    set(${out} "manager: DrainInbox lacks the drain, the table store, the prune, the shadow count or the minute line" PARENT_SCOPE)
    return()
  endif()
  if(NOT p_drain LESS p_store OR NOT p_store LESS p_prune OR NOT p_prune LESS p_shadow OR NOT p_shadow LESS p_log)
    set(${out} "manager: the pass order is not drain -> tables -> prune -> shadow count -> minute line" PARENT_SCOPE)
    return()
  endif()
  region("${mgr_cpp}" "void WorldThreadManager::StoreEvent(" "\n}\n" store)
  foreach(needle
      "        case manager_inbox::Kind::Status:\n            status_[event.botLow] = manager_inbox::SnapshotOf(event, nowMs);"
      "            wishes_.erase(event.botLow);"
      "        case manager_inbox::Kind::GroupEdge:\n            edges_[event.botLow] = manager_inbox::EdgeSnapshotOf(event, nowMs);"
      "        case manager_inbox::Kind::GroupWish:\n            wishes_[event.botLow] = manager_inbox::WishSnapshotOf(event, nowMs);")
    string(FIND "${store}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "manager: StoreEvent missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # T30-1: the shadow candidates take the R10 form (supervisor on and Applies), the same rule as the directive post.
  foreach(needle "        [](std::uint32_t low) { return sPlayerbotAIConfig.supervisor && ai::supervisor::Applies(sPlayerbotAIConfig.supervisor, low); }, nowMs,"
      "        manager_inbox::StaleMs(sPlayerbotAIConfig.botGroupsManagerStatusSeconds));")
    string(FIND "${pass}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "manager: the shadow count misses ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) no supervisor postbox in the pair ------------------------------------------------------------------------------------
function(check_no_postbox files out)
  strip_comments("${files}" code)
  string(REGEX MATCH "supervisor::(Post|Drain|Forget)[ ]*\\(|namespace (ai::)?supervisor" bad "${code}")
  if(NOT bad STREQUAL "")
    set(${out} "postbox: the pair touches the supervisor's postbox (${bad})" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (f) the unit tests -----------------------------------------------------------------------------------------------------------
function(check_unit inbox_test queue_test out)
  foreach(needle "    TestFlagsAndKey();" "    TestEdgeAndWish();" "    TestShadow();" "    TestT30MinuteDue();"
      "overflow: false and an empty key" "tally over the tables" "busy and grouped: not counted as cand_busy")
    string(FIND "${inbox_test}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "unit: t/manager_inbox_policy_tests.cpp missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "std::uint8_t(OpSource::Manager) == 7" "ManagerOpResultOf(Verdict::Execute, 3, 4) == ManagerOpResult::Failed"
      "the manager join is superseded" "quest join: QuestGroups.MaxSize reached: drop")
    string(FIND "${queue_test}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "unit: t/group_op_queue_tests.cpp missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

