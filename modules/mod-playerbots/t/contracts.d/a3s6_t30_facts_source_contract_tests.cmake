function(check_own_reads facts_h facts_cpp ai_cpp adhoc_world s7_world out)
  region("${ai_cpp}" "${POST_START}" "\n}\n" body)
  strip_comments("${facts_h}\n${facts_cpp}\n${body}" code)
  foreach(word "GetFirstMember" "GroupReference" "getSource" "GetMemberSlots" "ObjectAccessor" "FindPlayer" "GetPlayer(" "GetBotAI("
      "GetGroupMaster(" "GetMaster(" "GetPlayers(" "GetPlayerBot(" "HashMapHolder" "GetGroupById" "GetGroupByMember" "sObjectMgr.GetPlayer"
      "HandleGroup" "RemoveMember" "AddMember" "Disband" "UninviteFromGroup" "ChangeLeader" "group_ops::" "SetForced" "SetTarget("
      "TeleportTo" "DoSpecificAction" "ChangeStrategy" "supervisor::")
    string(FIND "${code}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "own reads: the fact posts must not use ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Every Player* the facts name is the bot itself.
  strip_comments("${facts_h}\n${facts_cpp}" facts_code)
  string(REGEX MATCHALL "Player\\*[ ]*[A-Za-z_]*" ptrs "${facts_code}")
  foreach(p IN LISTS ptrs)
    if(NOT p STREQUAL "Player* bot")
      set(${out} "own reads: ManagerFacts names another player (${p})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(REGEX MATCHALL "PlayerbotAI\\*[ ]*[A-Za-z_]*" ais "${facts_code}")
  foreach(p IN LISTS ais)
    if(NOT p STREQUAL "PlayerbotAI* ai")
      set(${out} "own reads: ManagerFacts names another AI (${p})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "adhoc_group::CandidateFacts(bot)" "adhoc_group::CurrentObjective(bot)" "adhoc_group::ObjectiveDone(bot, key)"
      "adhoc_group::ObjectiveCounter(bot, key)" "ai::zone_keep::StartZoneHolds(bot, ai)" "Group* const group = bot->GetGroup();")
    string(FIND "${facts_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "own reads: ManagerFacts.cpp missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The ad-hoc helpers read only their argument (no member list, no lookup, only the argument's own AI).
  foreach(fn "ObjectiveKey CurrentObjective(Player* player)\n{" "bool CandidateFacts(Player* player)\n{"
      "std::uint32_t ObjectiveCounter(Player* player, ObjectiveKey const& key)\n{" "bool ObjectiveDone(Player* player, ObjectiveKey const& key)\n{")
    region("${adhoc_world}" "${fn}" "\n}\n" helper)
    if(helper STREQUAL "")
      set(${out} "own reads: AdhocGroupWorld.cpp helper not found: ${fn}" PARENT_SCOPE)
      return()
    endif()
    string(REPLACE "GetBotAI(player)" "" helper_rest "${helper}")
    foreach(word "GetFirstMember" "ObjectAccessor" "GetGroupMaster(" "GetMaster(" "GetBotAI(" "GetPlayer(")
      string(FIND "${helper_rest}" "${word}" at)
      if(NOT at EQUAL -1)
        set(${out} "own reads: an ad-hoc helper the facts call reads beyond its player (${word})" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  # The interim wish is the S7 scan rule for the bot alone (F3 (a)).
  foreach(needle "${FACTS_OPEN}" "${DROP_ONLY}" "quest_groups::Waits(f)"
      "quest_groups::IsGroupHelpQuest(q->GetType(), q->GetSuggestedPlayers(), sPlayerbotAIConfig.questGroupsSuggestedPlayers)"
      "f.abandoned = target && target->IsStructurallyAbandoned(questId);" "bot->GetGroup() || bot->InBattleGround() || bot->InBattleGroundQueue()")
    string(FIND "${facts_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "own reads: the wish is not the S7 rule: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "${S7_OPEN}" "${DROP_ONLY}" "if (!Waits(f))"
      "IsGroupHelpQuest(q->GetType(), q->GetSuggestedPlayers(), sPlayerbotAIConfig.questGroupsSuggestedPlayers)")
    string(FIND "${s7_world}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "own reads: the S7 rule changed (QuestGroupWorld.cpp lacks ${needle}); align ManagerFacts.cpp ReadWish" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

