# ---- (a) writes nothing -----------------------------------------------------------------------------------------------------
function(check_writes_nothing text out)
  foreach(word "SetTarget(" "SetStatus(" "SetForced(" "SetExpireIn(" "SetConditions(" "SetNullTravelTarget(" "SetRelevance("
      "SET_AI_VALUE" "->Set(" "ChangeStrategy(" "ResetStrategies(" "TeleportTo(" "MoveTo(" "MotionMaster" "SetBestTarget("
      "CanRewardQuest(" "SendCanTakeQuestResponse(" "AddQuest(" "RewardQuest(" "SetAIInternalUpdateDelay(")
    string(FIND "${text}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlannerShadow.cpp: names '${word}' (the shadow writes nothing, no packet)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(money "    if (quest->GetRewOrReqMoney() < 0 && bot->GetMoney() < uint32(-quest->GetRewOrReqMoney()))\n        return false;")
  set(deliver "            if (quest->ReqItemCount[i] != 0 && bot->GetItemCount(quest->ReqItemId[i]) < quest->ReqItemCount[i])")
  set(auto "        if (!bot->CanTakeQuest(quest, false, true))")
  set(challenge "    if (!bot->SatisfyQuestChallenges(quest, false))")
  foreach(v money deliver auto challenge)
    count_text("${text}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "PlannerShadow.cpp: canReward copy '${v}' found ${n} times, want 1 (OB-10 264a55af)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) the tick, the budget, the minute -----------------------------------------------------------------------------------
function(check_tick text out)
  set(gate "void Supervisor::PlanTick(std::uint32_t nowMs, std::uint32_t arbiter)\n{\n    if (!sPlayerbotAIConfig.planner)\n        return;\n    PlanTickImpl(ai_, plan_, mode_, owner_, lastWriter_, nowMs, arbiter);\n}")
  set(budget "constexpr std::uint32_t kPlanLinesPerMinute = 300;")
  set(take "    return ai::rot_cast::BudgetTake(g_window, g_used, std::uint32_t(time(nullptr)), kPlanLinesPerMinute);")
  set(dropped "    else\n        ++c.planDropped;")
  set(write0 "        l.write = 0;   // P-2: the shadow writes nothing")
  foreach(v gate budget take dropped write0)
    count_text("${text}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "PlannerShadow.cpp: '${v}' found ${n} times, want 1" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${text}" "EmitEnforceLine" at)
  if(NOT at EQUAL -1)
    set(${out} "PlannerShadow.cpp: shares the enforcement line budget (section 7: own budget)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) the hooks ----------------------------------------------------------------------------------------------------------
function(check_hooks choose ai out)
  set(hit "    if (sPlayerbotAIConfig.planner)\n        ai::planner_shadow::NoteChoice(ai, futureTravelPurpose.c_str(), newTarget.GetDestination());\n\n    if (futureTravelPurpose == \"quest\")\n    {\n        TraceQuestRouteDecision(")
  set(miss "        SET_AI_VALUE2(bool, \"no active travel destinations\", futureTravelPurpose, true);\n        // A3 step 3 planner P-2b")
  set(miss_call "        if (sPlayerbotAIConfig.planner)\n            ai::planner_shadow::NoteChoice(ai, futureTravelPurpose.c_str(), nullptr);")
  set(any "planner_shadow::NoteChoice(")
  foreach(v hit miss miss_call)
    count_text("${choose}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "ChooseTravelTargetAction.cpp: hook '${v}' found ${n} times, want 1 (OB-10 B1/B4)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${choose}" any n)
  if(NOT n EQUAL 2)
    set(${out} "ChooseTravelTargetAction.cpp: ${n} NoteChoice calls, want 2" PARENT_SCOPE)
    return()
  endif()
  set(note "    if (questBook_)\n        questBook_->OnRewarded(questId);\n    // A3 step 3 planner P-2b")
  set(note_call "    if (sPlayerbotAIConfig.planner)\n        plannerRewardNotes_.Note(questId);\n}")
  set(packet "		if (sPlayerbotAIConfig.planner && packet.size() >= 4)\n		{\n			WorldPacket p(packet);\n			p.rpos(0);\n			uint32 plannerQuestId;\n			p >> plannerQuestId;\n			plannerRewardNotes_.Note(plannerQuestId);\n		}\n		if (questBook_ && packet.size() >= 4)")
  foreach(v note note_call packet)
    count_text("${ai}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "PlayerbotAI.cpp: reward note '${v}' found ${n} times, want 1 (OB-10 B2, OB-60 K1)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) the keys -----------------------------------------------------------------------------------------------------------
function(check_keys config_cpp config_h conf out)
  foreach(key IN LISTS PLANNER_KEYS)
    string(FIND "${config_cpp}" "(\"AiPlayerbot.${key}\"" at)
    if(at EQUAL -1)
      set(${out} "PlayerbotAIConfig.cpp: AiPlayerbot.${key} is not read" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${config_cpp}" "            {\"${key}\", Value(" at)
    if(at EQUAL -1)
      set(${out} "PlayerbotAIConfig.cpp: ${key} is not echoed" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${conf}" "\nAiPlayerbot.${key} = " at)
    if(at EQUAL -1)
      set(${out} "aiplayerbot.conf.dist.in: AiPlayerbot.${key} is not documented" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(off "    if (planner > 2)\n    {\n        sLog.outError(\"[Planner] config key=Planner value=%u result=off (0 off, 1 shadow, 2 plan pick acts)\", planner);\n        planner = 0;\n    }")
  count_text("${config_cpp}" off n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAIConfig.cpp: Planner above 2 is not off" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_h}" "    uint32 planner = 0;" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAIConfig.h: planner does not default to 0" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${conf}" "\nAiPlayerbot.Planner = 0\n" at)
  if(at EQUAL -1)
    set(${out} "aiplayerbot.conf.dist.in: AiPlayerbot.Planner is not 0" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) the state ----------------------------------------------------------------------------------------------------------
function(check_state sup_h shadow_h out)
  string(FIND "${sup_h}" "    ai::planner::PlanState plan_;" at)
  if(at EQUAL -1)
    set(${out} "Supervisor.h: no PlanState plan_" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${sup_h}" "TargetMemory" at)
  if(NOT at EQUAL -1)
    set(${out} "Supervisor.h: the scaffold TargetMemory is still there (the planner memory replaces it)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${shadow_h}" "MemorySlot memory[kMemorySlots];" at)
  if(at EQUAL -1)
    set(${out} "PlannerShadow.h: the planner memory is not MemorySlot" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

