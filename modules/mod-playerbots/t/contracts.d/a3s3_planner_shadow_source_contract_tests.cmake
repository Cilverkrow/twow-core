cmake_policy(VERSION 3.16)
# A3 step 3 planner P-2b (A3-S3-PLANER-ENTWURF.md v0.3, frozen d6e51878, Nachtrag 1; AiPlayerbot.Planner, default 0): the
# planner in the shadow. Pinned here:
#   (a) the shadow writes nothing: PlannerShadow.cpp names no travel target setter, no AI value write, no strategy change, no
#       teleport, no movement; it never calls Player::CanRewardQuest or SendCanTakeQuestResponse (both can send a packet; OB-10
#       264a55af, OB-60 20.11.) and copies the money and DELIVER checks instead;
#   (b) PlanTick: off is one config read; the body is file-local (PlanTickImpl); [Plan] has its own budget of 300 lines per
#       minute (not the enforcement line budget), [PlanMin] its own minute under its own mutex;
#   (c) the hooks: two read-only NoteChoice calls in ChooseTravelTargetAction.cpp (after the failure block of the main
#       SetBestTarget, and at the "no active travel destinations" line), each behind sPlayerbotAIConfig.planner; the planner's own
#       reward note at both reward sources (NoteQuestRewarded outside the book's if, the SMSG_QUESTGIVER_QUEST_COMPLETE handler);
#   (d) the keys: AiPlayerbot.Planner (0/1/2, above 2 off) and the Planner.* parameters are read, echoed and documented;
#   (e) Supervisor.h holds the planner state (PlanState plan_) instead of the unused scaffold TargetMemory.
# Every check_* returns "" when it holds, else the reason; the negative probes at the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s3 planner shadow: PB_SOURCE_DIR is required")
endif()

set(TAG "a3s3 planner shadow")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# needle_var is the NAME of a variable holding the needle (a ";" in a needle would split a list argument).
function(count_text text needle_var out)
  set(needle "${${needle_var}}")
  string(LENGTH "${needle}" nl)
  set(n 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

