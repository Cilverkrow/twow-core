# ---- (a) F2 ------------------------------------------------------------------------------------------------------------------
function(check_f2 policy write out)
  set(holds "    return heldKey && heldKey == pickKey && heldSinceMs == pickSinceMs && nowMs - heldAtMs < minBindMs;\n")
  set(skip "        case FeedSkip::Budget: return FeedFallback::BudgetHeld;\n")
  check_once("${policy}" "PlannerShadowPolicy.h" r holds skip)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(clear "    if (st.feedBudgetKey && !BudgetHolds(st.feedBudgetKey, st.feedBudgetSinceMs, st.feedBudgetAtMs, pick.key, pick.sinceMs, nowMs,\n            minBindMs))\n        st.feedBudgetKey = 0;\n")
  set(check "    FeedSkip const skip = FeedCheck(quest, grind, forcedTarget, pick.has, pickGrind, pick.atMs, nowMs, minBindMs, resumePending,\n        st.feedBudgetKey != 0);\n")
  set(note "        NoteFallback(st.fallbackAtMs, SkipFallback(skip), nowMs);\n")
  set(abort "            NoteFallback(st.fallbackAtMs, FeedFallback::Budget, nowMs);\n            st.feedBudgetKey = feed.key;")
  set(since "            st.feedBudgetSinceMs = feed.sinceMs;")
  set(at "            st.feedBudgetAtMs = nowMs;\n")
  check_once("${write}" "PlannerWrite.cpp" r clear check note abort since at)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) F3 and Q2 (c) --------------------------------------------------------------------------------------------------------
function(check_f3 write choose out)
  set(empty "                planFeed.grind ? ai::planner_write::FeedEnd::ZoneEmpty : ai::planner_write::FeedEnd::RejectEmpty);\n")
  check_once("${choose}" "ChooseTravelTargetAction.cpp" r empty)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(rej "            ++c.fallbackRejectEmpty;   // twow-repo#726 F3: the plan attempt never ran; no lock\n            NoteFallback(st.fallbackAtMs, FeedFallback::RejectEmpty, nowMs);\n")
  set(seen "            if (ZoneEmptySeen(st.zoneEmptyKey, st.zoneEmptySinceMs, feed.key, feed.sinceMs))\n            {\n                ++c.zoneEmptyHeld;\n                NoteFallback(st.fallbackAtMs, FeedFallback::ZoneEmptyHeld, nowMs);\n            }\n            else\n            {\n                ++c.fallbackZoneEmpty;\n                NoteFallback(st.fallbackAtMs, FeedFallback::ZoneEmpty, nowMs);\n                st.zoneEmptyKey = feed.key;\n                st.zoneEmptySinceMs = feed.sinceMs;\n            }\n")
  check_once("${write}" "PlannerWrite.cpp" r rej seen)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) F1 -------------------------------------------------------------------------------------------------------------------
function(check_f1 write choose out)
  set(start "        auto const takesStart = std::chrono::steady_clock::now();")
  set(stop "        planFeed.takesUs = uint32(std::min<long long>(std::chrono::duration_cast<std::chrono::microseconds>(\n            std::chrono::steady_clock::now() - takesStart).count(), 0xFFFFFFFFll));\n")
  check_once("${choose}" "ChooseTravelTargetAction.cpp" r start stop)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(count "    c.feedUs = feed.takesUs;")
  set(cmax "    c.feedUsMax = feed.takesUs;\n")
  check_once("${write}" "PlannerWrite.cpp" r count cmax)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) F4 -------------------------------------------------------------------------------------------------------------------
set(F4_KEYS "MinBindSec|120|1|3600" "MaxIdleSec|300|0|3600" "MinDwellSec|120|0|3600" "DeadWaitMaxSec|600|0|3600"
  "MaxHoldSec|1800|0|86400" "RepeatableRetakeSec|1800|0|86400")
function(check_f4 cpp out)
  set(clamp "        int32 const raw = config.GetIntDefault(key, def);\n        int32 const v = raw < lo ? lo : (raw > hi ? hi : raw);\n        if (v != raw)\n            sLog.outError(\"[Planner] config key=%s value=%d result=%d (%d..%d)\", key + 12, raw, v, lo, hi);\n        return uint32(v);\n")
  check_once("${cpp}" "PlayerbotAIConfig.cpp" r clamp)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(entry IN LISTS F4_KEYS)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 key)
    list(GET parts 1 def)
    list(GET parts 2 lo)
    list(GET parts 3 hi)
    set(call "= plannerSec(\"AiPlayerbot.Planner.${key}\", ${def}, ${lo}, ${hi});\n")
    set(old "uint32(config.GetIntDefault(\"AiPlayerbot.Planner.${key}\"")
    count_text("${cpp}" call n)
    count_text("${cpp}" old m)
    if(NOT n EQUAL 1 OR NOT m EQUAL 0)
      set(${out} "PlayerbotAIConfig.cpp: Planner.${key} clamped read ${n} (want 1), unclamped uint32 read ${m} (want 0)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) F6 and (f) the unit tests --------------------------------------------------------------------------------------------
function(check_f6_tests sup planner_t sup_t out)
  set(reason "    if (writer == WriterId::Planner)\n        return \"planner\";")
  check_once("${sup}" "SupervisorPolicy.h" r reason)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(def "void TestFeedFixes726()\n")
  set(run "    TestFeedFixes726();\n")
  check_once("${planner_t}" "t/planner_shadow_policy_tests.cpp" r def run)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(req "    Require(std::string(ReasonFor(plannerExpire)) == \"planner\", \"reason planner\");")
  check_once("${sup_t}" "t/supervisor_policy_tests.cpp" r req)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

