set(MINUTE3 "\"[GroupMgr] minute3 gather=%u region_mismatch=%llu z_out=%llu place_jump_same=%llu\"\n        \" place_jump_other=%llu gather_resume=%llu shadow_arrived=%llu shadow_disagree=%llu shadow_leg_expired=%llu places=%llu\"\n        \" open=%llu shadow_gathered=%llu shadow_compared=%llu shadow_t33_first=%llu shadow_t30_first=%llu shadow_t30_cut=%llu\"\n        \" dead_at_point=%llu shadow_lines_dropped=%llu adhoc_formed=%llu adhoc_arrived=%llu adhoc_all=%llu adhoc_never=%llu\"\n        \" adhoc_open=%llu\"")
set(PHASE "\"[GroupMgr] event=phase group=%u phase=%s ms=%llu gather=%u\"")
set(SHADOW_END "\"[GroupMgr] event=shadow_end group=%u gather=%u result=%s ms=%llu arrived=%u/%u\"")
set(T30_TIMEOUT "    if (why != EndReason::RendezvousTimeout)\n        return ShadowEnd::Closed;\n    GatherPoint leg;\n    leg.deadlineMs = deadlineMs;\n    return !resumed && LegExpired(mgrMs + kT30SecondSlackMs, leg) ? ShadowEnd::Expired : ShadowEnd::T30Cut;")
# Review fixes (CLI-GRP 10.11.): T30's whole second as slack, the verdict for a meeting ended and swept in one pass, and no
# place_jump from a stale previous place.
set(T30_SLACK "constexpr std::uint64_t kT30SecondSlackMs = 1100;")
set(T30_ENDING "            ShadowEnd const r = T30EndVerdict(g.endReason, in.resumed, in.mgrMs, s.deadlineMs);")
set(T30_SWEPT "                if (in.swept)\n                    for (SweptGroup const& sg : *in.swept)\n                        if (sg.serial == it->first)\n                            r = T30EndVerdict(sg.why, in.resumed, in.mgrMs, it->second.deadlineMs);\n                CountEnd(r);")
set(JUMP_FRESH "        bool const base = !it->second.busy && !s.busy && manager_inbox::Fresh(it->second.receivedMs, nowMs, maxAgeMs);")
set(ENGINE_SWEPT_CLEAR "        ++passNo_;\n        swept_.clear();")
set(ENGINE_SWEPT_PUSH "            pendingDissolved_.push_back(g);\n            swept_.push_back(SweptGroup{g.serial, g.endReason});\n            it = groups_.erase(it);")
set(LEADER_FRESH "    if (lp != places.end() && ls != status.end() && manager_inbox::Fresh(lp->second.receivedMs, nowMs, r.maxAgeMs) &&\n        manager_inbox::Fresh(ls->second.receivedMs, nowMs, r.maxAgeMs))\n        leader = &lp->second;")

function(check_shadow gather_h shadow_h mgr_cpp all_sources out)
  string(REGEX MATCHALL "#include [^\n]*" inc "${gather_h}")
  string(REPLACE ";" "|" inc "${inc}")
  if(NOT inc STREQUAL "#include \"GroupManagerPolicy.h\"|#include \"ManagerInboxPolicy.h\"|#include <algorithm>|#include <cstdint>|#include <cstring>|#include <vector>")
    set(${out} "shadow: GroupGatherPolicy.h includes changed (${inc})" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "#include [^\n]*" inc "${shadow_h}")
  string(REPLACE ";" "|" inc "${inc}")
  if(NOT inc STREQUAL "#include \"GroupGatherPolicy.h\"|#include \"GroupDirectivePolicy.h\"|#include <algorithm>|#include <cstdint>|#include <cstdio>|#include <iterator>|#include <unordered_map>|#include <vector>")
    set(${out} "shadow: GroupGatherShadow.h includes changed (${inc})" PARENT_SCOPE)
    return()
  endif()
  foreach(bad "sLog" "sPlayerbotAIConfig" "WorldTimer" "Player*" "ObjectAccessor" "TeleportTo" "MotionMaster" "Post(" "Enqueue"
      "group_ops::" "supervisor::")
    string(FIND "${gather_h}\n${shadow_h}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "shadow: the pure headers use ${bad}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The registry through a const view only.
  string(FIND "${shadow_h}" "    void Pass(std::unordered_map<std::uint32_t, ManagedGroup> const& groups, ShadowInput const& in, Sink const& line)" at)
  if(at EQUAL -1)
    set(${out} "shadow: Pass does not take the registry as a const view" PARENT_SCOPE)
    return()
  endif()
  foreach(bad "ManagedGroup&" "Member&" "const_cast")
    string(FIND "${shadow_h}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "shadow: GroupGatherShadow.h holds a writable registry reference (${bad})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The T33 arrival rule: S7's Arrived, only inside ArrivedForGroup and (T33-0b) ArrivedAtAnchor; the shadow and the manager
  # call only those.
  count_text("${gather_h}" "Arrived(" n)
  count_text("${shadow_h}\n${mgr_cpp}" "Arrived(" m)
  count_text("${all_sources}" "ArrivedForGroup(" k)
  if(NOT n EQUAL 2 OR NOT m EQUAL 0 OR NOT k EQUAL 2)
    set(${out} "shadow: Arrived( ${n} times in GroupGatherPolicy.h (2), ${m} in the shadow/manager (0), ArrivedForGroup( ${k} in the module (2)" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "        m.judged = m.low != leaderLow;"
      "        m.arrived = Arrived(place, point);"
      "    v.gathered = v.pointKnown && v.arrived == v.judged;"
      "${LEADER_FRESH}"
      "    std::uint32_t const limit = 2u * std::max<std::uint32_t>(intervalMs, 1000u);\n    return mgrMs + (delta > limit ? intervalMs : delta);")
    string(FIND "${gather_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "shadow: GroupGatherPolicy.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle
      "${MINUTE3}"
      "${PHASE}"
      "${SHADOW_END}"
      "                s.deadlineMs = in.mgrMs + legMs;"
      "                    entry.second.deadlineMs = in.mgrMs + legMs;"
      "        if (!in.resumed && LegExpired(in.mgrMs, leg))"
      "${T30_TIMEOUT}"
      "${T30_SLACK}"
      "${T30_ENDING}"
      "${T30_SWEPT}"
      "${JUMP_FRESH}"
      "        bool const compare = s.phase == quest_groups::Phase::Rendezvous && !ending && !in.resumed &&\n            g.phase != quest_groups::Phase::TurnIn;"
      "            if (g.type != GroupType::Quest)\n                continue;"
      "    void Off()\n    {\n        if (!on_)\n            return;"
      "        if (linesThisMinute_ >= kLinesPerMinute)\n        {\n            ++counts_.linesDropped;\n            return;\n        }")
    string(FIND "${shadow_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "shadow: GroupGatherShadow.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${all_sources}" "(buf, size, \"[GroupMgr] minute3 " n)
  count_text("${all_sources}" "(buf, size, \"[GroupMgr] event=phase " m)
  count_text("${all_sources}" "(buf, size, \"[GroupMgr] event=shadow_end " k)
  if(NOT n EQUAL 1 OR NOT m EQUAL 1 OR NOT k EQUAL 1)
    set(${out} "shadow: the minute3 / event=phase / event=shadow_end formats appear ${n} / ${m} / ${k} times in the module (1 each)" PARENT_SCOPE)
    return()
  endif()
  # Event lines only through the budget (EventLine), the minute line once.
  count_text("${shadow_h}" "        EventLine(line, buf);" n)
  count_text("${shadow_h}" "line(text);" m)
  count_text("${shadow_h}" "line(buf);" k)
  if(NOT n EQUAL 2 OR NOT m EQUAL 1 OR NOT k EQUAL 1)
    set(${out} "shadow: event lines bypass the budget (EventLine ${n} of 2, line(text) ${m} of 1, line(buf) ${k} of 1)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d2) T33-0b: ADHOC anchor counters ---------------------------------------------------------------------------------------
set(ANCHOR_BRANCH "            if (g.type == GroupType::Adhoc)\n            {\n                AnchorPass(g, in);\n                continue;\n            }\n            if (g.type != GroupType::Quest)\n                continue;")
set(ANCHOR_SIG "    void AnchorPass(ManagedGroup const& g, ShadowInput const& in)\n    {")
set(ANCHOR_ENDING "        if (g.state == GroupState::Ending)\n            return;\n        verdicts_.clear();")
set(ANCHOR_CALL "        GroupVerdict const v = ArrivedAtAnchor(g.mapId, g.anchorX, g.anchorY, g.leaderLow, verdicts_, *in.status, *in.places,\n            in.nowMs, in.rules);")
set(ANCHOR_NEVER "            counts_.adhocNever += it->second.open ? 1 : 0;\n            it = anchors_.erase(it);")
set(ANCHOR_OFF "        meetings_.clear();\n        anchors_.clear();")
set(ANCHOR_INSTANCE "    g.instanceId = leader && leader->place.mapId == mapId && leader->place.instanceable ? leader->place.instanceId : 0u;")
set(ANCHOR_GATHERED "    v.gathered = v.judged > 0 && v.arrived == v.judged;")
function(check_anchor gather_h shadow_h all_sources out)
  foreach(needle "${ANCHOR_INSTANCE}" "    g.zBand = kZUnknown;\n    g.deadlineMs = 0;" "${ANCHOR_GATHERED}"
      "    v.pointKnown = true;   // the anchor is fixed at creation"
      "    GatherPoint const point = AnchorPointFor(mapId, x, y, leader, r.radius);")
    string(FIND "${gather_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "anchor: GroupGatherPolicy.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "${ANCHOR_BRANCH}" "${ANCHOR_SIG}" "${ANCHOR_ENDING}" "${ANCHOR_CALL}" "${ANCHOR_NEVER}" "${ANCHOR_OFF}")
    string(FIND "${shadow_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "anchor: GroupGatherShadow.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # One rule, one caller (the definition + AnchorPass); AnchorPass has no line sink, so it writes no line.
  count_text("${all_sources}" "ArrivedAtAnchor(" n)
  count_text("${all_sources}" "AnchorPass(" m)
  if(NOT n EQUAL 2 OR NOT m EQUAL 2)
    set(${out} "anchor: ArrivedAtAnchor( ${n} times (2), AnchorPass( ${m} times (2) in the module" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# The engine's swept list for the shadow: cleared at every pass start, one entry per group Sweep erases (serial and end
# reason), read through a const accessor only; the engine never reads it back (no behaviour depends on it).
function(check_swept directive_h out)
  foreach(needle "${ENGINE_SWEPT_CLEAR}" "${ENGINE_SWEPT_PUSH}"
      "    std::vector<SweptGroup> const& Swept() const { return swept_; }")
    string(FIND "${directive_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "swept: GroupDirectivePolicy.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${directive_h}" "swept_" n)
  if(NOT n EQUAL 4)
    set(${out} "swept: swept_ appears ${n} times in GroupDirectivePolicy.h (4: clear, push, accessor, member)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) T33-1 absent, no movement -------------------------------------------------------------------------------------------
function(check_absent mgr_h mgr_cpp facts_cpp gather_h shadow_h all_sources out)
  foreach(bad "MaskRendezvous" "ReanchorDue" "kReanchorMs" "PackUpdateVerb" "GatherApplies" "rungSentMs")
    string(FIND "${all_sources}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "absent: T33-1 name ${bad} in the module" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(pair "NextFallback(@1" "Verb::Update@1" "kAckReasonGatherOtherMap@2" "kAckReasonNoOpenGroup@2" "supervisor::Post(@1" "->Tick(@1")
    string(FIND "${pair}" "@" cut)
    string(SUBSTRING "${pair}" 0 ${cut} needle)
    math(EXPR cut "${cut} + 1")
    string(SUBSTRING "${pair}" ${cut} -1 want)
    count_text("${all_sources}" "${needle}" n)
    if(NOT n EQUAL want)
      set(${out} "absent: ${needle} appears ${n} times in the module (${want} expected: no T33-1 use)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(bad "Fallback::" "TeleportTo" "MotionMaster" "SetForced(" "TemporaryTravelDestination" "DoSpecificAction" "ShortcutNear(" "SetTravelTarget"
      "GetMotionMaster")
    string(FIND "${mgr_h}\n${mgr_cpp}\n${facts_cpp}\n${gather_h}\n${shadow_h}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "absent: movement or action ${bad} in the manager, facts or shadow files" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (f) the unit test --------------------------------------------------------------------------------------------------------
function(check_unit tests_cmake unit_test out)
  foreach(needle "add_executable(group_gather_policy_tests\n  \"\${PB_MODULE_DIR}/t/group_gather_policy_tests.cpp\")"
      "add_test(NAME group_gather_policy\n  COMMAND group_gather_policy_tests")
    string(FIND "${tests_cmake}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "unit: tests.cmake missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "    TestSwitch();" "    TestPack();" "    TestJump();" "    TestPlaceOf();" "    TestGatherPoint();" "    TestArrivedForGroup();"
      "    TestAdvanceClock();" "    TestShadowVerdicts();" "    TestShadowDeadline();" "    TestShadowScope();" "    TestShadowMinute();"
      "    TestShadowEnd();" "    TestShadowSecondSlack();" "    TestShadowSwept();" "    TestPlaceJumpStale();"
      "    TestArrivedAtAnchor();" "    TestShadowAnchor();")
    string(FIND "${unit_test}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "unit: t/group_gather_policy_tests.cpp main misses ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

