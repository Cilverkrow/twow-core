set(GATE "    bool const gather = sPlayerbotAIConfig.botGroupsManagerGather && edge.groupId &&\n        ai::group_mgr::Applies(sPlayerbotAIConfig.botGroupsManager, bot->GetGUIDLow());")
set(PLACE_POST "    if (gather && (due || placeChanged))\n        ai::manager_inbox::Post(ai::group_mgr::MakeGatherPlace(bot->GetGUIDLow(), place));")
set(EDGE_POST "    if (due || edgeChanged)\n        ai::manager_inbox::Post(ai::manager_inbox::MakeEdge(bot->GetGUIDLow(), edge, x, y));")

function(check_bot ai_cpp ai_h facts_cpp facts_h inbox_policy gather_h all_sources out)
  region("${ai_cpp}" "void PlayerbotAI::PostManagerStatus()\n{" "\n}\n" body)
  if(body STREQUAL "")
    set(${out} "bot: PostManagerStatus not defined" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "${GATE}"
      "    if (gather)\n    {\n        place = ai::manager_facts::ReadPlace(bot);\n        placeChanged = !managerPlaceKnown || place.mapId != managerPlaceMap || place.instanceId != managerPlaceInstance;"
      "    else\n        managerPlaceKnown = false;"
      "    if (!due && !edgeChanged && !placeChanged)\n        return;\n    if (!InQuestBookScope())\n        return;"
      "${PLACE_POST}"
      "${EDGE_POST}\n    if (!due)\n        return;")
    string(FIND "${body}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "bot: PostManagerStatus missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The gate on the bot's own facts: the edge read before it, no registry or other player in the gated block.
  string(FIND "${body}" "ai::manager_facts::ReadEdge(bot);" edge_at)
  string(FIND "${body}" "${GATE}" gate_at)
  if(NOT edge_at LESS gate_at)
    set(${out} "bot: the gate does not use the bot's own edge read before it" PARENT_SCOPE)
    return()
  endif()
  region("${body}" "${GATE}" "        managerPlaceKnown = false;" gated)
  foreach(bad "GetGroup(" "GetFirstMember" "GetBotAI(" "QuestRoleOf(" "IsManaged(" "Groups(" "ObjectAccessor" "sRandomPlayerbotMgr")
    string(FIND "${gated}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "bot: the GatherPlace gate reads beyond the bot's own facts (${bad})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Order: the scope test, the status, the place, the edge.
  string(FIND "${body}" "    if (!InQuestBookScope())" scope)
  string(FIND "${body}" "        ai::manager_inbox::Post(event);" status)
  string(FIND "${body}" "${PLACE_POST}" place)
  string(FIND "${body}" "${EDGE_POST}" edge)
  if(NOT scope LESS status OR NOT status LESS place OR NOT place LESS edge)
    set(${out} "bot: the GatherPlace is not posted after the scope test and the status, before the edge" PARENT_SCOPE)
    return()
  endif()
  count_text("${all_sources}" "MakeGatherPlace(" n)
  if(NOT n EQUAL 2)
    set(${out} "bot: MakeGatherPlace( appears ${n} times in the module (2 expected: definition, the one post)" PARENT_SCOPE)
    return()
  endif()
  count_text("${all_sources}" "ReadPlace(" n)
  if(NOT n EQUAL 3)
    set(${out} "bot: ReadPlace( appears ${n} times in the module (3 expected: declaration, definition, the gated read)" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "    uint32 managerPlaceMap = 0;" "    uint32 managerPlaceInstance = 0;" "    bool managerPlaceKnown = false;")
    string(FIND "${ai_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "bot: PlayerbotAI.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # ReadPlace: the bot's own map, instance and position only; the serial stays 0 (no directive record before T02-GROUP).
  string(FIND "${facts_h}" "group_mgr::PlaceFacts ReadPlace(Player* bot);" at)
  if(at EQUAL -1)
    set(${out} "bot: ManagerFacts.h does not declare ReadPlace(Player* bot)" PARENT_SCOPE)
    return()
  endif()
  region("${facts_cpp}" "group_mgr::PlaceFacts ReadPlace(Player* bot)\n{" "\n}\n" read)
  foreach(needle "    p.mapId = bot->GetMapId();" "    p.instanceId = bot->GetInstanceId();" "    p.instanceable = bot->GetMap()->Instanceable();"
      "    p.z = bot->GetPositionZ();\n    return p;\n}")
    string(FIND "${read}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "bot: ReadPlace missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(bad "p.serial" "GetGroup(" "GetBotAI(" "ObjectAccessor" "sRandomPlayerbotMgr" "group_mgr::Find" "IsManaged(")
    string(FIND "${read}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "bot: ReadPlace reads beyond the bot itself (${bad})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # GatherPlace appended to Kind: the existing kinds keep their values.
  foreach(needle "    DirectiveAck,\n    GroupEdge,\n    GatherPlace,\n};" "constexpr std::size_t kKinds = std::size_t(Kind::GatherPlace) + 1;")
    string(FIND "${inbox_policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "bot: ManagerInboxPolicy.h missing ${needle} (GatherPlace appended)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${all_sources}" "manager_inbox::Kind::GatherPlace" n)
  if(NOT n EQUAL 2)
    set(${out} "bot: manager_inbox::Kind::GatherPlace appears ${n} times in the module (2 expected: MakeGatherPlace, the manager's store)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

