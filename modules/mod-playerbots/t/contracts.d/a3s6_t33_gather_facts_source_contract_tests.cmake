set(LOAD "    botGroupsManagerGather = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.Manager.Gather\", 0));\n    if (!ai::group_mgr::GatherValid(botGroupsManagerGather))\n    {\n        sLog.outError(\"[GroupMgr] config key=Manager.Gather value=%d result=off (0 off, 1 all, 2 cohort B, 3 cohort A)\",\n            int32(botGroupsManagerGather));\n        botGroupsManagerGather = 0;\n    }\n    if (botGroupsManagerGather && !botGroupsManagerTypes)\n    {\n        sLog.outError(\"[GroupMgr] config key=Manager.Gather value=%u result=0 (needs Manager.Types > 0)\", botGroupsManagerGather);\n        botGroupsManagerGather = ai::group_mgr::EffectiveGather(botGroupsManagerGather, botGroupsManagerTypes);\n    }")
set(ECHO "            {\"BotGroups.Manager\", Value(botGroupsManager)},\n            {\"BotGroups.Manager.Gather\", Value(botGroupsManagerGather)},\n            {\"BotGroups.Manager.StatusSeconds\", Value(botGroupsManagerStatusSeconds)},\n")

function(check_switch config_h config_cpp conf_dist gather_h out)
  string(FIND "${config_h}" "    uint32 botGroupsManagerGather = 0;" at)
  if(at EQUAL -1)
    set(${out} "switch: PlayerbotAIConfig.h member botGroupsManagerGather not default 0" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${LOAD}" at)
  if(at EQUAL -1)
    set(${out} "switch: PlayerbotAIConfig.cpp does not read Gather with default 0, off on an unknown value and on Types 0" PARENT_SCOPE)
    return()
  endif()
  # Read after Types (the Types rule is final by then).
  string(FIND "${config_cpp}" "botGroupsManagerTypes = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.Manager.Types\"" types_at)
  if(types_at EQUAL -1 OR NOT types_at LESS at)
    set(${out} "switch: Gather is not read after Manager.Types" PARENT_SCOPE)
    return()
  endif()
  count_text("${config_cpp}" "\"AiPlayerbot.BotGroups.Manager.Gather\"" n)
  if(NOT n EQUAL 1)
    set(${out} "switch: Gather read ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${ECHO}" at)
  if(at EQUAL -1)
    set(${out} "switch: the [ConfigEcho] entry is not in its sorted place between BotGroups.Manager and .StatusSeconds" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "\nAiPlayerbot\\.BotGroups\\.Manager\\.Gather = [^\n]*" lines "${conf_dist}")
  list(LENGTH lines n)
  if(NOT n EQUAL 1 OR NOT lines STREQUAL "\nAiPlayerbot.BotGroups.Manager.Gather = 0")
    set(${out} "switch: conf.dist documents AiPlayerbot.BotGroups.Manager.Gather ${n} times or not = 0" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${conf_dist}" "\nAiPlayerbot.BotGroups.Manager.Types = 0\n# A3 step 6 T33-0 (design T33 v1.1, owner decisions F1-F17 = (a)): MEASUREMENT ONLY, default 0, no behaviour change." at)
  if(at EQUAL -1)
    set(${out} "switch: the conf.dist block is not right after Manager.Types = 0 as measurement only" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "inline bool GatherValid(std::uint32_t raw)\n{\n    return raw <= cohort::ModeOnlyA;\n}"
      "    return types && GatherValid(gather) ? gather : 0u;")
    string(FIND "${gather_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "switch: GroupGatherPolicy.h missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

