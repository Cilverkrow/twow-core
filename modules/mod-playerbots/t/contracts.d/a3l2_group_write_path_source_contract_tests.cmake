  foreach(needle "                if (!LeaveSupersedes(mine->second.kind))"
      "        else if (mine != latest.end() || (HoldsBoth(op.kind) && latest.count(op.other)))"
      "        for (OpKind kind : kPopOrder)"
      "        latest[op.bot] = { op.seq, op.kind, HoldsBoth(op.kind) ? op.other : 0u };"
      "        if (HoldsBoth(op.kind))\n            EraseIfLatest(op.other, op.seq);"
      "        if (!HoldsBoth(op.kind))\n            return true;")
    string(FIND "${queue_h}" "${needle}" at)
