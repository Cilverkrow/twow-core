function(check_switch config_h config_cpp conf_dist out)
  string(FIND "${config_h}" "    uint32 botGroupsWritePath = 0;" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAIConfig.h: botGroupsWritePath not default 0" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "    botGroupsWritePath = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.WritePath\", 0));\n    if (!ai::group_ops::ValidMode(botGroupsWritePath))\n    {\n        sLog.outError(\"[GroupWrite] config key=WritePath value=%u result=off (0 off, 1 all, 2 cohort B, 3 cohort A)\", botGroupsWritePath);\n        botGroupsWritePath = 0;\n    }"
      "            {\"BotGroups.WorldThreadDefer\", Value(botGroupsWorldThreadDefer)},\n            {\"BotGroups.WritePath\", Value(botGroupsWritePath)},\n            {\"BotUpdateTrace\"")
    string(FIND "${config_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "PlayerbotAIConfig.cpp: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${config_cpp}" "\"BotGroups.WritePath\"" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAIConfig.cpp: the echo entry ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  count_text("${conf_dist}" "\nAiPlayerbot.BotGroups.WritePath =" n)
  if(NOT n EQUAL 1)
    set(${out} "conf.dist: AiPlayerbot.BotGroups.WritePath documented ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${conf_dist}" "\nAiPlayerbot.BotGroups.WritePath = 0\n" at)
  if(at EQUAL -1)
    set(${out} "conf.dist: AiPlayerbot.BotGroups.WritePath is not 0" PARENT_SCOPE)
    return()
  endif()
  # The whole [GroupWrite] field list of the doc, as the code's GW_LINE prints it (a renamed field leaves no stale doc).
  foreach(needle "# A3 lever 2 (ADR-0041 amendment 4.2, OB-00 07.11.2026): the group write path."
      "\"[GroupWrite] minute mode= enq_<k>= exec_<k>=\n# fail_<k>= stale_<k>= refused_pending_<k>= dropped_full_<k>= superseding= superseded= bypass= off_wp_create= off_wp_disband=\n# off_wp_add= off_wp_remove= off_wp_leader= off_wp_invite= accept_player=\" for k = leave, join, accept, invite, leader.\n# accept_player counts the queued accepts of a real player's invite (a deviation from ADR-0041 E7"
      "off_wp_* counts the" "0 is necessary, not proof."
      "\"[GroupOps] minute\" line (mode=<OpQueue>) and the off-thread group observer (counters) run too, also with OpQueue = 0")
    string(FIND "${conf_dist}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "conf.dist: the doc block lost ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- the gate and the pure rules ----------------------------------------------------------------------------------------
function(check_gate ops policy out)
  region("${ops}" "${ROUTES_HEAD}" "\n}\n" routes)
  if(routes STREQUAL "")
    set(${out} "WritePathRoutes: the key is not its first check" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "    if (t_worldThread || t_writeBypass)\n        return false;" "    return InWritePathScope(ai);")
    string(FIND "${routes}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "WritePathRoutes: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${ops}" "bool InWritePathScope(PlayerbotAI* ai)\n{" "\n}\n" scope)
  foreach(needle "!ai->IsRealPlayer() && !ai->HasRealPlayerMaster() && !bot->InBattleGround()"
      "WritePathApplies(sPlayerbotAIConfig.botGroupsWritePath, bot->GetGUIDLow())")
    string(FIND "${scope}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "InWritePathScope: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle
      "inline bool WritePathApplies(std::uint32_t mode, std::uint32_t guidLow)\n{\n    return cohort::Applies(SanitizeMode(mode), guidLow);\n}"
      "    return mode <= cohort::ModeOnlyA;"
      "constexpr std::size_t kKinds = 5;"
      "constexpr OpKind kPopOrder[kKinds] = { OpKind::Leave, OpKind::Leader, OpKind::Accept, OpKind::Invite, OpKind::Join };"
      "    return kind == OpKind::Join || kind == OpKind::Invite;"
      "    return pending == OpKind::Join || pending == OpKind::Accept || pending == OpKind::Invite;"
      "    Leave = 0,\n    Join = 1,\n    Accept = 2,"
      "    Invite = 3,"
      "    Leader = 4,"
      "    AdhocAction = 0,\n    Command, " "    LeaveFarAway, " "    Repop, " "    Accept, " "    Invite, " "    Leader, ")
    string(FIND "${policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupOpPolicy.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

