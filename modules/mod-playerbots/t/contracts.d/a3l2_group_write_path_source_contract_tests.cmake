if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3l2 group_write_path: PB_SOURCE_DIR is required")
endif()

set(TAG "a3l2 group_write_path")

function(read_source path out_var)
  if(NOT EXISTS "${PB_SOURCE_DIR}/${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

function(expect_caught what reason)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
endfunction()

# The text from the first `start` up to the next `stop` after it ("" when start or stop is missing: every caller then fails
# on the empty window - never a silent widening to the rest of the file).
function(region text start stop out_var)
  string(FIND "${text}" "${start}" at)
  if(at EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(LENGTH "${start}" start_len)
  string(SUBSTRING "${rest}" ${start_len} -1 after)
  string(FIND "${after}" "${stop}" end)
  if(end EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
  else()
    math(EXPR len "${start_len} + ${end}")
    string(SUBSTRING "${rest}" 0 ${len} body)
    set(${out_var} "${body}" PARENT_SCOPE)
  endif()
endfunction()

# "" when `first` occurs in text and before every occurrence of `later` (later must occur too), else the reason.
function(check_before text first later what out)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${later}" b)
  if(a EQUAL -1)
    set(${out} "${what}: '${first}' missing" PARENT_SCOPE)
  elseif(b EQUAL -1)
    set(${out} "${what}: '${later}' missing" PARENT_SCOPE)
  elseif(NOT a LESS b)
    set(${out} "${what}: '${first}' is not before '${later}'" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

# How often needle occurs in text (no regex: a ';' in a MATCHALL match would split the list).
function(count_text text needle out)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" len)
  string(FIND "${rest}" "${needle}" at)
  while(NOT at EQUAL -1)
    math(EXPR n "${n} + 1")
    math(EXPR at "${at} + ${len}")
    string(SUBSTRING "${rest}" ${at} -1 rest)
    string(FIND "${rest}" "${needle}" at)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# "" when none of the needles occurs in text (needles without ';').
function(check_none text what out)
  foreach(needle IN LISTS ARGN)
    string(FIND "${text}" "${needle}" at)
    if(NOT at EQUAL -1)
      set(${out} "${what}: ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

