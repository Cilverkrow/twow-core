# ---- (c) executors in GroupOps.cpp ----------------------------------------------------------------------------------------
function(check_exec ops out)
  foreach(spec
      "RunAccept|DecideAcceptOp|ai->DoSpecificAction(\"accept invitation\", Event(group_ai_refresh::GroupOpSource, \"\", inviter), true)"
      "RunAccept|DecideAcceptOp|bot->UninviteFromGroup()"
      "RunInvite|DecideInviteOp|inviter->GetSession()->HandleGroupInviteOpcode(p)"
      "RunInvite|DecideInviteOp|inviter->GetGroup()->ConvertToRaid()"
      "RunLeader|DecideLeaderOp|bot->GetSession()->HandleGroupSetLeaderOpcode(p)")
    # The specs hold no ';', so '|' -> ';' makes a three-element list.
    string(REPLACE "|" ";" parts "${spec}")
    list(GET parts 0 fn)
    list(GET parts 1 decide)
    list(GET parts 2 core)
    region("${ops}" "Verdict ${fn}(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" body)
    if(body STREQUAL "")
      set(${out} "GroupOps.cpp: ${fn} not found" PARENT_SCOPE)
      return()
    endif()
    check_before("${body}" "Verdict const v = ${decide}(f);\n    if (v != Verdict::Execute)\n        return v;" "${core}"
      "${fn}: the world-thread re-check before the core call" r)
    if(NOT r STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${ops}" "Verdict RunLeader(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" run_leader)
  check_before("${run_leader}" "bot->GetSession()->HandleGroupSetLeaderOpcode(p);" "ai->RequestGroupAi(group_ai_refresh::LeaderReset);"
    "RunLeader: the reset posted to the bot after the core call" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  region("${ops}" "Verdict Run(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" run)
  foreach(needle "case OpKind::Leave:  return RunLeave(op, transitMs, m);" "case OpKind::Join:   return RunJoin(op, transitMs, m);"
      "case OpKind::Accept: return RunAccept(op, transitMs, m);" "case OpKind::Invite: return RunInvite(op, transitMs, m);"
      "case OpKind::Leader: return RunLeader(op, transitMs, m);")
    string(FIND "${run}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "Run: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${ops}" "                Verdict const v = Run(op, transitMs, m);" at)
  if(at EQUAL -1)
    set(${out} "Drain: not dispatched through Run (every kind)" PARENT_SCOPE)
    return()
  endif()
  # ClearPending clears both marks of a two-bot op.
