function(check_line ops policy out)
  # After the [GroupOps] line (whose fields stay), behind the key.
  check_before("${ops}" "    AddField(line, \"wt_disband\", wtDisband);\n    sLog.outBasic(\"%s\", line.c_str());\n" "${GW_LINE}"
    "[GroupWrite]: after the unchanged [GroupOps] line, only with WritePath on, fields in this order" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  count_text("${ops}" "[GroupWrite] minute" n)
  if(NOT n EQUAL 1)
    set(${out} "GroupOps.cpp: [GroupWrite] minute ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  # QueueAccept counts accept_player only after a queued push and never for a decline.
  string(FIND "${ops}" "bool QueueAccept(PlayerbotAI* ai, std::uint32_t inviterGuidLow, bool decline)\n{" qa)
  string(FIND "${ops}" "${ACCEPT_PLAYER_COUNT}" at)
  count_text("${ops}" "writeCounts.acceptPlayer.fetch_add" nap)
  if(qa EQUAL -1 OR at EQUAL -1 OR at LESS qa OR NOT nap EQUAL 1)
    set(${out} "QueueAccept: accept_player not counted once, after a queued push, without declines" PARENT_SCOPE)
    return()
  endif()
  # Per kind in OpKind order: leave, join, accept, invite, leader.
  string(FIND "${ops}" "    for (std::size_t i = 0; i < kKinds; ++i)\n        AddField(out, (std::string(prefix) + KindName(OpKind(i))).c_str(), values[i]);" at)
  if(at EQUAL -1)
    set(${out} "AddKindFields: not every kind in OpKind order" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${policy}" "        case OpKind::Leave:  return \"leave\";\n        case OpKind::Join:   return \"join\";\n        case OpKind::Accept: return \"accept\";\n        case OpKind::Invite: return \"invite\";\n        case OpKind::Leader: return \"leader\";" at)
  if(at EQUAL -1)
    set(${out} "KindName: the kind names of the [GroupWrite] fields changed" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

function(check_tail refresh out)
  foreach(needle "    LeaderReset = 1u << 6," "    p.reset = p.joinStrategies || (requests & (LeaveReset | LeaderReset)) != 0;")
    string(FIND "${refresh}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupAiRefresh.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The leader reset drops nothing pending (no Merge rule names it).
  region("${refresh}" "inline std::uint32_t Merge(std::uint32_t pending, std::uint32_t add)\n{" "\n}\n" merge)
  if(merge STREQUAL "")
    set(${out} "GroupAiRefresh.h: Merge not found" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${merge}" "LeaderReset" at)
  if(NOT at EQUAL -1)
    set(${out} "Merge: LeaderReset drops or is dropped" PARENT_SCOPE)
    return()
  endif()
  # Review fix: LeaveGroupAction's queued leave with a bot master - Reset only (a leave in Merge), never with a full reset.
  foreach(needle "    LeaveResetOnly = 1u << 7,"
      "    if (add & JoinReset)\n        pending &= ~std::uint32_t(LeaveResetOnly);\n    if (add & LeaveResetOnly)\n        pending &= ~std::uint32_t(JoinReset | JoinTail | Follower | TurnIn | ForceTravel);")
    string(FIND "${refresh}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupAiRefresh.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${refresh}" "    p.resetOnly = !p.reset && (requests & LeaveResetOnly) != 0;" at)
  if(at EQUAL -1)
    set(${out} "PlanFor: the reset-only leave not without a full reset" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- review fixes (review-A/B 07.11.): the legacy tail per source, the accept's invite, the leader reset, the invitee mark ----
set(TAIL_HEAD "    LeaveTail const tail = LeaveTailOf(op.reason);\n    if (tail != LeaveTail::None)\n    {\n        deferred_log::Scope const deferLogs(ai, true);")
set(TAIL_AFTER "    if (tail != LeaveTail::None)\n    {\n        if (sRandomPlayerbotMgr.IsFreeBot(bot))\n            ai->SetMaster(nullptr);\n        if (tail == LeaveTail::CommandBotMaster)\n            ai->RequestGroupAi(group_ai_refresh::LeaveResetOnly);\n        else\n            ai->RequestGroupAi(group_ai_refresh::LeaveReset);\n    }")
set(DROP_STALE "                    ++m.stale[std::size_t(op.kind)];\n                    DropAcceptInvite(op);")
set(DROP_SUPERSEDED "                    ++m.superseded;\n                    DropAcceptInvite(op);")

function(check_fixes ops policy ai_cpp out)
  region("${ops}" "Verdict RunLeave(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" run_leave)
  check_before("${run_leave}" "${TAIL_HEAD}" "bot->GetSession()->HandleGroupDisbandOpcode(p);" "RunLeave: the lines only with a tail, before the core leave" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  check_before("${run_leave}" "bot->GetSession()->HandleGroupDisbandOpcode(p);" "${TAIL_AFTER}" "RunLeave: master clear and reset only with a tail, after the core leave" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "constexpr std::uint8_t kLeaveQueued = 0x80;" "constexpr std::uint8_t kLeaveNoTail = 0x01;" "constexpr std::uint8_t kLeaveBotMaster = 0x02;"
      "    if (!(reason & kLeaveQueued))\n        return LeaveTail::Adhoc;\n    if (reason & kLeaveNoTail)\n        return LeaveTail::None;\n    return (reason & kLeaveBotMaster) ? LeaveTail::CommandBotMaster : LeaveTail::Command;")
    string(FIND "${policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupOpPolicy.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${ops}" "bool QueueLeave(PlayerbotAI* ai, OpSource source, std::uint8_t tail)\n{" "\n}\n" queue_leave)
  string(FIND "${queue_leave}" "    op.reason = std::uint8_t(kLeaveQueued | tail);" at)
  if(at EQUAL -1)
    set(${out} "QueueLeave: the op does not carry its producer's tail (it would get the ad-hoc one)" PARENT_SCOPE)
    return()
  endif()
  # The reset-only request runs on the bot's thread, next to (never with) the full reset.
  check_before("${ai_cpp}" "PlanFor(requests);\n    // A3 lever 2 (BotGroups.WritePath): LeaveGroupAction's queued leave with a bot master"
    "    if (plan.resetOnly)\n        Reset();\n    if (plan.reset)\n" "ApplyGroupAiRequests: the reset-only leave, before the full reset" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # The decline is the op's own branch.
  region("${ops}" "Verdict RunAccept(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" run_accept)
  check_before("${run_accept}" "    if (op.reason == kAcceptDecline)\n    {" "bot->UninviteFromGroup();" "RunAccept: the decline branch" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  check_before("${run_accept}" "    if (op.reason == kAcceptDecline)\n    {" "ai->DoSpecificAction(\"accept invitation\"" "RunAccept: the decline before the accept" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # A dropped or superseded accept clears its invite (only that invite).
  foreach(needle "${DROP_STALE}" "${DROP_SUPERSEDED}"
      "    if (op.kind != OpKind::Accept)\n        return;\n    Player* bot = FindPlayer(op.bot);\n    Group* invite = bot ? bot->GetGroupInvite() : nullptr;\n    if (invite && invite->GetLeaderGuid().GetCounter() == op.other)\n        bot->UninviteFromGroup();")
    string(FIND "${ops}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupOps.cpp: a dropped/superseded accept keeps its invite: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The leader reset after the core call, whatever the core did (legacy).
  region("${ops}" "Verdict RunLeader(Op const& op, std::uint32_t transitMs, DrainMinute& m)" "\n}\n" run_leader)
  check_before("${run_leader}" "        ai->RequestGroupAi(group_ai_refresh::LeaderReset);" "++m.failed[std::size_t(OpKind::Leader)];"
    "RunLeader: the reset also when the core refused" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # The invitee's mark only on the inviter's map.
  string(FIND "${ops}" "    PlayerbotAI* inviteeAi = invitee->GetMap() == bot->GetMap() ? GetBotAI(invitee) : nullptr;" at)
  if(at EQUAL -1)
    set(${out} "QueueInvite: the invitee's AI touched across maps" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

