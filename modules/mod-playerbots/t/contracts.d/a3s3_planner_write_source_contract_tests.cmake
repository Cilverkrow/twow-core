    if(NOT n EQUAL 1)
      set(${out} "PlayerbotAIConfig.cpp: '${${v}}' found ${n} times, want 1" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(hd "    uint32 plannerWriteCohort = 0;")
