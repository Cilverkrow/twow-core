  set(k2 "        plannerWriteCohort = ai::planner::WriteCohortOf(plannerWriteCohort);")
  set(k3 "    ai::supervisor::SetArbiterPlanField(planner == 2);")
  set(k4 "            {\"Planner.WriteCohort\", Value(plannerWriteCohort)},")
