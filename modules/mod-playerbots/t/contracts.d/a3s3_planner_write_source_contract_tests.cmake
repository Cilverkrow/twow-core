# ---- (a) one door -----------------------------------------------------------------------------------------------------------
function(check_door text out)
  set(e1 "    gate = ExpireCheck(f.phase, pick.forced);")
  set(e2 "    if (!ai::supervisor::OnOwnThread(ai))\n        return ExpireStep::DeniedThread;")
  set(e3 "ExpireAdmit(ai::supervisor::LaneFree(ai, ai::supervisor::Lane::Questbook, \"planner\"),\n        target->IsGroupCopy());")
  set(e4 "        ai::supervisor::WriterScope const scope(ai::supervisor::WriterId::Planner);")
  set(e5 "        target->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);")
  set(e6 "        ai->GetAiObjectContext()->ClearValues(\"no active travel destinations\");")
  check_once_in_order("${text}" "PlannerWrite.cpp" r e1 e2 e3 e4 e5 e6)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(status "SetStatus(")
  count_text("${text}" status n)
  if(NOT n EQUAL 1)
    set(${out} "PlannerWrite.cpp: SetStatus( found ${n} times, want 1 (the one status write)" PARENT_SCOPE)
    return()
  endif()
  foreach(word "WorldPacket" "Send" "TeleportTo(" "MoveTo(" "MotionMaster" "CanRewardQuest(" "SetTarget(" "SET_AI_VALUE" "->Set("
      "SetBestTarget(" "SetForced(" "SetExpireIn(" "SetNullTravelTarget(" "ChangeStrategy(" "AddQuest(" "RewardQuest(" "fetch_sub(")
    string(FIND "${text}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlannerWrite.cpp: names '${word}' (one status write, no target, no packet, no movement)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(m1 "    TransitionResult const result = Decide(from, to, Requester::Planner, phase_, dwellMs, cadence);")
  set(m2 "    if (result.allowed)\n        mode_ = result.to;")
  set(m3 "    WriteModeLine(from, to, result, \"planner\", arbiter);")
  check_once_in_order("${text}" "PlannerWrite.cpp PlannerMode" r m1 m2 m3)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# No WriterScope of WriterId::Planner outside PlannerWrite.cpp (headers and sources of the module).
function(check_scope_census dir out)
  file(GLOB_RECURSE files "${dir}/*.cpp" "${dir}/*.h")
  set(hits "")
  foreach(f ${files})
    get_filename_component(name "${f}" NAME)
    if(name STREQUAL "PlannerWrite.cpp")
      continue()
    endif()
    file(READ "${f}" t)
    string(REGEX MATCH "WriterScope[^;\n]*WriterId::Planner\\)" hit "${t}")
    if(hit)
      list(APPEND hits "${name}")
    endif()
  endforeach()
  if(hits)
    set(${out} "WriterScope(WriterId::Planner) outside PlannerWrite.cpp: ${hits}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) OB-60 H2 -----------------------------------------------------------------------------------------------------------
function(check_h2 text out)
  set(chain "    if (std::strcmp(where, \"request\") == 0)\n        CountEnforce(guid, EnforceCount::HeldRequest);\n    else if (std::strcmp(where, \"probe\") != 0 && std::strcmp(where, \"planner\") != 0)\n        CountEnforce(guid, EnforceCount::HeldErrand);\n    return false;\n}")
  count_text("${text}" chain n)
  if(NOT n EQUAL 1)
    set(${out} "SupervisorEnforce.cpp: the LaneFree count chain (request / probe / planner) found ${n} times, want 1" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) the feed -----------------------------------------------------------------------------------------------------------
function(check_feed text out)
  set(f1 "    ai::planner_write::Feed planFeed;")
  set(f2 "    if (sPlayerbotAIConfig.planner == 2 && ai::planner_write::FeedBegin(ai, futureTravelPurpose.c_str(), newTarget.IsForced(),\n            chooseResume.SkipFor(futureTravelPurpose) != 0, planFeed))")
  set(f3 "                if (ai::planner_write::FeedTakes(planFeed, std::get<0>(travelPoint), std::get<1>(travelPoint)))\n                    planList[partition].push_back(travelPoint);")
  set(f4 "            bool const planChosen = SetBestTarget(requester, &newTarget, planList, true, travelTarget);")
  set(f5 "                    return false;   // #416: out of time in the plan attempt; no second call in this pass")
  set(f6 "    if (!planFeed.fed && !SetBestTarget(requester, &newTarget, destinationList, true, travelTarget))")
  check_once_in_order("${text}" "ChooseTravelTargetAction.cpp feed" r f1 f2 f3 f4 f5 f6)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(watch "    ai::planner_write::ApplyWatch const planApply(ai, planFeed_, oldTarget, planFeed_ && newTarget == planFedTarget_);")
  count_text("${text}" watch n)
  if(NOT n EQUAL 1)
    set(${out} "ChooseTravelTargetAction.cpp: the ApplyWatch of setNewTarget found ${n} times, want 1" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) Nachtrag 3: class B and class P, two separate lists ----------------------------------------------------------------
set(CLASS_B_LIST "lastRejects, lastSuppressSources, lastSkillLocked, lastStaleObjective,\n                chooseBudgetExceeded, chooseResume")
set(CLASS_P_LIST checked skip skipB zFiltered eventFiltered)

function(check_class_b text out)
  set(decl "            ai::planner_write::AttemptRestore<ai::quest_search::RejectCounts, ai::contested_objective::SourceCounts, uint32, uint32,\n                bool, ai::travel_choose::Resume> classB(${CLASS_B_LIST});")
  set(restore "                classB.Restore();   // planGuard and planFeasibility are dropped (class P)")
  check_once_in_order("${text}" "ChooseTravelTargetAction.cpp class B" r decl restore)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # Shared, not restored (F1-OB60): the log caps.
  foreach(word levelGuardLogged lastChooseBudgetLog)
    string(FIND "${CLASS_B_LIST}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "class B restores the shared cap ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(cap "    uint32& levelGuardLogged = planFeed_ && planFeed_->tried ? planFeed_->guardLogged : ownGuardLogged;")
  set(chk "    if (planFeed_ && planFeed_->attempt)\n        planFeed_->checked += checked;\n    else\n        ai->AddTravelChooseChecked(checked);")
  set(add "                ai->AddTravelChooseChecked(planFeed.checked);")
  foreach(v cap chk add)
    count_text("${text}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "ChooseTravelTargetAction.cpp: '${${v}}' found ${n} times, want 1 (shared cap / buffered checked)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

function(check_class_p text guard out)
  set(sink "thread_local ai::level_guard::Counters* t_planGuardSink = nullptr;")
  set(redirect "        return t_planGuardSink ? *t_planGuardSink : counters;")
  set(on "            t_planGuardSink = &planGuard;")
  set(off "            t_planGuardSink = nullptr;")
  check_once_in_order("${text}" "ChooseTravelTargetAction.cpp class P" r sink redirect on off)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # Every atomic of level_guard::Counters is in the class P list, each added once on success.
  string(FIND "${guard}" "    struct Counters\n    {\n" at)
  if(at EQUAL -1)
    set(${out} "LevelGuardPolicy.h: struct Counters not found" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${guard}" ${at} -1 body)
  string(FIND "${body}" "\n    };" end)
  string(SUBSTRING "${body}" 0 ${end} body)
  string(REGEX MATCHALL "std::atomic<[a-z0-9_]+> [A-Za-z]+" atomics "${body}")
  set(names "")
  foreach(a ${atomics})
    string(REGEX REPLACE "^std::atomic<[a-z0-9_]+> " "" a "${a}")
    list(APPEND names "${a}")
  endforeach()
  if(NOT "${names}" STREQUAL "${CLASS_P_LIST}")
    set(${out} "level_guard::Counters atomics '${names}' differ from the class P list '${CLASS_P_LIST}'" PARENT_SCOPE)
    return()
  endif()
  foreach(c ${CLASS_P_LIST})
    set(commit "                ai::planner_write::CommitBuffered(shared.${c}, planGuard.${c});")
    count_text("${text}" commit n)
    if(NOT n EQUAL 1)
      set(${out} "ChooseTravelTargetAction.cpp: CommitBuffered of class P '${c}' found ${n} times, want 1" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${text}" "fetch_sub(" at)
  if(NOT at EQUAL -1)
    set(${out} "ChooseTravelTargetAction.cpp: a fetch_sub (class P is never taken back)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# Class P outside the action: the quest feasibility atomics of PlayerbotAI.cpp (SkipInfeasibleQuest, reached through IsActive).
# The buffer's members are this list; every count of the two shared atomics goes through the sink; the attempt sets and clears
# the sink around its SetBestTarget and commits once on success. The per-bot skip log ring (questFeasibilityLog) is shared.
set(CLASS_P_FEAS_LIST skips giverInactive)

function(check_class_p_feasibility choose ai write_h out)
  string(FIND "${write_h}" "struct FeasibilityCounts\n{\n" at)
  if(at EQUAL -1)
    set(${out} "PlannerWrite.h: struct FeasibilityCounts not found" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${write_h}" ${at} -1 body)
  string(FIND "${body}" "\n};" end)
  string(SUBSTRING "${body}" 0 ${end} body)
  string(REGEX MATCHALL "std::atomic<[a-z0-9_:]+> [A-Za-z]+" atomics "${body}")
  set(names "")
  foreach(a ${atomics})
    string(REGEX REPLACE "^std::atomic<[a-z0-9_:]+> " "" a "${a}")
    list(APPEND names "${a}")
  endforeach()
  if(NOT "${names}" STREQUAL "${CLASS_P_FEAS_LIST}")
    set(${out} "FeasibilityCounts members '${names}' differ from the class P list '${CLASS_P_FEAS_LIST}'" PARENT_SCOPE)
    return()
  endif()
  set(sink "thread_local ai::planner_write::FeasibilityCounts* t_feasibilitySink = nullptr;")
  set(giver "        (t_feasibilitySink ? t_feasibilitySink->giverInactive : questFeasibilityGiverInactive).fetch_add(1, std::memory_order_relaxed);")
  set(skip "        (t_feasibilitySink ? t_feasibilitySink->skips : questFeasibilitySkips).fetch_add(1, std::memory_order_relaxed);")
  set(c1 "    CommitBuffered(questFeasibilitySkips, buffer.skips);")
  set(c2 "    CommitBuffered(questFeasibilityGiverInactive, buffer.giverInactive);")
  check_once_in_order("${ai}" "PlayerbotAI.cpp class P" r sink c1 c2 giver skip)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(direct "questFeasibilitySkips.fetch_add(" "questFeasibilityGiverInactive.fetch_add(")
    string(FIND "${ai}" "${direct}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlayerbotAI.cpp: '${direct}' bypasses the plan attempt's buffer" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(on "            ai::planner_write::SetFeasibilitySink(&planFeasibility);")
  set(call "            bool const planChosen = SetBestTarget(requester, &newTarget, planList, true, travelTarget);")
  set(off "            ai::planner_write::SetFeasibilitySink(nullptr);")
  set(commit "                ai::planner_write::CommitFeasibility(planFeasibility);")
  check_once_in_order("${choose}" "ChooseTravelTargetAction.cpp class P (feasibility)" r on call off commit)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${CLASS_B_LIST}" "questFeasibilityLog" at)
  if(NOT at EQUAL -1)
    set(${out} "class B restores the shared feasibility log ring" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

