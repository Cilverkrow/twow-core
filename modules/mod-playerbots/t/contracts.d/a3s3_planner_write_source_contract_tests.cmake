    set(${out} "aiplayerbot.conf.dist.in: AiPlayerbot.Planner.WriteCohort = 0 found ${n} times, want 1" PARENT_SCOPE)
    return()
  endif()
  set(roll "        out.sums[i].planField = planField;")
  set(init "std::atomic<bool> g_planField{false};")
  foreach(v roll init)
