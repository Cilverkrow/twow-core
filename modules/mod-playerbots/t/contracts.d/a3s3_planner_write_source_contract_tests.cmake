endif()

set(TAG "a3s3 planner write")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# needle_var is the NAME of a variable holding the needle (a ";" in a needle would split a list argument).
function(count_text text needle_var out)
  set(needle "${${needle_var}}")
  string(LENGTH "${needle}" nl)
  set(n 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# Each named needle once, in the given order. names: the NAMES of variables holding the needles.
function(check_once_in_order text where out)
  set(last -1)
  foreach(v ${ARGN})
    count_text("${text}" ${v} n)
    if(NOT n EQUAL 1)
      set(${out} "${where}: '${${v}}' found ${n} times, want 1" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${text}" "${${v}}" at)
    if(NOT at GREATER last)
      set(${out} "${where}: '${${v}}' out of order" PARENT_SCOPE)
      return()
    endif()
    set(last ${at})
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

