# ---- (g) the write condition reads the live arbiter value (the console override), never the raw key --------------------------
# The two reads a3s3_arbiter_console counts (ArbiterValue( = 8): the feed (FeedBegin) and the back_to_band effect (NoteChoiceImpl).
function(check_arbiter_reads write shadow out)
  set(feed "    if (!sup || !Writes(ai, *sup, ai::supervisor::ArbiterValue(sPlayerbotAIConfig.supervisorArbiter)))")
  set(note "        if ((quest || grind) && WritingBot(ai, *supervisor, ai::supervisor::ArbiterValue(sPlayerbotAIConfig.supervisorArbiter)))")
  count_text("${write}" feed n)
  count_text("${shadow}" note m)
  if(NOT n EQUAL 1 OR NOT m EQUAL 1)
    set(${out} "the write condition's arbiter reads: FeedBegin ${n}, NoteChoiceImpl ${m}, want 1 each" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

