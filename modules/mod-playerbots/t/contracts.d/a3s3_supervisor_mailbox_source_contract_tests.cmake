set(DEF_POST "bool Post(std::uint32_t guidLow, Event const& event)\n{")
set(DEF_DRAIN "std::size_t Drain(std::uint32_t guidLow, Event* out, std::size_t max)\n{")
set(DEF_FORGET "void Forget(std::uint32_t guidLow)\n{")
set(DEF_WAITING "bool MailWaiting()\n{")
set(TAKE_DEF "void Supervisor::TakeMail()\n{")
set(TAKE_DRAIN "    std::size_t const n = Drain(bot->GetGUIDLow(), mail, kMailSlots);\n    HandleMail(mail, n);\n}")
set(DEF_REGISTER "std::uint32_t RegisterMail(std::uint32_t guidLow)\n{")
set(DEF_UNREGISTER "void UnregisterMail(std::uint32_t guidLow, std::uint32_t token)\n{")
set(OPEN_ALLOWED "MailOpenAllowed(g_registered.count(guidLow) != 0, guidLow, g_mail.size())")
set(FORGET_CALL "    if (bot)\n        ai::supervisor::Forget(bot->GetGUIDLow());\n")

# ---- (a) + (b) the definitions and their fast paths --------------------------------------------------------------------------
function(check_defs mail_cpp all_sources out)
  foreach(def "${DEF_POST}" "${DEF_DRAIN}" "${DEF_FORGET}" "${DEF_WAITING}" "${DEF_REGISTER}" "${DEF_UNREGISTER}")
    count_text("${mail_cpp}" "${def}" n)
    count_text("${all_sources}" "${def}" m)
    if(NOT n EQUAL 1 OR NOT m EQUAL 1)
      set(${out} "the mailbox definition ${def} found ${n} times in SupervisorMail.cpp and ${m} times in the module (1 and 1 expected)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_regex("${mail_cpp}" "std::mutex g_" n)
  if(NOT n EQUAL 1)
    set(${out} "SupervisorMail.cpp: ${n} mutexes (1 expected: g_mailMutex)" PARENT_SCOPE)
    return()
  endif()
  count_text("${mail_cpp}" "std::lock_guard<std::mutex> lock(g_mailMutex);" n)
  if(NOT n EQUAL 5)
    set(${out} "SupervisorMail.cpp: g_mailMutex taken ${n} times (5 expected: Post, Drain, Forget, RegisterMail, UnregisterMail)" PARENT_SCOPE)
    return()
  endif()
  # T02-GROUP: the registration pair writes no line and rolls no minute; Unregister compares the token (a late old instance
  # must not drop the new one's registration).
  region("${mail_cpp}" "${DEF_REGISTER}" "\n}\n" reg_body)
  region("${mail_cpp}" "${DEF_UNREGISTER}" "\n}\n" unreg_body)
  foreach(body "${reg_body}" "${unreg_body}")
    foreach(word "RollLocked(" "EmitMailMinute(" "sLog")
      string(FIND "${body}" "${word}" at)
      if(NOT at EQUAL -1)
        set(${out} "SupervisorMail.cpp: RegisterMail/UnregisterMail must not use ${word}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  count_text("${unreg_body}" "token" ntok)   # the parameter in the signature, then the comparison
  string(FIND "${unreg_body}" "g_registered" gr)
  if(ntok LESS 2 OR gr EQUAL -1)
    set(${out} "SupervisorMail.cpp: UnregisterMail does not compare the stored token" PARENT_SCOPE)
    return()
  endif()
  region("${mail_cpp}" "${DEF_DRAIN}" "\n}\n" drain)
  string(FIND "${drain}" "${DEF_DRAIN}\n    if (!out || max == 0 || !MailWaiting())\n        return 0;\n" at)
  if(NOT at EQUAL 0)
    set(${out} "SupervisorMail.cpp: Drain does not start with the lock-free fast path (no mail waiting)" PARENT_SCOPE)
    return()
  endif()
  region("${mail_cpp}" "${DEF_FORGET}" "\n}\n" forget)
  string(FIND "${forget}" "${DEF_FORGET}\n    if (g_ringsOpen.load(std::memory_order_relaxed) == 0)\n        return;\n" at)
  if(NOT at EQUAL 0)
    set(${out} "SupervisorMail.cpp: Forget does not start with the lock-free fast path (no ring open)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${mail_cpp}" "${DEF_WAITING}\n    return g_pending.load(std::memory_order_relaxed) != 0;\n}" at)
  if(at EQUAL -1)
    set(${out} "SupervisorMail.cpp: MailWaiting is not the one atomic load" PARENT_SCOPE)
    return()
  endif()
  # A full ring refuses the new event (counted); no overwrite of old mail, no wait.
  region("${mail_cpp}" "${DEF_POST}" "\n}\n" post)
  foreach(needle "        if (it != g_mail.end() && MailPush(it->second, event))" "        else\n            ++g_total.dropped;"
      "${OPEN_ALLOWED}" "++g_total.unreg")
    string(FIND "${post}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "SupervisorMail.cpp: Post lacks ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) the call sites ------------------------------------------------------------------------------------------------------
function(check_calls sup_cpp shadow_cpp ai_cpp all_sources out)
  # T30-1 (A3-S3-T30-SCHNITTSTELLE R7 (a)): exactly one supervisor::Post( outside the namespace, the group manager's directive
  # post in GroupManager.cpp; no Drain( outside.
  count_regex("${all_sources}" "supervisor::Drain\\(" n)
  count_regex("${all_sources}" "supervisor::Post\\(" np)
  count_regex("${mgr_cpp}" "supervisor::Post\\(" nm)
  if(NOT n EQUAL 0 OR NOT np EQUAL 1 OR NOT nm EQUAL 1)
    set(${out} "the mailbox is posted to or drained from outside the namespace: Drain ${n}, Post ${np} (${nm} in GroupManager.cpp; 0, 1 and 1 expected)" PARENT_SCOPE)
    return()
  endif()
  count_regex("${all_sources}" "supervisor::Forget\\(" n)
  if(NOT n EQUAL 1)
    set(${out} "supervisor::Forget( called ${n} times (1 expected: ~PlayerbotAI)" PARENT_SCOPE)
    return()
  endif()
  region("${ai_cpp}" "PlayerbotAI::~PlayerbotAI()\n{" "\n}\n" dtor)
  string(FIND "${dtor}" "${FORGET_CALL}" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAI.cpp: ~PlayerbotAI does not forget the bot's mail" PARENT_SCOPE)
    return()
  endif()
  # Inside the namespace: Supervisor.cpp drains once (TakeMail) and posts or forgets nothing; the shadow touches no mail.
  count_regex("${sup_cpp}" "[^A-Za-z_:]Drain\\(" n)
  if(NOT n EQUAL 1)
    set(${out} "Supervisor.cpp: Drain( called ${n} times (1 expected: TakeMail)" PARENT_SCOPE)
    return()
  endif()
  region("${sup_cpp}" "${TAKE_DEF}" "\n}\n" take)
  foreach(needle "${TAKE_DEF}\n    if (!MailWaiting())\n        return;\n" "${TAKE_DRAIN}")
    string(FIND "${take}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "Supervisor.cpp: TakeMail is not the fast path plus the one drain of its own bot" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${sup_cpp}" "TakeMail();" n)   # count_text: a ";" inside a MATCHALL hit splits the list (double count)
  if(NOT n EQUAL 1)
    set(${out} "Supervisor.cpp: TakeMail() called ${n} times (1 expected: the tick)" PARENT_SCOPE)
    return()
  endif()
  region("${sup_cpp}" "void Supervisor::Tick(" "\n}\n" tick)
  string(FIND "${tick}" "    TakeMail();\n" at)
  if(at EQUAL -1)
    set(${out} "Supervisor.cpp: the tick does not take the mail" PARENT_SCOPE)
    return()
  endif()
  count_regex("${shadow_cpp}" "[^A-Za-z_:](Post|Drain|Forget|MailWaiting)\\(" n)
  if(NOT n EQUAL 0)
    set(${out} "SupervisorShadow.cpp: touches the mailbox" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) nothing acts on mail ------------------------------------------------------------------------------------------------
function(check_no_behaviour mail_cpp sup_cpp out)
  region("${sup_cpp}" "${TAKE_DEF}" "\n}\n" take)
  set(code "${mail_cpp}\n${take}")
  foreach(word
      "SetTarget" "SetStatus" "SetForced" "SetExpireIn" "SetNullTravelTarget" "SetAIInternalUpdateDelay" "aiInternalUpdateDelay"
      "ChangeStrategy" "ResetStrategies" "TeleportTo" "DoSpecificAction" "GetAiObjectContext" "sPlayerbotAIConfig" "Group*"
      "GetGroup" "\"travel target\"")
    string(FIND "${code}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "the mailbox or TakeMail must not use ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) the pure header -----------------------------------------------------------------------------------------------------
function(check_pure mail_policy out)
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" includes "${mail_policy}")
  foreach(inc IN LISTS includes)
    if(NOT inc MATCHES "^#include (<(cstddef|cstdint|cstdio)>|\"SupervisorPolicy\\.h\")$")
      set(${out} "SupervisorMailPolicy.h: not a pure include: ${inc}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Code only: the comments cite the key names (AiPlayerbot.* contains "Player").
  string(REGEX REPLACE "//[^\n]*" "" mail_code "${mail_policy}")
  foreach(word "sPlayerbotAIConfig" "sLog" "mutex" "atomic" "Player" "WorldTimer")
    string(FIND "${mail_code}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "SupervisorMailPolicy.h: not pure: ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "constexpr std::size_t kMailSlots = 16;" "    if (ring.count >= kMailSlots)\n        return false;")
    string(FIND "${mail_policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "SupervisorMailPolicy.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (f) the event's target id -----------------------------------------------------------------------------------------------
function(check_event policy out)
  region("${policy}" "struct Event\n{" "\n};\n" event)
  string(FIND "${event}" "    std::uint32_t b = 0;\n    std::uint32_t c = 0;" at)
  if(at EQUAL -1)
    set(${out} "SupervisorPolicy.h: Event has no target id c = 0 right after b" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${event}" "*" at)
  if(NOT at EQUAL -1)
    set(${out} "SupervisorPolicy.h: Event holds a pointer" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (g) the line ------------------------------------------------------------------------------------------------------------
function(check_line mail_policy mail_cpp all_sources out)
  count_text("${all_sources}" "[SupervisorMail]" n)
  if(NOT n EQUAL 1)
    set(${out} "[SupervisorMail] appears ${n} times in the module (1 expected: the format in SupervisorMailPolicy.h)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${mail_policy}" "\"[SupervisorMail] posted=%llu dropped=%llu drained=%llu directive=%llu lost=%llu rings=%u\"" at)
  if(at EQUAL -1)
    set(${out} "SupervisorMailPolicy.h: the [SupervisorMail] line format changed" PARENT_SCOPE)
    return()
  endif()
  # T02-GROUP: the appended fields are their own literal (the tag literal above keeps its closing quote); the tag itself stays
  # once in the module, so this contract and the unit tests (outside PB) do not repeat it.
  string(FIND "${mail_policy}" "\" unreg=%llu regs=%u oldest_s=%u\"" at)
  if(at EQUAL -1)
    set(${out} "SupervisorMailPolicy.h: the appended mailbox fields unreg/regs/oldest_s are missing" PARENT_SCOPE)
    return()
  endif()
  region("${mail_cpp}" "MailMinuteOut RollLocked()\n{" "\n}\n" roll)
  string(FIND "${roll}" "MailGaugeDue(" at)
  if(at EQUAL -1)
    set(${out} "SupervisorMail.cpp: RollLocked lacks the gauge rule MailGaugeDue(" PARENT_SCOPE)
    return()
  endif()
  count_regex("${mail_cpp}" "sLog\\.out[A-Za-z]+\\(" n)
  if(NOT n EQUAL 1)
    set(${out} "SupervisorMail.cpp: ${n} log calls (1 expected: EmitMailMinute)" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "void EmitMailMinute(MailMinuteOut const& minute)\n{\n    if (!minute.due)\n        return;"
      "    out.due = MailGaugeDue(out.delta, "
      "    out.delta = MailDelta(g_total, g_logged);\n    g_logged = g_total;")
    string(FIND "${mail_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "SupervisorMail.cpp: the minute line lacks ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Written outside the lock: every EmitMailMinute( call comes after the closing brace of the lock scope.
  count_text("${mail_cpp}" "    }\n    EmitMailMinute(minute);\n" n)
  count_text("${mail_cpp}" "EmitMailMinute(minute);" m)
  if(NOT n EQUAL 3 OR NOT m EQUAL 3)
    set(${out} "SupervisorMail.cpp: the minute line is not written after the lock scope of Post, Drain and Forget" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (h) the unit test -------------------------------------------------------------------------------------------------------
function(check_unit tests_cmake unit_test out)
  foreach(needle "add_executable(supervisor_mail_policy_tests\n  \"\${PB_MODULE_DIR}/t/supervisor_mail_policy_tests.cpp\")"
      "add_test(NAME supervisor_mail_policy\n  COMMAND supervisor_mail_policy_tests")
    string(FIND "${tests_cmake}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "tests.cmake: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${unit_test}" "#include \"SupervisorMailPolicy.h\"" at)
  if(at EQUAL -1)
    set(${out} "t/supervisor_mail_policy_tests.cpp does not test SupervisorMailPolicy.h" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (i) no answer to the manager in this pair -------------------------------------------------------------------------------
function(check_ack sup_cpp mail_cpp out)
  string(FIND "${sup_cpp}\n${mail_cpp}" "PostDirectiveAck(" at)
  if(NOT at EQUAL -1)
    set(${out} "the mailbox files call PostDirectiveAck (T02-GROUP posts it from SupervisorGroup.cpp only)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

