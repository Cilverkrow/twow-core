expect_reason("Forget defined twice" "${r}" "the mailbox definition")
string(REPLACE "std::mutex g_mailMutex;" "std::mutex g_mailMutex;\nstd::mutex g_other;" m "${mail_cpp}")
check_defs("${m}" "${all_sources}" r)
expect_reason("a second mutex" "${r}" "mutexes")
string(REPLACE "    if (!out || max == 0 || !MailWaiting())\n        return 0;\n" "    if (!out || max == 0)\n        return 0;\n" m "${mail_cpp}")
check_defs("${m}" "${all_sources}" r)
expect_reason("Drain locks without mail" "${r}" "Drain does not start")
string(REPLACE "    if (g_ringsOpen.load(std::memory_order_relaxed) == 0)\n        return;\n" "" m "${mail_cpp}")
check_defs("${m}" "${all_sources}" r)
