string(REPLACE "    TakeMail();\n" "" m "${sup_cpp}")
check_calls("${m}" "${shadow_cpp}" "${ai_cpp}" "${all_sources}" r)
expect_reason("the tick without the mail take" "${r}" "TakeMail\\(\\) called")
check_calls("${sup_cpp}" "${shadow_cpp}\n    Forget(guid);" "${ai_cpp}" "${all_sources}" r)
expect_reason("the shadow forgets mail" "${r}" "SupervisorShadow")

# (d) a write or a config read in the mailbox.
check_no_behaviour("${mail_cpp}\n    target->SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);" "${sup_cpp}" r)
expect_reason("a travel-target write in the mailbox" "${r}" "must not use SetStatus")
string(REPLACE "${TAKE_DRAIN}" "    Drain(bot->GetGUIDLow(), mail, kMailSlots);\n    if (sPlayerbotAIConfig.supervisor) {}\n}" m "${sup_cpp}")
check_no_behaviour("${mail_cpp}" "${m}" r)
expect_reason("a config read in TakeMail" "${r}" "must not use sPlayerbotAIConfig")

# (e) an impure header, an overwrite of a full ring.
check_pure("#include <mutex>\n${mail_policy}" r)
expect_reason("a mutex include" "${r}" "not a pure include")
string(REPLACE "    if (ring.count >= kMailSlots)\n        return false;" "    if (ring.count >= kMailSlots)\n        ring.head = std::uint8_t((ring.head + 1) % kMailSlots);" m "${mail_policy}")
check_pure("${m}" r)
expect_reason("a full ring overwrites" "${r}" "missing")

# (f) the target id gone.
string(REPLACE "    std::uint32_t c = 0;" "" m "${policy}")
check_event("${m}" r)
expect_reason("no target id" "${r}" "no target id")

# (g) a second log call, a line for a silent stretch, the line under the lock, a foreign use of the tag.
check_line("${mail_policy}" "${mail_cpp}\n    sLog.outString(\"x\");" "${all_sources}" r)
expect_reason("a second log call" "${r}" "log calls")
string(REPLACE "    if (!minute.due)\n        return;" "" m "${mail_cpp}")
check_line("${mail_policy}" "${m}" "${all_sources}" r)
expect_reason("a line for a silent stretch" "${r}" "the minute line lacks")
string(REPLACE "    }\n    EmitMailMinute(minute);\n    return posted;" "        EmitMailMinute(minute);\n    }\n    return posted;" m "${mail_cpp}")
check_line("${mail_policy}" "${m}" "${all_sources}" r)
expect_reason("the line under the lock" "${r}" "after the lock scope")
check_line("${mail_policy}" "${mail_cpp}" "${all_sources}\n// [SupervisorMail]" r)
expect_reason("the tag used elsewhere" "${r}" "appears")
# T02-GROUP: the appended fields, the gauge rule in the roll.
string(REPLACE "\" unreg=%llu regs=%u oldest_s=%u\"" "\" unreg=%llu\"" m "${mail_policy}")
check_line("${m}" "${mail_cpp}" "${all_sources}" r)
expect_reason("the appended mailbox fields gone" "${r}" "unreg/regs/oldest_s")
string(REPLACE "MailGaugeDue(" "MailSilentNot(" m "${mail_cpp}")
check_line("${mail_policy}" "${m}" "${all_sources}" r)
expect_reason("the gauge rule removed" "${r}" "MailGaugeDue")

# (h) the unit test not registered.
string(REPLACE "add_test(NAME supervisor_mail_policy\n" "add_test(NAME other\n" m "${tests_cmake}")
check_unit("${m}" "${unit_test}" r)
expect_reason("the unit test not registered" "${r}" "tests.cmake: missing")

