cmake_policy(VERSION 3.16)
# A3 step 3, mailbox pair (design A3-S3-ENTWURF section 1.10; agreed with CLI-GRP 09.11.2026 for the group manager's directives,
# T30; owner standing approval 09.11.2026, plan A3-PLAN-ZIEL). The supervisor's mailbox, declared in the scaffold, is defined in
# SupervisorMail.cpp. No new switch: only a supervisor drains (AiPlayerbot.Supervisor, default 0), and nothing posts yet. This
# contract pins:
#   (a) the definitions: Post, Drain, Forget, MailWaiting, RegisterMail and UnregisterMail (T02-GROUP: the ring opens only for a
#       registered bot, the unregister compares the token) only in SupervisorMail.cpp, one file-local mutex, five lock sites;
#   (b) the fast paths: Drain and TakeMail return on one atomic load while no mail waits, Forget while no ring is open;
#   (c) the call sites: Drain only in Supervisor::TakeMail (called only from the tick), Forget only in ~PlayerbotAI, no Post
#       caller in this pair (T30 posts the first GroupDirective); nobody outside the namespace drains or posts;
#   (d) nothing acts on mail: SupervisorMail.cpp and TakeMail write nothing of the bot and read no config;
#   (e) the pure header SupervisorMailPolicy.h: no game header, no config, no lock; a full ring drops the new event;
#   (f) Event carries the target id c right after b;
#   (g) the line: own tag [SupervisorMail], one format, written outside the lock and never for a silent stretch;
#   (h) the unit test is registered;
#   (i) the answer to the manager (manager_inbox::PostDirectiveAck) is not called in Supervisor.cpp or SupervisorMail.cpp: T02-GROUP
#       calls it once from SupervisorGroup.cpp (a3s3_supervisor_group_source_contract_tests.cmake); TakeMail ends with
#       HandleMail(mail, n), which writes nothing.
# Pure rules: t/supervisor_mail_policy_tests.cpp. Every check_* returns "" when it holds, else the reason; the negative probes at
# the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s3 mailbox: PB_SOURCE_DIR is required")
endif()
if(NOT DEFINED PB_MODULE_DIR)
  message(FATAL_ERROR "a3s3 mailbox: PB_MODULE_DIR is required")
endif()

set(TAG "a3s3 supervisor mailbox")

function(read_source path out_var)
  if(NOT EXISTS "${PB_SOURCE_DIR}/${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# A probe must be caught by the check it aims at, not by a needle it broke on the way.
function(expect_reason what reason pattern)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
  if(NOT "${reason}" MATCHES "${pattern}")
    message(FATAL_ERROR "${TAG}: negative probe ${what} caught by another check: ${reason}")
  endif()
endfunction()

function(count_text text needle out)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nl)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR at "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${at} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

function(count_regex text regex out)
  string(REGEX MATCHALL "${regex}" hits "${text}")
  list(LENGTH hits n)
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# The text from the first `start` up to and including the first `stop` after it ("" when start or stop is missing).
function(region text start stop out)
  set(${out} "" PARENT_SCOPE)
  string(FIND "${text}" "${start}" at)
  if(at EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "${stop}" end)
  if(end EQUAL -1)
    return()
  endif()
  string(LENGTH "${stop}" sl)
  math(EXPR end "${end} + ${sl}")
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

