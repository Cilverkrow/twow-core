# ---- (8) RESCUE ----------------------------------------------------------------------------------------------------------------
function(check_rescue group_cpp out)
  region("${group_cpp}" "${DEF_TICK}" "\n}\n" tick)
  if(tick STREQUAL "")
    set(${out} "SupervisorGroup.cpp: Supervisor::GroupTick not found" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${tick}" "${DEF_TICK}\n${TICK_HEAD}" at)
  if(NOT at EQUAL 0)
    set(${out} "SupervisorGroup.cpp: GroupTick does not start with the rescueByGroup_ reset (first statement)" PARENT_SCOPE)
    return()
  endif()
  # The early return: one `if (mode_ ...` line naming both modes (after the reset statement above, which names Rescue alone).
  string(REPLACE "${TICK_HEAD}" "" tick_rest "${tick}")
  count_regex("${tick_rest}" "if \\(mode_ [^\n]*Mode::Group[^\n]*Mode::Rescue" nga)
  count_regex("${tick_rest}" "if \\(mode_ [^\n]*Mode::Rescue[^\n]*Mode::Group" ngb)
  if(nga EQUAL 0 AND ngb EQUAL 0)
    set(${out} "SupervisorGroup.cpp: the early return of GroupTick does not name Mode::Group and Mode::Rescue" PARENT_SCOPE)
    return()
  endif()
  # Every Decide(Rescue -> Quest) comes behind rescueByGroup_ (a foreign RESCUE is never ended here).
  set(rest "${group_cpp}")
  set(needle "Decide(Mode::Rescue, Mode::Quest, Requester::Self")
  count_text("${group_cpp}" "${needle}" total)
  if(total LESS 1)
    set(${out} "SupervisorGroup.cpp: no ${needle} (RESCUE ends into the quest mode only here)" PARENT_SCOPE)
    return()
  endif()
  set(seen 0)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR seen "${seen} + 1")
    if(at GREATER 600)
      math(EXPR from "${at} - 600")
      set(from_len 600)
    else()
      set(from 0)
      set(from_len ${at})
    endif()
    string(SUBSTRING "${rest}" ${from} ${from_len} before)
    string(FIND "${before}" "rescueByGroup_" rg)
    if(rg EQUAL -1)
      set(${out} "SupervisorGroup.cpp: ${needle} is not behind rescueByGroup_" PARENT_SCOPE)
      return()
    endif()
    string(LENGTH "${needle}" nl)
    math(EXPR at "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${at} -1 rest)
  endwhile()
  set(${out} "" PARENT_SCOPE)
endfunction()

