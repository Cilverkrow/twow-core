# ---- (1) the three manager calls ---------------------------------------------------------------------------------------------
function(check_calls group_cpp sup_cpp mail_cpp shadow_cpp enforce_cpp ai_cpp out)
  foreach(call "manager_inbox::PostDirectiveAck(" "manager_inbox::PostDirectiveLeft(" "group_mgr::IsManaged(")
    count_text("${group_cpp}" "${call}" n)
    if(NOT n EQUAL 1)
      set(${out} "SupervisorGroup.cpp: ${call} appears ${n} times (1 expected)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(var sup_cpp mail_cpp shadow_cpp enforce_cpp ai_cpp)
    foreach(word "PostDirectiveAck(" "PostDirectiveLeft(")
      count_text("${${var}}" "${word}" n)
      if(NOT n EQUAL 0)
        set(${out} "${var}: ${word} appears ${n} times (0 expected outside SupervisorGroup.cpp)" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  foreach(var sup_cpp mail_cpp shadow_cpp enforce_cpp)
    count_text("${${var}}" "IsManaged(" n)
    if(NOT n EQUAL 0)
      set(${out} "${var}: IsManaged( appears ${n} times (0 expected outside SupervisorGroup.cpp)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

