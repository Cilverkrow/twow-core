# ---- (18) the formats ----------------------------------------------------------------------------------------------------------------
# sha256 (first 16 hex) of FormatArbiterGrp, from its start up to and including its closing brace line (taken when T02-GROUP was
# built; the evaluator reads [ArbiterGrp] by key, the order of the fields is the GrpField order).
set(ARBITER_GRP_SHA "4fe645db466412d3")
function(check_formats policy mail_policy all_sources out)
  region("${policy}" "inline std::size_t FormatArbiterGrp(" "\n}\n" body)
  string(SHA256 h "${body}")
  string(SUBSTRING "${h}" 0 16 h)
  if(body STREQUAL "" OR NOT h STREQUAL "${ARBITER_GRP_SHA}")
    set(${out} "FormatArbiterGrp changed on purpose only: sha ${h} != ${ARBITER_GRP_SHA}" PARENT_SCOPE)
    return()
  endif()
  count_text("${mail_policy}" "\" unreg=%llu regs=%u oldest_s=%u\"" n)
  count_text("${all_sources}" "[SupervisorMail]" nt)
  if(NOT n EQUAL 1 OR NOT nt EQUAL 1)
    set(${out} "the appended mailbox fields literal appears ${n} times and the mailbox line tag ${nt} times under PB/ (1 and 1 expected)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

