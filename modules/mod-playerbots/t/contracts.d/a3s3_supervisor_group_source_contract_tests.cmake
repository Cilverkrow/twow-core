endfunction()

# ---- (3) HandleMail ------------------------------------------------------------------------------------------------------------
set(TAKE_DEF "void Supervisor::TakeMail()\n{")
set(TAKE_END "    std::size_t const n = Drain(bot->GetGUIDLow(), mail, kMailSlots);\n    HandleMail(mail, n);\n}")
function(check_handle_mail group_cpp sup_cpp out)
  count_text("${sup_cpp}" "HandleMail(" n)
  region("${sup_cpp}" "${TAKE_DEF}" "\n}\n" take)
  string(LENGTH "${TAKE_END}" el)
  string(LENGTH "${take}" tl)
  math(EXPR tail_at "${tl} - ${el} - 1")
  if(tail_at LESS 0)
    set(${out} "Supervisor.cpp: TakeMail not found" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${take}" ${tail_at} -1 tail)
  string(FIND "${tail}" "${TAKE_END}" at)
  if(NOT n EQUAL 1 OR at EQUAL -1)
    set(${out} "Supervisor.cpp: HandleMail( must be called once, as the end of TakeMail (found ${n})" PARENT_SCOPE)
    return()
  endif()
  region("${group_cpp}" "${DEF_HANDLE}" "\n}\n" body)
  if(body STREQUAL "")
    set(${out} "SupervisorGroup.cpp: Supervisor::HandleMail not found" PARENT_SCOPE)
    return()
  endif()
  foreach(word "SetTarget(" "CloseLive(" "SendAck(" "SendLeft(")
    string(FIND "${body}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "SupervisorGroup.cpp: HandleMail must write nothing (it uses ${word})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (4) the mailbox registration ----------------------------------------------------------------------------------------------
function(check_register group_cpp sup_cpp mail_cpp all_sources out)
  count_regex("${group_cpp}" "[^A-Za-z]RegisterMail\\(" n)
  region("${group_cpp}" "${DEF_TICK}" "\n}\n" tick)
  count_regex("${tick}" "[^A-Za-z]RegisterMail\\(" nt)
  count_regex("${all_sources}" "[^A-Za-z]RegisterMail\\(" na)
  if(NOT n EQUAL 1 OR NOT nt EQUAL 1 OR NOT na EQUAL 3)
    set(${out} "RegisterMail( called ${n} times in SupervisorGroup.cpp (${nt} in GroupTick), ${na} mentions in the module (1, 1 and 3 expected: declaration, definition, the call in GroupTick)" PARENT_SCOPE)
    return()
  endif()
  count_regex("${sup_cpp}" "[^A-Za-z]UnregisterMail\\(" n)
  count_regex("${sup_cpp}" "[^A-Za-z]UnregisterMail\\([^,()]+,[^,()]+\\)" n2)
  region("${sup_cpp}" "${DEF_DTOR}" "\n}\n" dtor)
  count_regex("${dtor}" "[^A-Za-z]UnregisterMail\\(" nd)
  count_regex("${all_sources}" "[^A-Za-z]UnregisterMail\\(" na)
  if(NOT n EQUAL 1 OR NOT n2 EQUAL 1 OR NOT nd EQUAL 1 OR NOT na EQUAL 3)
    set(${out} "UnregisterMail( appears ${n} times in Supervisor.cpp (${n2} with two arguments, ${nd} in ~Supervisor), ${na} in the module (1, 1, 1 and 3 expected)" PARENT_SCOPE)
    return()
  endif()
  region("${mail_cpp}" "void UnregisterMail(std::uint32_t guidLow, std::uint32_t token)\n{" "\n}\n" unreg)
  count_text("${unreg}" "token" nt)
  if(unreg STREQUAL "" OR nt LESS 2)
    set(${out} "SupervisorMail.cpp: UnregisterMail does not compare the token (a late old instance would drop the new registration)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

