    endif()
  endforeach()
  count_regex("${all_sources}" "lastWriter_ = [a-z]" n)
  count_regex("${sup_h}" "lastWriter_ = [a-z]" nh)
  count_text("${all_sources}" "NoteWriter(" nn)
  count_text("${group_cpp}" "NoteWriter(" ng)
  if(NOT n EQUAL 1 OR NOT nh EQUAL 1 OR NOT nn EQUAL 2 OR NOT ng EQUAL 0)
    set(${out} "lastWriter_ is assigned ${n} times (${nh} in Supervisor.h) and NoteWriter( appears ${nn} times (${ng} in SupervisorGroup.cpp); 1, 1, 2 and 0 expected: the member NoteWriter and its one call in CommitTargetWrite" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (11) Q4 -------------------------------------------------------------------------------------------------------------------
function(check_handler_on group_cpp out)
  count_text("${group_cpp}" "${DEF_HANDLER_ON}" nd)
  strip_comments("${group_cpp}" code)
  count_regex("${code}" "GroupHandlerOn\\(" nall)
  math(EXPR calls "${nall} - 1")
  if(NOT nd EQUAL 1 OR NOT calls EQUAL 2)
    set(${out} "SupervisorGroup.cpp: GroupHandlerOn defined ${nd} times with ${calls} calls (1 definition and exactly 2 calls expected: the Enter check and GroupTick step 3)" PARENT_SCOPE)
    return()
  endif()
  region("${group_cpp}" "${DEF_HANDLER_ON}" "\n}\n" body)
  string(FIND "${body}" "(void)guidLow;\n    return true;" a)
  string(FIND "${body}" "cohort::Applies(sPlayerbotAIConfig.supervisorGroupHandler, guidLow)" b)
  if(a EQUAL -1 AND b EQUAL -1)
    set(${out} "SupervisorGroup.cpp: GroupHandlerOn is neither 'return true' (Q4 a) nor the cohort rule on supervisorGroupHandler (Q4 b/c)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (12) following --------------------------------------------------------------------------------------------------------------
function(check_following group_cpp out)
  strip_comments("${group_cpp}" code)
  count_text("${code}" "MakeFollower(" n1)
  count_text("${code}" "MakeTurnIn(" n2)
  if(NOT n1 EQUAL 1 OR NOT n2 EQUAL 1)
    set(${out} "SupervisorGroup.cpp: MakeFollower( ${n1} times, MakeTurnIn( ${n2} times (1 and 1 expected)" PARENT_SCOPE)
    return()
  endif()
  # SameMapObject before FollowerIntact before MakeFollower, in the same block (the 600 characters before the call).
  string(FIND "${code}" "MakeFollower(" at)
  if(at GREATER 600)
    math(EXPR from "${at} - 600")
    set(len 600)
  else()
    set(from 0)
    set(len ${at})
  endif()
  string(SUBSTRING "${code}" ${from} ${len} before)
  string(FIND "${before}" "SameMapObject(" s)
  string(FIND "${before}" "FollowerIntact(" f)
  if(s EQUAL -1 OR f EQUAL -1 OR NOT s LESS f)
    set(${out} "SupervisorGroup.cpp: MakeFollower( is not preceded by SameMapObject( and FollowerIntact( in its block (a cross-bot read must be guard-first)" PARENT_SCOPE)
    return()
  endif()
  foreach(word "ChangeStrategy(" "ResetStrategies(" "FollowerSet" "TurnInSet")
    count_text("${group_cpp}" "${word}" n)
    if(NOT n EQUAL 0)
      set(${out} "SupervisorGroup.cpp: ${word} appears ${n} times (0 expected: the sets are posted by MakeFollower / MakeTurnIn)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${group_cpp}" "SetQuestGroupRole(" nr)
  region("${group_cpp}" "${DEF_START_FOLLOW}" "\n}\n" start_body)
  region("${group_cpp}" "${DEF_UNDO_FOLLOW}" "\n}\n" undo_body)
  count_text("${start_body}" "SetQuestGroupRole(" ns)
  count_text("${undo_body}" "SetQuestGroupRole(" nu)
  if(NOT nr EQUAL 2 OR NOT ns EQUAL 1 OR NOT nu EQUAL 1)
    set(${out} "SupervisorGroup.cpp: SetQuestGroupRole( ${nr} times (${ns} in StartFollow, ${nu} in UndoFollow; 2, 1 and 1 expected)" PARENT_SCOPE)
    return()
  endif()
  region("${group_cpp}" "${DEF_LEAVE}" "\n}\n" leave_body)
  count_text("${leave_body}" "UndoFollow()" nl)
  count_regex("${code}" "[^A-Za-z]UndoFollow\\(\\)" nu_all)
  if(leave_body STREQUAL "" OR nl LESS 1 OR nu_all LESS 3)
    set(${out} "SupervisorGroup.cpp: UndoFollow() must be called from LeaveGroupMode (${nl}) and from the done teardown (${nu_all} mentions incl. the definition, 3 or more expected)" PARENT_SCOPE)
    return()
  endif()
  # Recheck 4: StartFollow only from ApplyMove, ApplyMove only from Enter/move, the Update (T33) and RESCUE -> GROUP.
  count_regex("${code}" "[^A-Za-z_:]StartFollow\\(\\)" nsf)
  region("${code}" "bool Supervisor::ApplyMove()\n{" "\n}\n" move_body)
  count_text("${move_body}" "StartFollow()" nsfm)
  count_regex("${code}" "[^A-Za-z_:]ApplyMove\\(\\)" nam)
  if(NOT nsf EQUAL 1 OR NOT nsfm EQUAL 1 OR NOT nam EQUAL 3)
    set(${out} "SupervisorGroup.cpp: StartFollow() called ${nsf} times (${nsfm} in ApplyMove), ApplyMove() called ${nam} times (1, 1 and 3 expected: EnterGroup, ChangeGroup, RESCUE -> GROUP)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (13) the T33 traps (Q8) -----------------------------------------------------------------------------------------------------
function(check_traps ban_sources gpolicy out)
  strip_comments("${ban_sources}" code)
  count_text("${ban_sources}" "Verb::Update" n_raw)
  count_text("${code}" "Verb::Update" n_code)
  count_regex("${ban_sources}" "[A-Za-z0-9_]Verb::Update" n_ident)
  if(NOT n_raw EQUAL 1 OR NOT n_code EQUAL 1 OR NOT n_ident EQUAL 0)
    set(${out} "Verb::Update appears ${n_raw} times with and ${n_code} without comments (${n_ident} as the end of an identifier); 1, 1 and 0 expected (the VerbName case; T33-0 counts it)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${gpolicy}" "enum class VerbClass" at)
  if(at EQUAL -1)
    set(${out} "SupervisorGroupPolicy.h: no enum class VerbClass (the handler classifies by Enter/Change/Exit, never by Verb::Update)" PARENT_SCOPE)
    return()
  endif()
  foreach(name ${RESERVED_T33})
    count_text("${ban_sources}" "${name}" n)
    if(NOT n EQUAL 0)
      set(${out} "${name} appears ${n} times in src/ and t/ (reserved for a later T33 step)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(name ${MANAGER_T33})
    count_text("${gpolicy}" "${name}" n)
    if(NOT n EQUAL 0)
      set(${out} "${name} appears ${n} times in the handler (SupervisorGroupPolicy.h + Supervisor*.cpp; T33-1: the manager side only)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (14) no jumps, no number literals ---------------------------------------------------------------------------------------------
function(check_no_jumps group_cpp out)
  count_text("${group_cpp}" "TeleportTo" n)
  strip_comments("${group_cpp}" code)
  count_regex("${code}" "[A-Za-z_]*[Hh]op[A-Za-z_]*\\(" nh)
  if(NOT n EQUAL 0 OR NOT nh EQUAL 0)
    set(${out} "SupervisorGroup.cpp: TeleportTo ${n} times, hop calls ${nh} (0 and 0 expected: the handler never jumps)" PARENT_SCOPE)
    return()
  endif()
  count_regex("${code}" "(SendAck|SendLeft)\\((([^()]|\\([^()]*\\))*[^A-Za-z0-9_.])?[0-9]+u?[^A-Za-z0-9_.]" nlit)
  if(NOT nlit EQUAL 0)
    set(${out} "SupervisorGroup.cpp: SendAck / SendLeft with a number literal as state or reason (${nlit}): use kAck* / kAckReason*" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

