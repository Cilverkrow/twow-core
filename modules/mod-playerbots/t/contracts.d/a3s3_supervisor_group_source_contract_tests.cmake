    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (10) the close loop ---------------------------------------------------------------------------------------------------------
function(check_close_loop group_cpp all_sources sup_h out)
  foreach(needle "ev=goal_close" "ev=prep_cancel" "writer=")
    string(FIND "${group_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "SupervisorGroup.cpp: the close loop line lacks ${needle}" PARENT_SCOPE)
