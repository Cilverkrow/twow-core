cmake_policy(VERSION 3.16)
# twow-repo#575 F1 (CLI-PATH 27.10.2026, owner option B, Ae17 world-data hotfix with twin PR): the wave-0 travel graph
# (v3.2 + v3.3 minus the 4 Blackvenom links) as a core world migration, plus the same rows in
# the module base dumps (db-init applies the migrations before stage 40 re-creates the module tables from the dumps).
# 1. 20261027010000_world.sql: LF, every ai_playerbot_ table named only inside a quoted string (prepared statement or the
#    table guard; a fresh bootstrap has no module tables), the gate (tables, 32 old nodes once by key, the fixed id range
#    1839-1863 unused by nodes/links/paths), replay state, writes only under @w0m_do, no DELETE/DROP/UPDATE of a module
#    table, end-state CHECK, exact rollback by id range; header counts == integrity CHECK counts == value tuples.
# 2. Rows: new node ids exactly 1839-1863; every link has an end in the range (the rollback by id range is exact);
#    no link or path 1842<->1843 (v3 scorpid link); the 4 dropped v3.3 links 1861<->1840 / 1861<->1841 absent.
# 3. Base dump ai_playerbot_travel_nodes.sql: the appended rows equal the migration rows (old refs mapped to the dump ids
#    by name, map and position), node count 1839 + 25.
# Every check_* function sets "" when it holds, else the reason; the negative probes at the end reuse them.
if(NOT DEFINED PB_MODULE_DIR OR NOT DEFINED CORE_SOURCE_DIR)
  message(FATAL_ERROR "PB_MODULE_DIR and CORE_SOURCE_DIR are required")
endif()

set(TAG "#575 F1 wave0 migration")
set(MIG1 "${CORE_SOURCE_DIR}/sql/database_updates/20261027010000_world.sql")
set(DUMP_TN "${PB_MODULE_DIR}/sql/world/classic/ai_playerbot_travel_nodes.sql")
set(LO 1839)
set(HI 1863)
set(RANGE_RX "18(39|[45][0-9]|6[0-3])")
# A number, without a capture group (the cmake regex engine has 9 groups at most).
set(N "-?[0-9][0-9.]*")
string(REPEAT ",${N}" 6 N6)
string(REPEAT ",${N}" 10 N10)
string(REPEAT ",${N}" 3 N3)
set(LINK_RX "^\\(${N}${N10}\\)$")
set(PATH_RX "^\\(${N}${N6}\\)$")
set(PS1 "PREPARE w0m_stmt FROM @w0m_sql; EXECUTE w0m_stmt; DEALLOCATE PREPARE w0m_stmt;")
set(RANGE_L "`node_id` BETWEEN ${LO} AND ${HI} OR `to_node_id` BETWEEN ${LO} AND ${HI}")

foreach(f MIG1 DUMP_TN)
  if(NOT EXISTS "${${f}}")
    message(FATAL_ERROR "${TAG}: missing ${${f}}")
  endif()
endforeach()

# Comments out (full-line and trailing "--"), then every quoted string collapsed: what is left is plain SQL.
function(strip_comments text out)
  string(REGEX REPLACE "(^|\n|[ \t])--[^\n]*" "\\1" body "${text}")
  set(${out} "${body}" PARENT_SCOPE)
endfunction()
function(unquote text out)
  string(REGEX REPLACE "'([^']|'')*'" "''" u "${text}")
  set(${out} "${u}" PARENT_SCOPE)
endfunction()
# Tuples "(...)" of a text region, spaces and tabs removed, as a list.
function(tuples_of text out)
  string(REPLACE " " "" t "${text}")
  string(REPLACE "\t" "" t "${t}")
  string(REGEX MATCHALL "\\([^()\n]*\\)" l "${t}")
  set(${out} "${l}" PARENT_SCOPE)
endfunction()
function(region text from to out)
  string(FIND "${text}" "${from}" a)
  string(FIND "${text}" "${to}" b)
  if(a LESS 0 OR b LESS a)
    set(${out} "" PARENT_SCOPE)
  else()
    math(EXPR len "${b} - ${a}")
    string(SUBSTRING "${text}" ${a} ${len} r)
    set(${out} "${r}" PARENT_SCOPE)
  endif()
endfunction()

# ------------------------------------------------------------------ 1. migration 1 (text checks)
function(check_mig1 text out)
  set(r "")
  string(FIND "${text}" "\r" cr)
  strip_comments("${text}" body)
  unquote("${body}" plain)
  string(TOUPPER "${body}" upper)
  string(REGEX MATCH "-- Row counts: nodes \\+([0-9]+) \\(ids ([0-9]+)-([0-9]+)\\), links \\+([0-9]+) \\(v3\\.2 ([0-9]+) \\+ v3\\.3 ([0-9]+)\\), path points \\+([0-9]+) \\(v3\\.2 ([0-9]+) \\+ v3\\.3 ([0-9]+)\\)\\." hdr "${text}")
  set(hn "${CMAKE_MATCH_1}")
  set(hlo "${CMAKE_MATCH_2}")
  set(hhi "${CMAKE_MATCH_3}")
  set(hl "${CMAKE_MATCH_4}")
  set(hp "${CMAKE_MATCH_7}")
  if(hdr)
    math(EXPR span "${hhi} - ${hlo} + 1")
    math(EXPR lsum "${CMAKE_MATCH_5} + ${CMAKE_MATCH_6}")
    math(EXPR psum "${CMAKE_MATCH_8} + ${CMAKE_MATCH_9}")
  endif()
  string(REGEX MATCHALL "SET @w0m_sql := IF\\([^;]*" segs "${body}")
  string(REGEX MATCHALL "SET @w0m_sql := " sets "${body}")
  # (no ';' in a match: it would split into several list items)
  string(REPLACE "${PS1}" "@PS1@" ps_marked "${body}")
  string(REGEX MATCHALL "@PS1@" runs "${ps_marked}")
  list(LENGTH sets n_sets)
  list(LENGTH runs n_runs)
  if(NOT cr LESS 0)
    set(r "CR in migration 1")
  elseif(NOT text MATCHES "twow-repo#575")
    set(r "issue reference missing")
  elseif(NOT hdr)
    set(r "header row counts line missing")
  elseif(NOT hlo EQUAL ${LO} OR NOT hhi EQUAL ${HI} OR NOT hn EQUAL span)
    set(r "header id range / node count not ${LO}-${HI}")
  elseif(NOT hl EQUAL lsum OR NOT hp EQUAL psum)
    set(r "header count sums differ")
  elseif(plain MATCHES "ai_playerbot_")
    set(r "playerbot table outside a prepared statement or the table guard")
  endif()
  if(NOT r)
    foreach(need
        "-- Rollback (exact, mangosd stopped):\n--   DELETE FROM `ai_playerbot_travelnode_path` WHERE ${RANGE_L};\n--   DELETE FROM `ai_playerbot_travelnode_link` WHERE ${RANGE_L};\n--   DELETE FROM `ai_playerbot_travelnode` WHERE `id` BETWEEN ${LO} AND ${HI};\n"
        "SET @w0m_tables := (SELECT COUNT(DISTINCT `TABLE_NAME`) FROM `information_schema`.`TABLES` WHERE `TABLE_SCHEMA` = DATABASE()\n  AND `TABLE_NAME` IN ('ai_playerbot_travelnode', 'ai_playerbot_travelnode_link', 'ai_playerbot_travelnode_path'));"
        "'UPDATE `_w0m575_node` w SET w.`hits` = (SELECT COUNT(*) FROM `ai_playerbot_travelnode` n WHERE n.`name` = w.`name` AND n.`map_id` = w.`map_id`\n      AND ROUND(n.`x`, 1) = w.`kx` AND ROUND(n.`y`, 1) = w.`ky` AND ROUND(n.`z`, 1) = w.`kz`)'"
        "SET @w0m_oldok := (SELECT COUNT(*) FROM `_w0m575_node` WHERE `is_new` = 0 AND `hits` = 1 AND `id` IS NOT NULL);"
        "'SELECT COUNT(*) INTO @w0m_idn FROM `ai_playerbot_travelnode` WHERE `id` BETWEEN ${LO} AND ${HI}'"
        "'SELECT COUNT(*) INTO @w0m_idl FROM `ai_playerbot_travelnode_link` WHERE ${RANGE_L}'"
        "'SELECT COUNT(*) INTO @w0m_idp FROM `ai_playerbot_travelnode_path` WHERE ${RANGE_L}'"
        "SET @w0m_do := (@w0m_tables = 3 AND @w0m_oldok = 32 AND @w0m_idn = 0 AND @w0m_idl = 0 AND @w0m_idp = 0);"
        "WHEN @w0m_idn = ${hn} AND @w0m_keyn = ${hn} THEN 'replay'"
        "`name` VARCHAR(1024) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL"
        "CREATE TEMPORARY TABLE `_w0m575_check` (`ok` TINYINT(1) NOT NULL CHECK (`ok` = 1));"
        "`id` BETWEEN ${LO} AND ${HI}) = ${hn}\n"
        "(SELECT COUNT(*) FROM `_w0m575_link`) = ${hl}\n"
        "(SELECT COUNT(*) FROM `_w0m575_path`) = ${hp};"
        "(SELECT COUNT(*) FROM `ai_playerbot_travelnode_link` WHERE ${RANGE_L}) = ${hl}\n"
        "(SELECT COUNT(*) FROM `ai_playerbot_travelnode_path` WHERE ${RANGE_L}) = ${hp}\n")
      string(FIND "${text}" "${need}" at)
      if(at LESS 0 AND NOT r)
        string(SUBSTRING "${need}" 0 60 short)
        if(need MATCHES "^-- Rollback")
          set(r "rollback text missing or changed")
        elseif(need MATCHES "w0m_do :=|w0m_idl|w0m_idp|w0m_idn|w0m_tables :=|w0m_oldok|hits")
          set(r "gate changed: ${short}")
        else()
          set(r "missing or changed: ${short}")
        endif()
      endif()
    endforeach()
  endif()
  if(NOT r)
    foreach(bad "DELETE" "DROP TABLE " "TRUNCATE" "REPLACE INTO" "ALTER TABLE" "UPDATE `AI_PLAYERBOT")
      string(FIND "${upper}" "${bad}" at)
      if(NOT at LESS 0 AND NOT r)
        set(r "forbidden statement ${bad}")
      endif()
    endforeach()
  endif()
  if(NOT r AND NOT n_sets EQUAL n_runs)
    set(r "a prepared statement is set but not run (${n_sets} SET / ${n_runs} PREPARE)")
  endif()
  if(NOT r)
    set(n_writes 0)
    foreach(s IN LISTS segs)
      if(NOT s MATCHES "^SET @w0m_sql := IF\\(@w0m_(tables = 3|do),")
        set(r "a prepared statement is not gated by @w0m_tables = 3 or @w0m_do")
      elseif(s MATCHES "INTO `ai_playerbot_" AND NOT s MATCHES "^SET @w0m_sql := IF\\(@w0m_do,")
        set(r "a module-table write is not gated by @w0m_do")
      elseif(s MATCHES "INSERT IGNORE INTO `ai_playerbot_")
        math(EXPR n_writes "${n_writes} + 1")
      endif()
    endforeach()
    if(NOT r AND NOT n_writes EQUAL 3)
      set(r "expected 3 gated module-table inserts, found ${n_writes}")
    endif()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------ 2. migration 1 rows
# Sets in the parent: m_new (new-node tuples), m_old (old-node tuples), m_links, m_paths (normalized tuple lists).
function(rows_mig1 text)
  strip_comments("${text}" body)
  region("${body}" "CREATE TEMPORARY TABLE `_w0m575_node`" "CREATE TEMPORARY TABLE `_w0m575_check`" data)
  tuples_of("${data}" all)
  set(nodes "${all}")
  list(FILTER nodes INCLUDE REGEX "^\\([0-9]+,(NULL|[0-9]+),[01],'")
  set(new "${nodes}")
  list(FILTER new INCLUDE REGEX "^\\([0-9]+,[0-9]+,1,")
  set(old "${nodes}")
  list(FILTER old INCLUDE REGEX "^\\([0-9]+,NULL,0,")
  set(links "${all}")
  list(FILTER links INCLUDE REGEX "${LINK_RX}")
  set(paths "${all}")
  list(FILTER paths INCLUDE REGEX "${PATH_RX}")
  set(m_new "${new}" PARENT_SCOPE)
  set(m_old "${old}" PARENT_SCOPE)
  set(m_links "${links}" PARENT_SCOPE)
  set(m_paths "${paths}" PARENT_SCOPE)
endfunction()

function(check_rows hn hl hp new old links paths out)
  set(r "")
  list(LENGTH new nn)
  list(LENGTH old no)
  list(LENGTH links nl)
  list(LENGTH paths np)
  set(ids "")
  foreach(t IN LISTS new)
    string(REGEX MATCH "^\\(([0-9]+),([0-9]+)," _ "${t}")
    if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      set(r "new node ref ${CMAKE_MATCH_1} != id ${CMAKE_MATCH_2}")
    endif()
    list(APPEND ids "${CMAKE_MATCH_2}")
  endforeach()
  set(want "")
  foreach(i RANGE ${LO} ${HI})
    list(APPEND want "${i}")
  endforeach()
  set(free_links "${links}")
  list(FILTER free_links EXCLUDE REGEX "^\\(${RANGE_RX},")
  list(FILTER free_links EXCLUDE REGEX "^\\([0-9]+,${RANGE_RX},")
  string(REPLACE ";" "\n" lt "\n${links}")
  string(REPLACE ";" "\n" pt "\n${paths}")
  if(r)
  elseif(NOT nn EQUAL hn OR NOT nl EQUAL hl OR NOT np EQUAL hp)
    set(r "row count differs from the header: nodes ${nn}/${hn} links ${nl}/${hl} paths ${np}/${hp}")
  elseif(NOT no EQUAL 32)
    set(r "expected 32 old-node key rows, found ${no}")
  elseif(NOT "${ids}" STREQUAL "${want}")
    set(r "new node ids are not exactly the id range ${LO}-${HI}")
  elseif(free_links)
    list(GET free_links 0 f)
    set(r "link without an end in the id range (the rollback by id range would miss it): ${f}")
  else()
    foreach(p "1842,1843" "1843,1842")
      string(FIND "${lt}${pt}" "\n(${p}," at)
      if(NOT at LESS 0 AND NOT r)
        set(r "link or path ${p} (1842<->1843) present")
      endif()
    endforeach()
    foreach(p "1861,1840" "1840,1861" "1861,1841" "1841,1861")
      string(FIND "${lt}${pt}" "\n(${p}," at)
      if(NOT at LESS 0 AND NOT r)
        set(r "dropped v3.3 link ${p} present")
      endif()
    endforeach()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------ 3. base dump = migration rows
# dnodes: all node rows of the dump (normalized tuples); dl: the dump rows that touch the id range.
function(check_dump new old links paths dnodes dl out)
  set(r "")
  tuples_of("${dl}" d)
  set(dn "${d}")
  list(FILTER dn INCLUDE REGEX "^\\([0-9]+,'")
  set(dlinks "${d}")
  list(FILTER dlinks INCLUDE REGEX "${LINK_RX}")
  set(dpaths "${d}")
  list(FILTER dpaths INCLUDE REGEX "${PATH_RX}")
  # new nodes: (ref,id,1,'name',map,x,y,z,kx,ky,kz) -> (id,'name',map,x,y,z,1)
  set(mn "")
  foreach(t IN LISTS new)
    string(REGEX REPLACE "^\\([0-9]+,([0-9]+),1,('.*'),([0-9]+),(${N}),(${N}),(${N}),${N},${N},${N}\\)$" "(\\1,\\2,\\3,\\4,\\5,\\6,1)" t2 "${t}")
    list(APPEND mn "${t2}")
  endforeach()
  list(SORT mn)
  list(SORT dn)
  # old refs -> dump ids by name, map and position
  string(REPLACE ";" "\n" nodetext "\n${dnodes}")
  string(REPLACE ";" "\n" lt "\n${links}")
  string(REPLACE ";" "\n" pt "\n${paths}")
  foreach(t IN LISTS old)
    if(r)
      break()
    endif()
    string(REGEX MATCH "^\\(([0-9]+),NULL,0,('.*'),([0-9]+),(${N}),(${N}),(${N})," _ "${t}")
    set(ref "${CMAKE_MATCH_1}")
    set(needle ",${CMAKE_MATCH_2},${CMAKE_MATCH_3},${CMAKE_MATCH_4},${CMAKE_MATCH_5},${CMAKE_MATCH_6},1)")
    string(FIND "${nodetext}" "${needle}" at)
    string(FIND "${nodetext}" "${needle}" last REVERSE)
    if(at LESS 0 OR NOT at EQUAL last)
      set(r "old node ref ${ref} not found exactly once in the dump")
      break()
    endif()
    string(SUBSTRING "${nodetext}" 0 ${at} head)
    string(FIND "${head}" "\n(" open REVERSE)
    math(EXPR open "${open} + 2")
    string(SUBSTRING "${head}" ${open} -1 id)
    string(REGEX REPLACE "\n\\(${ref}," "\n(#${id}," lt "${lt}")
    string(REGEX REPLACE "\n\\(([#0-9]+),${ref}," "\n(\\1,#${id}," lt "${lt}")
    string(REGEX REPLACE "\n\\(${ref}," "\n(#${id}," pt "${pt}")
    string(REGEX REPLACE "\n\\(([#0-9]+),${ref}," "\n(\\1,#${id}," pt "${pt}")
  endforeach()
  string(REPLACE "#" "" lt "${lt}")
  string(REPLACE "#" "" pt "${pt}")
  string(REPLACE "\n" ";" ml "${lt}")
  string(REPLACE "\n" ";" mp "${pt}")
  list(FILTER ml EXCLUDE REGEX "^$")
  list(FILTER mp EXCLUDE REGEX "^$")
  list(SORT ml)
  list(SORT mp)
  list(SORT dlinks)
  list(SORT dpaths)
  list(LENGTH dnodes total)
  math(EXPR want_total "${LO} + ${HI} - ${LO} + 1")
  string(FIND "${dl}" "\r" cr)
  if(r)
  elseif(NOT cr LESS 0)
    set(r "CR in the dump rows")
  elseif(NOT "${mn}" STREQUAL "${dn}")
    set(r "dump node rows differ from the migration")
  elseif(NOT total EQUAL want_total)
    set(r "dump has ${total} node rows, expected ${want_total}")
  elseif(NOT "${ml}" STREQUAL "${dlinks}")
    set(r "dump link rows differ from the migration")
  elseif(NOT "${mp}" STREQUAL "${dpaths}")
    set(r "dump path rows differ from the migration")
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ------------------------------------------------------------------ run
foreach(f MIG1)
  file(READ "${${f}}" hex HEX)
  string(FIND "${hex}" "0d" crx)
  if(NOT crx LESS 0)
    message(FATAL_ERROR "${TAG}: ${f} has a CR or a non-ASCII byte (raw bytes)")
  endif()
endforeach()
file(READ "${MIG1}" mig1)
file(STRINGS "${DUMP_TN}" dl REGEX "^\t\\(([0-9]+, )?${RANGE_RX}, ")
file(STRINGS "${DUMP_TN}" dnodes_raw REGEX "^\t\\([0-9]+, '")
tuples_of("${dnodes_raw}" dnodes)

check_mig1("${mig1}" e)
if(e)
  message(FATAL_ERROR "${TAG}: ${e}")
endif()
string(REGEX MATCH "path points \\+([0-9]+)" _ "${mig1}")
set(HP "${CMAKE_MATCH_1}")
string(REGEX MATCH "links \\+([0-9]+)" _ "${mig1}")
set(HL "${CMAKE_MATCH_1}")
string(REGEX MATCH "nodes \\+([0-9]+)" _ "${mig1}")
set(HN "${CMAKE_MATCH_1}")
rows_mig1("${mig1}")
check_rows("${HN}" "${HL}" "${HP}" "${m_new}" "${m_old}" "${m_links}" "${m_paths}" e)
if(e)
  message(FATAL_ERROR "${TAG}: ${e}")
endif()
check_dump("${m_new}" "${m_old}" "${m_links}" "${m_paths}" "${dnodes}" "${dl}" e)
if(e)
  message(FATAL_ERROR "${TAG}: ${e}")
endif()

# ------------------------------------------------------------------ negative probes
set(caught 0)
macro(expect_caught what reason)
  if(NOT e)
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
  string(FIND "${e}" "${reason}" hit)
  if(hit LESS 0)
    message(FATAL_ERROR "${TAG}: negative probe '${what}' caught for the wrong reason: ${e}")
  endif()
  math(EXPR caught "${caught} + 1")
endmacro()
# a) a module-table statement outside a prepared statement
check_mig1("${mig1}\nINSERT INTO `ai_playerbot_travelnode_link` SELECT * FROM `_w0m575_link`;\n" e)
expect_caught("ungated module-table write" "outside a prepared statement")
# b) the gate without the link-range condition
string(REPLACE " AND @w0m_idl = 0 AND" " AND" probe "${mig1}")
check_mig1("${probe}" e)
expect_caught("gate without the link range" "gate changed")
# c) a write gated only by the table guard
string(REPLACE "SET @w0m_sql := IF(@w0m_do,\n  'INSERT IGNORE INTO `ai_playerbot_travelnode_link`" "SET @w0m_sql := IF(@w0m_tables = 3,\n  'INSERT IGNORE INTO `ai_playerbot_travelnode_link`" probe "${mig1}")
check_mig1("${probe}" e)
expect_caught("link insert not under @w0m_do" "not gated by @w0m_do")
# d) the rollback gone
string(REPLACE "--   DELETE FROM `ai_playerbot_travelnode` WHERE `id` BETWEEN ${LO} AND ${HI};\n" "" probe "${mig1}")
check_mig1("${probe}" e)
expect_caught("rollback removed" "rollback text")
# e) a CR
check_mig1("${mig1}\r\n" e)
expect_caught("CR" "CR in migration 1")
# f) a header count that no longer matches its parts
string(REPLACE "path points +${HP} (" "path points +1${HP} (" probe "${mig1}")
check_mig1("${probe}" e)
expect_caught("header path count" "header count sums differ")
# g) the scorpid link 1842->1843 back (header count raised with it, so only the link check can see it)
set(probe_links "${m_links}")
list(REMOVE_AT probe_links 0)
list(APPEND probe_links "(1842,1843,1,0,608.178,0.000,0,1,8,0,0)")
check_rows("${HN}" "${HL}" "${HP}" "${m_new}" "${m_old}" "${probe_links}" "${m_paths}" e)
expect_caught("link 1842->1843" "1842<->1843")
# h) a dropped v3.3 link back
set(probe_links "${m_links}")
list(REMOVE_AT probe_links 0)
list(APPEND probe_links "(1861,1840,1,0,311.284,0.000,0,1,8,0,50)")
check_rows("${HN}" "${HL}" "${HP}" "${m_new}" "${m_old}" "${probe_links}" "${m_paths}" e)
expect_caught("dropped link 1861->1840" "dropped v3.3 link")
# i) a link between two old nodes (outside the rollback range)
set(probe_links "${m_links}")
list(REMOVE_AT probe_links 0)
list(APPEND probe_links "(2,3,1,0,100.000,0.000,0,1,8,0,50)")
check_rows("${HN}" "${HL}" "${HP}" "${m_new}" "${m_old}" "${probe_links}" "${m_paths}" e)
expect_caught("old-old link" "without an end in the id range")
# j) a node id outside the range
string(REPLACE ";(1863,1863,1," ";(1864,1864,1," probe_new "${m_new}")
check_rows("${HN}" "${HL}" "${HP}" "${probe_new}" "${m_old}" "${m_links}" "${m_paths}" e)
expect_caught("node id 1864" "not exactly the id range")
# k) one path row missing in the migration (the header still says the old count)
set(probe_paths "${m_paths}")
list(REMOVE_AT probe_paths 0)
check_rows("${HN}" "${HL}" "${HP}" "${m_new}" "${m_old}" "${m_links}" "${probe_paths}" e)
expect_caught("path row missing" "row count differs")
# l) one dump path point changed
list(GET m_paths 0 p0)
string(REGEX REPLACE ",(${N})\\)$" ",999.999)" p0x "${p0}")
set(probe_paths "${m_paths}")
list(REMOVE_AT probe_paths 0)
list(INSERT probe_paths 0 "${p0x}")
check_dump("${m_new}" "${m_old}" "${m_links}" "${probe_paths}" "${dnodes}" "${dl}" e)
expect_caught("dump path differs" "dump path rows differ")

list(LENGTH m_paths np)
list(LENGTH m_links nl)
message(STATUS "${TAG} contract passed (nodes ${HN}, links ${nl}, path points ${np}; ${caught} negative probes caught)")
