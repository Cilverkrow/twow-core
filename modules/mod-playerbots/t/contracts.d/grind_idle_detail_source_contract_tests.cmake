cmake_policy(VERSION 3.16)
# twow-repo#601 (CLI-Deep 20.11.2026, OB-00 order, deep research 1 NOTE-R1 section 4 no. 3): AiPlayerbot.ActivityTrace.GrindIdleDetail
# (default 0). In DAUER-B the L11-20 roster bots were grind_idle 21 % of their time and no log said why (crowding, grey spots,
# waiting for a respawn). With the switch the grind target pass (round 0) counts its candidates and refusals into the bot's tally,
# and a grind_idle episode writes one [GrindIdleDetail] start line (with the cause) and one end line. Pins: the key, the pure
# policy (no lock), one tally note per refusal before its log line, the episode hook in the sample, the lines, and that it is log
# only (no decision reads the tally). Negative probes at the end prove that the checks bite.

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "grind idle detail: PB_SOURCE_DIR is required")
endif()

set(TAG "grind idle detail")

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

# Every check returns "" when it holds, else the reason (the probes reuse them).
function(check_text text needle description out_var)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    set(${out_var} "missing ${description}" PARENT_SCOPE)
  else()
    set(${out_var} "" PARENT_SCOPE)
  endif()
endfunction()

function(check_absent text needle description out_var)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
  else()
    set(${out_var} "forbidden ${description}" PARENT_SCOPE)
  endif()
endfunction()

function(check_order text first second description out_var)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(${out_var} "${description}" PARENT_SCOPE)
  else()
    set(${out_var} "" PARENT_SCOPE)
  endif()
endfunction()

function(between text first second out_var)
  string(FIND "${text}" "${first}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${second}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} region)
  set(${out_var} "${region}" PARENT_SCOPE)
endfunction()

macro(must result)
  if(NOT "${${result}}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${${result}}")
  endif()
endmacro()

read_source("PlayerbotAIConfig.h" config_h)
read_source("PlayerbotAIConfig.cpp" config_cpp)
read_source("aiplayerbot.conf.dist.in" conf_dist)
read_source("GrindIdlePolicy.h" policy)
read_source("BotActivityPolicy.h" activity)
read_source("PlayerbotAI.h" ai_h)
read_source("PlayerbotAI.cpp" ai_cpp)
read_source("strategy/values/GrindTargetValue.cpp" grind_cpp)

# The refusals of the grind pass: log text -> the Skip it must note right before it.
set(SKIP_PAIRS
  "Height|\"ignored (to far above/below)."
  "FreeRange|\"ignored (out of free range)."
  "FreeRange|\"ignored (far from master)."
  "LevelAbove| levels above bot)."
  "Avoided|\"ignored (killed this bot repeatedly)."
  "Elite|\"ignored (can not fight elites currently)."
  "Invalid|\"ignored (is pet or evading/unkillable)."
  "Tapped|\"ignored (tapped, cced or out of range)."
  "Critter|\"ignored (ignore critters)."
  "Rule|\"ignored (GrindMode 2: not needed for a quest)."
  "Rule|\"ignored (QuestFirstOrder: not needed for a quest, not in the way)."
  "Rule|\"ignored (QuestLoop.RelationWorkNoGrind: the hand-in / accept at the NPC first)."
  "Rule|\"ignored (GrindMode 1: level outside the window)."
  "NotNeeded|\"ignored (not needed for active quest)."
  "Grey|\"ignored (not xp and not needed for quest).")

function(run_checks grind ai sample report pol out_var)
  set(fail "")
  # 1. Key: default 0, loaded, echoed in byte order, documented.
  check_text("${config_h}" "bool activityTraceGrindIdleDetail = false;" "member default off" r)
  if(r)
    set(fail "${r}")
  endif()
  check_text("${config_cpp}" "activityTraceGrindIdleDetail = config.GetBoolDefault(\"AiPlayerbot.ActivityTrace.GrindIdleDetail\", false);" "default 0" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${config_cpp}" "            {\"ActivityTrace\", Value(activityTrace)},\n            {\"ActivityTrace.GrindIdleDetail\", Value(activityTraceGrindIdleDetail)},\n            {\"ActivityTrace.IdleDetail\", Value(activityTraceIdleDetail)}," "ConfigEcho entry in byte order" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${conf_dist}" "\nAiPlayerbot.ActivityTrace.GrindIdleDetail = 0\n" "documented default" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()

  # 2. Policy: pure, the cause rule's constants and order.
  check_absent("${pol}" "mutex" "a lock in the policy" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${pol}" "constexpr std::uint32_t PassMaxAgeSeconds = 120;\nconstexpr std::uint32_t CrowdOthers = 2;" "the cause constants" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${pol}" "    if (t.picked)\n        return Cause::Picked;\n    if (!t.candidates)\n        return others >= CrowdOthers ? Cause::Crowded : Cause::Respawn;" "pick before the empty spot" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_order("${pol}" "return Cause::Grey;" "        return Cause::Crowded;\n    if (std::uint32_t(t.skips" "grey before tapped" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${activity}" "inline StuckDetailLimit& GrindIdleDetailGlobal()\n{\n    static StuckDetailLimit limit;" "its own budget" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()

  # 3. The grind pass: tally only in round 0 behind both switches; one note right before each refusal's log line; the pick.
  check_text("${grind}" "    ai::grind_idle::PassTally* const tally = !assistCount && sPlayerbotAIConfig.activityTrace &&\n        sPlayerbotAIConfig.activityTraceGrindIdleDetail ? &ai->GrindPassTally() : nullptr;" "the round-0 tally behind the switches" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  foreach(pair IN LISTS SKIP_PAIRS)
    string(FIND "${pair}" "|" bar)
    string(SUBSTRING "${pair}" 0 ${bar} why)
    math(EXPR from "${bar} + 1")
    string(SUBSTRING "${pair}" ${from} -1 msg)
    string(FIND "${grind}" "${msg}" at)
    if(at EQUAL -1)
      if(NOT fail)
        set(fail "refusal text gone: ${msg}")
      endif()
      continue()
    endif()
    # the note sits on the line before the refusal's logGrind (at most 200 chars back)
    math(EXPR back "${at} - 200")
    if(back LESS 0)
      set(back 0)
    endif()
    math(EXPR len "${at} - ${back}")
    string(SUBSTRING "${grind}" ${back} ${len} head)
    set(note "skip(ai::grind_idle::Skip::${why});\n")
    string(LENGTH "${note}" note_len)
    string(FIND "${head}" "${note}" hit REVERSE)
    string(FIND "${head}" "logGrind(" lg REVERSE)
    set(gap "x")
    if(NOT hit EQUAL -1 AND NOT lg EQUAL -1)
      math(EXPR after "${hit} + ${note_len}")
      if(NOT after GREATER lg)
        math(EXPR gap_len "${lg} - ${after}")
        string(SUBSTRING "${head}" ${after} ${gap_len} gap)
        string(STRIP "${gap}" gap)
      endif()
    endif()
    # only indentation between the note and the refusal's own logGrind
    if(NOT "${gap}" STREQUAL "")
      if(NOT fail)
        set(fail "no Skip::${why} note right before: ${msg}")
      endif()
    endif()
  endforeach()
  check_text("${grind}" "            skip(ai::grind_idle::Skip::Unreachable);\n            continue;" "unreachable refusal" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${grind}" "        if (tally && tally->candidates < 0xFFFF)\n            ++tally->candidates;\n\n        // Hotfix 8.2" "candidates counted after the null check" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${grind}" "        if (tally)\n            tally->picked = true;\n        logGrind(unit, \"(hostile) selected.\");\n        return unit;" "an attacker is a pick" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${grind}" "        round0GapSkipped = gapSkipped;\n    // twow-repo#601 (ActivityTrace.GrindIdleDetail): the pass's pick, after the safe-pull and neighbour rules (round 0 only).\n    if (tally)\n        tally->picked = result != nullptr;\n\n    return result;" "the pass's pick after the safe-pull and neighbour rules" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  # log only: no decision reads the tally (it is only written in the pass)
  foreach(read "tally->picked)" "tally->candidates)" "tally->skips" "if (tally->" "GrindPassTally().")
    check_absent("${grind}" "${read}" "a decision on the tally (${read})" r)
    if(r AND NOT fail)
      set(fail "${r}")
    endif()
  endforeach()

  # 4. The sample: the episode behind the switch, its own limit, after the kind and before the credit.
  check_text("${sample}" "    if (sPlayerbotAIConfig.activityTraceGrindIdleDetail)\n    {\n        ai::bot_activity::IdleNote const note = grindIdleEpisode.Note(kind == ai::bot_activity::Kind::GrindIdle, now," "the episode on grind_idle" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${sample}" "            grindIdleEpisode.startLogged = ai::bot_activity::GrindIdleDetailGlobal().Take(now);\n            if (grindIdleEpisode.startLogged)\n                ReportGrindIdleDetail(kind, note, now);" "the start within its limit" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${sample}" "        if (note == ai::bot_activity::IdleNote::End && grindIdleEpisode.startLogged)\n        {\n            grindIdleEpisode.startLogged = false;" "an end only after its start" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_order("${sample}" "ai::bot_activity::Kind const kind = ai::bot_activity::Classify(state);" "ReportGrindIdleDetail(kind, note, now);" "after the kind" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_order("${sample}" "ReportGrindIdleDetail(kind, note, now);" "activityClock.Add(kind, now)" "before the credit" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()

  # 5. The lines; log only.
  check_text("${report}" "\"[GrindIdleDetail] state=end bot=%u level=%u grind_idle_s=%u cause=%s next=%s gap=%u dropped=%u\"" "end line" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${report}" "\"[GrindIdleDetail] state=start bot=%u level=%u map=%u zone=%u x=%.0f y=%.0f entry=%d tmpl_min=%u tmpl_max=%u\"" "start line head" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${report}" "grindIdleCause = ai::grind_idle::CauseOf(t, now, others);" "the cause from the pure rule" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  check_text("${report}" "ai::bot_activity::GrindIdleDetailGlobal().TakeDropped()" "refused lines counted" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  foreach(change "SetStatus(" "SetExpireIn(" "SetRetry(" "MoveTo(" "->Clear(" "->Set(" "->Reset(" "TakeInactiveReselectPending(")
    check_absent("${report}" "${change}" "a behaviour change in the report (${change})" r)
    if(r AND NOT fail)
      set(fail "${r}")
    endif()
  endforeach()
  check_text("${ai}" "    ai::grind_idle::PassTally& GrindPassTally() { return grindPass; }" "the tally accessor" r)
  if(r AND NOT fail)
    set(fail "${r}")
  endif()
  set(${out_var} "${fail}" PARENT_SCOPE)
endfunction()

between("${ai_cpp}" "void PlayerbotAI::SampleActivity(uint32 now)" "\n}\n" sample)
between("${ai_cpp}" "void PlayerbotAI::ReportGrindIdleDetail(" "\n}\n" report)
run_checks("${grind_cpp}" "${ai_h}" "${sample}" "${report}" "${policy}" result)
must(result)

# Negative probes: each mutation must fail the checks.
function(probe name grind ai sample report pol)
  run_checks("${grind}" "${ai}" "${sample}" "${report}" "${pol}" r)
  if("${r}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: probe '${name}' was not caught")
  endif()
endfunction()

string(REPLACE "            skip(ai::grind_idle::Skip::Grey);\n" "" p "${grind_cpp}")
probe("grey note dropped" "${p}" "${ai_h}" "${sample}" "${report}" "${policy}")
string(REPLACE "skip(ai::grind_idle::Skip::Tapped);" "skip(ai::grind_idle::Skip::Critter);" p "${grind_cpp}")
probe("tapped noted as critter" "${p}" "${ai_h}" "${sample}" "${report}" "${policy}")
string(REPLACE "    if (tally)\n        tally->picked = result != nullptr;\n\n    return result;" "\n    return result;" p "${grind_cpp}")
probe("pick not recorded" "${p}" "${ai_h}" "${sample}" "${report}" "${policy}")
string(REPLACE "    if (result)\n    {\n        logGrind(result, \"selected.\");" "    if (tally->picked)\n        result = nullptr;\n    if (result)\n    {\n        logGrind(result, \"selected.\");" p "${grind_cpp}")
probe("a decision on the tally" "${p}" "${ai_h}" "${sample}" "${report}" "${policy}")
string(REPLACE "!assistCount && sPlayerbotAIConfig.activityTrace &&" "sPlayerbotAIConfig.activityTrace &&" p "${grind_cpp}")
probe("assist rounds tallied" "${p}" "${ai_h}" "${sample}" "${report}" "${policy}")
string(REPLACE "GrindIdleDetailGlobal().Take(now)" "IdleDetailGlobal().Take(now)" p "${sample}")
probe("shared idle budget" "${grind_cpp}" "${ai_h}" "${p}" "${report}" "${policy}")
string(REPLACE "    if (sPlayerbotAIConfig.activityTraceGrindIdleDetail)\n" "    if (true)\n" p "${sample}")
probe("not behind the switch" "${grind_cpp}" "${ai_h}" "${p}" "${report}" "${policy}")
string(REPLACE "    int32 entry = 0;" "    aiObjectContext->GetValue<TravelTarget*>(\"travel target\")->Reset();\n    int32 entry = 0;" p "${report}")
probe("a behaviour change in the report" "${grind_cpp}" "${ai_h}" "${sample}" "${p}" "${policy}")
string(REPLACE "        return others >= CrowdOthers ? Cause::Crowded : Cause::Respawn;" "        return Cause::Respawn;" p "${policy}")
probe("crowding ignored on an empty spot" "${grind_cpp}" "${ai_h}" "${sample}" "${report}" "${p}")

message(STATUS "grind idle detail source contract passed")
