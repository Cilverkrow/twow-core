cmake_policy(VERSION 3.16)
# A3 step 3 planner P-2a (A3-S3-PLANER-ENTWURF.md v0.3, frozen d6e51878; AiPlayerbot.Planner, default 0): the pure rules of the
# planner in the supervisor tick. Unit suite: t/planner_shadow_policy_tests.cpp. Pinned here:
#   (a) PlannerShadowPolicy.h is pure: <cstddef>/<cstdint>/<cstdio> only, no game type, no log, no config read, no lock, no clock;
#   (b) the rules the review asked for: COOLDOWN is never expired, WORK only by a forced reason (OB-10 B3); a close always has a
#       reason and an end (CLI-Deep 19.11.); a relocation is tested on the same map only (OB-10 N3); Diff leaves the label of a
#       gone quest to the adapter (repeatable quests are "gone", OB-10);
#   (c) PlannerPolicy.h names the planner reasons of section 7 (OB-10 N2); SupervisorPolicy.h appends the planner fields of the
#       [Plan] line after budget_ms, so the head of the line stays;
#   (d) tests.cmake registers planner_shadow_policy;
#   (e) P-2a is inert: no source includes PlannerShadowPolicy.h yet (P-2b adds the adapter and updates this check).
# Every check_* returns "" when it holds, else the reason; the negative probes at the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s3 planner shadow policy: PB_SOURCE_DIR is required")
endif()
get_filename_component(PB_MODULE_ROOT "${PB_SOURCE_DIR}/../.." ABSOLUTE)

set(TAG "a3s3 planner shadow policy")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# "" when a comes before b in text (both present), else the reason.
function(check_order text a b what out)
  string(FIND "${text}" "${a}" pa)
  string(FIND "${text}" "${b}" pb)
  if(pa EQUAL -1 OR pb EQUAL -1)
    set(${out} "${what}: missing '${a}' or '${b}'" PARENT_SCOPE)
  elseif(NOT pa LESS pb)
    set(${out} "${what}: '${a}' not before '${b}'" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

read_file("${PB_SOURCE_DIR}/PlannerShadowPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/PlannerPolicy.h" planner)
read_file("${PB_SOURCE_DIR}/SupervisorPolicy.h" supervisor_policy)
read_file("${PB_MODULE_ROOT}/tests.cmake" tests)

# (a) pure
function(check_pure text out)
  string(REGEX MATCHALL "\n#include [^\n]*" includes "\n${text}")
  foreach(inc IN LISTS includes)
    string(STRIP "${inc}" inc)
    if(NOT inc MATCHES "^#include (<cstddef>|<cstdint>|<cstdio>)$")
      set(${out} "PlannerShadowPolicy.h: include not allowed: ${inc}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(word sPlayerbotAIConfig sObjectMgr sLog "Player*" "Player&" "Player const" PlayerbotAI "std::mutex" WorldTimer
      "Unit*" "Creature*" TravelTarget TravelDestination "time(")
    string(FIND "${text}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlannerShadowPolicy.h: names '${word}' (the header must stay pure)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# (b) the rules
# One needle (plain text; a variable name, so a ";" inside never splits a list).
function(need_text text needle_var name out)
  string(FIND "${text}" "${${needle_var}}" at)
  if(at EQUAL -1)
    set(${out} "PlannerShadowPolicy.h: rule changed: ${name}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

function(check_rules text out)
  set(n1 "    if (phase == TravelPhase::Cooldown)\n        return ExpireGate::Cooldown;\n    if (phase == TravelPhase::Work)\n        return forcedReason ? ExpireGate::WorkOverride : ExpireGate::Work;\n    return ExpireGate::Allowed;")
  set(n2 "    if (!mem || !n || !key || !closeMs || reason == CloseReason::None)\n        return;")
  set(n3 "    if (!a.valid || !b.valid || a.map != b.map || a.onTransport || b.onTransport)\n        return false;")
  set(n4 "    if (rewardNoted)\n        return EvQuestReward;\n    if (repeatable)\n        return EvQuestGone;\n    return rewardStatus ? EvQuestReward : EvQuestDrop;")
  set(n5 "    if (!questOrGrindPurpose)\n        return Compare::NaPurpose;")
  need_text("${text}" n1 "COOLDOWN locked, WORK only forced (B3)" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  need_text("${text}" n2 "a close needs a reason and an end" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  need_text("${text}" n3 "relocate on the same map only (N3)" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  need_text("${text}" n4 "repeatable quests are gone unless the reward note saw them (B2)" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  need_text("${text}" n5 "the shadow comparison counts other purposes apart (B1)" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # Diff does not label a gone quest itself.
  string(FIND "${text}" "inline std::uint32_t Diff(" d0)
  string(FIND "${text}" "inline std::uint32_t LabelGone(" d1)
  if(d0 EQUAL -1 OR d1 EQUAL -1 OR NOT d0 LESS d1)
    set(${out} "PlannerShadowPolicy.h: Diff or LabelGone missing or out of order" PARENT_SCOPE)
    return()
  endif()
  math(EXPR len "${d1} - ${d0}")
  string(SUBSTRING "${text}" ${d0} ${len} diff_body)
  foreach(word EvQuestReward EvQuestDrop EvQuestGone)
    string(FIND "${diff_body}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlannerShadowPolicy.h: Diff labels a gone quest (${word}); the adapter does that with the reward status" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# (c) reasons and the [Plan] line
function(check_lines planner_text policy_text out)
  foreach(pair "Incumbent:incumbent" "R1Hold:r1_hold" "DeadTarget:dead_target" "BandTableOff:band_table_off" "MaxHold:max_hold"
      "BackToBand:back_to_band" "RepeatCap:repeat_cap")
    string(REPLACE ":" ";" parts "${pair}")
    list(GET parts 0 enum_name)
    list(GET parts 1 text_name)
    string(FIND "${planner_text}" "        case Reason::${enum_name}: return \"${text_name}\";" at)
    if(at EQUAL -1)
      set(${out} "PlannerPolicy.h: reason ${enum_name} has no name ${text_name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${policy_text}" "\"[Plan] bot=%u cohort=%c arbiter=%u mode=%s pick=%s:%u:%u value=%.2f xpm=%.1f route_s=%.0f \"" at)
  if(at EQUAL -1)
    set(${out} "SupervisorPolicy.h: the head of the [Plan] line changed" PARENT_SCOPE)
    return()
  endif()
  check_order("${policy_text}" "blocked=%u budget_ms=%u " "\"lvl=%u zone=%u band=%u tier=%s ev=%s route=%s fb=%s "
    "SupervisorPolicy.h: the planner fields come after budget_ms" r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${policy_text}" "relocate_src=%s floor=%s hold=%s write=%u ms=%u\"," at)
  if(at EQUAL -1)
    set(${out} "SupervisorPolicy.h: the [Plan] line does not end with relocate_src floor hold write ms" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# (d) the unit suite
function(check_tests text out)
  foreach(needle "add_executable(planner_shadow_policy_tests\n  \"\${PB_MODULE_DIR}/t/planner_shadow_policy_tests.cpp\")"
      "add_test(NAME planner_shadow_policy\n  COMMAND planner_shadow_policy_tests")
    string(FIND "${text}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "tests.cmake: planner_shadow_policy is not registered" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# (e) inert
function(check_inert_text name text out)
  if(name STREQUAL "PlannerShadowPolicy.h")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${text}" "PlannerShadowPolicy.h" at)
  if(NOT at EQUAL -1)
    set(${out} "${name}: includes PlannerShadowPolicy.h (P-2a is inert; P-2b adds the adapter and updates this check)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

function(check_inert src_dir out)
  file(GLOB_RECURSE sources "${src_dir}/*.cpp" "${src_dir}/*.h")
  foreach(path IN LISTS sources)
    get_filename_component(name "${path}" NAME)
    file(READ "${path}" text)
    check_inert_text("${name}" "${text}" r)
    if(NOT "${r}" STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

check_pure("${policy}" r)
fail_if("${r}")
check_rules("${policy}" r)
fail_if("${r}")
check_lines("${planner}" "${supervisor_policy}" r)
fail_if("${r}")
check_tests("${tests}" r)
fail_if("${r}")
check_inert("${PB_SOURCE_DIR}" r)
fail_if("${r}")

# ---- negative probes --------------------------------------------------------------------------------------------------------
function(expect_caught what reason)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
endfunction()

string(REPLACE "#include <cstdio>" "#include <cstdio>\n#include <vector>" m "${policy}")
check_pure("${m}" r)
expect_caught("another include in the pure header" "${r}")
string(REPLACE "struct GoneList\n{" "struct GoneList\n{\n    void Log() { sLog.outBasic(\"x\"); }" m "${policy}")
check_pure("${m}" r)
expect_caught("log in the pure header" "${r}")
string(REPLACE "struct GoneList\n{" "struct GoneList\n{\n    Player* bot = nullptr;" m "${policy}")
check_pure("${m}" r)
expect_caught("a game type in the pure header" "${r}")
string(REPLACE "    if (phase == TravelPhase::Cooldown)\n        return ExpireGate::Cooldown;\n" "" m "${policy}")
check_rules("${m}" r)
expect_caught("COOLDOWN may expire" "${r}")
string(REPLACE "return forcedReason ? ExpireGate::WorkOverride : ExpireGate::Work;" "return ExpireGate::WorkOverride;" m "${policy}")
check_rules("${m}" r)
expect_caught("WORK expires without a forced reason" "${r}")
string(REPLACE " || !closeMs || reason == CloseReason::None)" ")" m "${policy}")
check_rules("${m}" r)
expect_caught("a close without an end or a reason" "${r}")
string(REPLACE " || a.map != b.map ||" " ||" m "${policy}")
check_rules("${m}" r)
expect_caught("relocate across maps" "${r}")
string(REPLACE "    gone.n = 0;\n" "    gone.n = 0;\n    std::uint32_t label = EvQuestReward;\n" m "${policy}")
check_rules("${m}" r)
expect_caught("Diff labels a gone quest" "${r}")
string(REPLACE "        case Reason::MaxHold: return \"max_hold\";\n" "" m "${planner}")
check_lines("${m}" "${supervisor_policy}" r)
expect_caught("a planner reason without a name" "${r}")
string(REPLACE "\"[Plan] bot=%u cohort=%c arbiter=%u mode=%s pick=" "\"[Plan] bot=%u lvl=%u cohort=%c arbiter=%u mode=%s pick=" m "${supervisor_policy}")
check_lines("${planner}" "${m}" r)
expect_caught("the head of the [Plan] line changed" "${r}")
string(REPLACE "add_test(NAME planner_shadow_policy\n" "add_test(NAME planner_shadow_policy_off\n" m "${tests}")
check_tests("${m}" r)
expect_caught("the unit suite is not registered" "${r}")
check_inert_text("Supervisor.h" "#include \"playerbot/PlannerShadowPolicy.h\"" r)
expect_caught("a source includes the pure header (P-2a is inert)" "${r}")

message(STATUS "${TAG}: all checks passed")
