# twow-repo#333 Berufe P1-aa (OB-00 04.11.2026 after M1r run 8: a level-7 skinner, bot 4583, on a near tool trip to vendor 66 at
# 209 yd never bought its knife - "attack anything" 5.0 beat "move to travel target" 1.0 and "rpg buy" 1.03, and the 600 s hold
# ended with reason=cap 19 min late). AiPlayerbot.ProfessionTraining.TripNoGrind (code default 0; 1 all, 2 cohort B, 3 cohort A):
#   (1) no proactive "attack anything" on an open profession trip, self-defence kept;
#   (2) on arrival the trip's vendor / trainer is the rpg target with "rpg buy" / "rpg train" next;
#   (3) the trip ends on time (a minute tick in PlayerbotAI::UpdateAI);
#   (4) with ProfessionTraining.Trace a "[ProfTravel] state=status" line at the arrival and at each end.
# This contract pins the switch (dist key, member, read with > 3 = off, sorted [ConfigEcho] entry), each change behind the switch-first
# test, and the anchors the other contracts need. The pure rules are tested in t/profession_travel_policy_tests.cpp.

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_source path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(between text first second out_var)
  string(FIND "${text}" "${first}" a)
  if(a EQUAL -1)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: region not found: '${first}'")
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${second}" b)
  if(b EQUAL -1)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: region end not found after '${first}': '${second}'")
  endif()
  string(SUBSTRING "${rest}" 0 ${b} region)
  set(${out_var} "${region}" PARENT_SCOPE)
endfunction()

function(count_text text needle expected description)
  string(LENGTH "${needle}" needle_len)
  set(count 0)
  string(FIND "${text}" "${needle}" offset)
  while(NOT offset EQUAL -1)
    math(EXPR count "${count} + 1")
    math(EXPR offset "${offset} + ${needle_len}")
    string(SUBSTRING "${text}" ${offset} -1 text)
    string(FIND "${text}" "${needle}" offset)
  endwhile()
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "#333 P1-aa TripNoGrind: ${description}: expected ${expected} of '${needle}', found ${count}")
  endif()
endfunction()

