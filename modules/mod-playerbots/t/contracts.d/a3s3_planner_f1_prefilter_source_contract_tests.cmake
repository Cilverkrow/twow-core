# ---- (a) the policy: pure, min / add / compare only -------------------------------------------------------------------------
function(check_a policy_h out)
  foreach(word "Player*" "Player&" "WorldPosition" "sLog" "#include \"playerbot/" "getX" "getY" "coord_" "sqDistance" "pow("
      "fma" "hypot")
    string(FIND "${policy_h}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "GiverPrefilterPolicy.h: names '${word}' (pure, no distance formula of its own)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(term "    return transferSq + squareToPortalSq;\n")
  set(cmp "    return maxDistance > 0 && float(std::sqrt(lowerBoundSq)) > maxDistance;\n")
  set(minv "    if (term < acc)\n        acc = term;\n")
  check_times("${policy_h}" "GiverPrefilterPolicy.h" 1 r term cmp minv)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (b) the bound from the original functions; the originals unchanged -----------------------------------------------------
function(check_b square_h square_cpp travel_h travel_cpp out)
  set(same "                    if (sq.IsIn(point))\n                    {\n                        inbox = true;\n                        term = 0.0f;\n                    }\n                    else\n                        term = sq.sqOutDistance(point);\n")
  set(portal "                    for (auto const& [portal, distance] : portalsOf(sq.GetMapId()))\n                        ai::giver_prefilter::TakeMin(term,\n                            ai::giver_prefilter::PortalTerm(distance, sq.IsIn(portal) ? 0.0f : sq.sqOutDistance(portal)));\n")
  set(lb "                ai::giver_prefilter::TakeMin(lb, term);\n")
  set(each "        void ForEachSubSquare(F&& f) const { for (auto& [id, sq] : subSquares) f(sq); }\n")
  check_times("${square_h}" "WorldSquare.h bound" 1 r same portal lb each)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # the originals (byte pins): the box distance, the in/out switch, the container's in-distance, the map square's IsIn and portal
  # path, DistanceTo, sqMapTransDistances and the transfer sqDist
  set(o1 "        virtual float sqOutDistance(const WorldPosition& point) const\n        {\n            float sqX = std::min(std::max(min.getX(), point.getX()), max.getX());\n            float sqY = std::min(std::max(min.getY(), point.getY()), max.getY());\n\n            return point.sqDistance2d(WorldPosition(0, sqX, sqY));\n        }\n")
  set(o2 "        virtual float sqDistance(const WorldPosition& point) const\n        {\n            if (IsIn(point))\n                return sqInDistance(point);\n            else\n                return sqOutDistance(point);\n        }\n")
  set(o3 "            float minDistSq = FLT_MAX;\n            for (auto& [id, sq] : subSquares)\n            {\n                float distSq = sq.sqDistance(point);\n                if (distSq < minDistSq)\n                    minDistSq = distSq;\n            }\n")
  set(o4 "        virtual bool IsIn(const WorldPosition& point) const override {\n            if (point.getMapId() != mapId) return false; return WorldPointSquareContainer\n                ::IsIn(point);\n        }\n")
  set(o5 "        virtual bool IsIn(const WorldPosition& point) const override { return true; }\n")
  check_times("${square_h}" "WorldSquare.h original" 1 r o1 o2 o3 o4 o5)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(o6 "    if (point.mapid != mapId)\n    {\n        float minSqDist = FLT_MAX;\n        //distance = point -> portal (on map of square)\n        for (auto& [portal, distance] : sTravelMgr.sqMapTransDistances(point, mapId))\n        {\n            float sqDist = distance + sqDistance(portal); //Add sqDistance = portal -> square.\n            if (sqDist < minSqDist)\n                minSqDist = sqDist;\n        }\n\n        return minSqDist;\n    }\n\n    return WorldPointSquareContainer::sqOutDistance(point);\n")
  check_times("${square_cpp}" "WorldSquare.cpp original" 1 r o6)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(o7 "\t\tfloat DistanceTo(const WorldPosition& pos) const { return sqrt(sqDistance(pos)); }\n")
  set(o8 "\t\tfloat sqDist(const WorldPosition& start, const WorldPosition& end) const { return start.sqDistance2d(pointFrom) + (portalLength * portalLength) + pointTo.sqDistance2d(end); }\n")
  check_times("${travel_h}" "TravelMgr.h original" 1 r o7 o8)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # no TravelDestination subclass has a distance of its own: DistanceTo / sqDistance / sqOutDistance / sqInDistance are declared
  # nowhere else in TravelMgr.h
  foreach(word "float sqDistance(" "float sqOutDistance(" "float sqInDistance(")
    string(FIND "${travel_h}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "TravelMgr.h: declares '${word}' (a destination distance of its own would bypass the bound)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(dt "DistanceTo(const WorldPosition& pos) const")
  check_times("${travel_h}" "TravelMgr.h DistanceTo" 1 r dt)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(o9 "        WorldPosition portalOnEndMap = mapTrans.GetPointTo();\n\n        float sqDist = mapTrans.sqDist(start, portalOnEndMap);\n\n        retPortals.push_back(std::make_pair(portalOnEndMap, sqDist));\n")
  check_times("${travel_cpp}" "TravelMgr.cpp sqMapTransDistances original" 1 r o9)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (c) TravelMgr: the switch, the condition, both paths, the cache ----------------------------------------------------------
function(check_c travel_h travel_cpp out)
  set(decl "\textern thread_local giver_prefilter::Counts* tDestRangePrefilter;\n")
  check_times("${travel_h}" "TravelMgr.h" 1 r decl)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(def "thread_local ai::giver_prefilter::Counts* ai::tDestRangePrefilter = nullptr;\n")
  set(cond "    giver_prefilter::Counts* const prefilter = (tDestRangePrefilter && !onlyPossible && maxDistance > 0) ? tDestRangePrefilter : nullptr;\n")
  set(cache "    std::vector<std::pair<uint32, std::vector<std::pair<WorldPosition, float>>>> portalCache;\n")
  set(off "        if (!prefilter)\n            return false;\n")
  check_times("${travel_cpp}" "TravelMgr.cpp" 1 r def cond cache off)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(p1 "                continue;\n\n            if (prefiltered(dest))\n                continue;\n\n            if (outOfTracedRange(dest))\n")
  set(p2 "                    continue;\n\n                if (prefiltered(dest))\n                    continue;\n\n                if (outOfTracedRange(dest))\n")
  check_times("${travel_cpp}" "TravelMgr.cpp walk paths" 1 r p1 p2)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(any "prefiltered(dest)")
  check_times("${travel_cpp}" "TravelMgr.cpp" 2 r any)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(word "static std::vector<std::pair<uint32, std::vector<std::pair<WorldPosition" "thread_local std::vector<std::pair<uint32")
    string(FIND "${travel_cpp}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "TravelMgr.cpp: a portal cache that outlives the call ('${word}')" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# no source file but TravelMgr.h / TravelMgr.cpp / PlannerShadow.cpp names the switch
function(check_c_only out)
  file(GLOB_RECURSE srcs "${PB_SOURCE_DIR}/*.cpp" "${PB_SOURCE_DIR}/*.h")
  foreach(f IN LISTS srcs)
    get_filename_component(name "${f}" NAME)
    if(name STREQUAL "TravelMgr.h" OR name STREQUAL "TravelMgr.cpp" OR name STREQUAL "PlannerShadow.cpp")
      continue()
    endif()
    file(READ "${f}" t)
    string(FIND "${t}" "tDestRangePrefilter" at)
    if(NOT at EQUAL -1)
      set(${out} "${name}: names tDestRangePrefilter (only the planner's giver fetch sets the switch)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) PlannerShadow: the scope, the cohort rule, the verify ---------------------------------------------------------------
function(check_d shadow_cpp out)
  set(ctor "    explicit PrefilterScope(ai::giver_prefilter::Counts* counts) { ai::tDestRangePrefilter = counts; }\n")
  set(dtor "    ~PrefilterScope() { ai::tDestRangePrefilter = nullptr; }\n")
  set(endf "    void End() const { ai::tDestRangePrefilter = nullptr; }\n")
  set(on "        prefilterOn = ai::cohort::Applies(sPlayerbotAIConfig.plannerGiverPrefilter, guid);\n")
  set(scope "        PrefilterScope const prefilterScope(prefilterOn ? &prefilterCounts : nullptr);\n        std::vector<ai::TravelDestination*> givers = sTravelMgr.GetDestinations(info,\n            std::uint32_t(ai::TravelDestinationPurpose::QuestGiver), {}, false, kPickupRadius);\n        giveScope.End();\n        prefilterScope.End();\n")
  set(verify "    if (prefilterVerify)\n    {\n        std::vector<ai::TravelDestination*> const original = sTravelMgr.GetDestinations(info,\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp" 1 r ctor dtor endf on scope verify)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # the switch is written only by the scope (ctor, dtor, End)
  set(w "ai::tDestRangePrefilter = ")
  check_times("${shadow_cpp}" "PlannerShadow.cpp switch writes" 3 r w)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(prefilterScopes "PrefilterScope const ")
  check_times("${shadow_cpp}" "PlannerShadow.cpp prefilter scopes" 1 r prefilterScopes)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # the verify runs after the plan's ms and the [PlanTime] end clocks are read (it changes no slot, no cut, no measured time):
  # right after the TimeTrace end block, before the minute max
  set(after "        planTime.cohort = ai::cohort::Letter(guid);\n    }\n    // S5 F1 verify:")
  set(before "        sLog.outBasic(\"%s\", vbuf);\n    }\n    c.msMax = ms;\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp verify place" 1 r after before)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(msread "    std::uint32_t const ms = WorldTimer::getMSTimeDiffToNow(startMs);\n")
  check_order("${shadow_cpp}" "PlannerShadow.cpp" msread verify r)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

