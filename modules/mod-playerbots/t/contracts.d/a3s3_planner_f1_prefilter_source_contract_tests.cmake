# ---- (f) the unit suite ----------------------------------------------------------------------------------------------------
function(check_f tests unit out)
  set(exe "add_executable(giver_prefilter_policy_tests\n  \"\${PB_MODULE_DIR}/t/giver_prefilter_policy_tests.cpp\")")
  set(run "add_test(NAME giver_prefilter_policy\n  COMMAND giver_prefilter_policy_tests\n")
  check_times("${tests}" "tests.cmake" 1 r exe run)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(t TestTakeMin TestPortalTermMonotone TestExcludesEdge TestFirstDiff TestVerifyLine)
    set(call "    ${t}();\n")
    check_times("${unit}" "t/giver_prefilter_policy_tests.cpp" 1 r call)
    if(NOT "${r}" STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

