cmake_policy(VERSION 3.16)
# twow-repo#750 (AiPlayerbot.QuestFeasibility.CraftOnlySkip; OB-10 840bcbdf / be58c794): its own key outside QuestFeasibility.Enable /
# S3Cohort. Pins the key (clamp, echo, dist), the start-only build, the gate on the one accept rule and the giver relation (never
# the taker), the held-quest counter that never skips, and keeps it off the exempt paths (share, escort confirm, catch-up, guild
# order) and off the drop step (no abandon).

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "craft-only: PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "craft-only: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "craft-only: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" first_at)
  string(FIND "${text}" "${second}" second_at)
  if(first_at EQUAL -1 OR second_at EQUAL -1 OR NOT first_at LESS second_at)
    message(FATAL_ERROR "craft-only: order ${description}")
  endif()
endfunction()

function(count_text text needle expected description)
  set(count 0)
  set(rest "${text}")
  string(LENGTH "${needle}" needle_length)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR count "${count} + 1")
    math(EXPR next "${at} + ${needle_length}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "craft-only: ${description}: ${count} != ${expected}")
  endif()
endfunction()

function(region text start end out)
  string(FIND "${text}" "${start}" start_at)
  if(start_at EQUAL -1)
    message(FATAL_ERROR "craft-only: missing region start: ${start}")
  endif()
  string(SUBSTRING "${text}" ${start_at} -1 rest)
  string(LENGTH "${start}" start_length)
  string(SUBSTRING "${rest}" ${start_length} -1 tail)
  string(FIND "${tail}" "${end}" end_at)
  if(end_at EQUAL -1)
    message(FATAL_ERROR "craft-only: missing region end: ${end}")
  endif()
  math(EXPR total "${start_length} + ${end_at}")
  string(SUBSTRING "${rest}" 0 ${total} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

