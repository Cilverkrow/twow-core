# ---- negative probes --------------------------------------------------------------------------------------------------------
function(expect_caught what reason)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
endfunction()

string(REPLACE "#include <vector>" "#include <vector>\n#include \"playerbot/PlayerbotAIConfig.h\"" m "${policy}")
check_pure("${m}" r)
expect_caught("game include in the pure header" "${r}")
string(REPLACE "struct Table\n{" "struct Table\n{\n    void Log() { sLog.outBasic(\"x\"); }" m "${policy}")
check_pure("${m}" r)
expect_caught("log in the pure header" "${r}")
string(REPLACE "    if (path.empty())\n        return;   // default: no file I/O, no line\n" "" m "${loader}")
check_loader("${m}" r)
expect_caught("no empty-path guard" "${r}")
string(REPLACE "    loadAttempted = true;\n" "" m "${loader}")
check_loader("${m}" r)
expect_caught("no boot-only guard" "${r}")
string(REPLACE "published.store(table, std::memory_order_release);" "published.store(table, std::memory_order_relaxed);" m "${loader}")
check_loader("${m}" r)
expect_caught("relaxed publish" "${r}")
string(REPLACE "    sLog.outBasic(\"%s\", FormatLoaded(ShaHex8(bytes).c_str(), counts, path).c_str());\n    published.store(table, std::memory_order_release);"
  "    published.store(table, std::memory_order_release);\n    sLog.outBasic(\"%s\", FormatLoaded(ShaHex8(bytes).c_str(), counts, path).c_str());" m "${loader}")
check_loader("${m}" r)
expect_caught("publish before the loaded line" "${r}")
string(REPLACE "    return published.load(std::memory_order_acquire);" "    return published.load(std::memory_order_relaxed);" m "${loader}")
check_loader("${m}" r)
expect_caught("relaxed read" "${r}")
string(REPLACE "ai::band_table::Table const* ai::band_table::Get()\n{"
  "ai::band_table::Table const* ai::band_table::Get()\n{\n    delete published.load();" m "${loader}")
check_loader("${m}" r)
expect_caught("freeing the published table" "${r}")
string(REPLACE "    ai::band_table::Load();\n" "" m "${travel}")
check_wiring("${m}" "${config_cpp}" "${config_h}" "${conf}" "${tests}" r)
expect_caught("loader not called" "${r}")
string(REPLACE "    ai::quest_band::LoadLadder();\n" "" m0 "${travel}")
string(REPLACE "    ai::band_table::Load();\n" "    ai::band_table::Load();\n    ai::quest_band::LoadLadder();\n" m "${m0}")
check_wiring("${m}" "${config_cpp}" "${config_h}" "${conf}" "${tests}" r)
expect_caught("loader before the hub ladder" "${r}")
string(REPLACE "\"AiPlayerbot.Planner.BandTable\", \"\")" "\"AiPlayerbot.Planner.BandTable\", \"band.tsv\")" m "${config_cpp}")
check_wiring("${travel}" "${m}" "${config_h}" "${conf}" "${tests}" r)
expect_caught("non-empty default" "${r}")
string(REPLACE "\nAiPlayerbot.Planner.BandTable = \"\"\n" "\nAiPlayerbot.Planner.BandTable = \"band.tsv\"\n" m "${conf}")
check_wiring("${travel}" "${config_cpp}" "${config_h}" "${m}" "${tests}" r)
expect_caught("conf.dist value not empty" "${r}")

message(STATUS "${TAG}: all checks passed")
