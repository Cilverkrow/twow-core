cmake_policy(VERSION 3.16)
# A3 step 3 planner P-1 (A3-S3-PLANER-ENTWURF.md v0.3 §6, A3-GERUEST-L60.md 3 B6a; AiPlayerbot.Planner.BandTable, default ""):
# the planner's band table. Pure rules: BandTablePolicy.h, unit suite t/band_table_policy_tests.cpp. Pinned here:
#   (a) BandTablePolicy.h is pure: standard headers only, no game type, no log, no config read, no code of the hub ladder;
#   (b) BandTable.cpp: an empty path returns before any file I/O and line; boot only (loadAttempted); the table is published
#       last (one release store, after the loaded line) and read with an acquire load; it is never freed once published;
#   (c) wiring: Load() once in TravelMgr.cpp, after the hub ladder loader; the key is read with default "" and documented in
#       aiplayerbot.conf.dist.in with "" as its value; tests.cmake registers band_table_policy;
#   (d) P-1 is inert: nothing outside BandTable.cpp calls ai::band_table::Get() yet (the planner pair P-2 adds the reader and
#       updates this check).
# Every check_* returns "" when it holds, else the reason; the negative probes at the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s3 planner band_table: PB_SOURCE_DIR is required")
endif()
get_filename_component(PB_MODULE_ROOT "${PB_SOURCE_DIR}/../.." ABSOLUTE)

set(TAG "a3s3 planner band_table")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# Number of non-overlapping occurrences of needle (plain text, no regex, no list splitting).
function(count_text text needle out_var)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nl)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR cut "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${cut} -1 rest)
  endwhile()
  set(${out_var} ${n} PARENT_SCOPE)
endfunction()

# "" when a comes before b in text (both present), else the reason.
function(check_order text a b what out)
  string(FIND "${text}" "${a}" pa)
  string(FIND "${text}" "${b}" pb)
  if(pa EQUAL -1 OR pb EQUAL -1)
    set(${out} "${what}: missing '${a}' or '${b}'" PARENT_SCOPE)
  elseif(NOT pa LESS pb)
    set(${out} "${what}: '${a}' not before '${b}'" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

read_file("${PB_SOURCE_DIR}/BandTablePolicy.h" policy)
read_file("${PB_SOURCE_DIR}/BandTable.h" loader_h)
read_file("${PB_SOURCE_DIR}/BandTable.cpp" loader)
read_file("${PB_SOURCE_DIR}/TravelMgr.cpp" travel)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" conf)
read_file("${PB_MODULE_ROOT}/tests.cmake" tests)

# ---- (a) the pure header ----------------------------------------------------------------------------------------------------
function(check_pure policy out)
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" includes "${policy}")
  foreach(inc IN LISTS includes)
    if(NOT inc MATCHES "^#include <(cstdint|cstdio|cstdlib|string|vector)>$")
      set(${out} "BandTablePolicy.h: include '${inc}' (standard headers only)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(word "Player*" "Player&" "WorldPosition" "sLog" "sPlayerbotAIConfig" "quest_band::" "std::atomic" "std::mutex")
    string(FIND "${policy}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "BandTablePolicy.h: names '${word}' (pure header)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) the loader ---------------------------------------------------------------------------------------------------------
function(check_loader loader out)
  check_order("${loader}" "    if (path.empty())\n        return;" "std::ifstream file(" "empty path before file I/O" r)
  if(NOT r STREQUAL "")
    set(${out} "BandTable.cpp: ${r}" PARENT_SCOPE)
    return()
  endif()
  check_order("${loader}" "    if (loadAttempted)\n        return;\n    loadAttempted = true;" "std::ifstream file(" "boot-only guard" r)
  if(NOT r STREQUAL "")
    set(${out} "BandTable.cpp: ${r}" PARENT_SCOPE)
    return()
  endif()
  count_text("${loader}" "published.store(" n)
  if(NOT n EQUAL 1)
    set(${out} "BandTable.cpp: published.store ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  count_text("${loader}" "published.store(table, std::memory_order_release);" n)
  if(NOT n EQUAL 1)
    set(${out} "BandTable.cpp: the publish is not one release store of the table" PARENT_SCOPE)
    return()
  endif()
  check_order("${loader}" "FormatLoaded(ShaHex8(bytes).c_str(), counts, path)" "published.store(" "loaded line before publish" r)
  if(NOT r STREQUAL "")
    set(${out} "BandTable.cpp: ${r}" PARENT_SCOPE)
    return()
  endif()
  count_text("${loader}" "return published.load(std::memory_order_acquire);" n)
  if(NOT n EQUAL 1)
    set(${out} "BandTable.cpp: Get() is not one acquire load" PARENT_SCOPE)
    return()
  endif()
  # The only delete is the unpublished empty table.
  count_text("${loader}" "delete " n)
  count_text("${loader}" "        delete table;\n        LogOff(\"empty\", path);" ne)
  if(NOT n EQUAL 1 OR NOT ne EQUAL 1)
    set(${out} "BandTable.cpp: a delete other than the unpublished empty table" PARENT_SCOPE)
    return()
  endif()
  check_order("${loader}" "        delete table;" "published.store(" "the empty table is freed before any publish" r)
  if(NOT r STREQUAL "")
    set(${out} "BandTable.cpp: ${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) wiring -------------------------------------------------------------------------------------------------------------
function(check_wiring travel config_cpp config_h conf tests out)
  count_text("${travel}" "ai::band_table::Load();" n)
  if(NOT n EQUAL 1)
    set(${out} "TravelMgr.cpp: ai::band_table::Load() ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  check_order("${travel}" "    ai::quest_band::LoadLadder();" "    ai::band_table::Load();" "TravelMgr.cpp: after the hub ladder" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  count_text("${config_cpp}" "plannerBandTable = config.GetStringDefault(\"AiPlayerbot.Planner.BandTable\", \"\");" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAIConfig.cpp: the key is not read once with default \"\"" PARENT_SCOPE)
    return()
  endif()
  count_text("${config_h}" "    std::string plannerBandTable;" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAIConfig.h: plannerBandTable missing" PARENT_SCOPE)
    return()
  endif()
  count_text("${conf}" "\nAiPlayerbot.Planner.BandTable = \"\"\n" n)
  if(NOT n EQUAL 1)
    set(${out} "aiplayerbot.conf.dist.in: AiPlayerbot.Planner.BandTable = \"\" not documented once" PARENT_SCOPE)
    return()
  endif()
  count_text("${tests}" "add_test(NAME band_table_policy\n  COMMAND band_table_policy_tests" n)
  if(NOT n EQUAL 1)
    set(${out} "tests.cmake: band_table_policy not registered" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) inert in P-1 -------------------------------------------------------------------------------------------------------
function(check_inert src_dir out)
  file(GLOB_RECURSE sources "${src_dir}/*.cpp" "${src_dir}/*.h")
  foreach(path IN LISTS sources)
    get_filename_component(name "${path}" NAME)
    if(name STREQUAL "BandTable.cpp" OR name STREQUAL "BandTable.h")
      continue()
    endif()
    file(READ "${path}" text)
    string(FIND "${text}" "band_table::Get(" at)
    if(NOT at EQUAL -1)
      set(${out} "${name}: reads the band table (P-1 is inert; the planner pair updates this check)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

check_pure("${policy}" r)
