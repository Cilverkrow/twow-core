cmake_policy(VERSION 3.16)
# A3 step 3 planner S5 plan time (twow-repo#726; S5-FIX-ENTWURF-v0.1 sections 2 and 6; AiPlayerbot.Planner.TimeTrace, default 0).
# Pinned here:
#   (a) PlannerTimePolicy.h is pure (no game type, no clock, no log) and the trace is gated: every clock read and count of the plan
#       hangs on timeTrace = (plannerTimeTrace == 1); the [PlanTime] line is written once, after the [Plan] line, before Flush;
#   (b) each of the three fetches (turn-ins, objectives, pickups) runs inside one FetchStatsScope that is ended right after the
#       fetch, and its stage is closed by one traceStage call; the plan's ms read stays the getMSTime difference;
#   (c) TravelMgr counts only through the thread-local pointer (null by default): walk on both paths, ret once before the return;
#   (d) the key: read, any value but 0 / 1 is 0 with one error line, echoed, documented, in the planner key list;
#   (e) the unit suite planner_time_policy is registered and runs every test.
# Every check_* returns "" when it holds, else the reason; the negative probes at the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s3 planner s5 time: PB_SOURCE_DIR is required")
endif()
if(NOT DEFINED PB_MODULE_DIR)
  message(FATAL_ERROR "a3s3 planner s5 time: PB_MODULE_DIR is required")
endif()

set(TAG "a3s3 planner s5 time")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# needle_var is the NAME of a variable holding the needle (a ";" in a needle would split a list argument).
function(count_text text needle_var out)
  set(needle "${${needle_var}}")
  string(LENGTH "${needle}" nl)
  set(n 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# Each named needle exactly n times in text. names: the NAMES of variables holding the needles.
function(check_times text where want out)
  foreach(v ${ARGN})
    count_text("${text}" ${v} n)
    if(NOT n EQUAL ${want})
      set(${out} "${where}: '${${v}}' found ${n} times, want ${want}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

