# ---- (a) pure header, gated trace, one line --------------------------------------------------------------------------------
function(check_a time_h shadow_cpp out)
  foreach(word "Player*" "Player&" "WorldPosition" "sLog" "<chrono>" "clock_gettime" "WorldTimer" "#include \"playerbot/")
    string(FIND "${time_h}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "PlannerTimePolicy.h: names '${word}' (the header stays pure)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(gate "    bool const timeTrace = sPlayerbotAIConfig.plannerTimeTrace == 1;\n")
  set(start "    std::int64_t const traceStartNs = timeTrace ? TraceNowNs() : 0;\n")
  set(startcpu "    std::int64_t const traceStartCpuNs = timeTrace ? ThreadCpuNs() : -1;\n")
  set(now "    auto const traceNow = [&]() -> std::int64_t { return timeTrace ? TraceNowNs() : 0; };\n")
  set(stageoff "        if (!timeTrace)\n            return;\n        std::int64_t const endAt = TraceNowNs();\n")
  set(endblk "    std::uint32_t const ms = WorldTimer::getMSTimeDiffToNow(startMs);\n    if (timeTrace)\n    {\n        std::int64_t const traceEndNs = TraceNowNs();\n")
  set(emit "    if (timeTrace)\n    {\n        char tbuf[kPlanTimeBuf];\n        FormatPlanTimeLine(tbuf, sizeof(tbuf), planTime);\n        sLog.outBasic(\"%s\", tbuf);\n    }\n\n    Flush(guid, c, int(ms));\n")
  # cut / done / open (n of complete and open quest ids: 1 = one key lookup, 2+ = the key walk) come with every line
  set(fcut "        planTime.cut = cut;\n")
  set(fdone "        planTime.done = std::uint32_t(completeIds.size());\n")
  set(fopen "        planTime.open = std::uint32_t(openIds.size());\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp" 1 r gate start startcpu now stageoff endblk emit fcut fdone fopen)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # every TraceNowNs() / ThreadCpuNs() call of the file is a gated one or a definition (TraceNowNs: start, traceNow, traceStage,
  # end; ThreadCpuNs: start, end) - an ungated clock read would cost every plan with the trace off.
  set(tn "TraceNowNs()")
  set(tc "ThreadCpuNs()")
  check_times("${shadow_cpp}" "PlannerShadow.cpp TraceNowNs" 5 r tn)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  check_times("${shadow_cpp}" "PlannerShadow.cpp ThreadCpuNs" 3 r tc)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (b) the three fetch stages --------------------------------------------------------------------------------------------
function(check_b shadow_cpp out)
  foreach(stage take obj give)
    set(scope "        FetchStatsScope const ${stage}Scope(timeTrace ? &fetchStats : nullptr);\n")
    set(endcall "        ${stage}Scope.End();\n")
    set(close "        traceStage(planTime.${stage}, ${stage}FetchAt, ${stage}SortAt, ${stage}LoopAt);\n    }\n")
    check_times("${shadow_cpp}" "PlannerShadow.cpp ${stage}" 1 r scope endcall close)
    if(NOT "${r}" STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(reset "        fetchStats = ai::DestFetchStats();\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp" 3 r reset)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(dtor "    ~FetchStatsScope() { ai::tDestFetchStats = nullptr; }\n")
  set(budget "    std::uint32_t const budgetMs = sPlayerbotAIConfig.plannerBudgetMs;\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp" 1 r dtor budget)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (c) TravelMgr counts --------------------------------------------------------------------------------------------------
function(check_c travel_h travel_cpp out)
  set(decl "\textern thread_local DestFetchStats* tDestFetchStats;\n")
  check_times("${travel_h}" "TravelMgr.h" 1 r decl)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(def "thread_local ai::DestFetchStats* ai::tDestFetchStats = nullptr;\n")
  set(take "    DestFetchStats* const fetchStats = tDestFetchStats;")
  set(ret "    if (fetchStats)\n        fetchStats->ret += uint32(retDests.size());\n    return retDests;\n")
  check_times("${travel_cpp}" "TravelMgr.cpp" 1 r def take ret)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(walk "fetchStats->walk += uint32(dests.size());\n")
  check_times("${travel_cpp}" "TravelMgr.cpp walk (both paths)" 2 r walk)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (d) the key -----------------------------------------------------------------------------------------------------------
function(check_d config_cpp config_h conf shadow_contract out)
  set(read "    plannerTimeTrace = uint32(config.GetIntDefault(\"AiPlayerbot.Planner.TimeTrace\", 0));\n    if (!ai::planner::ValidTimeTrace(plannerTimeTrace))\n    {\n")
  set(zero "        plannerTimeTrace = 0;\n")
  set(echo "            {\"Planner.TimeTrace\", Value(plannerTimeTrace)},\n")
  check_times("${config_cpp}" "PlayerbotAIConfig.cpp" 1 r read zero echo)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(member "    uint32 plannerTimeTrace = 0;\n")
  check_times("${config_h}" "PlayerbotAIConfig.h" 1 r member)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(doc "\nAiPlayerbot.Planner.TimeTrace = 0\n")
  check_times("${conf}" "aiplayerbot.conf.dist.in" 1 r doc)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(listed " Planner.TimeTrace ")
  check_times("${shadow_contract}" "a3s3_planner_shadow contract PLANNER_KEYS" 1 r listed)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (e) the unit suite ----------------------------------------------------------------------------------------------------
function(check_e tests time_tests out)
  set(exe "add_executable(planner_time_policy_tests\n  \"\${PB_MODULE_DIR}/t/planner_time_policy_tests.cpp\")")
  set(run "add_test(NAME planner_time_policy\n  COMMAND planner_time_policy_tests\n")
  check_times("${tests}" "tests.cmake" 1 r exe run)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(t TestValidTimeTrace TestUsBetween TestLineShape TestBufferBound)
    set(call "    ${t}();\n")
    check_times("${time_tests}" "t/planner_time_policy_tests.cpp" 1 r call)
    if(NOT "${r}" STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

