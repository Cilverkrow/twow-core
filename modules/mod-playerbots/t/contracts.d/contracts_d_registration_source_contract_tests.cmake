cmake_policy(VERSION 3.16)
# t/contracts.d (OB-00 25.10.2026): a source contract in this directory registers itself. tests.cmake globs
# t/contracts.d/*.cmake (sorted, CONFIGURE_DEPENDS) and adds <name>_tests.cmake as the ctest test <name>, run with
# cmake -P and PB_SOURCE_DIR / PB_MODULE_DIR / CORE_SOURCE_DIR. This contract is the first file here and pins:
# the glob block in tests.cmake; every file here is named <name>_tests.cmake (lower case, one dot) and sets its
# policies first (trixie cmake 3.31 runs a -P script without them in compatibility mode); no file here is also
# registered by hand in tests.cmake, and no derived name collides with a test added by hand there.
# Reads named files only. Every check_* function returns "" when it holds, else the reason; the negative probes at
# the end reuse them.
if(NOT DEFINED PB_MODULE_DIR)
  message(FATAL_ERROR "PB_MODULE_DIR is required")
endif()

set(TAG "contracts.d")
set(GLOB_HEAD "file(GLOB pb_contracts_d ")
set(GLOB_LINE "file(GLOB pb_contracts_d CONFIGURE_DEPENDS \"\${PB_MODULE_DIR}/t/contracts.d/*.cmake\")\n")
set(SORT_LINES "list(SORT pb_contracts_d)\nforeach(pb_contract IN LISTS pb_contracts_d)\n")
set(NAME_LINES "  get_filename_component(pb_contract_name \"\${pb_contract}\" NAME)\n  string(REGEX REPLACE \"(_tests)?\\\\.cmake$\" \"\" pb_contract_name \"\${pb_contract_name}\")\n  add_test(NAME \"\${pb_contract_name}\"")
set(VAR_PB_SOURCE_DIR "      \"-DPB_SOURCE_DIR=\${PB_MODULE_DIR}/src/playerbot\"\n")
set(VAR_PB_MODULE_DIR "      \"-DPB_MODULE_DIR=\${PB_MODULE_DIR}\"\n")
set(VAR_CORE_SOURCE_DIR "      \"-DCORE_SOURCE_DIR=\${PB_MODULE_DIR}/../..\"\n")
set(RUN_TAIL "      -P \"\${pb_contract}\")\nendforeach()")

function(read_source path out_var)
  if(NOT EXISTS "${PB_MODULE_DIR}/${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${PB_MODULE_DIR}/${path}" text)
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

# The glob block: present once, re-globbed on rebuild, sorted, the name rule, every variable passed. Each part is
# searched in the block only (the -D lines also stand in the hand blocks above it), with its own reason.
function(check_block tests out)
  set(r "")
  string(FIND "${tests}" "${GLOB_HEAD}" at)
  string(FIND "${tests}" "${GLOB_HEAD}" last REVERSE)
  if(at LESS 0)
    set(r "glob block missing")
  elseif(NOT at EQUAL last)
    set(r "glob block twice")
  else()
    string(SUBSTRING "${tests}" ${at} -1 block)
    string(FIND "${block}" "${GLOB_LINE}" g)
    string(FIND "${block}" "${SORT_LINES}" s)
    string(FIND "${block}" "${NAME_LINES}" n)
    string(FIND "${block}" "${RUN_TAIL}" t)
    if(NOT g EQUAL 0)
      set(r "glob line changed (CONFIGURE_DEPENDS, the PB_MODULE_DIR path)")
    elseif(s LESS 0)
      set(r "glob not sorted")
    elseif(n LESS s)
      set(r "name rule changed")
    elseif(t LESS n)
      set(r "the -P run changed")
    else()
      string(SUBSTRING "${block}" ${n} -1 run)
      foreach(var PB_SOURCE_DIR PB_MODULE_DIR CORE_SOURCE_DIR)
        string(FIND "${run}" "${VAR_${var}}" v)
        if(v LESS 0 AND NOT r)
          set(r "${var} not passed")
        endif()
      endforeach()
    endif()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# One file: <name>_tests.cmake, lower case with one dot, policies set before anything else.
function(check_file name text out)
  set(r "")
  if(NOT name MATCHES "^[a-z0-9_]+_tests\\.cmake$")
    set(r "${name}: not named <name>_tests.cmake (lower case, one dot)")
  else()
    # Skip the leading comment lines (no REGEX REPLACE here: trixie cmake 3.31 refuses a pattern that can match empty).
    string(STRIP "${text}" body)
    while(body MATCHES "^#")
      string(FIND "${body}" "\n" nl)
      if(nl LESS 0)
        set(body "")
        break()
      endif()
      math(EXPR nl "${nl} + 1")
      string(SUBSTRING "${body}" ${nl} -1 body)
      string(STRIP "${body}" body)
    endwhile()
    if(NOT body MATCHES "^(cmake_policy\\(VERSION|cmake_minimum_required\\()")
      set(r "${name}: the first statement is not cmake_policy(VERSION ...) / cmake_minimum_required(...)")
    endif()
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# No double registration: a file here is never named in tests.cmake, its test name is not added by hand.
function(check_unique name tests out)
  set(r "")
  string(REGEX REPLACE "_tests\\.cmake$" "" test "${name}")
  string(FIND "${tests}" "/t/contracts.d/${name}" hand)
  # Every form a hand block uses: the name alone on its line, a one-liner (add_test(NAME x COMMAND x)), quoted.
  set(taken -1)
  foreach(form "add_test(NAME ${test}\n" "add_test(NAME ${test} " "add_test(NAME \"${test}\"")
    string(FIND "${tests}" "${form}" at)
    if(NOT at LESS 0)
      set(taken ${at})
    endif()
  endforeach()
  if(NOT hand LESS 0)
    set(r "${name}: also registered by hand in tests.cmake")
  elseif(NOT taken LESS 0)
    set(r "${name}: test name ${test} is already added in tests.cmake")
  endif()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

read_source("tests.cmake" tests)
check_block("${tests}" e)
if(e)
  message(FATAL_ERROR "${TAG}: ${e}")
endif()

file(GLOB files RELATIVE "${PB_MODULE_DIR}/t/contracts.d" "${PB_MODULE_DIR}/t/contracts.d/*.cmake")
list(LENGTH files count)
if(count LESS 1)
  message(FATAL_ERROR "${TAG}: no contract found (this file should be one)")
endif()
foreach(name IN LISTS files)
  read_source("t/contracts.d/${name}" text)
  check_file("${name}" "${text}" e)
  if(NOT e)
    check_unique("${name}" "${tests}" e)
  endif()
  if(e)
    message(FATAL_ERROR "${TAG}: ${e}")
  endif()
endforeach()

# Negative probes: each broken copy must be caught, and for its own reason.
set(caught 0)
macro(expect_caught what reason)
  if(NOT e)
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
  string(FIND "${e}" "${reason}" hit)
  if(hit LESS 0)
    message(FATAL_ERROR "${TAG}: negative probe '${what}' caught for the wrong reason: ${e}")
  endif()
  math(EXPR caught "${caught} + 1")
endmacro()
# a) the glob without CONFIGURE_DEPENDS
string(REPLACE "pb_contracts_d CONFIGURE_DEPENDS " "pb_contracts_d " probe "${tests}")
check_block("${probe}" e)
expect_caught("glob without CONFIGURE_DEPENDS" "glob line changed")
# b) the glob unsorted
string(REPLACE "list(SORT pb_contracts_d)\n" "" probe "${tests}")
check_block("${probe}" e)
expect_caught("glob unsorted" "glob not sorted")
# c) the name rule back to NAME_WE (a dotted file name would register under its first part)
string(REPLACE "\${pb_contract}\" NAME)" "\${pb_contract}\" NAME_WE)" probe "${tests}")
check_block("${probe}" e)
expect_caught("name rule NAME_WE" "name rule changed")
# d) a variable no longer passed
foreach(var PB_SOURCE_DIR PB_MODULE_DIR CORE_SOURCE_DIR)
  string(FIND "${tests}" "${GLOB_HEAD}" at)
  string(SUBSTRING "${tests}" 0 ${at} head)
  string(SUBSTRING "${tests}" ${at} -1 block)
  string(REPLACE "${VAR_${var}}" "" block "${block}")
  check_block("${head}${block}" e)
  expect_caught("${var} not passed" "${var} not passed")
endforeach()
# e) the block twice
check_block("${tests}\n${GLOB_LINE}\n" e)
expect_caught("glob block twice" "glob block twice")
# f) a file with an upper-case or dotted name, or without the _tests suffix
check_file("Foo_tests.cmake" "cmake_policy(VERSION 3.16)\n" e)
expect_caught("upper-case name" "not named")
check_file("foo.v2_tests.cmake" "cmake_policy(VERSION 3.16)\n" e)
expect_caught("dotted name" "not named")
check_file("foo_contract.cmake" "cmake_policy(VERSION 3.16)\n" e)
expect_caught("name without _tests" "not named")
# g) a file that does something before setting its policies
check_file("foo_tests.cmake" "# header\nif(NOT DEFINED PB_SOURCE_DIR)\nendif()\ncmake_policy(VERSION 3.16)\n" e)
expect_caught("policies not first" "is not cmake_policy")
# h) a file also registered by hand, and a name already taken by a block above (name alone, one-liner, quoted)
check_unique("foo_tests.cmake" "${tests}\n    -P \"\${PB_MODULE_DIR}/t/contracts.d/foo_tests.cmake\")\n" e)
expect_caught("registered by hand" "also registered by hand")
check_unique("transport_board_fix_source_contract_tests.cmake" "${tests}" e)
expect_caught("name already taken" "is already added")
check_unique("foo_tests.cmake" "${tests}\nadd_test(NAME foo COMMAND foo)\n" e)
expect_caught("name taken by a one-liner" "is already added")
check_unique("foo_tests.cmake" "${tests}\nadd_test(NAME \"foo\"\n" e)
expect_caught("name taken, quoted" "is already added")

message(STATUS "contracts.d registration contract passed (${count} file(s), ${caught} negative probes caught)")
