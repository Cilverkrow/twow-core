cmake_policy(VERSION 3.16)
# T30 v1.1 V2 (OB-00 19.11.2026; design round CLI-GRP 19.11.): the [GroupHook] membership line. Pure format: GroupHookLine.h,
# unit suite t/group_hook_line_tests.cpp. Pinned here:
#   (a) GroupHookLog.cpp overrides exactly the four core group hooks it relies on, with the core's signatures;
#   (b) it writes with sLog.outBasic only - no deferred log (drops lines, delays, routes disband lines to one bot) - and resolves
#       no player (only the group's own fields on the changing thread: harm_race clean);
#   (c) every override returns early with BotGroups.Diagnostics off and for battleground groups;
#   (d) wiring: AddGroupHookObserver once in AddSC_playerbot_hooks; SnapshotOnce once in PlayerbotWorldScript::OnUpdate after the
#       enabled check and before the remote commands / UpdateAI (both branches see it);
#   (e) the core facts the line semantics rest on: RemoveMethod GROUP_LEAVE = 0 / GROUP_KICK = 1 (mirrored in GroupHookLine.h);
#       Group::Create adds the founder through AddMember (so the founder gets ev=add); Group::Disband calls OnDisband before
#       it walks the member slots; RemoveMember of a 2-member group goes to Disband.
# Every check_* returns "" when it holds, else the reason; the negative probes at the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "t30v2 group_hook: PB_SOURCE_DIR is required")
endif()
if(NOT DEFINED CORE_SOURCE_DIR)
  get_filename_component(CORE_SOURCE_DIR "${PB_SOURCE_DIR}/../../../.." ABSOLUTE)
endif()

set(TAG "t30v2 group_hook")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# Number of non-overlapping occurrences of needle (plain text, no regex, no list splitting).
function(count_text text needle out_var)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nl)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR cut "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${cut} -1 rest)
  endwhile()
  set(${out_var} ${n} PARENT_SCOPE)
endfunction()

# The text from the first `start` up to the next `stop` after it ("" when start is missing).
function(region text start stop out_var)
  string(FIND "${text}" "${start}" at)
  if(at EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(LENGTH "${start}" start_len)
  string(SUBSTRING "${rest}" ${start_len} -1 after)
  string(FIND "${after}" "${stop}" end)
  if(end EQUAL -1)
    set(${out_var} "${rest}" PARENT_SCOPE)
  else()
    math(EXPR keep "${start_len} + ${end}")
    string(SUBSTRING "${rest}" 0 ${keep} piece)
    set(${out_var} "${piece}" PARENT_SCOPE)
  endif()
endfunction()

# "" when a comes before b in text (both present), else the reason.
function(check_order text a b what out)
  string(FIND "${text}" "${a}" pa)
  string(FIND "${text}" "${b}" pb)
  if(pa EQUAL -1 OR pb EQUAL -1)
    set(${out} "${what}: missing '${a}' or '${b}'" PARENT_SCOPE)
  elseif(NOT pa LESS pb)
    set(${out} "${what}: '${a}' not before '${b}'" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

# ---- (a)-(c) GroupHookLog.cpp ----------------------------------------------------------------------------------------------
function(check_observer log out)
  foreach(sig
      "void OnAddMember(Group* group, ObjectGuid guid) override"
      "void OnRemoveMember(Group* group, ObjectGuid guid, uint8 method) override"
      "void OnChangeLeader(Group* group, ObjectGuid newLeaderGuid, ObjectGuid oldLeaderGuid) override"
      "void OnDisband(Group* group) override")
    count_text("${log}" "${sig}" n)
    if(NOT n EQUAL 1)
      set(${out} "GroupHookLog.cpp: override '${sig}' ${n} times (1 expected)" PARENT_SCOPE)
      return()
    endif()
    region("${log}" "${sig}" "\n    }\n" body)
    foreach(guard "!sPlayerbotAIConfig.botGroupsDiagnostics" "group->isBGGroup()" "return;")
      string(FIND "${body}" "${guard}" g)
      if(g EQUAL -1)
        set(${out} "GroupHookLog.cpp: '${sig}' lacks the early return '${guard}'" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  foreach(bad "PostDeferredLog" "deferred_log" "GetPlayer(" "Player*" "Player const*" "ObjectAccessor")
    string(FIND "${log}" "${bad}" b)
    if(NOT b EQUAL -1)
      set(${out} "GroupHookLog.cpp: forbidden '${bad}' (deferred log / player lookup)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${log}" "sLog.outBasic(" n)
  if(NOT n EQUAL 1)
    set(${out} "GroupHookLog.cpp: sLog.outBasic ${n} times (1 expected, in Write)" PARENT_SCOPE)
    return()
  endif()
  count_text("${log}" "class GroupHookObserver : public GroupScript" n)
  if(NOT n EQUAL 1)
    set(${out} "GroupHookLog.cpp: GroupHookObserver : GroupScript ${n} times" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) wiring in PlayerbotScripts.cpp ------------------------------------------------------------------------------------
function(check_wiring scripts out)
  count_text("${scripts}" "ai::group_hook::AddGroupHookObserver();" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotScripts.cpp: AddGroupHookObserver ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  region("${scripts}" "void AddSC_playerbot_hooks()" "\n}\n" sc)
  string(FIND "${sc}" "ai::group_hook::AddGroupHookObserver();" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotScripts.cpp: AddGroupHookObserver not in AddSC_playerbot_hooks" PARENT_SCOPE)
    return()
  endif()
  count_text("${scripts}" "ai::group_hook::SnapshotOnce();" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotScripts.cpp: SnapshotOnce ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  region("${scripts}" "void OnUpdate(uint32 diff) override" "sRandomPlayerbotMgr.RunQueuedRemoteCommands();" upd)
  string(FIND "${upd}" "ai::group_hook::SnapshotOnce();" s)
  string(FIND "${upd}" "if (!sPlayerbotAIConfig.enabled)" e)
  if(s EQUAL -1 OR e EQUAL -1 OR NOT e LESS s)
    set(${out} "PlayerbotScripts.cpp: SnapshotOnce not between the enabled check and the first RunQueuedRemoteCommands" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) core facts --------------------------------------------------------------------------------------------------------
function(check_core group_h group_cpp line_h out)
  foreach(pair "GROUP_LEAVE = 0" "GROUP_KICK = 1")
    string(FIND "${group_h}" "${pair}" at)
    if(at EQUAL -1)
      set(${out} "Group.h: RemoveMethod changed, missing '${pair}' (GroupHookLine.h mirrors it)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(pair "kRemoveLeave = 0;" "kRemoveKick = 1;")
    string(FIND "${line_h}" "${pair}" at)
    if(at EQUAL -1)
      set(${out} "GroupHookLine.h: missing '${pair}'" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${group_cpp}" "bool Group::Create(" "\nbool Group::" create)
  check_order("${create}" "if (!AddMember(guid, name))" "script->OnCreate(" "Group::Create: founder via AddMember before OnCreate" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  region("${group_cpp}" "void Group::Disband(" "\nvoid Group::" disband)
  check_order("${disband}" "script->OnDisband(this);" "for (const auto& itr : m_memberSlots)" "Group::Disband: OnDisband before the slot walk" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  region("${group_cpp}" "uint32 Group::RemoveMember(" "\nvoid Group::" remove)
  check_order("${remove}" "if (GetMembersCount() > GetMembersMinCount())" "Disband(true, guid);" "Group::RemoveMember: 2-member group disbands" r)
  if(NOT r STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/GroupHookLog.cpp" log)
read_file("${PB_SOURCE_DIR}/GroupHookLine.h" line_h)
read_file("${PB_SOURCE_DIR}/PlayerbotScripts.cpp" scripts)
read_file("${CORE_SOURCE_DIR}/src/game/Group/Group.h" group_h)
read_file("${CORE_SOURCE_DIR}/src/game/Group/Group.cpp" group_cpp)

check_observer("${log}" r)
fail_if("${r}")
check_wiring("${scripts}" r)
fail_if("${r}")
check_core("${group_h}" "${group_cpp}" "${line_h}" r)
fail_if("${r}")

# ---- negative probes: each mutation must be caught ---------------------------------------------------------------------------
function(expect_caught what reason)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
endfunction()

string(REPLACE "sLog.outBasic(\"%s\", line.c_str());" "ai->PostDeferredLog(\"\", line);" m "${log}")
check_observer("${m}" r)
expect_caught("deferred log instead of sLog" "${r}")
string(REPLACE "        if (!sPlayerbotAIConfig.botGroupsDiagnostics || !group || group->isBGGroup())\n            return;\n        Write(\"add\""
  "        Write(\"add\"" m "${log}")
check_observer("${m}" r)
expect_caught("add hook without the diagnostics guard" "${r}")
string(REPLACE "    void OnDisband(Group* group) override" "    void OnDisbandGroup(Group* group)" m "${log}")
check_observer("${m}" r)
expect_caught("OnDisband override renamed" "${r}")
string(REPLACE "Write(\"leader\"" "Player* p = nullptr; Write(\"leader\"" m "${log}")
check_observer("${m}" r)
expect_caught("player pointer in the observer" "${r}")
string(REPLACE "    ai::group_hook::AddGroupHookObserver();\n" "" m "${scripts}")
check_wiring("${m}" r)
expect_caught("observer not registered" "${r}")
string(REPLACE "            ai::group_hook::SnapshotOnce();" "" m "${scripts}")
check_wiring("${m}" r)
expect_caught("snapshot not called" "${r}")
string(REPLACE "GROUP_KICK = 1" "GROUP_KICK = 2" m "${group_h}")
check_core("${m}" "${group_cpp}" "${line_h}" r)
expect_caught("core RemoveMethod changed" "${r}")
string(REPLACE "kRemoveKick = 1;" "kRemoveKick = 2;" m "${line_h}")
check_core("${group_h}" "${group_cpp}" "${m}" r)
expect_caught("mirror changed" "${r}")

message(STATUS "${TAG}: all checks passed")
