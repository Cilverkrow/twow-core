# ---- (i) DirectiveAck (09.11., agreed with CLI-Projekt): defined, posted through Post, no caller yet --------------------------
set(ACK_DECL "bool PostDirectiveAck(std::uint32_t guidLow, std::uint32_t seq, std::uint8_t state, std::uint8_t reason);")
set(ACK_DEF "bool PostDirectiveAck(std::uint32_t guidLow, std::uint32_t seq, std::uint8_t state, std::uint8_t reason)\n{")

function(check_ack policy inbox_h inbox_cpp all_sources out)
  string(FIND "${inbox_h}" "${ACK_DECL}" at)
  if(at EQUAL -1)
    set(${out} "ManagerInbox.h: PostDirectiveAck is not declared as agreed" PARENT_SCOPE)
    return()
  endif()
  region("${inbox_cpp}" "${ACK_DEF}" "\n}\n" body)
  if(body STREQUAL "")
    set(${out} "ManagerInbox.cpp: PostDirectiveAck not defined" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "    Event event{};" "    event.botLow = guidLow;" "    event.kind = Kind::DirectiveAck;" "    event.seq = seq;"
      "    event.mapOrDungeon = state;" "    event.reason = reason;" "    return Post(event);\n}")
    string(FIND "${body}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "PostDirectiveAck: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # No caller in this pair: the declaration and the definition are the only two mentions in the module.
  count_text("${all_sources}" "PostDirectiveAck(" n)
  if(NOT n EQUAL 2)
    set(${out} "PostDirectiveAck( appears ${n} times in the module (2 expected: declaration and definition, no caller yet)" PARENT_SCOPE)
    return()
  endif()
  # The unqualified Post( inside the namespace: exactly one call (PostDirectiveAck), next to the declaration and definition.
  set(code "${policy}\n${inbox_h}\n${inbox_cpp}")
  string(REPLACE "bool Post(Event const& event)" "" code "${code}")
  string(REGEX MATCHALL "[^A-Za-z0-9_:]Post\\(" calls "${code}")
  list(LENGTH calls nc)
  if(NOT nc EQUAL 1)
    set(${out} "ManagerInbox: ${nc} unqualified Post( call(s) in the inbox files (1 expected: PostDirectiveAck)" PARENT_SCOPE)
    return()
  endif()
  # Nobody else opens the inbox namespace (an unqualified Post( there would pass the qualified count).
  count_text("${all_sources}" "namespace ai::manager_inbox" n)
  if(NOT n EQUAL 3)
    set(${out} "namespace ai::manager_inbox opened ${n} times (3 expected: the policy header, ManagerInbox.h, ManagerInbox.cpp)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

