# ---- (a) the switch ----------------------------------------------------------------------------------------------------------
set(READ_LINE "    botGroupsManagerStatusSeconds = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.Manager.StatusSeconds\", 0));\n    if (botGroupsManagerStatusSeconds > ai::manager_inbox::kStatusSecondsMax)\n    {\n        uint32 const clamped = ai::manager_inbox::ClampStatusSeconds(int32(botGroupsManagerStatusSeconds));\n        sLog.outError(\"[GroupMgr] config key=Manager.StatusSeconds value=%d result=%u (0 off, 1..%u s)\",")
set(ECHO "            {\"BotGroups.Manager\", Value(botGroupsManager)},\n            {\"BotGroups.Manager.StatusSeconds\", Value(botGroupsManagerStatusSeconds)},\n")

function(check_switch config_h config_cpp conf_dist policy out)
  string(FIND "${config_h}" "    uint32 botGroupsManagerStatusSeconds = 0;" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAIConfig.h: StatusSeconds member not default 0" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${READ_LINE}" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAIConfig.cpp: StatusSeconds not read with default 0 and clamped with one error line" PARENT_SCOPE)
    return()
  endif()
  count_text("${config_cpp}" "\"AiPlayerbot.BotGroups.Manager.StatusSeconds\"" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAIConfig.cpp: StatusSeconds read ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${ECHO}" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAIConfig.cpp: the [ConfigEcho] entry is not right after BotGroups.Manager" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "\nAiPlayerbot\\.BotGroups\\.Manager\\.StatusSeconds = [^\n]*" lines "${conf_dist}")
  list(LENGTH lines n)
  if(NOT n EQUAL 1)
    set(${out} "conf.dist: AiPlayerbot.BotGroups.Manager.StatusSeconds documented ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  if(NOT lines STREQUAL "\nAiPlayerbot.BotGroups.Manager.StatusSeconds = 0")
    set(${out} "conf.dist: AiPlayerbot.BotGroups.Manager.StatusSeconds is not 0" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${conf_dist}" "\nAiPlayerbot.BotGroups.Manager = 0\n# A3-GERUEST-L60 7.2.11 (manager inbox): MEASUREMENT ONLY, default 0, no behaviour change." at)
  if(at EQUAL -1)
    set(${out} "conf.dist: the StatusSeconds block is not right after AiPlayerbot.BotGroups.Manager = 0 as measurement only" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "constexpr std::uint32_t kStatusSecondsMax = 3600;" "    if (raw <= 0)\n        return 0;")
    string(FIND "${policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "ManagerInboxPolicy.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) + (c) the status hook: one Post site, gated, in its place ------------------------------------------------------------
set(HOOK "        if (sPlayerbotAIConfig.botGroupsManagerStatusSeconds && ai::group_mgr::Applies(sPlayerbotAIConfig.botGroupsManager, bot->GetGUIDLow()))\n            PostManagerStatus();\n")
set(REACTION "    if(!UpdateAIReaction(elapsed, doMinimalReaction, bot->IsTaxiFlying()) && CanUpdateAIInternal())")
set(PROGRESS "        // A3 step 5 (ADR-0041, AiPlayerbot.CombatRule.ProgressGuard, default 0): one reading")
set(QB_K "        // A3 step 2 (ADR-0041, AiPlayerbot.QuestBook, default 0)")
set(SUP_GATE "            EnsureSupervisor()->Tick(WorldTimer::getMSTime(), ai::supervisor::ArbiterValue(sPlayerbotAIConfig.supervisorArbiter));")

function(check_hook ai_cpp ai_h all_sources out)
  count_text("${ai_cpp}" "${HOOK}" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAI.cpp: the status hook (gated on StatusSeconds and the manager's mode) found ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  count_text("${ai_cpp}" "PostManagerStatus();" n)
  if(NOT n EQUAL 1)
    set(${out} "PlayerbotAI.cpp: PostManagerStatus() called ${n} times (1 expected: the gated hook)" PARENT_SCOPE)
    return()
  endif()
  # In UpdateAI's engine pass: after the reaction gate, before the progress reading, the quest book block and the supervisor gate.
  region("${ai_cpp}" "void PlayerbotAI::UpdateAI(uint32 elapsed, bool minimal)\n{" "\n}\n" update)
  string(FIND "${update}" "${HOOK}" hook)
  string(FIND "${update}" "${REACTION}" reaction)
  string(FIND "${update}" "${PROGRESS}" progress)
  string(FIND "${update}" "${QB_K}" qbk)
  string(FIND "${update}" "${SUP_GATE}" gate)
  if(hook EQUAL -1 OR reaction EQUAL -1 OR progress EQUAL -1 OR qbk EQUAL -1 OR gate EQUAL -1)
    set(${out} "PlayerbotAI.cpp: UpdateAI lacks the hook, the reaction gate, the progress reading, the QB-K block or the supervisor gate" PARENT_SCOPE)
    return()
  endif()
  if(NOT hook GREATER reaction OR NOT hook LESS progress OR NOT progress LESS qbk OR NOT qbk LESS gate)
    set(${out} "PlayerbotAI.cpp: the status hook is not in the engine pass before the progress reading and the QB-K block" PARENT_SCOPE)
    return()
  endif()
  count_text("${all_sources}" "->Tick(" n)
  if(NOT n EQUAL 1)
    set(${out} "->Tick( appears ${n} times in the module (1 expected: the supervisor gate)" PARENT_SCOPE)
    return()
  endif()
  # The post itself: due by StatusDue, roster bot without a real player master, own values only. T30-0: the status, the edge (on
  # a change or with the status) and the wish (with the status) - all after the scope test, the status only when due.
  region("${ai_cpp}" "void PlayerbotAI::PostManagerStatus()\n{" "\n}\n" body)
  if(body STREQUAL "")
    set(${out} "PlayerbotAI.cpp: PostManagerStatus not defined" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "    if (!bot->IsInWorld())\n        return;"
      "    bool const due = ai::manager_inbox::StatusDue(managerStatusLastMs, nowMs, sPlayerbotAIConfig.botGroupsManagerStatusSeconds * 1000);"
      "    if (!due && !edgeChanged)\n        return;\n    if (!InQuestBookScope())\n        return;"
      "    if (due)\n    {\n        managerStatusLastMs = ai::manager_inbox::PostStamp(nowMs);"
      "        event.kind = ai::manager_inbox::Kind::Status;"
      "        event.role = 0;"
      "        ai::manager_inbox::Post(event);\n    }"
      "    ai::manager_inbox::Post(ai::manager_inbox::MakeEdge(bot->GetGUIDLow(), edge, x, y));\n    if (!due)\n        return;"
      "        ai::manager_inbox::Post(ai::manager_inbox::MakeWish(bot->GetGUIDLow(), managerStatusSeq, wish));\n}")
    string(FIND "${body}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "PostManagerStatus: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The scope test comes before any post.
  string(FIND "${body}" "    if (!InQuestBookScope())" scope)
  string(FIND "${body}" "manager_inbox::Post(" first_post)
  if(first_post EQUAL -1 OR NOT scope LESS first_post)
    set(${out} "PostManagerStatus: a post before the roster scope test" PARENT_SCOPE)
    return()
  endif()
  # The roster rule has one home (shared with the quest book): a roster bot without a real player master.
  string(FIND "${ai_cpp}" "bool PlayerbotAI::InQuestBookScope()\n{\n    return bot && sRandomPlayerbotMgr.IsPersistentRosterMember(bot->GetGUIDLow()) && !HasRealPlayerMaster();\n}" at)
  if(at EQUAL -1)
    set(${out} "PlayerbotAI.cpp: InQuestBookScope is no longer the roster rule (roster member, no real player master)" PARENT_SCOPE)
    return()
  endif()
  count_text("${all_sources}" "manager_inbox::Post(" n)
  count_text("${body}" "manager_inbox::Post(" nb)
  if(NOT n EQUAL 3 OR NOT nb EQUAL 3)
    set(${out} "manager_inbox::Post( called ${n} times in the module, ${nb} in PostManagerStatus (3 expected there: status, edge, wish)" PARENT_SCOPE)
    return()
  endif()
  foreach(needle "    uint32 managerStatusLastMs = 0;" "    uint32 managerStatusSeq = 0;" "    void PostManagerStatus();")
    string(FIND "${ai_h}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "PlayerbotAI.h: missing ${needle} (per-bot state lives on the bot)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) one Drain site: the manager pass ----------------------------------------------------------------------------------------
function(check_drain mgr_cpp inbox_cpp inbox_h policy all_sources out)
  count_text("${all_sources}" "manager_inbox::Drain(" n)
  count_text("${mgr_cpp}" "manager_inbox::Drain(inboxBuf_, manager_inbox::kDrainMaxPerPass);" m)
  if(NOT n EQUAL 1)
    set(${out} "manager_inbox::Drain( called ${n} times in the module (1 expected: GroupManager.cpp)" PARENT_SCOPE)
    return()
  endif()
  if(NOT m EQUAL 1)
    set(${out} "GroupManager.cpp: the drain is not bounded by kDrainMaxPerPass" PARENT_SCOPE)
    return()
  endif()
  # Inside the inbox files, Drain( only as the definition, the declaration and the ring's own member.
  set(code "${inbox_h}\n${inbox_cpp}\n${policy}")
  string(REPLACE "std::size_t Drain(std::vector<Event>& out, std::size_t max)" "" code "${code}")
  string(REPLACE "InboxRing().Drain(out, max)" "" code "${code}")
  string(REGEX MATCHALL "Drain\\(" calls "${code}")
  list(LENGTH calls nc)
  if(NOT nc EQUAL 0)
    set(${out} "ManagerInbox: ${nc} other Drain( call(s) in the inbox files" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "void WorldThreadManager::Update(std::map<std::uint32_t, Player*> const& bots, std::uint32_t /*now*/)\n{\n    ++passes_;\n    DrainInbox(bots, WorldTimer::getMSTime());\n}"
      "    bool const resumed = minuteStarted_ && manager_inbox::ResumedAfterGap(lastPassMs_, nowMs);\n    lastPassMs_ = nowMs;\n    if (resumed)\n    {\n        minuteStarted_ = false;\n        status_.clear();\n        edges_.clear();\n        wishes_.clear();\n    }"
      "        if (!resumed)\n            StoreEvent(event, nowMs);"
      "        case manager_inbox::Kind::Status:\n            status_[event.botLow] = manager_inbox::SnapshotOf(event, nowMs);"
      "        seen_ = manager_inbox::Read();\n        statusSeen_ = kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::Status)];\n        ackSeen_ = kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::DirectiveAck)];\n        edgeSeen_ = kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::GroupEdge)];\n        wishSeen_ = kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::GroupWish)];\n        return;"
      "        if (bots.find(it->first) == bots.end())\n            it = table.erase(it);"
      "    DropGone(status_, bots);\n    DropGone(edges_, bots);\n    DropGone(wishes_, bots);")
    string(FIND "${mgr_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupManager.cpp: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Map keys only: no Player* is dereferenced and no map value is read.
  foreach(bad "->second" ".second" "Player*>::" "bot->" "player->" "->Get" "->Is")
    string(FIND "${mgr_cpp}" "${bad}" at)
    if(NOT at EQUAL -1)
      set(${out} "GroupManager.cpp: reads beyond the map keys (${bad})" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (e) no supervisor postbox, no group write -------------------------------------------------------------------------------
function(check_isolation policy inbox_h inbox_cpp mgr_h mgr_cpp ai_cpp out)
  region("${ai_cpp}" "void PlayerbotAI::PostManagerStatus()\n{" "\n}\n" post_body)
  set(pair "${policy}\n${inbox_h}\n${inbox_cpp}\n${mgr_h}\n${mgr_cpp}\n${post_body}")
  string(REGEX MATCH "supervisor::(Post|Drain|Forget)|namespace (ai::)?supervisor" bad "${pair}")
  if(NOT bad STREQUAL "")
    set(${out} "the pair touches the supervisor's postbox: ${bad}" PARENT_SCOPE)
    return()
  endif()
  set(inbox "${policy}\n${inbox_h}\n${inbox_cpp}\n${post_body}")
  foreach(word "HandleGroup" "RemoveMember" "AddMember" "Group::Create" "->Create(" "Disband" "AddGroup" "RemoveGroup"
      "UninviteFromGroup" "ChangeLeader" "group_ops::" "GetGroup" "TeleportTo" "DoSpecificAction" "ChangeStrategy")
    string(FIND "${inbox}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "ManagerInbox / the status post must not use ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (f) the pure header and the event ---------------------------------------------------------------------------------------
function(check_pure policy out)
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" includes "${policy}")
  foreach(inc IN LISTS includes)
    if(NOT inc MATCHES "^#include <(array|cstddef|cstdint|cstdio|type_traits|vector)>$")
      set(${out} "ManagerInboxPolicy.h: not a pure include: ${inc}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(word "sPlayerbotAIConfig" "sObjectMgr" "sLog" "Player*" "Unit*" "ObjectGuid" "std::mutex" "std::atomic")
    string(FIND "${policy}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "ManagerInboxPolicy.h: names ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  region("${policy}" "struct Event\n{" "\n};\n" event)
  if(event STREQUAL "")
    set(${out} "ManagerInboxPolicy.h: struct Event not found" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "//[^\n]*" "" fields "${event}")
  string(FIND "${fields}" "*" at)
  string(FIND "${fields}" "&" amp)
  if(NOT at EQUAL -1 OR NOT amp EQUAL -1)
    set(${out} "ManagerInboxPolicy.h: Event holds a pointer or reference (by value only across threads)" PARENT_SCOPE)
    return()
  endif()
  foreach(needle
      "static_assert(sizeof(Event) == 32,"
      "static_assert(std::is_trivially_copyable<Event>::value,"
      "static_assert(std::is_standard_layout<Event>::value,"
      "enum class Kind : std::uint8_t\n{\n    QueueRequest,\n    DungeonWish,\n    GroupWish,\n    Status,\n    RepopEdge,\n    ReviveEdge,\n    RunEnded,\n    QueueLeave,\n    DirectiveAck,\n    GroupEdge,\n};"
      "constexpr std::size_t kKinds = std::size_t(Kind::GroupEdge) + 1;"
      "constexpr std::size_t kKindBuckets = kKinds + 1;"
      "    return i < kKinds ? i : kKinds;"
      "constexpr std::size_t Capacity = 4096;"
      "    if (periodMs == 0)\n        return false;\n    if (lastMs == 0)\n        return true;\n    return std::uint32_t(nowMs - lastMs) >= periodMs;")
    string(FIND "${policy}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "ManagerInboxPolicy.h: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (g) the minute line ----------------------------------------------------------------------------------------------------
function(check_minute policy inbox_h inbox_cpp mgr_h mgr_cpp all_sources out)
  # T30-0 appends its fields after snapshots= (the inbox pair's fields keep their place).
  string(FIND "${policy}" "\"[ManagerInbox] posted=%llu dropped=%llu drained=%llu status=%llu ack=%llu snapshots=%llu\"\n        \" edge=%llu wish=%llu key_overflow=%llu edges=%llu wishes=%llu stale_snap=%llu cand_busy=%llu cand_adhoc=%llu\"\n        \" cand_quest=%llu cand_zone_hold=%llu no_supervisor=%llu\"" at)
  if(at EQUAL -1)
    set(${out} "ManagerInboxPolicy.h: the [ManagerInbox] line format changed" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${inbox_cpp}" "    FormatMinuteLine(buf, sizeof(buf), minute);\n    sLog.outString(\"%s\", buf);" at)
  if(at EQUAL -1)
    set(${out} "ManagerInbox.cpp: LogMinute does not write the formatted line with sLog.outString" PARENT_SCOPE)
    return()
  endif()
  # Own tag: no evaluator or other module tag in the pair's files.
  string(REGEX MATCH "\\[(ArbiterMin|BotUpdate|BotUpdateCohort|Supervisor|GroupMgr|GroupOps|GroupWrite|ArbiterCtl)\\]" bad
    "${policy}\n${inbox_h}\n${inbox_cpp}\n${mgr_h}\n${mgr_cpp}")
  if(NOT bad STREQUAL "")
    set(${out} "the inbox or manager files use another tag: ${bad}" PARENT_SCOPE)
    return()
  endif()
  count_text("${all_sources}" "manager_inbox::LogMinute(" n)
  if(NOT n EQUAL 1)
    set(${out} "manager_inbox::LogMinute( called ${n} times in the module (1 expected: the manager's minute branch)" PARENT_SCOPE)
    return()
  endif()
  # Written only after the minute gate, with increments (TakeDelta) of every counter.
  foreach(needle
      "    if (std::uint32_t(nowMs - minuteStartMs_) < 60000)\n        return;"
      "    line.posted = manager_inbox::TakeDelta(totals.posted, seen_.posted);"
      "    line.dropped = manager_inbox::TakeDelta(totals.dropped, seen_.dropped);"
      "    line.drained = manager_inbox::TakeDelta(totals.drained, seen_.drained);"
      "    line.status = manager_inbox::TakeDelta("
      "    line.ack = manager_inbox::TakeDelta(kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::DirectiveAck)], ackSeen_);"
      "    line.edge = manager_inbox::TakeDelta(kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::GroupEdge)], edgeSeen_);"
      "    line.wish = manager_inbox::TakeDelta(kindTotals_[manager_inbox::KindIndex(manager_inbox::Kind::GroupWish)], wishSeen_);"
      "    line.keyOverflow = manager_inbox::TakeDelta(totals.keyOverflow, seen_.keyOverflow);"
      "    if (manager_inbox::MinuteLineDue(line))\n        manager_inbox::LogMinute(line);")
    string(FIND "${mgr_cpp}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "GroupManager.cpp: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # A silent minute (StatusSeconds 0, no ack) writes no line; kind totals have an "other" bucket.
  foreach(needle
      "    return m.posted || m.dropped || m.drained || m.status || m.ack || m.snapshots || m.edge || m.wish || m.keyOverflow ||\n        m.edges || m.wishes;"
