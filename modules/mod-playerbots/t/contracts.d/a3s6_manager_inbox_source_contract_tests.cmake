cmake_policy(VERSION 3.16)
# A3-GERUEST-L60 7.2.11 (OB-00 07.11.2026; owner standing approval 09.11.2026, plan A3-PLAN-ZIEL): the manager inbox, bots ->
# group manager. AiPlayerbot.BotGroups.Manager.StatusSeconds (0 = no posts, default; 1..3600, larger = 3600 + error line).
# Measurement only: the manager keeps the latest Status per bot and decides nothing. The opposite direction (the supervisor's
# postbox, manager -> bot) belongs to another pair and is not wired here. This contract pins:
#   (a) the switch: member default 0, read with default 0 and clamped, echoed right after BotGroups.Manager, documented = 0
#       right after AiPlayerbot.BotGroups.Manager = 0 as measurement only;
#   (b) one Post site: PlayerbotAI::PostManagerStatus (the status hook), gated in UpdateAI on StatusSeconds and the manager's
#       mode/cohort, due by StatusDue, roster bot without a real player master;
#   (c) the hook's place: in the engine pass of UpdateAI, after the reaction gate, before the progress reading, the quest book
#       block (QB-K) and the supervisor gate; no new ->Tick(;
#   (d) one Drain site: GroupManager.cpp, bounded by kDrainMaxPerPass; the manager reads only the map keys of its bots;
#   (e) the supervisor's postbox is neither defined nor called by this pair; no group write API in the inbox or manager files;
#   (f) the pure header: no game header, no config, no lock; Event is 32 bytes without a pointer;
#   (g) the minute line: own tag [ManagerInbox], increments, written only from the manager's minute branch and never for a
#       silent minute (StatusSeconds 0, no ack); a stale window/table after an off gap is started over;
#   (h) the unit test is registered;
#   (i) DirectiveAck (addendum 09.11., agreed with CLI-Projekt): appended to Kind, PostDirectiveAck posts it through the inbox's
#       own Post, counted as ack=<inc>; no caller in this pair. Post sites = the status hook + PostDirectiveAck.
# T30-0 (design T30 v1.1, Fakten + Op-Weg) extends this pair, measurement only: GroupEdge appended to Kind; the status hook's
# PostManagerStatus posts Status (flags + objective key), GroupEdge (on a change, compared each engine pass, and with every
# status) and GroupWish (with the status) - three Post sites, all in PostManagerStatus behind the same gate; the manager keeps the
# latest status, edge and wish per bot and appends edge/wish/key_overflow increments and table/shadow stands to its line.
# The T30-0 specifics (facts read from the bot only, op path without caller, Run* bodies unchanged) are pinned by
# a3s6_t30_facts_source_contract_tests.cmake.
# Pure rules: t/manager_inbox_policy_tests.cpp. Every check_* returns "" when it holds, else the reason; the negative probes at
# the end reuse them on mutated text.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "a3s6 manager inbox: PB_SOURCE_DIR is required")
endif()
if(NOT DEFINED PB_MODULE_DIR)
  message(FATAL_ERROR "a3s6 manager inbox: PB_MODULE_DIR is required")
endif()

set(TAG "a3s6 manager inbox")

function(read_source path out_var)
  if(NOT EXISTS "${PB_SOURCE_DIR}/${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

function(expect_caught what reason)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
endfunction()

# A probe must be caught by the check it aims at, not by a needle it broke on the way.
function(expect_reason what reason pattern)
  if("${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what}")
  endif()
  if(NOT "${reason}" MATCHES "${pattern}")
    message(FATAL_ERROR "${TAG}: negative probe ${what} caught by another check: ${reason}")
  endif()
endfunction()

function(count_text text needle out)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nl)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR at "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${at} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# The text from the first `start` up to and including the first `stop` after it ("" when start or stop is missing).
function(region text start stop out)
  set(${out} "" PARENT_SCOPE)
  string(FIND "${text}" "${start}" at)
  if(at EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "${stop}" end)
  if(end EQUAL -1)
    return()
  endif()
  string(LENGTH "${stop}" sl)
  math(EXPR end "${end} + ${sl}")
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

