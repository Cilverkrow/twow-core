function(check_unit tests_cmake unit_test out)
  foreach(needle "add_executable(manager_inbox_policy_tests" "add_test(NAME manager_inbox_policy\n  COMMAND manager_inbox_policy_tests")
    string(FIND "${tests_cmake}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "tests.cmake: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(needle "    TestFifo();" "    TestFull();" "    TestDrainMax();" "    TestCounters();" "    TestStatusDue();" "    TestPerMille();"
      "    TestLayout();" "    TestMinuteDue();" "    TestSnapshotAndLine();" "    TestFlagsAndKey();" "    TestEdgeAndWish();"
      "    TestShadow();" "    TestT30MinuteDue();")
    string(FIND "${unit_test}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "t/manager_inbox_policy_tests.cpp: missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

