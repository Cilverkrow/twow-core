# ---- (a) the key ---------------------------------------------------------------------------------------------------------------
set(LOAD "    botGroupsManagerGatherLever = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.Manager.Gather.Lever\", 0));\n    if (!ai::group_mgr::GatherLeverValid(botGroupsManagerGatherLever))\n    {\n        sLog.outError(\"[GroupMgr] config key=Manager.Gather.Lever value=%d result=0 (0 off, 1 on)\", int32(botGroupsManagerGatherLever));\n        botGroupsManagerGatherLever = 0;\n    }\n    if (botGroupsManagerGatherLever && !botGroupsManagerGather)\n    {\n        sLog.outError(\"[GroupMgr] config key=Manager.Gather.Lever value=%u result=0 (needs Manager.Gather > 0)\",\n            botGroupsManagerGatherLever);\n        botGroupsManagerGatherLever = ai::group_mgr::EffectiveGatherLever(botGroupsManagerGatherLever, botGroupsManagerGather);\n    }")
set(ECHO "            {\"BotGroups.Manager.Gather\", Value(botGroupsManagerGather)},\n            {\"BotGroups.Manager.Gather.Lever\", Value(botGroupsManagerGatherLever)},\n            {\"BotGroups.Manager.StatusSeconds\"")

function(check_key config_h config_cpp conf_dist out)
  count_text("${config_h}" "    uint32 botGroupsManagerGatherLever = 0;" n)
  if(NOT n EQUAL 1)
    set(${out} "key: PlayerbotAIConfig.h member not default 0 (${n})" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${LOAD}" at)
  if(at EQUAL -1)
    set(${out} "key: not read with default 0, unknown value and Gather 0 off with one error line each" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "    botGroupsManagerGather = uint32(config.GetIntDefault(\"AiPlayerbot.BotGroups.Manager.Gather\", 0));" g)
  if(g EQUAL -1 OR NOT g LESS at)
    set(${out} "key: Lever not read after Gather" PARENT_SCOPE)
    return()
  endif()
  count_text("${config_cpp}" "\"AiPlayerbot.BotGroups.Manager.Gather.Lever\"" n)
  if(NOT n EQUAL 1)
    set(${out} "key: read ${n} times (1 expected)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${config_cpp}" "${ECHO}" at)
  count_text("${config_cpp}" "{\"BotGroups.Manager.Gather.Lever\"" n)
  if(at EQUAL -1 OR NOT n EQUAL 1)
    set(${out} "key: the [ConfigEcho] entry is not once right after BotGroups.Manager.Gather" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "\nAiPlayerbot\\.BotGroups\\.Manager\\.Gather\\.Lever = [^\n]*" lines "${conf_dist}")
  if(NOT lines STREQUAL "\nAiPlayerbot.BotGroups.Manager.Gather.Lever = 0")
    set(${out} "key: conf.dist does not document Gather.Lever = 0 once" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${conf_dist}" "The lever acts ONLY with Lever = 1; Gather stays the measurement switch and the arm: Gather != 0 with Lever = 0 is the\n# shadow above alone, no behaviour change." at)
  if(at EQUAL -1)
    set(${out} "key: conf.dist does not say the lever acts only with Lever = 1" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (b) the pure rules ---------------------------------------------------------------------------------------------------------
set(VALID "inline bool GatherLeverValid(std::uint32_t raw)\n{\n    return raw <= 1u;\n}")
set(EFFECTIVE "inline std::uint32_t EffectiveGatherLever(std::uint32_t lever, std::uint32_t gather)\n{\n    return gather && lever == 1u ? 1u : 0u;\n}")
set(APPLIES "inline bool GatherApplies(std::uint32_t gather, std::uint32_t lever, GroupType type, std::uint32_t leaderLow)\n{\n    return EffectiveGatherLever(lever, gather) && type == GroupType::Quest && GatherArm(gather, leaderLow);\n}")
set(FOLLOW "constexpr std::uint8_t kGatherKindFollow = 0;")
set(RUNG "inline Fallback NextRung(Fallback current, RungFacts const& f)\n{\n    Fallback const next = NextFallback(current, false, false);\n    if (next == Fallback::Hearthstone && !(f.hearthOn && f.hearthUseful))\n        return Fallback::Dissolve;\n    return next;\n}")

function(check_pure gather_h mpol dpol mgr_cpp out)
  foreach(var VALID EFFECTIVE APPLIES FOLLOW)
    string(FIND "${gather_h}" "${${var}}" at)
    if(at EQUAL -1)
      set(${out} "pure: GroupGatherPolicy.h missing ${${var}}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${mpol}" "${RUNG}" at)
  if(at EQUAL -1)
    set(${out} "pure: GroupManagerPolicy.h NextRung is not walk -> dissolve (hearthstone only when on and useful)" PARENT_SCOPE)
    return()
  endif()
  count_text("${mpol}" "NextFallback(" n)
  count_text("${dpol}\n${mgr_cpp}" "NextFallback(" m)
  count_text("${dpol}" "NextRung(" k)
  if(NOT n EQUAL 2 OR NOT m EQUAL 0 OR NOT k EQUAL 1)
    set(${out} "pure: NextFallback( ${n} in GroupManagerPolicy.h (2: definition, NextRung), ${m} in the engine/manager (0), NextRung( ${k} in the engine (1)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (c) the engine -------------------------------------------------------------------------------------------------------------
set(ENTER "        d.serial = std::uint16_t(g.serial);\n        // T33-1 (3.1, F1 (a)): a meeting group's Enter carries b15 = 1, kind a (follow); without the lever byte-equal to T30.\n        if (g.meetLever)\n        {\n            d.gatherFlag = true;\n            d.gatherKind = kGatherKindFollow;\n        }\n        std::uint32_t const seq = NextSeq();")
set(CREATE "        g.meetLever = GatherApplies(gatherNow_, leverNow_, type, leader.low);")
set(DECIDE "        if (g.meetLever)\n            MeetVerdict(g, in, f, io);\n        quest_groups::Step const s = quest_groups::Decide(g.meetOpen ? MaskRendezvous(f) : f, r.timers);")
set(MASK "inline quest_groups::GroupFacts MaskRendezvous(quest_groups::GroupFacts f)\n{\n    f.phaseSince = f.now;\n    return f;\n}")
set(DEADLINE "        if (g.meetOpen && !in.resumed && LegExpired(mgrMs_, leg) && NextRung(Fallback::Walk, RungFacts()) == Fallback::Dissolve)\n        {\n            ++lever_.endTimeout;\n            EndGroup(g, EndReason::RendezvousTimeout, io);\n        }")
set(HOLD "                if (g.meetOpen)\n                {\n                    lever_.joinHeld += m.joinHeld ? 0 : 1;\n                    m.joinHeld = true;\n                    continue;\n                }\n                // QUEST join n+1 only with the confirmed core id (M8)")

function(check_engine dpol out)
  foreach(var ENTER CREATE DECIDE MASK DEADLINE HOLD)
    string(FIND "${dpol}" "${${var}}" at)
    if(at EQUAL -1)
      set(${out} "engine: GroupDirectivePolicy.h missing ${var}: ${${var}}" PARENT_SCOPE)
      return()
    endif()
    set(at_${var} ${at})
  endforeach()
  if(NOT at_DECIDE LESS at_DEADLINE)
    set(${out} "engine: the meeting deadline is not after Decide" PARENT_SCOPE)
    return()
  endif()
  foreach(pair "g.meetLever = GatherApplies(@1" "g.meetLever = true@0" "d.gatherFlag = true;@1" "d.gatherKind = kGatherKind@1" "MaskRendezvous(@2" "Arrived(@0" "ArrivedForGroup(@1"
      "Fallback::Hearthstone@0" "TeleportTo@0" "MotionMaster@0")
    string(FIND "${pair}" "@" cut)
    string(SUBSTRING "${pair}" 0 ${cut} needle)
    math(EXPR cut "${cut} + 1")
    string(SUBSTRING "${pair}" ${cut} -1 want)
    count_text("${dpol}" "${needle}" n)
    if(NOT n EQUAL want)
      set(${out} "engine: ${needle} appears ${n} times in GroupDirectivePolicy.h (${want} expected)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) the unit tests ---------------------------------------------------------------------------------------------------------
function(check_unit tests_cmake dtest gtest out)
  foreach(needle "add_executable(group_directive_policy_tests" "add_executable(group_gather_policy_tests")
    string(FIND "${tests_cmake}" "${needle}" at)
    if(at EQUAL -1)
      set(${out} "unit: tests.cmake missing ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(t TestGatherLeverPure TestGatherLeverEnter TestGatherLeverShadowOnly TestGatherLeverMeeting TestGatherLeverLateMembers
      TestGatherLeverSwitchOffResume)
    count_text("${dtest}" "${t}()" n)
    if(NOT n EQUAL 2)
      set(${out} "unit: ${t} defined and run ${n} times in group_directive_policy_tests.cpp (2 expected)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  count_text("${gtest}" "TestMinute3MaxFits()" n)
  if(NOT n EQUAL 2)
    set(${out} "unit: TestMinute3MaxFits defined and run ${n} times (2 expected)" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

