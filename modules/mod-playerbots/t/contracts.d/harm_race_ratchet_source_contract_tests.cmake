cmake_policy(VERSION 3.16)
# twow-repo#563 HARM-RACE ratchet (E3 item 3, OB-00 order 11.11.2026; OB-60). The class "a bot reads or writes ANOTHER player's state from its own
# thread" was fixed site by site (#697, #707, #710, the guard pair #1030/#1031). This contract keeps it from coming back: it COUNTS, per source
# file, the access shapes that touch another player, and the counts must equal the baseline `harm_race_ratchet_baseline.txt` next to it.
#   - a count that GROWS (a new site) fails: the author must add a same-Map-object guard (SameMapObject / GetBotAIOnMapOf, or IsSafe with the
#     instance id, which is region-correct) and then raise the baseline in the same PR, so a reviewer sees every new foreign access;
#   - a count that SHRINKS fails too (tight both ways): lower the baseline, so the ratchet only ever tightens and a deleted site cannot be
#     replaced silently by a new one in the same file.
# Counted shapes (a match is a "site"; guarded sites are counted as well - the baseline is the inventory, not a list of defects):
#   mapid   `X->GetMapId() ==/!= Y->GetMapId()` comparing two objects by map id only (a continent region is its own Map object)
#   botai   `GetBotAI(arg)->` with an argument other than `bot` (a dereference of another bot's AI)
#   pai     PAI_VALUE / PAI_VALUE2 / SET_PAI_VALUE / SET_PAI_VALUE2 / PHAS_AI_VALUE / PHAS_AI_VALUE2 / MAI_VALUE / MAI_VALUE2 uses (they operate on
#           the variable `player` / `master` = another player)
#   quest   `X->getQuestStatusMap()` with a receiver other than `bot`
#   trade   `X->GetTradeData()` with a receiver other than `bot`
# Update the baseline after a reviewed change with:
#   cmake -DPB_SOURCE_DIR=<src/playerbot> -DPB_MODULE_DIR=<modules/mod-playerbots> -DHARM_RATCHET_UPDATE=ON -P <this file>
# Out of scope (named): mod-dungeon-clear (instance maps: one Map object per instance), the world-hook managers (tick barrier, twow-repo#708).

set(TAG "HARM-RACE ratchet (#563)")

if(NOT DEFINED PB_SOURCE_DIR OR NOT DEFINED PB_MODULE_DIR)
  message(FATAL_ERROR "${TAG}: PB_SOURCE_DIR and PB_MODULE_DIR are required")
endif()

set(BASELINE_FILE "${PB_MODULE_DIR}/t/contracts.d/harm_race_ratchet_baseline.txt")
set(SHAPES mapid botai pai quest trade)

# count one shape in a text (the same function runs on the real files and on the probe texts)
function(count_shape out text shape)
  set(n 0)
  if(shape STREQUAL "mapid")
    if(text MATCHES "GetMapId\\(\\)")
      string(REGEX MATCHALL "[A-Za-z_]+(->|\\.)GetMapId\\(\\) *[!=]= *[A-Za-z_]+(->|\\.)GetMapId\\(\\)" m "${text}")
      list(LENGTH m n)
    endif()
  elseif(shape STREQUAL "botai")
    if(text MATCHES "GetBotAI\\(")
      string(REGEX MATCHALL "GetBotAI\\([^()]*\\) *->" m "${text}")
      foreach(call ${m})
        string(REGEX REPLACE "GetBotAI\\(([^()]*)\\) *->" "\\1" arg "${call}")
        string(STRIP "${arg}" arg)
        if(NOT arg STREQUAL "bot")
          math(EXPR n "${n} + 1")
        endif()
      endforeach()
    endif()
  elseif(shape STREQUAL "pai")
    if(text MATCHES "AI_VALUE")
      string(REGEX MATCHALL "(PAI_VALUE2?|SET_PAI_VALUE2?|PHAS_AI_VALUE2?|MAI_VALUE2?)\\(" m "${text}")
      list(LENGTH m n)
    endif()
  elseif(shape STREQUAL "quest")
    if(text MATCHES "getQuestStatusMap\\(\\)")
      string(REGEX MATCHALL "[A-Za-z_]+->getQuestStatusMap\\(\\)" m "${text}")
      foreach(call ${m})
        if(NOT call STREQUAL "bot->getQuestStatusMap()")
          math(EXPR n "${n} + 1")
        endif()
      endforeach()
    endif()
  elseif(shape STREQUAL "trade")
    if(text MATCHES "GetTradeData\\(\\)")
      string(REGEX MATCHALL "[A-Za-z_]+->GetTradeData\\(\\)" m "${text}")
      foreach(call ${m})
        if(NOT call STREQUAL "bot->GetTradeData()")
          math(EXPR n "${n} + 1")
        endif()
      endforeach()
    endif()
  else()
    message(FATAL_ERROR "${TAG}: unknown shape ${shape}")
  endif()
  set(${out} "${n}" PARENT_SCOPE)
endfunction()

# "a,b,c,d,e" for one text
function(count_all out text)
  set(parts "")
  foreach(shape ${SHAPES})
    count_shape(n "${text}" "${shape}")
    list(APPEND parts "${n}")
  endforeach()
  string(REPLACE ";" "," joined "${parts}")
  set(${out} "${joined}" PARENT_SCOPE)
endfunction()

# the actual table: lines "relative/path|a,b,c,d,e" for every file with a non-zero count
function(scan_sources out)
  file(GLOB_RECURSE all_src RELATIVE "${PB_SOURCE_DIR}" "${PB_SOURCE_DIR}/*.cpp" "${PB_SOURCE_DIR}/*.h")
  list(SORT all_src)
  set(rows "")
  foreach(rel ${all_src})
    file(READ "${PB_SOURCE_DIR}/${rel}" text)
    string(REPLACE "\r" "" text "${text}")
    count_all(counts "${text}")
    if(NOT counts STREQUAL "0,0,0,0,0")
      list(APPEND rows "${rel}|${counts}")
    endif()
  endforeach()
  set(${out} "${rows}" PARENT_SCOPE)
endfunction()

# compare two tables (each a list of "path|a,b,c,d,e"); returns the violations
function(compare_tables errors_var actual baseline)
  set(errors "")
  set(seen "")
  foreach(row ${actual})
    string(REPLACE "|" ";" kv "${row}")
    list(GET kv 0 path)
    list(GET kv 1 counts)
    list(APPEND seen "${path}")
    set(expected "")
    foreach(brow ${baseline})
      string(REPLACE "|" ";" bkv "${brow}")
      list(GET bkv 0 bpath)
      if(bpath STREQUAL path)
        list(GET bkv 1 expected)
      endif()
    endforeach()
    if(expected STREQUAL "")
      list(APPEND errors "${path}: NEW foreign-access sites ${counts} (shapes ${SHAPES}) and the file is not in the baseline")
    elseif(NOT expected STREQUAL counts)
      list(APPEND errors "${path}: counts ${counts} differ from the baseline ${expected} (shapes ${SHAPES}); a new site needs a guard and a baseline raise, a removed site a baseline cut")
    endif()
  endforeach()
  foreach(brow ${baseline})
    string(REPLACE "|" ";" bkv "${brow}")
    list(GET bkv 0 bpath)
    list(FIND seen "${bpath}" at)
    if(at EQUAL -1)
      list(APPEND errors "${bpath}: in the baseline but no longer has any foreign-access site (or was removed): cut the baseline")
    endif()
  endforeach()
  set(${errors_var} "${errors}" PARENT_SCOPE)
endfunction()

scan_sources(actual_rows)

if(HARM_RATCHET_UPDATE)
  string(REPLACE ";" "\n" body "${actual_rows}")
  file(WRITE "${BASELINE_FILE}" "# HARM-RACE ratchet baseline (harm_race_ratchet_source_contract_tests.cmake): per file, counts of the shapes ${SHAPES}\n# generated with -DHARM_RATCHET_UPDATE=ON; change only in a reviewed PR\n${body}\n")
  list(LENGTH actual_rows n_rows)
  message(STATUS "${TAG}: baseline written (${n_rows} files)")
  return()
endif()

if(NOT EXISTS "${BASELINE_FILE}")
  message(FATAL_ERROR "${TAG}: missing baseline ${BASELINE_FILE}")
endif()
file(STRINGS "${BASELINE_FILE}" baseline_lines)
set(baseline_rows "")
foreach(line ${baseline_lines})
  if(NOT line MATCHES "^#" AND NOT line STREQUAL "")
    list(APPEND baseline_rows "${line}")
  endif()
endforeach()

compare_tables(real_errors "${actual_rows}" "${baseline_rows}")
if(real_errors)
  string(REPLACE ";" "\n  - " listed "${real_errors}")
  message(FATAL_ERROR "${TAG}:\n  - ${listed}")
endif()

# ---- negative probes (the comparison and the counters must see each case) ----
function(expect_rejected name errs)
  if(NOT errs)
    message(FATAL_ERROR "${TAG}: negative probe '${name}' was accepted - the ratchet no longer sees it")
  endif()
endfunction()

# 1. the counters see each shape on a synthetic text
count_all(c_map "if (player->GetMapId() != bot->GetMapId()) continue;")
count_all(c_ai "GetBotAI(member)->Reset(); GetBotAI(bot)->Reset();")
count_all(c_pai "x = PAI_VALUE(int, \"a\"); SET_PAI_VALUE2(int, \"b\", \"c\", 1);")
count_all(c_quest "player->getQuestStatusMap().find(1); bot->getQuestStatusMap().find(2);")
count_all(c_trade "trader->GetTradeData()->GetMoney(); bot->GetTradeData();")
if(NOT c_map STREQUAL "1,0,0,0,0" OR NOT c_ai STREQUAL "0,1,0,0,0" OR NOT c_pai STREQUAL "0,0,2,0,0" OR NOT c_quest STREQUAL "0,0,0,1,0" OR NOT c_trade STREQUAL "0,0,0,0,1")
  message(FATAL_ERROR "${TAG}: probe 1: counters off: ${c_map} ${c_ai} ${c_pai} ${c_quest} ${c_trade}")
endif()

# 2. a NEW site in an existing file (one more map-id-only compare) is rejected
list(GET baseline_rows 0 first_row)
string(REPLACE "|" ";" first_kv "${first_row}")
list(GET first_kv 0 first_path)
list(GET first_kv 1 first_counts)
string(REPLACE "," ";" fc "${first_counts}")
list(GET fc 0 fc_mapid)
math(EXPR fc_mapid_up "${fc_mapid} + 1")
list(REMOVE_AT fc 0)
string(REPLACE ";" "," fc_rest "${fc}")
set(probe_actual "${first_path}|${fc_mapid_up},${fc_rest}")
list(LENGTH actual_rows n_actual)
set(probe_rows "${probe_actual}")
foreach(row ${actual_rows})
  string(FIND "${row}" "${first_path}|" same)
  if(NOT same EQUAL 0)
    list(APPEND probe_rows "${row}")
  endif()
endforeach()
compare_tables(e2 "${probe_rows}" "${baseline_rows}")
expect_rejected("one more map-id-only compare in an existing file" "${e2}")

# 3. a NEW file with a foreign access that is not in the baseline is rejected
set(probe_rows3 "${actual_rows}")
list(APPEND probe_rows3 "strategy/actions/BrandNewAction.cpp|0,1,0,0,0")
compare_tables(e3 "${probe_rows3}" "${baseline_rows}")
expect_rejected("a new file with a foreign GetBotAI deref" "${e3}")

# 4. tight both ways: a removed site (the baseline is higher than the actual count) is rejected
set(probe_base4 "${baseline_rows}")
list(APPEND probe_base4 "strategy/actions/GoneAction.cpp|1,0,0,0,0")
compare_tables(e4 "${actual_rows}" "${probe_base4}")
expect_rejected("a baseline row for a file that has no site any more" "${e4}")

# 5. a changed count on an existing row (one fewer than the baseline) is rejected
set(probe_rows5 "")
set(done5 OFF)
foreach(row ${actual_rows})
  if(NOT done5)
    string(REPLACE "|" ";" kv "${row}")
    list(GET kv 0 p5)
    set(probe_rows5 "${p5}|9,9,9,9,9")
    set(done5 ON)
  else()
    list(APPEND probe_rows5 "${row}")
  endif()
endforeach()
compare_tables(e5 "${probe_rows5}" "${baseline_rows}")
expect_rejected("a changed count against the baseline" "${e5}")

list(LENGTH baseline_rows n_base)
message(STATUS "${TAG} contract passed (${n_base} files in the baseline)")
