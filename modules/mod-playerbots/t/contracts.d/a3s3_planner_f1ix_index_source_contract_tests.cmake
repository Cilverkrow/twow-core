# ---- (a) the policy: pure, one bucket function for box and query ------------------------------------------------------------
function(check_a policy_h out)
  foreach(word "Player*" "Player&" "WorldPosition" "sLog" "#include \"playerbot/" "TravelDestination" "sTravelMgr")
    string(FIND "${policy_h}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "GiverIndexPolicy.h: names '${word}' (pure, no game type)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(bucket "    float const t = (v + kHalf) / cell;\n    if (!(t >= 0.0f))\n        return 0;\n    if (t >= float(kCells))\n        return kCells - 1;\n    return int(t);\n")
  set(box "    return Range{ Bucket(minX - kEps, cell), Bucket(maxX + kEps, cell), Bucket(minY - kEps, cell), Bucket(maxY + kEps, cell) };\n")
  set(query "    return Range{ Bucket(x - r - kEps, cell), Bucket(x + r + kEps, cell), Bucket(y - r - kEps, cell), Bucket(y + r + kEps, cell) };\n")
  set(eps "constexpr float kEps = 1.0f;")
  set(wide "            if (!finite || span == 0 || span > kWideSpan)\n")
  set(wrap "        if (++gen_ == 0)\n        {\n            std::fill(mark_.begin(), mark_.end(), 0u);\n            gen_ = 1;\n        }\n")
  set(take "        if (ord >= mark_.size() || mark_[ord] == gen_)\n            return false;\n")
  check_times("${policy_h}" "GiverIndexPolicy.h" 1 r bucket box query eps wide wrap take)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (b) the box: the getters sqOutDistance clamps with -----------------------------------------------------------------------
function(check_b square_h out)
  set(lo "        WorldPosition BoxMin() const { return GetMin(); }\n")
  set(hi "        WorldPosition BoxMax() const { return GetMax(); }\n")
  set(call "                WorldPosition const lo = sq.BoxMin();\n                WorldPosition const hi = sq.BoxMax();\n                f(sq.GetMapId(), lo.getX(), lo.getY(), hi.getX(), hi.getY());\n")
  set(clamp "            float sqX = std::min(std::max(min.getX(), point.getX()), max.getX());\n            float sqY = std::min(std::max(min.getY(), point.getY()), max.getY());\n")
  set(getmin "        WorldPosition GetMin() const { return min; }\n        WorldPosition GetMax() const { return max; }\n")
  check_times("${square_h}" "WorldSquare.h" 1 r lo hi call clamp getmin)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# ---- (c) TravelMgr --------------------------------------------------------------------------------------------------------------
function(check_c travel_h travel_cpp out)
  set(decl "\textern thread_local giver_index::Counts* tDestGiverIndex;\n")
  check_times("${travel_h}" "TravelMgr.h" 1 r decl)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(def "thread_local ai::giver_index::Counts* ai::tDestGiverIndex = nullptr;\n")
  set(cond "    giver_index::Counts* const indexCounts = (tDestGiverIndex && purposeFlag == (uint32)TravelDestinationPurpose::QuestGiver &&\n        entries.empty() && !onlyPossible && maxDistance > 0) ? tDestGiverIndex : nullptr;\n")
  set(path "        if (GiverIndexCandidates(center, maxDistance, *indexCounts, portalCache, cand))\n")
  set(append "            appendDestinations(cand);\n")
  set(ret "            if (fetchStats)\n                fetchStats->ret += uint32(retDests.size());\n            return retDests;\n")
  set(build "    if (sPlayerbotAIConfig.plannerGiverIndex)\n        BuildGiverIndex();\n")
  set(reset "    giverIndex.reset();   // S5 F1-IX: the index points at the destinations deleted below\n")
  set(skip "            if (giver_prefilter::Excludes(transferSq, maxDistance))\n                continue;\n")
  set(home "    uint32 const homeBuckets = ix.grid.Collect(homeMap, cx, cy, maxDistance, take);\n")
  set(away "            counts.buckets += ix.grid.Collect(mapId, px, py, maxDistance, take);\n")
  set(stamp "    stamp.Begin(ix.order.size());\n")
  check_times("${travel_cpp}" "TravelMgr.cpp" 1 r def cond path append ret build reset skip home away stamp)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # the index path comes before the outer walk loop; the build after the last destination writer of the load
  set(loop "    for (auto& [purpose, entryDests] : destinationMap)\n    {\n\n")
  check_order("${travel_cpp}" "TravelMgr.cpp" cond loop r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(direct "    LoadDirectTargets(guidpMap);\n")
  check_order("${travel_cpp}" "TravelMgr.cpp" direct build r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(ladder "    ai::quest_band::LoadLadder();\n")
  check_order("${travel_cpp}" "TravelMgr.cpp" build ladder r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # B2: in the candidate function the built check and the stale check come before the stamp and any order[] read but the guard's
  set(fn "bool TravelMgr::GiverIndexCandidates(")
  cut_body("${travel_cpp}" fn body)
  if("${body}" STREQUAL "")
    set(${out} "TravelMgr.cpp: GiverIndexCandidates body not found" PARENT_SCOPE)
    return()
  endif()
  set(built "    if (!giverIndex)\n    {\n        counts.miss = true;\n        return false;\n    }\n")
  set(stale "        counts.stale = true;\n        return false;\n")
  set(bucketcount "givers->second.bucket_count() != ix.buckets")
  set(first "givers->second.begin()->second.front() != ix.order.front()")
  check_times("${body}" "GiverIndexCandidates" 1 r built stale bucketcount first stamp)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  check_order("${body}" "GiverIndexCandidates" built stale r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  check_order("${body}" "GiverIndexCandidates" stale stamp r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(ordread "ix.order[ord]")
  check_order("${body}" "GiverIndexCandidates" stamp ordread r)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  # B1: the radius is the call's: no literal yard radius in the index code
  foreach(word "1500" "kPickupRadius")
    string(FIND "${body}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out} "GiverIndexCandidates: names '${word}' (the radius is the call's maxDistance, OB-10 B1)" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # the giver destinations are created in LoadQuestTravelTable only (the index is built once from them)
  set(add "AddDestination<QuestRelationTravelDestination>(")
  check_times("${travel_cpp}" "TravelMgr.cpp QuestGiver writer" 1 r add)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

# no source file but TravelMgr.h / TravelMgr.cpp / PlannerShadow.cpp names the switch; the giver destination type is created
# nowhere else
function(check_c_only out)
  file(GLOB_RECURSE srcs "${PB_SOURCE_DIR}/*.cpp" "${PB_SOURCE_DIR}/*.h")
  foreach(f IN LISTS srcs)
    get_filename_component(name "${f}" NAME)
    file(READ "${f}" t)
    if(NOT (name STREQUAL "TravelMgr.h" OR name STREQUAL "TravelMgr.cpp" OR name STREQUAL "PlannerShadow.cpp"))
      string(FIND "${t}" "tDestGiverIndex" at)
      if(NOT at EQUAL -1)
        set(${out} "${name}: names tDestGiverIndex (only the planner's giver fetch sets the switch)" PARENT_SCOPE)
        return()
      endif()
    endif()
    if(NOT name STREQUAL "TravelMgr.cpp")
      string(FIND "${t}" "AddDestination<QuestRelationTravelDestination>" at)
      if(NOT at EQUAL -1)
        set(${out} "${name}: creates giver destinations outside LoadQuestTravelTable (the index would go stale)" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# ---- (d) PlannerShadow ---------------------------------------------------------------------------------------------------------
function(check_d shadow_cpp out)
  set(ctor "    explicit IndexScope(ai::giver_index::Counts* counts) { ai::tDestGiverIndex = counts; }\n")
  set(dtor "    ~IndexScope() { ai::tDestGiverIndex = nullptr; }\n")
  set(endf "    void End() const { ai::tDestGiverIndex = nullptr; }\n")
  set(on "        ixOn = ai::cohort::Applies(sPlayerbotAIConfig.plannerGiverIndex, guid);\n        ixCounts.timed = timeTrace;\n        IndexScope const ixScope(ixOn ? &ixCounts : nullptr);\n        PrefilterScope const prefilterScope(prefilterOn || ixOn ? &prefilterCounts : nullptr);\n")
  set(close "        giveScope.End();\n        prefilterScope.End();\n        ixScope.End();\n")
  set(verify "    if (ixVerify)\n    {\n        std::vector<ai::TravelDestination*> const original = sTravelMgr.GetDestinations(info,\n            std::uint32_t(ai::TravelDestinationPurpose::QuestGiver), {}, false, kPickupRadius);\n")
  set(place "        sLog.outBasic(\"%s\", xbuf);\n    }\n    c.msMax = ms;\n")
  set(due "        ixVerify = ixOn && ixCounts.used && IndexVerifyDue(sPlayerbotAIConfig.plannerGiverIndexVerify);\n")
  # the [PlanTime] ixv= flag is the verify decision of the same plan (the readout's line check pairs it with the [PlanIndex] line)
  set(flag "        planTime.giveIxVerify = ixVerify;\n")
  check_times("${shadow_cpp}" "PlannerShadow.cpp" 1 r ctor dtor endf on close verify place due flag)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(w "ai::tDestGiverIndex = ")
  check_times("${shadow_cpp}" "PlannerShadow.cpp switch writes" 3 r w)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(scopes "IndexScope const ")
  check_times("${shadow_cpp}" "PlannerShadow.cpp index scopes" 1 r scopes)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(msread "    std::uint32_t const ms = WorldTimer::getMSTimeDiffToNow(startMs);\n")
  check_order("${shadow_cpp}" "PlannerShadow.cpp" msread verify r)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

