  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  set(suffix "    if (t.giveIx && len + 1 < n)\n")
  set(fmt "\" ix=1 give_ixall=%u give_ixmaps=%u give_ixportals=%u give_ixbuckets=%u \"\n            \"give_ixwide=%u give_ixt=%u/%u/%u/%u ixv=%u\"")
  set(fallback "    else if ((t.giveIxMiss || t.giveIxStale) && len + 1 < n)\n")
  set(dflt "    bool giveIx = false;\n    bool giveIxMiss = false;\n    bool giveIxStale = false;\n")
  set(give "\"%u/%u/%u/%u/%u\", s.fetchUs, s.sortUs, s.loopUs, s.walk, s.ret")
  check_times("${time_h}" "PlannerTimePolicy.h" 1 r suffix fmt fallback dflt give)
  set(${out} "${r}" PARENT_SCOPE)
