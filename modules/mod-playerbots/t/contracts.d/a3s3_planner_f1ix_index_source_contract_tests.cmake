set(TAG "a3s3 planner f1ix index")

function(read_file path out_var)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(NOT "${reason}" STREQUAL "")
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

# needle_var is the NAME of a variable holding the needle (a ";" in a needle would split a list argument).
function(count_text text needle_var out)
  set(needle "${${needle_var}}")
  string(LENGTH "${needle}" nl)
  set(n 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${nl}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  set(${out} ${n} PARENT_SCOPE)
endfunction()

# Each named needle exactly n times in text. names: the NAMES of variables holding the needles.
function(check_times text where want out)
  foreach(v ${ARGN})
    count_text("${text}" ${v} n)
    if(NOT n EQUAL ${want})
      set(${out} "${where}: '${${v}}' found ${n} times, want ${want}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} "" PARENT_SCOPE)
endfunction()

# first before second, both present (names of variables holding the needles).
function(check_order text where first_var second_var out)
  string(FIND "${text}" "${${first_var}}" a)
  string(FIND "${text}" "${${second_var}}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(${out} "${where}: '${${first_var}}' must come before '${${second_var}}'" PARENT_SCOPE)
    return()
  endif()
  set(${out} "" PARENT_SCOPE)
endfunction()

# The text of one function body: from the needle start_var to the first "\n}\n" after it.
function(cut_body text start_var out)
  string(FIND "${text}" "${${start_var}}" at)
  if(at EQUAL -1)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "\n}\n" end)
  if(end EQUAL -1)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

