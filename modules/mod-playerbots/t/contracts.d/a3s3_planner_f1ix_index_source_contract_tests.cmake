  set(d1 "\nAiPlayerbot.Planner.GiverIndex = 0\n")
  set(d2 "\nAiPlayerbot.Planner.GiverIndexVerify = 0\n")
  check_times("${conf}" "aiplayerbot.conf.dist.in" 1 r d1 d2)
