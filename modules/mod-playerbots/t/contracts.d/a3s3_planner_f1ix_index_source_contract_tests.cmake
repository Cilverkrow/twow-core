# ---- (f) the unit suite ----------------------------------------------------------------------------------------------------
function(check_f tests unit out)
  set(exe "add_executable(giver_index_policy_tests\n  \"\${PB_MODULE_DIR}/t/giver_index_policy_tests.cpp\")")
  set(run "add_test(NAME giver_index_policy\n  COMMAND giver_index_policy_tests\n")
  check_times("${tests}" "tests.cmake" 1 r exe run)
  if(NOT "${r}" STREQUAL "")
    set(${out} "${r}" PARENT_SCOPE)
    return()
  endif()
  foreach(t TestBucket TestAxes TestSupersetRandom TestEdge TestWide TestEmpty TestStamp TestCellPrint TestVerifyLine)
    set(call "    ${t}();\n")
    check_times("${unit}" "t/giver_index_policy_tests.cpp" 1 r call)
    if(NOT "${r}" STREQUAL "")
      set(${out} "${r}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(radii "    float const radii[3] = { 300.0f, 1500.0f, 20000.0f };\n")
  check_times("${unit}" "t/giver_index_policy_tests.cpp radii (OB-10 B1)" 1 r radii)
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

