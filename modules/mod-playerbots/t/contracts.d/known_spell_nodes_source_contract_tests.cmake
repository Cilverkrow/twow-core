# twow-repo#602 ROT-01 (owner 04.11.2026 "die fähigkeiten ab dem fähigen level", OB-00 plan OK): AiPlayerbot.Rotation.KnownSpellNodes
# (default 0). Engine::ProcessTriggers does not check a trigger node whose every handler is a spell action the bot does not know
# and that has no alternatives. Pins: switch default 0, > 3 = off, cohort modes, [ConfigEcho]; pure policy; the skip only with the
# switch, never in test mode, before Check() (a set event flag needs no exception: the push could only end IMPOSSIBLE); the node answer cached on the node, taken again after a
# known-spell stamp change (spell id read fresh) and every RecheckMs; non-spell / runtime / mount actions and actions with
# alternatives keep the node; the handler copy and the action node are freed; the minute line only when on. Every check runs once
# on the real sources and once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/KnownSpellNodesPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/strategy/Engine.cpp" engine_cpp)
read_file("${PB_SOURCE_DIR}/strategy/Engine.h" engine_h)
read_file("${PB_SOURCE_DIR}/strategy/Trigger.h" trigger_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)
read_file("${PB_SOURCE_DIR}/RandomPlayerbotMgr.cpp" rnd_cpp)

# text from `start` up to (not including) `stop`, empty when either is missing
function(between text start stop out_var)
  string(FIND "${text}" "${start}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${stop}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} part)
  set(${out_var} "${part}" PARENT_SCOPE)
endfunction()

function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check policy engine_cpp engine_h trigger_h config_h config_cpp dist rnd_cpp out_var)
  set(errors "")

  # 1. Switch: default 0, > 3 = off, cohort modes, [ConfigEcho] sorted.
  need("${dist}" "\nAiPlayerbot.Rotation.KnownSpellNodes = 0\n" "dist key, default 0")
  need("${config_h}" "uint32 rotationKnownSpellNodes = 0;" "config member, default 0")
  need("${config_cpp}" "rotationKnownSpellNodes = config.GetIntDefault(\"AiPlayerbot.Rotation.KnownSpellNodes\", 0);" "config read, default 0")
  need("${config_cpp}" "    if (rotationKnownSpellNodes > 3)\n        rotationKnownSpellNodes = 0;" "an unknown mode is off")
  need("${config_cpp}" "            {\"Rotation.InvalidTargetQuiet\", Value(rotationInvalidTargetQuiet)},\n            {\"Rotation.KnownSpellNodes\", Value(rotationKnownSpellNodes)},\n            {\"Rotation.LosCacheMs\"" "[ConfigEcho], sorted (owner rule #615, #710)")

  # 2. Pure policy and its rules.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${policy}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <atomic>" AND NOT inc STREQUAL "#include <cstdint>")
      list(APPEND errors "KnownSpellNodesPolicy.h is not pure: ${inc}")
    endif()
  endforeach()
  ban("${policy}" "sLog" "logging in the policy")
  need("${policy}" "    return h.spellAction && !h.keepsUnknown && !h.spellKnown && !h.hasAlternatives;" "dead = unknown spell action without alternatives")
  need("${policy}" "    return !taken || cachedStamp != stamp || std::uint32_t(nowMs - takenAtMs) >= RecheckMs;" "recheck: never taken, stamp change, RecheckMs (unsigned)")
  need("${policy}" "constexpr std::uint32_t RecheckMs = 10000;" "recheck at least every 10 s")

  # 3. The engine gate: switch + cohort, not in test mode, before the trigger check.
  need("${engine_cpp}" "#include \"playerbot/KnownSpellNodesPolicy.h\"" "policy include")
  between("${engine_cpp}" "void Engine::ProcessTriggers(bool minimal)" "MultiplyAndPush(node->getHandlers()" loop)
  if(loop STREQUAL "")
    list(APPEND errors "ProcessTriggers loop not found")
  endif()
  need("${loop}" "        if (sPlayerbotAIConfig.rotationKnownSpellNodes && !testMode &&\n            ai::cohort::Applies(sPlayerbotAIConfig.rotationKnownSpellNodes, ai->GetBot()->GetGUIDLow()))" "gate: switch, cohort, no test mode")
  need("${loop}" "            if (KnownSpellNodeSkip(node))\n            {\n                ai::known_spell_nodes::Global().skipped[cls].fetch_add(1, std::memory_order_relaxed);\n                continue;\n            }" "a dead node is skipped and counted")
  before("${loop}" "if (KnownSpellNodeSkip(node))" "Event event = trigger->Check();" "the skip before the trigger check")
  before("${loop}" "if (!trigger)\n            continue;" "if (KnownSpellNodeSkip(node))" "the skip after the trigger lookup")
  need("${engine_h}" "        bool KnownSpellNodeSkip(TriggerNode* node);" "declared on the engine")
  need("${trigger_h}" "        bool knownSpellTaken = false;\n        bool knownSpellSkip = false;\n        std::uint64_t knownSpellStamp = 0;\n        std::uint32_t knownSpellTakenMs = 0;" "per-node cache, empty at start")

  # 4. The node answer.
  between("${engine_cpp}" "bool Engine::KnownSpellNodeSkip(TriggerNode* node)" "\n}\n" skip)
  if(skip STREQUAL "")
    list(APPEND errors "KnownSpellNodeSkip not found")
  endif()
  need("${skip}" "ai::spellstamp::Make(bot->GetSpellMap().size(), bot->GetLevel(), bot->GetFreeTalentPoints(), 0);" "the known-spell stamp (spells, level, talent points)")
  need("${skip}" "    if (!Recheck(node->knownSpellTaken, node->knownSpellStamp, stamp, nowMs, node->knownSpellTakenMs))\n        return node->knownSpellSkip;" "cached answer until a recheck")
  need("${skip}" "                if (idValue && stampChanged)\n                    idValue->Reset();" "spell id read fresh after a stamp change")
  need("${skip}" "h.spellKnown = !idValue || idValue->Get() != 0;" "a missing value counts as known")
  need("${skip}" "h.keepsUnknown = cast->NodeCheckKeepsUnknownSpell() || cast->NodeCheckSpellName() == \"mount\";" "runtime / vehicle / mount spells keep the node")
  need("${skip}" "CastSpellAction* const cast = dynamic_cast<CastSpellAction*>(action);" "only spell actions can be dead")
  need("${skip}" "                NextAction** alternatives = actionNode->getAlternatives();\n                h.hasAlternatives = alternatives && alternatives[0];\n                NextAction::destroy(alternatives);\n                delete actionNode;" "alternatives keep the node; node and copy freed")
  need("${skip}" "    bool skip = handlers && handlers[0];" "a node without handlers is never skipped")
  need("${skip}" "        skip = Dead(h);" "every handler must be dead")
  need("${skip}" "    NextAction::destroy(handlers);" "the handler copy freed")

  # 5. Minute line only when on.
  need("${rnd_cpp}" "    if (!sPlayerbotAIConfig.rotationKnownSpellNodes || now < lastReport + 60)\n        return;" "minute line only when on")
  need("${rnd_cpp}" "    ReportKnownSpellNodes();" "minute line called")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${engine_cpp}" "${engine_h}" "${trigger_h}" "${config_h}" "${config_cpp}" "${dist}" "${rnd_cpp}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#602 KnownSpellNodes contract failed:\n  ${errs}")
endif()

# The engine reads two facts of CastSpellAction; GetSpellName / KeepsUnknownSpell are protected, so the class offers them
# through public accessors (CI trixie 04.11.2026: a direct call from Engine.cpp does not compile). Both must sit in the public
# part, before the class's first "protected:".
read_file("${PB_SOURCE_DIR}/strategy/actions/GenericSpellActions.h" spells_h)
function(check_accessors spells_h out_var)
  set(errors "")
  between("${spells_h}" "    class CastSpellAction : public Action\n    {\n    public:" "    protected:" cast_public)
  if(cast_public STREQUAL "")
    list(APPEND errors "CastSpellAction public part not found")
  endif()
  need("${cast_public}" "        const std::string& NodeCheckSpellName() const { return GetSpellName(); }" "public spell-name accessor")
  need("${cast_public}" "        bool NodeCheckKeepsUnknownSpell() const { return KeepsUnknownSpell(); }" "public keeps-unknown accessor")
  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()
check_accessors("${spells_h}" aerrs)
if(aerrs)
  message(FATAL_ERROR "#602 KnownSpellNodes accessors: ${aerrs}")
endif()
string(REPLACE "        bool NodeCheckKeepsUnknownSpell() const { return KeepsUnknownSpell(); }\n" "" moved "${spells_h}")
string(REPLACE "    protected:\n        const uint32& GetSpellID() const { return spellId; }" "    protected:\n        bool NodeCheckKeepsUnknownSpell() const { return KeepsUnknownSpell(); }\n        const uint32& GetSpellID() const { return spellId; }" moved "${moved}")
check_accessors("${moved}" aerrs)
if(NOT aerrs)
  message(FATAL_ERROR "#602 KnownSpellNodes probe 'accessor protected': the contract did not catch it")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#602 KnownSpellNodes probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${engine_cpp}" "${engine_h}" "${trigger_h}" "${config_h}" "${config_cpp}" "${dist}" "${rnd_cpp}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "#602 KnownSpellNodes probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default on" dist "\nAiPlayerbot.Rotation.KnownSpellNodes = 0\n" "\nAiPlayerbot.Rotation.KnownSpellNodes = 1\n")
probe("unknown mode kept" config_cpp "    if (rotationKnownSpellNodes > 3)\n        rotationKnownSpellNodes = 0;" "")
probe("echo missing" config_cpp "            {\"Rotation.KnownSpellNodes\", Value(rotationKnownSpellNodes)},\n" "")
probe("alternatives ignored" policy "!h.spellKnown && !h.hasAlternatives;" "!h.spellKnown;")
probe("known spell skipped" policy "!h.keepsUnknown && !h.spellKnown && !h.hasAlternatives" "!h.keepsUnknown && !h.hasAlternatives")
probe("no periodic recheck" policy " || std::uint32_t(nowMs - takenAtMs) >= RecheckMs;" ";")
probe("stamp ignored" policy "!taken || cachedStamp != stamp ||" "!taken ||")
probe("impure policy" policy "#include <cstdint>" "#include <cstdint>\n#include \"Entities/Player.h\"")
probe("skip in test mode" engine_cpp "rotationKnownSpellNodes && !testMode &&\n" "rotationKnownSpellNodes &&\n")
probe("cohort ignored" engine_cpp "ai::cohort::Applies(sPlayerbotAIConfig.rotationKnownSpellNodes, ai->GetBot()->GetGUIDLow()))" "true)")
probe("stale spell id" engine_cpp "                if (idValue && stampChanged)\n                    idValue->Reset();\n" "")
probe("mount skipped" engine_cpp "cast->NodeCheckKeepsUnknownSpell() || cast->NodeCheckSpellName() == \"mount\";" "cast->NodeCheckKeepsUnknownSpell();")
probe("handlers leak" engine_cpp "    NextAction::destroy(handlers);\n" "")
probe("empty node skipped" engine_cpp "    bool skip = handlers && handlers[0];" "    bool skip = true;")
probe("report always" rnd_cpp "    if (!sPlayerbotAIConfig.rotationKnownSpellNodes || now < lastReport + 60)" "    if (now < lastReport + 60)")

message(STATUS "known_spell_nodes source contract passed (${probes} negative probes)")
