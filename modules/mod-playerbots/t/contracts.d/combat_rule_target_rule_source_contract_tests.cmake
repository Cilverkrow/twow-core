# A3 step 5 P5 (ADR-0041; OB-00 08.11.2026 (a), design A3-S5-PROGRESSGUARD-ENTWURF.md v1.1 §3): the combat rule, part TargetRule
# (AiPlayerbot.CombatRule.TargetRule, default 0; 1 all, 2 cohort B, 3 cohort A; TargetBackoffMs 2000). The "select new target"
# backoff: an empty pick of the dps/tank assist arms it, and the "invalid target" trigger stays quiet while the current target is empty
# until the attacker set changes, the bot takes damage or TargetBackoffMs pass. No candidate cache. Log only: the TargetValues line
# (computes and time of five target values), and the ProgressGuardLoop overwrite counter. P4 follow-ups (OB-10 08.11. notes (1), (2)):
# the guard acts only with a current target, and its target lookup stays on the bot's own map.
# Pins: keys and clamp, [ConfigEcho] sorted, .dist; the pure backoff (order-free key, the three wakes, wrap-safe, a wake disarms);
# the hooks (trigger after the InvalidTargetQuiet block and before the old check, the pick note first in TraceRetargetEmpty); the
# glue (nothing read while off or for a real player master, a current target ends it, no target writes, no clock read while off);
# the value timers; the P4 follow-ups; the minute lines only with the switch on.
# Every check runs once on the real sources and once per negative probe.

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/CombatRulePolicy.h" policy)
read_file("${PB_SOURCE_DIR}/CombatRule.cpp" glue)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.cpp" ai_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)
read_file("${PB_SOURCE_DIR}/strategy/triggers/GenericTriggers.cpp" triggers)
read_file("${PB_SOURCE_DIR}/strategy/actions/ChooseTargetActions.cpp" choose)
read_file("${PB_SOURCE_DIR}/strategy/values/AttackersValue.cpp" v_attackers)
read_file("${PB_SOURCE_DIR}/strategy/values/PossibleAttackTargetsValue.cpp" v_possible)
read_file("${PB_SOURCE_DIR}/strategy/values/DpsTargetValue.cpp" v_dps)
read_file("${PB_SOURCE_DIR}/strategy/values/TankTargetValue.cpp" v_tank)
read_file("${PB_SOURCE_DIR}/strategy/values/InvalidTargetValue.cpp" v_invalid)
set(values "${v_attackers}\n@@\n${v_possible}\n@@\n${v_dps}\n@@\n${v_tank}\n@@\n${v_invalid}")

function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()
# The text between the first "first" and the next "last" after it ("" when not found).
function(region text first last out_var)
  set(${out_var} "" PARENT_SCOPE)
  string(FIND "${text}" "${first}" a)
  if(a EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${last}" b)
  if(b EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} cut)
  set(${out_var} "${cut}" PARENT_SCOPE)
endfunction()

function(check policy glue ai_cpp config_h config_cpp dist triggers choose values out_var)
  set(errors "")

  # 1. Keys: mode default 0 and > 3 off; clamp 250..10000; [ConfigEcho] sorted after RestStartMana; .dist.
  need("${dist}" "\nAiPlayerbot.CombatRule.TargetRule = 0\n" "dist key, default 0")
  need("${dist}" "\nAiPlayerbot.CombatRule.TargetBackoffMs = 2000\n" "dist TargetBackoffMs 2000")
  need("${config_h}" "    uint32 combatRuleTargetRule = 0;\n" "config member, default 0")
  need("${config_cpp}" "    combatRuleTargetRule = uint32(config.GetIntDefault(\"AiPlayerbot.CombatRule.TargetRule\", 0));\n    if (combatRuleTargetRule > 3)\n        combatRuleTargetRule = 0;\n" "config read, > 3 = off")
  need("${config_cpp}" "ai::combat_rule::ClampTargetBackoffMs(config.GetIntDefault(\"AiPlayerbot.CombatRule.TargetBackoffMs\", 2000));" "clamped backoff")
  need("${config_cpp}" "            {\"CombatRule.RestStartMana\", Value(combatRuleRestStartMana)},\n            {\"CombatRule.TargetBackoffMs\", Value(combatRuleTargetBackoffMs)},\n            {\"CombatRule.TargetRule\", Value(combatRuleTargetRule)},\n" "in [ConfigEcho], sorted after CombatRule.RestStartMana (the key after it is not pinned)")
  need("${policy}" "    return value < 250 ? 250u : (value > 10000 ? 10000u : std::uint32_t(value));" "clamp 250..10000")

  # 2. The pure backoff: order-free key, wakes on a new attacker set, a hit or the time; a wake disarms; wrap-safe; no game types.
  region("${policy}" "inline TargetBackoffVerdict CheckTargetBackoff(" "\n}\n" chk)
  if(chk STREQUAL "")
    set(errors "${errors};missing CheckTargetBackoff")
  endif()
  need("${chk}" "    if (attackersKey != b.attackersKey)\n        verdict = TargetBackoffVerdict::WokenAttackers;" "wake on a new attacker set")
  need("${chk}" "    else if (health < b.health)\n        verdict = TargetBackoffVerdict::WokenHit;" "wake on a hit (regeneration is none)")
  need("${chk}" "    else if (std::uint32_t(nowMs - b.sinceMs) >= backoffMs)\n        verdict = TargetBackoffVerdict::WokenTime;" "wake after TargetBackoffMs, wrap-safe")
  need("${chk}" "    if (verdict != TargetBackoffVerdict::Skip)\n        b.armed = false;" "a wake disarms")
  need("${policy}" "        key += MixGuid(guid);" "order-free key (a sum)")
  need("${policy}" "inline bool ProgressMayAct(ProgressClock const& c)\n{\n    return c.target != 0;\n}" "the guard acts only with a target")
  ban("${policy}" "#include \"playerbot/" "game includes in the pure policy")

  # 3. The hooks: the trigger after the InvalidTargetQuiet block and before the old check; the pick note first in TraceRetargetEmpty.
  region("${triggers}" "bool InvalidTargetTrigger::IsActive()" "\n}\n" trig)
  need("${trig}" "    if (ai::combat_rule::TargetBackoffSkips(ai))\n        return false;\n" "the trigger asks the backoff")
  before("${trig}" "        ai::invalid_target::quiet.fetch_add(1, std::memory_order_relaxed);" "ai::combat_rule::TargetBackoffSkips(ai)" "the quiet block first")
  before("${trig}" "ai::combat_rule::TargetBackoffSkips(ai)" "    return AI_VALUE2(bool, \"invalid target\", \"current target\");" "the backoff before the old check")
  need("${triggers}" "#include \"playerbot/CombatRule.h\"" "the include in GenericTriggers.cpp")
  need("${choose}" "bool SelectNewTargetAction::TraceRetargetEmpty(bool picked)\n{\n    ai::combat_rule::NoteTargetPick(ai, picked);" "the pick note first (both assists, picked or not)")

  # 4. The glue: nothing read while off / other cohort / real player master; a current target ends it; no target writes.
  need("${glue}" "    return sPlayerbotAIConfig.combatRuleTargetRule && ai::cohort::Applies(sPlayerbotAIConfig.combatRuleTargetRule, ai->GetBot()->GetGUIDLow()) &&\n        !ai->HasRealPlayerMaster();" "applies: switch, cohort, no real player master")
  region("${glue}" "void NoteTargetPick(PlayerbotAI* ai, bool picked)" "\n}\n" note)
  need("${note}" "    if (!TargetRuleApplies(ai))\n        return;" "the note reads nothing while off")
  need("${note}" "    if (picked)\n    {\n        b.armed = false;\n        return;\n    }" "a pick ends the backoff")
  region("${glue}" "bool TargetBackoffSkips(PlayerbotAI* ai)" "\n}\n" skips)
  need("${skips}" "    if (!b.armed)\n        return false;" "not armed: nothing read")
  need("${skips}" "    if (!TargetRuleApplies(ai))\n    {\n        b.armed = false;\n        return false;\n    }" "switched off: the backoff ends")
  need("${skips}" "    if (ai->GetAiObjectContext()->GetValue<Unit*>(\"current target\")->Get())\n    {\n        b.armed = false;" "a current target ends the backoff")
  foreach(word "->Set(" "AttackStop" "SetSelectionGuid" "InterruptSpell" "MovePoint" "DoSpecificAction")
    ban("${note}${skips}" "${word}" "a target or movement write in the backoff")
  endforeach()

  # 5. The value timers: in the five Calculate bodies, no clock read while off.
  foreach(v "AttackersValue.cpp:Attackers" "PossibleAttackTargetsValue.cpp:PossibleAttackTargets" "DpsTargetValue.cpp:DpsTarget" "TankTargetValue.cpp:TankTarget" "InvalidTargetValue.cpp:InvalidTarget")
    string(REPLACE ":" ";" parts "${v}")
    list(GET parts 1 enum)
    need("${values}" "Calculate()\n{\n    ai::combat_rule::TargetValueTimer const costTimer(ai, ai::combat_rule::TargetValue::${enum});" "the ${enum} timer first in Calculate")
  endforeach()
  region("${glue}" "TargetValueTimer::TargetValueTimer(PlayerbotAI* ai, TargetValue value)" "\n}\n" timer)
  need("${timer}" "    if (!sPlayerbotAIConfig.combatRuleTargetRule || !ai || !ai->GetBot() || value_ >= TargetRuleCounters::Values)\n        return;" "no clock read while off")
  before("${timer}" "        return;" "NowUs()" "the switch check before the clock")

  # 6. The P4 follow-ups: the guard acts only with a target (before the cohort check); lookups on the own map; overwrite counter.
  region("${ai_cpp}" "void PlayerbotAI::ActOnCombatProgress()" "\n}\n" act)
  need("${act}" "    if (!ai::combat_rule::ProgressMayAct(progressClock))\n        return;" "no act without a target")
  before("${act}" "ai::combat_rule::ProgressMayAct(progressClock)" "    if (progressVerdict == ai::combat_rule::ProgressVerdict::Break)" "the target check before the break")
  region("${ai_cpp}" "void PlayerbotAI::ObserveCombatProgress()" "\n}\n" observe)
  region("${ai_cpp}" "void PlayerbotAI::BreakCombatLoop()" "\n}\n" brk)
  need("${observe}" "ProgressUnitOnMap(ObjectGuid(progressClock.target))" "the kill lookup on the own map")
  need("${brk}" "ProgressUnitOnMap(ObjectGuid(progressClock.target))" "the break lookup on the own map")
  ban("${observe}${brk}" "GetUnit(" "the global unit lookup in the guard")
  region("${ai_cpp}" "Unit* PlayerbotAI::ProgressUnitOnMap(ObjectGuid guid)" "\n}\n" onmap)
  need("${onmap}" "    for (auto itr = map->GetPlayers().getFirst(); itr != nullptr; itr = itr->next())" "a player only from the map's own list")
  foreach(word "FindPlayer" "sObjectAccessor" "ObjectAccessor::" "GetMap()")
    ban("${onmap}" "${word}" "a lookup outside the own map")
  endforeach()
  need("${brk}" "    if (supervised && combatLoopPending)\n        ai::combat_rule::CountProgressAct(bot, ai::combat_rule::ProgressAct::LoopOverwrite);" "the overwrite counter (log only)")
  before("${brk}" "ProgressAct::LoopOverwrite" "        combatLoopPending = true;" "counted before the new event is left")

  # 7. The minute lines only with the switch on; reported after ProgressGuard.
  need("${glue}" "    if (!sPlayerbotAIConfig.combatRuleTargetRule || now < lastReport + 60)\n        return;" "minute lines only when on")
  need("${glue}" "    ReportProgressGuard();\n    ReportTargetRule();\n" "reported after ProgressGuard")
  need("${glue}" "\"[CombatRule] part=TargetRule mode=%u backoff_ms=%u failed=%llu/%llu skipped=%llu/%llu woken_attackers=%llu/%llu \"" "TargetRule line format")
  need("${glue}" "\"[CombatRule] part=TargetValues mode=%u values=%s\"" "TargetValues line format")
  need("${glue}" "\"[CombatRule] part=ProgressGuardLoop mode=%u loop_overwrites=%llu/%llu\"" "overwrite line format")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${glue}" "${ai_cpp}" "${config_h}" "${config_cpp}" "${dist}" "${triggers}" "${choose}" "${values}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "A3 step 5 combat rule TargetRule contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "TargetRule probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${glue}" "${ai_cpp}" "${config_h}" "${config_cpp}" "${dist}" "${triggers}" "${choose}" "${values}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "TargetRule probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default on" dist "\nAiPlayerbot.CombatRule.TargetRule = 0\n" "\nAiPlayerbot.CombatRule.TargetRule = 1\n")
probe("unknown mode kept" config_cpp "    if (combatRuleTargetRule > 3)\n        combatRuleTargetRule = 0;\n" "")
probe("echo missing" config_cpp "            {\"CombatRule.TargetRule\", Value(combatRuleTargetRule)},\n" "")
probe("no attacker wake" policy "    if (attackersKey != b.attackersKey)\n        verdict = TargetBackoffVerdict::WokenAttackers;\n    else if" "    if")
probe("regeneration wakes" policy "    else if (health < b.health)" "    else if (health != b.health)")
probe("wake keeps armed" policy "    if (verdict != TargetBackoffVerdict::Skip)\n        b.armed = false;" "")
probe("ordered key" policy "        key += MixGuid(guid);" "        key = key * 31 + MixGuid(guid);")
probe("guard acts without target" policy "    return c.target != 0;" "    return true;")
probe("trigger before quiet" triggers "    // A3 step 5 P5 (CombatRule.TargetRule, default 0): after an empty pick, quiet until a new attacker, a hit or TargetBackoffMs.\n    if (ai::combat_rule::TargetBackoffSkips(ai))\n        return false;\n" "")
probe("pick note late" choose "{\n    ai::combat_rule::NoteTargetPick(ai, picked);" "{\n    (void)0; ai::combat_rule::NoteTargetPick(ai, picked);")
probe("real master backs off" glue " &&\n        !ai->HasRealPlayerMaster();" ";")
probe("target keeps backoff" glue "    if (ai->GetAiObjectContext()->GetValue<Unit*>(\"current target\")->Get())\n    {\n        b.armed = false;" "    if (false)\n    {\n        b.armed = false;")
probe("backoff writes target" glue "            c.skipped[cohort].fetch_add(1, std::memory_order_relaxed);\n" "            c.skipped[cohort].fetch_add(1, std::memory_order_relaxed);\n            ai->GetAiObjectContext()->GetValue<Unit*>(\"current target\")->Set(nullptr);\n")
probe("timer clock while off" glue "    if (!sPlayerbotAIConfig.combatRuleTargetRule || !ai || !ai->GetBot() || value_ >= TargetRuleCounters::Values)\n        return;\n" "")
probe("dps timer missing" values "    ai::combat_rule::TargetValueTimer const costTimer(ai, ai::combat_rule::TargetValue::DpsTarget);" "")
probe("global lookup back" ai_cpp "        Unit* const previous = ProgressUnitOnMap(ObjectGuid(progressClock.target));" "        Unit* const previous = GetUnit(ObjectGuid(progressClock.target));")
probe("lookup via accessor" ai_cpp "    for (auto itr = map->GetPlayers().getFirst(); itr != nullptr; itr = itr->next())" "    return sObjectAccessor.GetUnit(*bot, guid);\n    for (auto itr = map->GetPlayers().getFirst(); itr != nullptr; itr = itr->next())")
probe("act without target" ai_cpp "    if (!ai::combat_rule::ProgressMayAct(progressClock))\n        return;\n" "")
probe("minute line always on" glue "    if (!sPlayerbotAIConfig.combatRuleTargetRule || now < lastReport + 60)" "    if (now < lastReport + 60)")

message(STATUS "combat_rule_target_rule source contract passed (${probes} negative probes)")
