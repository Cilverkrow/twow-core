# twow-repo#601 S3a (feasibility at accept time; design rev. 2, OB-10 review + OB-00 decisions 18.10.2026).
# AiPlayerbot.QuestFeasibility.Enable / .Blocklist / .BlocklistWhileNoCustomStarts / .SoloSkipGroupQuests, restart-only,
# default 0 / empty. Pins:
#  - the pure policy QuestFeasibilityPolicy.h (no game headers, no locks; Enable / scope first, then the explicit lists,
#    the class exemption only on the solo group rule - review S3a F2, OB-00 Q-O3 lists three class quests),
#  - the hook sites: the one accept rule SkipQuestForRosterBot (A/B/C, still 3 call sites, after the S1 mark), the
#    autonomous quest item (G), the giver relation (after the pinned S1 mark block, giver only - never the taker), the
#    drop step right after the pinned grey step (open quests only, via ai->DropQuest so [QuestDrop] appears; no listed
#    quest while grouped, never the guild order's quest - review S3a F2),
#  - paths D / D' / E / F untouched (a real player's share, catch-up, escort confirm, guild order: #420),
#  - the [QuestFeasibility] lines (bounded skip line, minute line on the world thread only with Enable, atomics),
#  - neutral defaults: members false / empty, conf documented with 0 / empty, never shipped as 1.
# Reads only named files below modules/mod-playerbots/src/playerbot (never a glob, never src/modules/Eluna).

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#601 S3a: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#601 S3a: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" first_at)
  string(FIND "${text}" "${second}" second_at)
  if(first_at EQUAL -1 OR second_at EQUAL -1 OR NOT first_at LESS second_at)
    message(FATAL_ERROR "#601 S3a: order (${description}): '${first}' must come before '${second}'")
  endif()
endfunction()

# The part of `text` from `start` up to the first `end` after it (both required).
function(region text start end out)
  string(FIND "${text}" "${start}" start_at)
  if(start_at EQUAL -1)
    message(FATAL_ERROR "#601 S3a: missing region start: ${start}")
  endif()
  string(SUBSTRING "${text}" ${start_at} -1 rest)
  string(LENGTH "${start}" start_length)
  string(SUBSTRING "${rest}" ${start_length} -1 tail)
  string(FIND "${tail}" "${end}" end_at)
  if(end_at EQUAL -1)
    message(FATAL_ERROR "#601 S3a: missing region end: ${end}")
  endif()
  math(EXPR length "${start_length} + ${end_at}")
  string(SUBSTRING "${rest}" 0 ${length} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

function(count_text text needle expected description)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" len)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${len}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(NOT n EQUAL expected)
    message(FATAL_ERROR "#601 S3a: ${description}: expected ${expected} x '${needle}', found ${n}")
  endif()
endfunction()

