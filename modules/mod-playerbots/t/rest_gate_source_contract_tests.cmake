# Pins:
#  - the pure policy RestGatePolicy.h and that neither it nor the trace or the value enters the PlayerbotAI.h / PlayerbotAIConfig.h chain,
#  - the neutral defaults (switch 0, 70 / 40 / 90 / 85 / 120; plain load lines, mode and threshold clamps) and the conf block after X3,
#  - switch off = one config test per hook; the new trigger nodes only with the switch on; the global "low health" trigger and the #420
#    drink line unchanged,
#  - solo free bots only (E1), the pull gate = "can move around" read before the grind-target search, hold-still only there (E3),
#  - OB-10 condition 1: a resting bot is a pause of the turn-in stall observation and of the move-retry failure,
#  - OB-10 condition 2: a failed food / drink cast while resting waits CastRetryMs and is counted (cast_fail),
#  - the second-sit fix and the longer wait for both auras only while resting (E5), the hourly report after ReportEmergencyLadder,
#    budgeted episode lines, no shared_mutex.
# Reads only named files below modules/mod-playerbots/src/playerbot (never a glob, never src/modules/Eluna).

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#602 X1 RestGate: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#602 X1 RestGate: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" first_at)
  string(FIND "${text}" "${second}" second_at)
  if(first_at EQUAL -1 OR second_at EQUAL -1 OR NOT first_at LESS second_at)
    message(FATAL_ERROR "#602 X1 RestGate: order (${description}): '${first}' must come before '${second}'")
  endif()
endfunction()

function(require_count text needle expected description)
  string(LENGTH "${needle}" needle_len)
  set(count 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR count "${count} + 1")
    math(EXPR next "${at} + ${needle_len}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "#602 X1 RestGate: ${description}: found ${count} of '${needle}', expected ${expected}")
  endif()
endfunction()

function(region text begin_marker end_marker out_var)
  string(FIND "${text}" "${begin_marker}" begin_at)
  if(begin_at EQUAL -1)
    message(FATAL_ERROR "#602 X1 RestGate: region start not found: ${begin_marker}")
  endif()
  string(SUBSTRING "${text}" ${begin_at} -1 tail)
  string(FIND "${tail}" "${end_marker}" end_at)
  if(end_at EQUAL -1)
    message(FATAL_ERROR "#602 X1 RestGate: region end not found: ${end_marker}")
  endif()
  string(SUBSTRING "${tail}" 0 ${end_at} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

