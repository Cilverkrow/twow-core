# twow-repo#602 ROT-01 3c-B (priest Farathil loop, OB-00 24.10.2026): AiPlayerbot.Rotation.OomBackoff (default 0, behaviour change)
# lets an out-of-mana priest/mage/warlock without a wand fight in melee and makes an idle out-of-mana combat pass wait DelayMs.
# Pins: switch default 0; off = no fallback node, "enemy too close for spell" with its old body; the fallback condition (class,
# "no mana" mark, no wand); the backoff conditions and its wake; the X1 rest gate and panic untouched; report; pure policy.
# Every check runs once on the real sources and once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/OomBackoffPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/strategy/triggers/RangeTriggers.h" range_h)
read_file("${PB_SOURCE_DIR}/strategy/triggers/TriggerContext.h" trig_ctx)
read_file("${PB_SOURCE_DIR}/strategy/generic/RangedCombatStrategy.cpp" ranged_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.cpp" ai_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.h" ai_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)
read_file("${PB_SOURCE_DIR}/RandomPlayerbotMgr.cpp" mgr_cpp)

# text from `start` up to (not including) `stop`, empty when either is missing
function(between text start stop out_var)
  string(FIND "${text}" "${start}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${stop}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} part)
  set(${out_var} "${part}" PARENT_SCOPE)
endfunction()

# append to `errors` of the calling function instead of failing (functions, not macros: macro arguments would
# re-evaluate the backslashes of the source text)
function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check policy range_h trig_ctx ranged_cpp ai_cpp ai_h config_h config_cpp dist mgr_cpp out_var)
  set(errors "")

  # 1. Switch: default 0 in the dist, the member and the read; unknown modes are off; parsed mode in [ConfigEcho].
  need("${dist}" "\nAiPlayerbot.Rotation.OomBackoff = 0\n" "dist key, default 0")
  need("${dist}" "\nAiPlayerbot.Rotation.OomBackoff.DelayMs = 1000\n" "dist wait, default 1000")
  need("${config_h}" "uint32 rotationOomBackoff = 0;" "config member, default 0")
  need("${config_h}" "uint32 rotationOomBackoffDelayMs = 1000;" "wait member, default 1000")
  need("${config_cpp}" "rotationOomBackoff = config.GetIntDefault(\"AiPlayerbot.Rotation.OomBackoff\", 0);   // twow-repo#602 ROT-01 3c-B\n    if (rotationOomBackoff > 2)\n        rotationOomBackoff = 0;" "config read, > 2 = off")
  need("${config_cpp}" "rotationOomBackoffDelayMs = config.GetIntDefault(\"AiPlayerbot.Rotation.OomBackoff.DelayMs\", 1000);" "wait read")
  need("${config_cpp}" "{\"Rotation.OomBackoff\", Value(rotationOomBackoff)}," "parsed mode in [ConfigEcho] (owner rule #615)")

  # 2. Pure policy (std + the cohort rule only) and its rules.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${policy}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <atomic>" AND NOT inc STREQUAL "#include <cstdint>" AND NOT inc STREQUAL "#include \"CohortPolicy.h\"")
      list(APPEND errors "OomBackoffPolicy.h is not pure: ${inc}")
    endif()
  endforeach()
  need("${policy}" "return cls == ClassPriest || cls == ClassMage || cls == ClassWarlock;" "wand classes")
  need("${policy}" "constexpr std::uint32_t NoManaPct = 5;" "the no mana mark (NoManaTrigger)")
  need("${policy}" "return applies && WandClass(cls) && OutOfMana(hasMana, manaPct) && !hasWand;" "fallback rule")
  need("${policy}" "return applies && combatIdleTick && yieldSetDelay && !minimal && !casting && OutOfMana(hasMana, manaPct) &&\n        healthPct >= lowHealthPct;" "backoff rule incl. LowHealth")
  need("${policy}" "return pending && (!OutOfMana(hasMana, manaPct) || healthPct < lowHealthPct);" "wake rule")

  # 3. Melee fallback: a node only with the switch, reach melee before melee; the trigger needs a target.
  need("${ranged_cpp}" "    triggers.push_back(new TriggerNode(\n        \"enemy too close for spell\",\n        NextAction::array(0, new NextAction(\"flee\", ACTION_MOVE), NULL)));\n" "old flee node unchanged")
  need("${ranged_cpp}" "if (ai::oom_backoff::Applies(sPlayerbotAIConfig.rotationOomBackoff, ai->GetBot()->GetGUIDLow()))\n        triggers.push_back(new TriggerNode(\n            \"oom melee fallback\"," "fallback node only with the switch")
  need("${ranged_cpp}" "NextAction::array(0, new NextAction(\"reach melee\", ACTION_NORMAL + 1), new NextAction(\"melee\", ACTION_NORMAL), NULL)" "reach melee, then melee")
  need("${trig_ctx}" "creators[\"oom melee fallback\"] = [](PlayerbotAI* ai) { return new OomMeleeFallbackTrigger(ai); };" "trigger registered")
  between("${range_h}" "inline bool OomMeleeFallback(PlayerbotAI* ai, AiObjectContext* context)" "\n    }\n" fb)
  need("${fb}" "if (!ai::oom_backoff::Applies(sPlayerbotAIConfig.rotationOomBackoff, bot->GetGUIDLow()))\n            return false;" "cohort mode")
  need("${fb}" "ranged->GetProto()->SubClass == ITEM_SUBCLASS_WEAPON_WAND" "wand in the ranged slot")
  need("${fb}" "AI_VALUE2(bool, \"has mana\", \"self target\")" "has mana value")
  between("${range_h}" "class OomMeleeFallbackTrigger : public Trigger" "    };\n" fbt)
  need("${fbt}" "if (!AI_VALUE(Unit*, \"current target\") || !OomMeleeFallback(ai, context))\n                return false;" "a target is needed")

  # 4. "enemy too close for spell": off = the old body; on = quiet only while the fallback holds.
  between("${range_h}" "class EnemyTooCloseForSpellTrigger : public Trigger" "class EnemyTooCloseForShootTrigger" tooclose)
  need("${tooclose}" "if (!sPlayerbotAIConfig.rotationOomBackoff)\n                return TooClose();" "switch first, off = old body")
  need("${tooclose}" "if (tooClose && OomMeleeFallback(ai, context))" "quiet only for the fallback")
  need("${tooclose}" "return sServerFacade.IsDistanceLessOrEqualThan(targetDistance, minDistance * coeff);" "old body end")
  need("${tooclose}" "if (bot->getClass() != CLASS_HUNTER && !isVictim && target->GetTarget() != bot)\n                    return false;" "old body caster rule")

  # 5. Backoff: after the combat-idle stretch, own bot only, not with a real player master; the wake; pending reset per pass.
  before("${ai_cpp}" "            StretchCombatIdle();\n" "        if (sPlayerbotAIConfig.rotationOomBackoff && !HasRealPlayerMaster())\n            BackoffOutOfMana(yieldSetDelay, min);" "backoff after the combat-idle stretch")
  between("${ai_cpp}" "void PlayerbotAI::BackoffOutOfMana(bool yieldSetDelay, bool minimal)" "\n}\n" bo)
  need("${bo}" "if (currentEngine != engines[(uint8)BotState::BOT_STATE_COMBAT])\n        return;" "combat engine only")
  need("${bo}" "bot->IsNonMeleeSpellCasted(true, false, true)" "not while casting")
  need("${bo}" "sPlayerbotAIConfig.lowHealth))" "LowHealth exemption")
  need("${bo}" "if (aiInternalUpdateDelay >= sPlayerbotAIConfig.rotationOomBackoffDelayMs)\n        return;" "never shorter than another delay")
  need("${ai_cpp}" "if (ai::oom_backoff::ShouldWake(true, hasMana, mana, uint32(bot->GetHealthPercent()), sPlayerbotAIConfig.lowHealth))" "wake check")
  need("${ai_cpp}" "if (ai::oom_backoff::WakeResets(aiInternalUpdateDelay, sPlayerbotAIConfig.rotationOomBackoffDelayMs))" "wake cuts only its own wait")
  need("${ai_cpp}" "        oomBackoffPending = false;   // twow-repo#602 ROT-01 3c-B: a pass runs, so no backoff wait is pending any more\n        // twow-repo#541 (audit A17): set by DoNextAction when the combat engine executed nothing.\n        combatIdleTick = false;\n        UpdateAIInternal(elapsed, minimal);" "pending reset per pass")
  need("${ai_h}" "bool oomBackoffPending = false;" "pending member")

  # 6. The combat-idle stretch (A17) and the panic flee are unchanged.
  need("${ai_cpp}" "if (ai::combat_idle::MayStretch(sPlayerbotAIConfig.perfCombatIdleYield, combatIdleTick, yieldSetDelay, min) && !HasRealPlayerMaster())\n            StretchCombatIdle();" "A17 stretch unchanged")
  between("${ai_cpp}" "void PlayerbotAI::StretchCombatIdle()" "\n}\n" stretch)
  ban("${stretch}" "oom_backoff" "the backoff inside the A17 stretch")

  # 7. Report once per minute after [CastWait], nothing when off.
  before("${mgr_cpp}" "    ReportCastWait();" "    ReportOomBackoff();" "report after ReportCastWait")
  need("${mgr_cpp}" "if (!sPlayerbotAIConfig.rotationOomBackoff || now < lastReport + 60)" "report only when on")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${range_h}" "${trig_ctx}" "${ranged_cpp}" "${ai_cpp}" "${ai_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#602 oom backoff contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#602 probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${range_h}" "${trig_ctx}" "${ranged_cpp}" "${ai_cpp}" "${ai_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "#602 probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default on" dist "\nAiPlayerbot.Rotation.OomBackoff = 0\n" "\nAiPlayerbot.Rotation.OomBackoff = 1\n")
probe("unknown mode kept" config_cpp "    if (rotationOomBackoff > 2)\n        rotationOomBackoff = 0;" "")
probe("node always" ranged_cpp "    if (ai::oom_backoff::Applies(sPlayerbotAIConfig.rotationOomBackoff, ai->GetBot()->GetGUIDLow()))\n" "")
probe("hunter fallback" policy "cls == ClassPriest || cls == ClassMage" "cls == 3 || cls == ClassPriest || cls == ClassMage")
probe("with a wand" policy "OutOfMana(hasMana, manaPct) && !hasWand;" "OutOfMana(hasMana, manaPct);")
probe("too close always quiet" range_h "if (tooClose && OomMeleeFallback(ai, context))" "if (OomMeleeFallback(ai, context))")
probe("too close off path" range_h "if (!sPlayerbotAIConfig.rotationOomBackoff)\n                return TooClose();" "")
probe("no LowHealth exemption" policy "OutOfMana(hasMana, manaPct) &&\n        healthPct >= lowHealthPct;" "OutOfMana(hasMana, manaPct);")
probe("backoff while casting" ai_cpp "bot->IsNonMeleeSpellCasted(true, false, true),\n            hasMana" "false,\n            hasMana")
probe("shorter delay" ai_cpp "    if (aiInternalUpdateDelay >= sPlayerbotAIConfig.rotationOomBackoffDelayMs)\n        return;\n" "")
probe("no wake on health" policy "(!OutOfMana(hasMana, manaPct) || healthPct < lowHealthPct)" "(!OutOfMana(hasMana, manaPct))")
probe("A17 touched" ai_cpp "    aiInternalUpdateDelay = ai::combat_idle::StretchedDelay(sPlayerbotAIConfig.reactDelay);" "    aiInternalUpdateDelay = ai::combat_idle::StretchedDelay(sPlayerbotAIConfig.reactDelay); // oom_backoff")
probe("impure policy" policy "#include <cstdint>" "#include <cstdint>\n#include \"Entities/Player.h\"")
probe("report always" mgr_cpp "if (!sPlayerbotAIConfig.rotationOomBackoff || now < lastReport + 60)" "if (now < lastReport + 60)")

message(STATUS "oom_backoff source contract passed (${probes} negative probes)")
