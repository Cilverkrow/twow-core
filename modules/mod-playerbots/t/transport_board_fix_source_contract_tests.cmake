# OB-10 #1 hybrid: near -> continue after the run; else ONE route search from the bot's own position; none -> the existing
# rescues (the stored path dropped, no teleport, no new rescue). The record is cleared before anything else (once per loss).
function(check_recovery move out_var)
  set(${out_var} "" PARENT_SCOPE)
  region_of("${move}" "\nstatic bool RecoverLostRide(PlayerbotAI* ai, LastMovement& lastMove)\n{" "\n}\n" rec)
  if(rec STREQUAL "")
    set(${out_var} "RecoverLostRide not found" PARENT_SCOPE)
    return()
  endif()
  occurrences("${rec}" "sTravelNodeMap.getFullPath(" n_search)
  if(NOT n_search EQUAL 1)
    set(${out_var} "the recovery searches exactly one route (found ${n_search})" PARENT_SCOPE)
    return()
  endif()
  require_order_nf("${rec}" "    lastMove.transportBoard.ride = transport_board::Ride();" "transport_board::RecoverNear(lost, at.getMapId(), at.getX(), at.getY())" o1)
  require_order_nf("${rec}" "transport_board::RecoverNear(lost, at.getMapId(), at.getX(), at.getY())" "sTravelNodeMap.getFullPath(at, lastMove.lastPath.getBack(), bot);" o2)
  if(o1 OR o2)
    set(${out_var} "record cleared first, then near, then the one search (${o1}${o2})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${rec}" m "    if (kind == transport_board::Recovery::NoRoute)\n        lastMove.lastPath.clear();"
    "            points.erase(points.begin(), points.begin() + i);   // up to the arrival dock" "        EndFixedRide(lastMove, lost.entry);" "LogTransportRecovery(bot, lost, kind, at);")
  if(m)
    set(${out_var} "recovery outcomes (${m})" PARENT_SCOPE)
    return()
  endif()
  foreach(word "TeleportTo(" "Rescue(" "ZoneEscape(" "RemovePassenger(" "AddPassenger(" "getFullPath(WorldPosition(" "for (;;)" "while (")
    string(FIND "${rec}" "${word}" at)
    if(NOT at EQUAL -1)
      set(${out_var} "the recovery adds no mechanism of its own: ${word}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

# The stop test is paced (CLI-Deep nit): VesselAtStopNear only inside VesselAtStopNearPaced; the gates and the probe use that.
function(check_stop_pace move out_var)
  set(${out_var} "" PARENT_SCOPE)
  occurrences("${move}" "VesselAtStopNear(" n_raw)
  occurrences("${move}" "VesselAtStopNearPaced(" n_paced)
  if(NOT n_raw EQUAL 2 OR NOT n_paced EQUAL 4)
    set(${out_var} "VesselAtStopNear defined and called once (by the pacer), the pacer by the board gate, the exit gate and the probe (raw ${n_raw}, paced ${n_paced})" PARENT_SCOPE)
    return()
  endif()
  region_of("${move}" "\nstatic bool VesselAtStopNearPaced(" "\n}\n" pace)
  missing_of("${pace}" m "if (!transport_board::StopCheckFresh(check, transport->GetEntry(), dock.getMapId(), dock.getX(), dock.getY(), nowMs))" "VesselAtStopNear(transport, dock));")
  if(m)
    set(${out_var} "the pacer computes only when the stored answer is stale (${m})" PARENT_SCOPE)
    return()
  endif()
  foreach(fn "\nstatic bool FixBoardOpen(" "\nstatic bool FixExitOpen(" "\nstatic void NoteDeckProbe(")
    region_of("${move}" "${fn}" "\n}\n" body)
