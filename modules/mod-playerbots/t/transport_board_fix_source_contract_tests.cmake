# 6. Negative probes: each mutation must change the text and be caught, otherwise the scan is broken.
set(caught 0)
macro(expect_caught original_var what)
  if(probe STREQUAL "${${original_var}}")
    message(FATAL_ERROR "${TAG}: negative probe did not apply: ${what}")
  endif()
  if(NOT e)
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what} - the scan is broken")
  endif()
  math(EXPR caught "${caught} + 1")
