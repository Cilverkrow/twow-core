# Byte-identity gates: every S3b-1 behaviour sits behind the switch; the legacy expressions are kept as they were.
function(check_gates wp move node ai out_var)
  set(${out_var} "" PARENT_SCOPE)
  # Deck hit: isOnTransport only with its deckHit argument (default false), SetOnTransport / RandomPointOnTrans behind the fix.
  region_of("${wp}" "bool WorldPosition::isOnTransport(GenericTransport* transport, bool deckHit)" "\n}\n" is_on)
  region_of("${wp}" "bool WorldPosition::SetOnTransport(" "\n}\n" set_on)
  region_of("${wp}" "WorldPosition WorldPosition::RandomPointOnTrans(GenericTransport* transport, uint32 radius, Player* botForPath" "\n}\n" random_on)
  if(is_on STREQUAL "" OR set_on STREQUAL "" OR random_on STREQUAL "")
    set(${out_var} "isOnTransport(transport, deckHit) / SetOnTransport / RandomPointOnTrans not found" PARENT_SCOPE)
    return()
  endif()
  missing_of("${is_on}\n}" m "${IS_ON_DECK}")
  if(m)
    set(${out_var} "isOnTransport: the deck hit only under deckHit, then the static answer as before (${m})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${set_on}" m "${SET_ON_DECK}" "    float const bottomZ = below.getZ();" "        below.setZ(deckZ);\n        gotHit = true;")
  if(m)
    set(${out_var} "SetOnTransport: the deck snap only under the fix (${m})" PARENT_SCOPE)
    return()
  endif()
  occurrences("${set_on}" "HitsVesselDeck(" n_set)
  occurrences("${is_on}" "HitsVesselDeck(" n_is)
  if(NOT n_set EQUAL 1 OR NOT n_is EQUAL 1)
    set(${out_var} "one gated deck ray each in isOnTransport / SetOnTransport (found ${n_is} / ${n_set})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${random_on}" m "${RP_ON}" "${RP_BREAK}" "        bool const onDeck = pos.SetOnTransport(transport, 1, -1);")
  if(m)
    set(${out_var} "RandomPointOnTrans: deck acceptance / early break only under the fix (${m})" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${random_on}" "HitsVesselDeck" rp_ray)
  if(NOT rp_ray EQUAL -1)
    set(${out_var} "RandomPointOnTrans calls the deck ray directly (it must go through isOnTransport / SetOnTransport)" PARENT_SCOPE)
    return()
  endif()
  # UseTransport: the switch and the state first; the legacy exit / board expressions kept verbatim.
  region_of("${move}" "bool MovementAction::UseTransport(PlayerbotAI* ai, uint32 entry, WorldPosition dockPosition" "\nbool MovementAction::MinimalMove(" use)
  region_of("${use}" "{" "\n}\n" use_body)
  if(use_body STREQUAL "")
    set(${out_var} "UseTransport body not found" PARENT_SCOPE)
    return()
  endif()
  missing_of("${use_body}" m
    "    bool const boardFix = board && ${FIX};"
    "        bool const fixedRide = boardFix && board->ride.set && board->ride.entry == transport->GetEntry();\n        if (fixedRide)\n        {\n            dockPosition = PositionOf(board->ride.arrival);\n            exitPosition = PositionOf(board->ride.exit);\n        }"
    "        bool const legacyExit = ${LEGACY_EXIT};\n        if (fixedRide ? FixExitOpen(transport, dockPosition, exitPosition, *board, legacyExit) : legacyExit)\n        {\n            if (fixedRide)"
    "        if (urand(0, 50) && !(boardFix && doTeleport))\n            MoveOnTransport(ai, transport, doTeleport);"
    "    bool const legacyBoard = ${LEGACY_BOARD};\n${BOARD_HEAD}"
    "${BOARD_ANSWER}")
  if(m)
    set(${out_var} "UseTransport gates (${m})" PARENT_SCOPE)
    return()
  endif()
  require_order_nf("${use_body}" "bool const boardFix = board && ${FIX};" "GenericTransport* transport = bot->GetTransport();" o)
  if(o)
    set(${out_var} "the fix gate must come before any branch" PARENT_SCOPE)
    return()
  endif()
  # The S3b-1 state is reached only through BoardFor, which answers nullptr with the fix off before anything else.
  region_of("${move}" "\nstatic transport_board::BotState* BoardFor(PlayerbotAI* ai, std::vector<PathNodePoint> const& path, std::size_t at, bool walker)\n{" "\n}\n" board_for)
  string(FIND "${board_for}" "{\n    if (!${FIX})\n        return nullptr;\n    transport_board::BotState& board =" head_at)
  if(board_for STREQUAL "" OR head_at EQUAL -1)
    set(${out_var} "BoardFor must test the switch first and answer nullptr off" PARENT_SCOPE)
    return()
  endif()
  # Caller blocks behind the switch or behind the (fix-only) state.
  region_of("${move}" "${MINIMAL_HEAD}" "\nbool MovementAction::WaitForTransport()" minimal)
  region_of("${move}" "\nbool MovementAction::WaitForTransport()" "\nTravelPath MovementAction::ResolveMovePath(" wait_fn)
  region_of("${move}" "\nbool MovementAction::HandleSpecialMovement(TravelPath& path)" "\n    if (nextPoint.type == PathNodeType::NODE_FLIGHTPATH && nextPoint.entry)" hsm)
  if(minimal STREQUAL "" OR wait_fn STREQUAL "" OR hsm STREQUAL "")
    set(${out_var} "MinimalMove (with its unchanged head) / WaitForTransport / HandleSpecialMovement not found" PARENT_SCOPE)
    return()
  endif()
  missing_of("${minimal}" m "${RIDE_GUARD}"
    "        if (board && board->exited)\n        {\n            EndFixedRide(lastMove, nextStep->entry);\n            return true;\n        }"
    "        if (${FIX} && path.empty())   // twow-repo#342 (S3b-1)")
  if(m)
    set(${out_var} "MinimalMove: fix blocks behind the switch / the state (${m})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${wait_fn}" m "${RIDE_GUARD}")
  if(m)
    set(${out_var} "WaitForTransport: the ride-record flow behind the switch (${m})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${hsm}" m "            if (board && board->exited)   // twow-repo#342 (S3b-1)")
  if(m)
    set(${out_var} "HandleSpecialMovement: the exited block behind the state (${m})" PARENT_SCOPE)
    return()
  endif()
  # D2 and both walk-start rules behind the switch; the stored link objects and getTransportId untouched.
  region_of("${node}" "\nstatic uint32 RouteTransportEntry(" "\n}\n" d2)
  string(FIND "${d2}" "{\n${D2_GATE}" d2_at)
  if(d2_at EQUAL -1)
    set(${out_var} "RouteTransportEntry must answer the stored object off (D2 gate)" PARENT_SCOPE)
    return()
  endif()
  missing_of("${node}" m "${T2_CUT}" "${T1_RULE}" "${T1_WALK}" "${T2_WALK}"
    "                travelPath.addPath(nodePath->getPath(), PathNodeType::NODE_TRANSPORT,\n                    RouteTransportEntry(nodes, std::size_t(&node - nodes.data()), uint32(nodePath->getPathObject())));"
    "${WALK_HOP_BRANCH}" "${WALK_HOP_ADD}")
  if(m)
    set(${out_var} "TravelNode.cpp: D2 / walk-start rules / lone hop behind the switch (${m})" PARENT_SCOPE)
    return()
  endif()
  # Review 18.10.: the walker distance test is the policy's (same radius as FixBoardOpen); the lone hop off answers false.
  region_of("${node}" "\nstatic bool WalkerAtDock(WorldPosition const& bot, WorldPosition const& dock)\n{" "\n}\n" walker_fn)
  region_of("${node}" "\nstatic bool RouteWalkHop(" "\n}\n" hop_fn)
  region_of("${node}" "\nstatic bool TransportLinkOf(TravelNode* from, TravelNode* to)" "\n}\n" link_fn)
  string(FIND "${walker_fn}" "{\n${WALKER_AT_DOCK}" walker_at)
  string(FIND "${hop_fn}" "{\n${WALK_HOP_GATE}" hop_gate_at)
  string(FIND "${hop_fn}" "    return ai::transport_board::WalkHop(object, next, prev);" hop_ret_at)
  string(FIND "${link_fn}" "return from->hasPathTo(to) && from->getPathTo(to)->getPathType() == TravelNodePathType::transport;" link_at)
  if(walker_at EQUAL -1 OR hop_gate_at EQUAL -1 OR hop_ret_at EQUAL -1 OR link_at EQUAL -1)
    set(${out_var} "TravelNode.cpp: WalkerAtDock = WalkerNearDock, RouteWalkHop answers false off, hasPathTo before getPathTo" PARENT_SCOPE)
    return()
  endif()
  # The route neighbours of link nodes[i-1] -> nodes[i]: the next link (nodes[i] -> nodes[i+1]) and the previous one.
  missing_of("${d2}" m
    "    uint32 const next = i + 1 < nodes.size() ? RideObjectOf(nodes[i], nodes[i + 1]) : 0;"
    "    uint32 const prev = i >= 2 ? RideObjectOf(nodes[i - 2], nodes[i - 1]) : 0;"
    "    return ai::transport_board::InheritEntry(object, next, prev);")
  if(m)
    set(${out_var} "RouteTransportEntry: the adjacent ride legs (${m})" PARENT_SCOPE)
    return()
  endif()
  missing_of("${hop_fn}" m
    "    bool const next = i + 1 < nodes.size() && TransportLinkOf(nodes[i], nodes[i + 1]);"
    "    bool const prev = i >= 2 && TransportLinkOf(nodes[i - 2], nodes[i - 1]);")
  if(m)
    set(${out_var} "RouteWalkHop: the adjacent transport links (${m})" PARENT_SCOPE)
    return()
  endif()
  require_order_nf("${node}" "\nstatic bool WalkerAtDock(" "\nbool TravelPath::UpcommingSpecialMovement(" o)
  if(o)
    set(${out_var} "WalkerAtDock defined before UpcommingSpecialMovement (${o})" PARENT_SCOPE)
    return()
  endif()
  occurrences("${node}" "WalkerAtDock(startPos, " n_walk)
  if(NOT n_walk EQUAL 3)
    set(${out_var} "the walker test at the three walk-start places (found ${n_walk})" PARENT_SCOPE)
    return()
  endif()
  # Fell-off: the deck hit only for a bot with a ride record; master follow unchanged.
  missing_of("${ai}" m "${FELL_OFF}" "${FOLLOW_LINE}")
  if(m)
    set(${out_var} "PlayerbotAI fell-off / follow check (${m})" PARENT_SCOPE)
    return()
  endif()
  occurrences("${ai}" "isOnTransport(" n_ai)
  if(NOT n_ai EQUAL 2)
    set(${out_var} "expected the 2 isOnTransport checks in PlayerbotAI.cpp, found ${n_ai}" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(require_order_nf text first second out_var)
  set(${out_var} "" PARENT_SCOPE)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(${out_var} "order: '${first}' before '${second}'" PARENT_SCOPE)
  endif()
endfunction()

# OB-10 #2 / #3: the ride record drives the aboard flow; the recovery acts only on an episode with a ride record; the legacy
# WaitForTransport flow stays textually unchanged after the fix block.
function(check_ride_flow move policy out_var)
  set(${out_var} "" PARENT_SCOPE)
  region_of("${policy}" "inline bool RideLost(" "\n" lost_fn)
  string(FIND "${lost_fn}" "{ return ride.set && (!aboard || onEntry != ride.entry); }" lost_at)
  if(lost_at EQUAL -1)
    set(${out_var} "RideLost must require a ride record" PARENT_SCOPE)
    return()
  endif()
  occurrences("${move}" "RecoverLostRide(" n_rec)
  occurrences("${move}" "${LOST_TEST}" n_lost)
  occurrences("${move}" "${RIDE_GUARD}" n_guard)
  if(NOT n_rec EQUAL 3 OR NOT n_lost EQUAL 2 OR NOT n_guard EQUAL 2)
    set(${out_var} "the recovery: defined once, called twice, each after RideLost under the ride-record guard (calls ${n_rec}, tests ${n_lost}, guards ${n_guard})" PARENT_SCOPE)
    return()
  endif()
  region_of("${move}" "\nbool MovementAction::WaitForTransport()" "\nTravelPath MovementAction::ResolveMovePath(" wait_fn)
  region_of("${wait_fn}" "${RIDE_GUARD}" "\n    }\n" wait_fix)
  region_of("${move}" "bool MovementAction::MinimalMove(PlayerbotAI* ai)" "\n    if (lastMove.lastPath.empty())\n        return false;" minimal_fix)
  foreach(block wait_fix minimal_fix)
    string(FIND "${${block}}" "${LOST_TEST}" t)
    string(FIND "${${block}}" "RecoverLostRide(ai, lastMove)" r)
    string(FIND "${${block}}" "${RIDE_GUARD}" g)
    if(t EQUAL -1 OR r EQUAL -1 OR g EQUAL -1 OR NOT g LESS t OR NOT t LESS r)
      set(${out_var} "${block}: the recovery only after RideLost inside the ride-record guard" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${wait_fix}" "        lastMove.lastTransportEntry = 0;" replaces)
  if(replaces EQUAL -1)
    set(${out_var} "WaitForTransport: the ride record replaces lastTransportEntry (OB-10 #2)" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${wait_fn}" "\n    }\n\n${WAIT_LEGACY}" legacy_at)
  if(legacy_at EQUAL -1)
    set(${out_var} "WaitForTransport: the legacy flow after the fix block must stay byte-identical to base 8cc67274" PARENT_SCOPE)
    return()
  endif()
  # The aboard tail: KeepRideTail twice (MinimalMove before the empty test, WaitForTransport), EndFixedRide three times.
  occurrences("${move}" "KeepRideTail(lastMove);" n_keep)
  occurrences("${move}" "EndFixedRide(" n_end)
  if(NOT n_keep EQUAL 2 OR NOT n_end EQUAL 5)
    set(${out_var} "KeepRideTail called twice, EndFixedRide defined once, called at the three exits and by the near recovery (found ${n_keep} / ${n_end})" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${minimal_fix}" "KeepRideTail(lastMove);" keep_minimal)
  string(FIND "${wait_fix}" "KeepRideTail(lastMove);" keep_wait)
  if(keep_minimal EQUAL -1 OR keep_wait EQUAL -1)
    set(${out_var} "KeepRideTail in MinimalMove (before the empty-path test) and in the WaitForTransport fix block" PARENT_SCOPE)
    return()
  endif()
  # The ride record: set only by BoardAnswer for a vessel the bot is on, with the run's tail; cleared at the exit / recovery.
  region_of("${move}" "\nstatic bool BoardAnswer(" "\n}\n" answer_fn)
  string(FIND "${answer_fn}" "    if (on && board.pending.arrival.set)\n        board.ride = transport_board::RideOf(" set_at)
  occurrences("${move}" "ride = transport_board::RideOf(" n_set)
  if(set_at EQUAL -1 OR NOT n_set EQUAL 1)
    set(${out_var} "the ride record is set only in BoardAnswer under 'on && board.pending.arrival.set' (sets ${n_set})" PARENT_SCOPE)
    return()
  endif()
  occurrences("${move}" "ride = transport_board::Ride();" n_clear)
  if(NOT n_clear EQUAL 2)
    set(${out_var} "the ride record is cleared at the exit and by the recovery only (found ${n_clear})" PARENT_SCOPE)
    return()
  endif()
  # Review 3 (18.10.): the honest answer itself (no silent true inside BoardAnswer), its only return.
  string(FIND "${answer_fn}" "${ANSWER_RET}" ret_at)
  occurrences("${answer_fn}" "return" n_ret)
  if(ret_at EQUAL -1 OR NOT n_ret EQUAL 1)
    set(${out_var} "BoardAnswer: one answer, Boarded(on != nullptr, doTeleport, moved) (returns ${n_ret})" PARENT_SCOPE)
    return()
  endif()
  # Review 3: OB-10 #3, the fell-off deck hit only for a bot on the vessel of its own ride record.
  region_of("${move}" "\nstatic bool FixedRideOf(" "\n}\n" fixed_fn)
  region_of("${move}" "\nbool MovementAction::HasFixedRide(PlayerbotAI* ai)\n{" "\n}\n" has_fn)
  string(FIND "${fixed_fn}" "${FIXED_RIDE_RET}" fixed_at)
  string(FIND "${has_fn}" "{\n${HAS_FIXED_RIDE}" has_at)
  occurrences("${fixed_fn}" "return" n_fixed)
  if(fixed_at EQUAL -1 OR has_at EQUAL -1 OR NOT n_fixed EQUAL 1)
    set(${out_var} "FixedRideOf / HasFixedRide: the ride record's vessel is the bot's (OB-10 #3)" PARENT_SCOPE)
    return()
  endif()
  # Review 3: the polarity of the lost-ride test in both blocks (the recovery only for a lost ride, the tail kept aboard).
  string(FIND "${wait_fix}" "${WAIT_LOST}" wait_lost_at)
  string(FIND "${minimal_fix}" "${MINIMAL_LOST}" minimal_lost_at)
  if(wait_lost_at EQUAL -1 OR minimal_lost_at EQUAL -1)
    set(${out_var} "RideLost polarity: WaitForTransport recovers when lost, MinimalMove keeps the tail when not lost" PARENT_SCOPE)
    return()
  endif()
  # Review 3: KeepRideTail's body (the arrival found and cut to, else rebuilt from the record), no early return.
  region_of("${move}" "\nstatic void KeepRideTail(LastMovement& lastMove)\n{" "\n}\n" keep_fn)
  string(FIND "${keep_fn}" "${KEEP_SCAN}" keep_at)
  occurrences("${keep_fn}" "return" n_keep_ret)
  require_order_nf("${keep_fn}" "    for (std::size_t i = 0; i < points.size(); ++i)" "        return;" o)
  if(keep_at EQUAL -1 OR NOT n_keep_ret EQUAL 1 OR o)
    set(${out_var} "KeepRideTail: the arrival scan and the rebuild, the only return inside the scan" PARENT_SCOPE)
    return()
  endif()
endfunction()

# Review 18.10.: BoardFor's per-call state (the walker point of a HandleSpecialMovement caller; no tail for a run longer than
# MaxRunScan) and the board gate's distance test for walkers, before the paced stop test.
function(check_board_for move policy out_var)
  set(${out_var} "" PARENT_SCOPE)
  region_of("${move}" "\nstatic transport_board::BotState* BoardFor(" "\n}\n" board_for)
  region_of("${move}" "\nstatic bool FixBoardOpen(" "\n}\n" open_fn)
  if(board_for STREQUAL "" OR open_fn STREQUAL "")
    set(${out_var} "BoardFor / FixBoardOpen not found" PARENT_SCOPE)
    return()
  endif()
  missing_of("${board_for}" m "${WALKER_SET}" "${RUN_CAP}")
  if(m)
    set(${out_var} "BoardFor: walker point per call, no tail past MaxRunScan (${m})" PARENT_SCOPE)
    return()
  endif()
  require_order_nf("${board_for}" "${WALKER_SET}" "    if (at >= path.size() || ai->GetBot()->GetTransport())" o)
  if(o)
    set(${out_var} "BoardFor: the walker point is set (or cleared) on every call (${o})" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${open_fn}" "${WALKER_GATE}" gate_at)
  string(FIND "${open_fn}" "VesselAtStopNearPaced(" stop_at)
  if(gate_at EQUAL -1 OR stop_at EQUAL -1 OR NOT gate_at LESS stop_at)
    set(${out_var} "FixBoardOpen: a walker boards only near the dock, tested before the stop test" PARENT_SCOPE)
    return()
  endif()
  foreach(call "BoardFor(ai, path, 0, false)" "BoardFor(ai, ridePath.getPath(), 0, false)" "BoardFor(ai, path.getPath(), 1, true)"
      "BoardFor(ai, path.getPath(), 0, true)")
    occurrences("${move}" "${call}" n)
    if(NOT n EQUAL 1)
      set(${out_var} "BoardFor caller (MinimalMove / aboard: no walker; HandleSpecialMovement: walker): ${call} found ${n}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  missing_of("${policy}" m "constexpr float BoardFromDockYards = StopRadiusYards;"
    "    return !walker.set || Near2d(dock, walker.map, walker.x, walker.y, BoardFromDockYards);"
    "    return !own && !nextTransportLink && !prevTransportLink;")
  if(m)
    set(${out_var} "policy: walker radius / lone hop (${m})" PARENT_SCOPE)
    return()
  endif()
endfunction()

