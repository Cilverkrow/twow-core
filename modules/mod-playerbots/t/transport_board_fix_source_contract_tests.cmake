function(read_source path out_var)
  if(NOT EXISTS "${PB_SOURCE_DIR}/${path}")
    message(FATAL_ERROR "${TAG}: missing source ${path}")
  endif()
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(fail_if reason)
  if(reason)
    message(FATAL_ERROR "${TAG}: ${reason}")
  endif()
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "${TAG}: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "${TAG}: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "${TAG}: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

# Occurrences of needle in text (non-fatal).
function(occurrences text needle out_var)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nlen)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR from "${at} + ${nlen}")
    string(SUBSTRING "${rest}" ${from} -1 rest)
  endwhile()
  set(${out_var} ${n} PARENT_SCOPE)
endfunction()

function(count_text text needle expected description)
  occurrences("${text}" "${needle}" n)
  if(NOT n EQUAL ${expected})
    message(FATAL_ERROR "${TAG}: expected ${expected}x ${description}, found ${n}")
  endif()
endfunction()

# Text from start_marker up to the first end_marker after it; "" when a marker is missing (non-fatal).
function(region_of text start_marker end_marker out_var)
  set(${out_var} "" PARENT_SCOPE)
  string(FIND "${text}" "${start_marker}" start)
  if(start EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "${end_marker}" len)
  if(len EQUAL -1)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${len} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

function(region text start_marker end_marker out_var)
  region_of("${text}" "${start_marker}" "${end_marker}" body)
  if(body STREQUAL "")
    message(FATAL_ERROR "${TAG}: region not found: ${start_marker} .. ${end_marker}")
  endif()
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

# Non-fatal: "" when every further argument is in text, else the first missing one. The needles are read as ARGV<i>, not
# as the ARGN list: source lines end in ';', which a list would split.
function(missing_of text out_var)
  set(${out_var} "" PARENT_SCOPE)
  if(ARGC LESS 3)
    return()
  endif()
  math(EXPR last "${ARGC} - 1")
  foreach(i RANGE 2 ${last})
    set(needle "${ARGV${i}}")
    string(FIND "${text}" "${needle}" at)
    if(at EQUAL -1)
      set(${out_var} "missing: ${needle}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

