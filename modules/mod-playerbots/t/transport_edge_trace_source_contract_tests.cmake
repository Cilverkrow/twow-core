cmake_policy(VERSION 3.16)
# twow-repo#342 (S1, measurement patch, OB-10 decision + CLI-PATH review 18.10.2026): AiPlayerbot.Path.TransportEdgeTrace
# (default 0) writes one [TransportWait] state=attempt|board|arrive|fail line per transport edge transition and a summary.
# Its wait_timeout / overrun threshold is AiPlayerbot.Path.TransportWaitTimeoutMin * 60000, passed by the callers (S3b-0;
# default 15 = the 900 s of map section 3). Off = one bool test per hook, no state, no counters, no lines; the old
# [TransportWait] bot= line and [TaxiUse] stay byte-identical. Reads named files only.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#342: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#342: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#342: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(count_text text needle expected description)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nlen)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR from "${at} + ${nlen}")
    string(SUBSTRING "${rest}" ${from} -1 rest)
  endwhile()
  if(NOT n EQUAL ${expected})
    message(FATAL_ERROR "#342: expected ${expected}x ${description}, found ${n}")
  endif()
endfunction()

function(region text start_marker end_marker out_var)
  string(FIND "${text}" "${start_marker}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "#342: region start not found: ${start_marker}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "${end_marker}" len)
  if(len EQUAL -1)
    message(FATAL_ERROR "#342: region end not found: ${end_marker}")
  endif()
  string(SUBSTRING "${rest}" 0 ${len} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

