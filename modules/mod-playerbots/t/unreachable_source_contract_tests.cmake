function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "Missing ${description}: ${needle}")
  endif()
endfunction()

file(READ "${PB_SOURCE_DIR}/PlayerbotAI.cpp" ai_cpp)
file(READ "${PB_SOURCE_DIR}/strategy/actions/ReachTargetActions.h" reach)
file(READ "${PB_SOURCE_DIR}/strategy/values/GrindTargetValue.cpp" grind)

# Hotfix 8.2: unreachable targets dropped and skipped, skill-ups count as progress.
require_text("${reach}" "if (!isFriend && ai->CheckReachProgress(target, distanceToTarget))" "reach progress checked")
require_text("${reach}" "if (ai->IsUnreachableTarget(target->GetObjectGuid()))" "no reach to an ignored target")
require_text("${grind}" "if (ai->IsUnreachableTarget(unit->GetObjectGuid()))" "grind skips ignored targets")
# twow-repo#630 GRP-REACH-01 (Rotation.ReachPlayerMaster, default 0): the player-master branch no longer returns early when the
# mode applies; the ignore is short there, and only the bot's own target is dropped (the caller).
file(READ "${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
file(READ "${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" config_template)
string(FIND "${ai_cpp}" "if (!target || HasRealPlayerMaster())" early_return)
if(NOT early_return EQUAL -1)
  message(FATAL_ERROR "#630: the player-master early return is back: if (!target || HasRealPlayerMaster())")
endif()
require_text("${ai_cpp}" "if (!ai::unreachable::Checks(playerMaster, ai::cohort::Applies(sPlayerbotAIConfig.rotationReachPlayerMaster, bot->GetGUIDLow())))" "#630 player master checked only under the mode")
require_text("${ai_cpp}" "uint32 const ignoreSeconds = ai::unreachable::IgnoreFor(playerMaster);" "#630 short ignore with a player master")
require_text("${ai_cpp}" "unreachableTargets.Add(target->GetObjectGuid().GetRawValue(), now, ignoreSeconds);" "#630 ignore with its length")
require_text("${ai_cpp}" "master=%s ignore_s=%u" "#630 log fields")
require_text("${reach}" "if (AI_VALUE(Unit*, \"current target\") == target)\n                        SET_AI_VALUE(Unit*, \"current target\", nullptr);" "#630 only the bot's own target dropped")
require_text("${config_cpp}" "rotationReachPlayerMaster = config.GetIntDefault(\"AiPlayerbot.Rotation.ReachPlayerMaster\", 0);" "#630 key, default 0")
require_text("${config_template}" "AiPlayerbot.Rotation.ReachPlayerMaster = 0" "#630 key documented")
require_text("${ai_cpp}" "if (!lastUnreachableLog || now - lastUnreachableLog >= ai::unreachable::LogSeconds)" "log budget")
require_text("${ai_cpp}" "snapshot += uint64(value) * (uint64(skill) * 2654435761ULL + 1ULL);" "declared skill-ups are progress (8.5)")
