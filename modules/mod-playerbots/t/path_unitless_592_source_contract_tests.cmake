require_count("${route}" "->buildPath(" 3 "the three node path builds, all behind mayBuild")
require_count("${route}" "&& mayBuild)" 2 "both build branches gated")
require_text("${route}" "            if (!nodePath || !nodePath->getComplete()) //If we can not build a path just try to move to the node.\n            {\n                if (!mayBuild)  // twow-repo#592: not rebuilt at runtime\n                    ai::path_unitless_bot::routeIncomplete.fetch_add(1, std::memory_order_relaxed);\n                travelPath.addPoint(*prevNode->getPosition(), PathNodeType::NODE_NODE);" "move-to-node fallback counted")

