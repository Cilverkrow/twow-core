# twow-repo#656 BOT-PULL-01-L1 (#653 lever 1, OB-00 31.10.2026): AiPlayerbot.Grind.SafePull (default 0; modes 1, 2 (cohort B)
# and 3 (cohort A, crossover) change behaviour, mode 4 only counts) orders the stage-2 grind candidates of solo free bots by the creatures that would join the fight at
# the target, the ranged fight spot or on the approach, and lets a bot that is not ready for a risky pick rest (bounded).
# Pins: switch default 0, > 4 = off, ready keys 80 / 50 clamped to 0-100, all three in [ConfigEcho]; pure policy; the population
# (solo, free, no battleground, no real master, round 0); stage 1 untouched; the old solo replace decision unchanged; the rule
# before the neighbour rule; shadow returns the distance pick and never waits; lowest risk then distance; snapshot edge never safe;
# level guard; bounded wait; no grid search, raycast, value read or log line in the score; the minute report only when on; the
# death line only when on, for 2+ attackers within the window, the pick used once. Every check runs once on the real sources and
# once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/SafePullPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/strategy/values/GrindTargetValue.cpp" grind_cpp)
read_file("${PB_SOURCE_DIR}/strategy/values/GrindTargetValue.h" grind_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)
read_file("${PB_SOURCE_DIR}/RandomPlayerbotMgr.cpp" mgr_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.cpp" ai_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAI.h" ai_h)

# text from `start` up to (not including) `stop`, empty when either is missing
function(between text start stop out_var)
  string(FIND "${text}" "${start}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${stop}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} part)
  set(${out_var} "${part}" PARENT_SCOPE)
endfunction()

# append to `errors` of the calling function instead of failing (functions, not macros: macro arguments would
# re-evaluate the backslashes of the source text)
function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check policy grind_cpp grind_h config_h config_cpp dist mgr_cpp ai_cpp ai_h out_var)
  set(errors "")

  # 1. Switch: default 0 in the dist, the member and the read; unknown modes are off; ready keys 80 / 50, clamped; [ConfigEcho].
  need("${dist}" "\nAiPlayerbot.Grind.SafePull = 0\nAiPlayerbot.Grind.SafePull.ReadyHp = 80\nAiPlayerbot.Grind.SafePull.ReadyMana = 50\n" "dist keys, default 0 / 80 / 50")
  need("${config_h}" "uint32 grindSafePull = 0;" "config member, default 0")
  need("${config_h}" "uint32 grindSafePullReadyHp = 80;" "ready HP member, default 80")
  need("${config_h}" "uint32 grindSafePullReadyMana = 50;" "ready mana member, default 50")
  need("${config_cpp}" "grindSafePull = config.GetIntDefault(\"AiPlayerbot.Grind.SafePull\", 0);   // twow-repo#656\n    if (grindSafePull > 4)\n        grindSafePull = 0;" "config read, > 4 = off")
  need("${config_cpp}" "grindSafePullReadyHp = std::min<uint32>(100, uint32(std::max<int32>(0, config.GetIntDefault(\"AiPlayerbot.Grind.SafePull.ReadyHp\", 80))));" "ready HP read, 0-100")
  need("${config_cpp}" "grindSafePullReadyMana = std::min<uint32>(100, uint32(std::max<int32>(0, config.GetIntDefault(\"AiPlayerbot.Grind.SafePull.ReadyMana\", 50))));" "ready mana read, 0-100")
  need("${config_cpp}" "            {\"Grind.QuestFirstOrder\", Value(grindQuestFirstOrder)},\n            {\"Grind.SafePull\", Value(grindSafePull)},\n            {\"Grind.SafePull.ReadyHp\", Value(grindSafePullReadyHp)},\n            {\"Grind.SafePull.ReadyMana\", Value(grindSafePullReadyMana)},\n            {\"LogInGroupOnly\"" "parsed values in [ConfigEcho], sorted (owner rule #615, #710)")

  # 2. Pure policy (std + the cohort and neighbour rules only) and its rules.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${policy}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <algorithm>" AND NOT inc STREQUAL "#include <atomic>" AND NOT inc STREQUAL "#include <cstdint>" AND
       NOT inc STREQUAL "#include \"CohortPolicy.h\"" AND NOT inc STREQUAL "#include \"GrindNeighbourPolicy.h\"")
      list(APPEND errors "SafePullPolicy.h is not pure: ${inc}")
    endif()
  endforeach()
  ban("${policy}" "sLog" "logging in the policy")
  need("${policy}" "    if (mode == ModeOnlyA)\n        return !ai::cohort::InB(guidLow);\n    return mode != ModeShadow && ai::cohort::Applies(mode, guidLow);" "applied: 1 all, 2 cohort B, 3 cohort A, 4 nobody")
  need("${policy}" "return mode >= ai::cohort::ModeAll && mode <= ModeShadow;" "computed in modes 1-4")
  need("${policy}" "constexpr std::uint32_t ModeOnlyA = 3;\nconstexpr std::uint32_t ModeShadow = 4;" "cohort A mode 3 (crossover), shadow mode 4")
  need("${policy}" "return risk < bestRisk || (risk == bestRisk && distance < bestDistance);" "lowest risk, then the lowest distance")
  need("${policy}" "return edge ? std::max<std::uint32_t>(risk, 1) : risk;" "the snapshot edge is never safe")
  need("${policy}" "return risk >= WaitRisk && !ready && waitedS < MaxWaitS;" "bounded wait for a risky pick only")
  need("${policy}" "constexpr std::uint32_t MaxWaitS = 90;" "wait at most 90 s")
  need("${policy}" "return std::max(0.0f, std::min(botDistance, pullRange - SpotBack));" "the ranged fight spot, never beyond the bot")

  # 3. GrindTargetValue: population, stage 1 untouched, the old solo decision unchanged, the rule after the loop and before the
  #    neighbour rule.
  need("${grind_cpp}" "#include \"playerbot/SafePullPolicy.h\"" "policy include")
  need("${grind_cpp}" "    uint32 const safeMode = sPlayerbotAIConfig.grindSafePull;\n    bool const safeScored = ai::safe_pull::Computes(safeMode) && !assistCount && !group && !bot->InBattleGround() &&\n        !ai->HasRealPlayerMaster() && sRandomPlayerbotMgr.IsFreeBot(bot);" "population: solo free bots, round 0, no battleground, no real master")
  between("${grind_cpp}" "context->GetValue<std::list<ObjectGuid>>(\"possible attack targets\")" "context->GetValue<std::list<ObjectGuid> >(\"possible targets\")" stage1)
  if(stage1 STREQUAL "")
    list(APPEND errors "stage 1 loop not found")
  endif()
  ban("${stage1}" "afe" "the risk rule in stage 1 (attackers)")
  need("${grind_cpp}" "            if (safeScored)\n                safeCandidates.push_back({ unit, newdistance, sServerFacade.GetDistance2d(bot, unit) });\n            // twow-repo#602 #2: every candidate" "every solo candidate recorded, before the neighbour record")
  need("${grind_cpp}" "            if (!result || (newdistance < distance && urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.1))\n            {\n                distance = newdistance;\n                result = unit;\n            }" "the old solo decision unchanged")
  need("${grind_cpp}" "    if (safeScored)\n        result = SafePick(result, safeCandidates, targets, ai::safe_pull::Applies(safeMode, bot->GetGUIDLow()));" "the rule after the loop, applied only by Applies")
  before("${grind_cpp}" "        result = SafePick(result, safeCandidates" "        result = NeighbourPick(result, neighbourCandidates" "the risk rule before the neighbour rule")
  between("${grind_cpp}" "Unit* GrindTargetValue::SafePick(" "\n}\n" pick)
  if(pick STREQUAL "")
    list(APPEND errors "SafePick not found")
  endif()
  need("${pick}" "    if (!pick || candidates.empty())\n        return pick;" "no pick, no change")
  need("${pick}" "    if (!applies)\n        return pick;\n    return wait ? nullptr : candidates[b].unit;" "shadow keeps the distance pick and never waits")
  need("${pick}" "if (i == p || !Better(risks[i], candidates[i].distance, risks[b], candidates[b].distance))" "the order rule")
  need("${pick}" "if (!GuardOk(int32(candidates[i].unit->GetLevel()), elite, int32(pick->GetLevel()), pickElite))" "level guard against the distance pick")
  need("${pick}" "return EdgeRisk(risk, edge);" "edge risk")
  need("${pick}" "bool const wait = Waits(risks[b], ready, waited);" "the bounded wait")
  need("${pick}" "for (ObjectGuid const& guid : targets)" "creatures from the pass's own list")
  need("${pick}" "if (entries.size() >= MaxEntries)" "entry cap")
  need("${pick}" "creature->IsInCombat()" "a creature in combat never counts")
  foreach(costly "Cell::Visit" "IsWithinLOS" "GetValue<" "AI_VALUE" "CalculatePath" "sLog")
    ban("${pick}" "${costly}" "a new search, raycast, value read or log line in the score")
  endforeach()
  need("${grind_h}" "Unit* SafePick(Unit* pick, std::vector<NeighbourCandidate> const& candidates, std::list<ObjectGuid> const& targets, bool applies);" "declaration")
  need("${grind_h}" "uint32 safeWaitSince = 0;" "the wait start")

  # 4. Report once per minute after [GrindNeighbour], nothing when off.
  before("${mgr_cpp}" "    ReportGrindNeighbour();" "    ReportSafePull();" "report after ReportGrindNeighbour")
  need("${mgr_cpp}" "if (!sPlayerbotAIConfig.grindSafePull || now < lastReport + 60)" "report only when on")

  # 5. The death line: only when on, 2+ attackers within the window, the pick used once; the member on the bot.
  between("${ai_cpp}" "// twow-repo#656 (AiPlayerbot.Grind.SafePull): a death with 2+ living attackers" "safePullLast = ai::safe_pull::LastPick();" death)
  if(death STREQUAL "")
    list(APPEND errors "death line block not found")
  endif()
  need("${death}" "if (ai::safe_pull::Computes(sPlayerbotAIConfig.grindSafePull) && safePullLast.at)" "death line only when on and after a pick")
  need("${death}" "if (age <= ai::safe_pull::DeathWindowS)" "death window")
  need("${death}" "if (attackers.size() >= 2)" "2+ attackers")
  need("${ai_h}" "ai::safe_pull::LastPick safePullLast;" "the last pick on the bot")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${grind_cpp}" "${grind_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" "${ai_cpp}" "${ai_h}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#656 grind safe pull contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#656 probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${grind_cpp}" "${grind_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" "${ai_cpp}" "${ai_h}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "#656 probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default on" dist "\nAiPlayerbot.Grind.SafePull = 0\n" "\nAiPlayerbot.Grind.SafePull = 2\n")
probe("unknown mode kept" config_cpp "    if (grindSafePull > 4)\n        grindSafePull = 0;" "")
probe("shadow applies" policy "    return mode != ModeShadow && ai::cohort::Applies(mode, guidLow);" "    return mode == ModeShadow || ai::cohort::Applies(mode, guidLow);")
probe("cohort A mode missing" policy "    if (mode == ModeOnlyA)\n        return !ai::cohort::InB(guidLow);\n" "")
probe("echo missing" config_cpp "            {\"Grind.SafePull\", Value(grindSafePull)},\n" "")
probe("grouped bots scored" grind_cpp "ai::safe_pull::Computes(safeMode) && !assistCount && !group && !bot->InBattleGround() &&" "ai::safe_pull::Computes(safeMode) && !assistCount && !bot->InBattleGround() &&")
probe("shadow applied" grind_cpp "targets, ai::safe_pull::Applies(safeMode, bot->GetGUIDLow()));" "targets, ai::safe_pull::Computes(safeMode));")
probe("shadow waits" grind_cpp "    if (!applies)\n        return pick;\n    return wait ? nullptr : candidates[b].unit;" "    return wait ? nullptr : candidates[b].unit;")
probe("distance before risk" policy "return risk < bestRisk || (risk == bestRisk && distance < bestDistance);" "return distance < bestDistance;")
probe("edge counted safe" policy "return edge ? std::max<std::uint32_t>(risk, 1) : risk;" "return risk;")
probe("unbounded wait" policy "return risk >= WaitRisk && !ready && waitedS < MaxWaitS;" "return risk >= WaitRisk && !ready;")
probe("no level guard" grind_cpp "        if (!GuardOk(int32(candidates[i].unit->GetLevel()), elite, int32(pick->GetLevel()), pickElite))\n        {\n            guarded = true;" "        if (false)\n        {\n            guarded = true;")
probe("old decision changed" grind_cpp "urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.1))\n            {\n                distance = newdistance;" "urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.2))\n            {\n                distance = newdistance;")
probe("stage 1 scored" grind_cpp "        logGrind(unit, \"(hostile) selected.\");" "        logGrind(unit, \"(hostile) selected.\"); // safeScored")
probe("raycast in the score" grind_cpp "    // The risk of candidate i;" "    bool const los = bot->IsWithinLOSInMap(pick);\n    // The risk of candidate i;")
probe("impure policy" policy "#include <cstdint>" "#include <cstdint>\n#include \"Entities/Player.h\"")
probe("report always" mgr_cpp "if (!sPlayerbotAIConfig.grindSafePull || now < lastReport + 60)" "if (now < lastReport + 60)")
probe("death line for one attacker" ai_cpp "                    if (attackers.size() >= 2)\n                    {\n                        sLog.outBasic(\"[SafePull] death" "                    if (attackers.size() >= 1)\n                    {\n                        sLog.outBasic(\"[SafePull] death")
probe("after the neighbour rule" grind_cpp "    if (safeScored)\n        result = SafePick(result, safeCandidates, targets, ai::safe_pull::Applies(safeMode, bot->GetGUIDLow()));\n" "")

message(STATUS "grind_safe_pull source contract passed (${probes} negative probes)")
