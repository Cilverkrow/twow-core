region("${policy_h}" "inline uint32_t ClampSeconds(" "inline uint32_t SlotReleaseWaitMs(" clamp)
require_text("${clamp}" "uint32_t seconds = cfgSeconds ? cfgSeconds : defaultSeconds;" "0 = the default")
require_text("${clamp}" "if (seconds < minSeconds)\n        seconds = minSeconds;" "minimum")
require_text("${policy_h}" "constexpr uint32_t DefaultSlotReleaseWaitSeconds = 60;" "wait default 60 s")
require_text("${policy_h}" "constexpr uint32_t MinSlotReleaseWaitSeconds = 15;" "wait minimum 15 s")
require_text("${policy_h}" "constexpr uint32_t DefaultBotOnlyGraceSeconds = 120;" "grace default 120 s")
require_text("${policy_h}" "constexpr uint32_t MinBotOnlyGraceSeconds = 60;" "grace minimum 60 s")

# 14. R5: leave packets with the real map id under BG.Enable (vanilla HandleLeaveBattlefieldOpcode reads a uint32
#     map id), the old bytes with the switch off.
region("${join_cpp}" "if (Time1 == TIME_TO_AUTOREMOVE)" "if (statusid == STATUS_WAIT_QUEUE)" time_remove)
require_text("${time_remove}" "#ifdef MANGOSBOT_ZERO\n        // twow-repo#517 R5" "TIME_REMOVE: vanilla branch")
require_text("${time_remove}" "if (sPlayerbotAIConfig.bgEnable)\n            packet << uint32(bot->GetMapId());\n        else\n        {\n            packet << uint8(0);\n            packet << uint8(0);                           // BattleGroundTypeId-1 ?\n            packet << uint16(0);\n        }" "TIME_REMOVE: map id under BG.Enable, old bytes without")
require_order("${time_remove}" "packet << uint32(bot->GetMapId());" "bot->GetSession()->HandleLeaveBattlefieldOpcode(packet);" "map id before the leave")
region("${join_cpp}" "if (bot->InBattleGround() && bot->GetBattleGroundTypeId() != _bgTypeId)" "//Queue the event again to try to join next tick." leave_before_join)
require_text("${leave_before_join}" "if (sPlayerbotAIConfig.bgEnable)\n                leave << uint32(bot->GetMapId());\n            else\n                leave << uint8(0) << uint8(0) << uint32(0) << uint16(0);" "leave-before-join: map id under BG.Enable, old bytes without")
require_order("${leave_before_join}" "#ifdef MANGOSBOT_ZERO" "leave << uint32(bot->GetMapId());" "leave-before-join: vanilla branch")
count_text("${join_cpp}" "uint32(bot->GetMapId())" 2 "map id only in the two R5 leave packets")
# Review: leaving a battleground that still runs would cast Deserter (which refuses the new invite) and leave a hole;
# under BG.Enable the bot declines the new invite instead and leaves only a battleground that is over.
set(decline "if (sPlayerbotAIConfig.bgEnable)\n            {\n                BattleGround* current = bot->GetBattleGround();\n                if (current && current->GetStatus() != STATUS_WAIT_LEAVE)\n                {\n                    LeaveQueue(bot, _bgTypeId);\n                    return true;\n                }\n            }")
require_text("${leave_before_join}" "${decline}" "leave-before-join: decline while the own battleground runs")
require_order("${leave_before_join}" "${decline}" "bot->GetSession()->HandleLeaveBattlefieldOpcode(leave);" "decline before the leave")
require_order("${leave_before_join}" "#ifdef MANGOSBOT_ZERO" "${decline}" "decline only in the vanilla branch")

message(STATUS "bg_slot_release_517 source contract passed")
