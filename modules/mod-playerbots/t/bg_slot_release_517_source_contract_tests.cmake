# cmake 3.x script mode (Debian trixie / CI): without a policy version TRUE in while()/if() (CMP0012) and
# empty list elements (CMP0007) behave as in cmake 2.x; the host cmake 4.x has them NEW already.
cmake_policy(VERSION 3.16)
# twow-repo#517 stage b: behind AiPlayerbot.BG.Enable && AiPlayerbot.BG.SlotRelease (both default 0) a real player who
# has waited SlotReleaseWaitSeconds uninvited gets into a running battleground with fill bots - pair option first
# (OB-00 D2), else a fill bot of his side above the minimum leaves without Deserter (core castDeserter = false, OB-20)
# and the slot is reserved for him. Plus the bot-only cleanup (Enable && PlayerFill && BotOnlyCleanup, follow-up D with
# OB-20: drained to empty, no EndBattleGround, [BGBotOnlyEnd] for the edge case) and R5 (leave packets with the real map
# id under BG.Enable, the decline of a second invite). RandomPlayerbotMgr::ScanBgSlotRelease / WatchBotOnlyBgs /
# LeaveBotOnlyBg; pure rules in BgFillPolicy.h (t/bg_fill_policy_tests.cpp); the core parameter in
# t/check_bg_leave_deserter_517_contract.cmake. The core premises of the drain and the decline (CORE_SOURCE_DIR) at the
# end.

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()
if(NOT DEFINED CORE_SOURCE_DIR)
  message(FATAL_ERROR "CORE_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(read_core path out_var)
  if(NOT EXISTS "${CORE_SOURCE_DIR}/${path}")
    message(FATAL_ERROR "#517 b: core source missing: ${CORE_SOURCE_DIR}/${path}")
  endif()
  file(READ "${CORE_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#517 b: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#517 b: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#517 b: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(count_text text needle expected description)
  string(LENGTH "${needle}" needle_length)
  set(count 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" offset)
    if(offset EQUAL -1)
      break()
    endif()
    math(EXPR count "${count} + 1")
    math(EXPR next "${offset} + ${needle_length}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "#517 b: ${description}: '${needle}' found ${count} times, expected ${expected}")
  endif()
endfunction()

# Every occurrence of needle has guard_a or guard_b within the window characters before it.
function(require_guarded text needle guard_a guard_b window description)
  string(LENGTH "${needle}" needle_length)
  set(seen 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" offset)
    if(offset EQUAL -1)
      break()
    endif()
    math(EXPR seen "${seen} + 1")
    set(from 0)
    set(length ${offset})
    if(offset GREATER window)
      math(EXPR from "${offset} - ${window}")
      set(length ${window})
    endif()
    string(SUBSTRING "${rest}" ${from} ${length} before)
    string(FIND "${before}" "${guard_a}" guard_a_offset)
    string(FIND "${before}" "${guard_b}" guard_b_offset)
    if(guard_a_offset EQUAL -1 AND guard_b_offset EQUAL -1)
      string(SUBSTRING "${rest}" ${offset} 80 line)
      message(FATAL_ERROR "#517 b: ${description}: no '${guard_a}' or '${guard_b}' before: ${line}")
    endif()
    math(EXPR next "${offset} + ${needle_length}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(seen EQUAL 0)
    message(FATAL_ERROR "#517 b: ${description}: '${needle}' not found")
  endif()
endfunction()

function(region text start_marker end_marker out)
  string(FIND "${text}" "${start_marker}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "#517 b: missing region start: ${start_marker}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "${end_marker}" length)
  if(length EQUAL -1)
    message(FATAL_ERROR "#517 b: missing region end: ${end_marker}")
  endif()
  string(SUBSTRING "${rest}" 0 ${length} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

