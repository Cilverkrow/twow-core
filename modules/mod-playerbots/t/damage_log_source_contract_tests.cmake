# twow-repo#653 (OB-00 31.10.2026): AiPlayerbot.ActionLog.DamageSampleEvery (default 5, log only). The action log's DMG_DEALT /
# DMG_TAKEN lines every Nth damage event with separate dealt / taken counters, and a bot's minion damage in the owner's log with via=.
# Pins: key default 5 (dist, member, read through the policy), in [ConfigEcho] sorted; pure policy; two counters, never one shared;
# the rate from the config; the minion branch only for a creature with a player charmer / owner and a bot owner, the owner's dealt
# counter, via= on its line; the non-bot fast path (return when neither side has a bot) kept. Every check runs once on the real
# sources and once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/DamageLogPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/BotActionLog.cpp" log_cpp)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)

# text from `start` up to (not including) `stop`, empty when either is missing
function(between text start stop out_var)
  string(FIND "${text}" "${start}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${stop}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} part)
  set(${out_var} "${part}" PARENT_SCOPE)
endfunction()

function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check policy log_cpp config_h config_cpp dist out_var)
  set(errors "")

  # 1. Key: default 5, read through the policy, [ConfigEcho] in its sorted place.
  need("${dist}" "\nAiPlayerbot.ActionLog.DamageSampleEvery = 5\n" "dist key, default 5")
  need("${config_h}" "uint32 actionLogDamageSampleEvery = 5;" "config member, default 5")
  need("${config_cpp}" "actionLogDamageSampleEvery = ai::damage_log::Every(config.GetIntDefault(\"AiPlayerbot.ActionLog.DamageSampleEvery\", 5));" "read through the policy")
  need("${config_cpp}" "            {\"ActionLog.DamageSampleEvery\", Value(actionLogDamageSampleEvery)},\n            {\"ActionLog.Guids.count\"" "in [ConfigEcho], sorted (owner rule #615, #710)")

  # 2. Pure policy.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${policy}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <algorithm>" AND NOT inc STREQUAL "#include <cstdint>")
      list(APPEND errors "DamageLogPolicy.h is not pure: ${inc}")
    endif()
  endforeach()
  need("${policy}" "constexpr std::uint32_t DefaultEvery = 5;" "default 5")
  need("${policy}" "    if (configured < 1)\n        return DefaultEvery;\n    return std::min<std::uint32_t>(MaxEvery, std::uint32_t(configured));" "below 1 = default, capped")
  need("${policy}" "return every <= 1 || n % every == 0;" "every Nth event, 1 = all")

  # 3. BotActionLog_LogDamage: two counters, the configured rate, the minion branch, the fast path.
  between("${log_cpp}" "void BotActionLog_LogDamage(" "\n}\n" fn)
  if(fn STREQUAL "")
    list(APPEND errors "BotActionLog_LogDamage not found")
  endif()
  need("${fn}" "static thread_local std::unordered_map<uint64, uint32> sDealt;" "dealt counter")
  need("${fn}" "static thread_local std::unordered_map<uint64, uint32> sTaken;" "taken counter")
  ban("${fn}" "kSampleEvery" "the old fixed rate")
  ban("${fn}" "sCounter" "the old shared counter")
  need("${fn}" "uint32 const every = sPlayerbotAIConfig.actionLogDamageSampleEvery;" "the configured rate")
  need("${fn}" "return ai::damage_log::Due(++counter[g], every);" "sampled by the policy")
  need("${fn}" "if (attackerAi && bucket(sDealt, dealer)) {" "dealt on the dealt counter (the owner for a minion)")
  need("${fn}" "if (victimAi && bucket(sTaken, victim)) {" "taken on the taken counter")
  need("${fn}" "if (!attackerAi && attacker && !attacker->IsPlayer() && attacker->GetCharmerOrOwnerGuid().IsPlayer())" "minion branch: creature with a player charmer / owner only (guid test first)")
  need("${fn}" "if (PlayerbotAI* ownerAi = GetBotAI(owner))" "a bot owner only")
  need("${fn}" "via=0x%llx viaName=%s" "via= on the minion line")
  before("${fn}" "attacker->GetCharmerOrOwnerGuid().IsPlayer()" "if (!attackerAi && !victimAi) return;" "the minion lookup before the fast-path return")
  need("${fn}" "if (!attackerAi && !victimAi) return;" "non-bot fast path")
  need("${log_cpp}" "#include \"playerbot/DamageLogPolicy.h\"" "policy include")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${log_cpp}" "${config_h}" "${config_cpp}" "${dist}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#653 damage log contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#653 probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${log_cpp}" "${config_h}" "${config_cpp}" "${dist}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "#653 probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default changed" dist "\nAiPlayerbot.ActionLog.DamageSampleEvery = 5\n" "\nAiPlayerbot.ActionLog.DamageSampleEvery = 1\n")
probe("echo missing" config_cpp "            {\"ActionLog.DamageSampleEvery\", Value(actionLogDamageSampleEvery)},\n" "")
probe("shared counter" log_cpp "if (victimAi && bucket(sTaken, victim)) {" "if (victimAi && bucket(sDealt, victim)) {")
probe("fixed rate" log_cpp "uint32 const every = sPlayerbotAIConfig.actionLogDamageSampleEvery;" "uint32 const every = 5;")
probe("zero not default" policy "    if (configured < 1)\n        return DefaultEvery;\n" "")
probe("minion of anyone" log_cpp "if (!attackerAi && attacker && !attacker->IsPlayer() && attacker->GetCharmerOrOwnerGuid().IsPlayer())" "if (!attackerAi && attacker)")
probe("via dropped" log_cpp "via=0x%llx viaName=%s" "")
probe("fast path dropped" log_cpp "    if (!attackerAi && !victimAi) return;\n" "")
probe("impure policy" policy "#include <cstdint>" "#include <cstdint>\n#include \"Log.h\"")

message(STATUS "damage_log source contract passed (${probes} negative probes)")
