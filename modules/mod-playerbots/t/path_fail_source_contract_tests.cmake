require_text("${route}" "    if (startNodes.empty() || endNodes.empty())\n    {\n        if (outDetail)   // twow-repo#575 (PATH-01 #1)\n            outDetail->noNodes = true;\n        return TravelNodeRoute();\n    }" "no-node case")
