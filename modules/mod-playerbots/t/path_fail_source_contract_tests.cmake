string(REGEX MATCHALL "outDetail->" writes "${route}")
string(REGEX MATCHALL "if \\(outDetail" guards "${route}")
list(LENGTH writes n_writes)
list(LENGTH guards n_guards)
if(NOT n_guards EQUAL 6 OR n_writes LESS 10)
  message(FATAL_ERROR "#575: getRoute must fill the detail only inside its 6 'if (outDetail' blocks (guards ${n_guards}, writes ${n_writes})")
