# twow-repo#602 ROT-01 #2 (adds analysis 25.10.2026, OB-00): AiPlayerbot.Grind.NeighbourAware (default 0; mode 2 and 1 change
# behaviour, mode 3 only counts) scores the stage-2 grind candidates of solo free bots by the neighbours that would join the fight
# and replaces the distance pick by a candidate with fewer neighbours and a lower score.
# Pins: switch default 0, > 3 = off, parsed mode in [ConfigEcho]; pure policy; the population (solo, free, no battleground, no real
# master, round 0); stage 1 untouched; the old solo replace decision unchanged; demote only (the pick stays when nothing replaces
# it, shadow never changes it); strictly lower W and score; snapshot edge and level guard; no grid search or raycast in the score;
# report only when on. Every check runs once on the real sources and once per negative probe (a mutated copy that must fail).

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

function(read_file path out_var)
  file(READ "${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

read_file("${PB_SOURCE_DIR}/GrindNeighbourPolicy.h" policy)
read_file("${PB_SOURCE_DIR}/strategy/values/GrindTargetValue.cpp" grind_cpp)
read_file("${PB_SOURCE_DIR}/strategy/values/GrindTargetValue.h" grind_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.h" config_h)
read_file("${PB_SOURCE_DIR}/PlayerbotAIConfig.cpp" config_cpp)
read_file("${PB_SOURCE_DIR}/aiplayerbot.conf.dist.in" dist)
read_file("${PB_SOURCE_DIR}/RandomPlayerbotMgr.cpp" mgr_cpp)

# text from `start` up to (not including) `stop`, empty when either is missing
function(between text start stop out_var)
  string(FIND "${text}" "${start}" a)
  if(a EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${stop}" b)
  if(b EQUAL -1)
    set(${out_var} "" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${rest}" 0 ${b} part)
  set(${out_var} "${part}" PARENT_SCOPE)
endfunction()

# append to `errors` of the calling function instead of failing (functions, not macros: macro arguments would
# re-evaluate the backslashes of the source text)
function(need text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    set(errors "${errors};missing ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(ban text needle what)
  string(FIND "${text}" "${needle}" at)
  if(NOT at EQUAL -1)
    set(errors "${errors};forbidden ${what}: ${needle}" PARENT_SCOPE)
  endif()
endfunction()
function(before text first second what)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(errors "${errors};order ${what}: ${first} before ${second}" PARENT_SCOPE)
  endif()
endfunction()

function(check policy grind_cpp grind_h config_h config_cpp dist mgr_cpp out_var)
  set(errors "")

  # 1. Switch: default 0 in the dist, the member and the read; unknown modes are off; parsed mode in [ConfigEcho].
  need("${dist}" "\nAiPlayerbot.Grind.NeighbourAware = 0\n" "dist key, default 0")
  need("${config_h}" "uint32 grindNeighbourAware = 0;" "config member, default 0")
  need("${config_cpp}" "grindNeighbourAware = config.GetIntDefault(\"AiPlayerbot.Grind.NeighbourAware\", 0);   // twow-repo#602 #2\n    if (grindNeighbourAware > 3)\n        grindNeighbourAware = 0;" "config read, > 3 = off")
  need("${config_cpp}" "{\"Grind.NeighbourAware\", Value(grindNeighbourAware)}," "parsed mode in [ConfigEcho] (owner rule #615)")

  # 2. Pure policy (std + the cohort rule only) and its rules.
  string(REGEX MATCHALL "#include [<\"][^>\"]+[>\"]" incs "${policy}")
  foreach(inc ${incs})
    if(NOT inc STREQUAL "#include <algorithm>" AND NOT inc STREQUAL "#include <atomic>" AND NOT inc STREQUAL "#include <cstdint>" AND
       NOT inc STREQUAL "#include \"CohortPolicy.h\"")
      list(APPEND errors "GrindNeighbourPolicy.h is not pure: ${inc}")
    endif()
  endforeach()
  ban("${policy}" "sLog" "logging in the policy")
  need("${policy}" "return ai::cohort::Applies(mode, guidLow);" "applied: mode 1 all, 2 cohort B (3 = nobody)")
  need("${policy}" "return mode >= ai::cohort::ModeAll && mode <= ModeShadow;" "computed in modes 1-3")
  need("${policy}" "constexpr std::uint32_t ModeShadow = 3;" "shadow mode 3")
  need("${policy}" "return w < pw && distance + Penalty(w) < pickDistance + Penalty(pw);" "strictly fewer neighbours and a strictly lower score")
  need("${policy}" "return float(std::min(halfW, HalfCap)) * YdPerHalf;" "capped penalty")
  need("${policy}" "return botDistance > sightDistance - EdgeMargin;" "snapshot edge")
  need("${policy}" "return level <= pickLevel + LevelSlack && (!elite || pickElite);" "level guard")

  # 3. GrindTargetValue: population, stage 1 untouched, the old solo decision unchanged, the score after the loop.
  need("${grind_cpp}" "#include \"playerbot/GrindNeighbourPolicy.h\"" "policy include")
  need("${grind_cpp}" "    uint32 const neighbourMode = sPlayerbotAIConfig.grindNeighbourAware;\n    bool const neighbourScored = ai::grind_neighbour::Computes(neighbourMode) && !assistCount && !group && !bot->InBattleGround() &&\n        !ai->HasRealPlayerMaster() && sRandomPlayerbotMgr.IsFreeBot(bot);" "population: solo free bots, round 0, no battleground, no real master")
  between("${grind_cpp}" "context->GetValue<std::list<ObjectGuid>>(\"possible attack targets\")" "context->GetValue<std::list<ObjectGuid> >(\"possible targets\")" stage1)
  if(stage1 STREQUAL "")
    list(APPEND errors "stage 1 loop not found")
  endif()
  ban("${stage1}" "eighbour" "the neighbour rule in stage 1 (attackers)")
  need("${grind_cpp}" "            if (neighbourScored)\n                neighbourCandidates.push_back({ unit, newdistance, sServerFacade.GetDistance2d(bot, unit) });\n            if (!result || (newdistance < distance && urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.1))\n            {\n                distance = newdistance;\n                result = unit;\n            }" "every solo candidate recorded before the unchanged old decision")
  need("${grind_cpp}" "    if (neighbourScored)\n        result = NeighbourPick(result, neighbourCandidates, targets, ai::grind_neighbour::Applies(neighbourMode, bot->GetGUIDLow()));\n\n    if (result)\n    {\n        logGrind(result, \"selected.\");" "the score after the loop, applied only by Applies")
  between("${grind_cpp}" "Unit* GrindTargetValue::NeighbourPick(" "\n}\n" pick)
  if(pick STREQUAL "")
    list(APPEND errors "NeighbourPick not found")
  endif()
  need("${pick}" "    if (!pick || candidates.empty())\n        return pick;" "no pick, no change")
  need("${pick}" "    return applies && best ? best : pick;" "demote only: shadow and no replacement keep the pick")
  need("${pick}" "if (i == p || !Replaces(candidates[i].distance, halfWs[i], candidates[p].distance, halfWs[p]))" "the replacement rule")
  need("${pick}" "        if (Edge(candidates[p].botDistance, sight))\n            count.edgePick.fetch_add(1, std::memory_order_relaxed);\n        else" "an edge pick is kept")
  need("${pick}" "if (Edge(candidates[i].botDistance, sight))" "an edge candidate never replaces")
  need("${pick}" "if (!GuardOk(int32(candidates[i].unit->GetLevel()), elite, int32(pick->GetLevel()), pickElite))" "level guard")
  need("${pick}" "for (ObjectGuid const& guid : targets)" "neighbours from the pass's own list")
  need("${pick}" "if (entries.size() >= MaxEntries)" "entry cap")
  foreach(costly "Cell::Visit" "IsWithinLOS" "GetValue<" "AI_VALUE" "CalculatePath" "sLog")
    ban("${pick}" "${costly}" "a new search, raycast, value read or log line in the score")
  endforeach()
  need("${grind_h}" "Unit* NeighbourPick(Unit* pick, std::vector<NeighbourCandidate> const& candidates, std::list<ObjectGuid> const& targets, bool applies);" "declaration")

  # 4. Report once per minute after [CastWait], nothing when off.
  before("${mgr_cpp}" "    ReportCastWait();" "    ReportGrindNeighbour();" "report after ReportCastWait")
  need("${mgr_cpp}" "if (!sPlayerbotAIConfig.grindNeighbourAware || now < lastReport + 60)" "report only when on")

  set(${out_var} "${errors}" PARENT_SCOPE)
endfunction()

check("${policy}" "${grind_cpp}" "${grind_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" errs)
if(errs)
  string(REPLACE ";" "\n  " errs "${errs}")
  message(FATAL_ERROR "#602 grind neighbour contract failed:\n  ${errs}")
endif()

# Negative probes: each mutation must make the contract fail.
set(probes 0)
function(probe label var from to)
  string(REPLACE "${from}" "${to}" mut "${${var}}")
  if(mut STREQUAL "${${var}}")
    message(FATAL_ERROR "#602 probe '${label}': mutation did not apply")
  endif()
  set(${var} "${mut}")
  check("${policy}" "${grind_cpp}" "${grind_h}" "${config_h}" "${config_cpp}" "${dist}" "${mgr_cpp}" perrs)
  if(NOT perrs)
    message(FATAL_ERROR "#602 probe '${label}': the contract did not catch it")
  endif()
  math(EXPR probes "${probes} + 1")
  set(probes "${probes}" PARENT_SCOPE)
endfunction()
probe("default on" dist "\nAiPlayerbot.Grind.NeighbourAware = 0\n" "\nAiPlayerbot.Grind.NeighbourAware = 2\n")
probe("unknown mode kept" config_cpp "    if (grindNeighbourAware > 3)\n        grindNeighbourAware = 0;" "")
probe("grouped bots scored" grind_cpp "&& !assistCount && !group && !bot->InBattleGround() &&" "&& !assistCount && !bot->InBattleGround() &&")
probe("shadow applied" grind_cpp "targets, ai::grind_neighbour::Applies(neighbourMode, bot->GetGUIDLow()));" "targets, ai::grind_neighbour::Computes(neighbourMode));")
probe("shadow returns the replacement" grind_cpp "    return applies && best ? best : pick;" "    return best ? best : pick;")
probe("equal W replaces" policy "return w < pw && distance + Penalty(w) < pickDistance + Penalty(pw);" "return distance + Penalty(w) < pickDistance + Penalty(pw);")
probe("no snapshot edge" policy "return botDistance > sightDistance - EdgeMargin;" "return false;")
probe("no level guard" grind_cpp "if (!GuardOk(int32(candidates[i].unit->GetLevel()), elite, int32(pick->GetLevel()), pickElite))" "if (false)")
probe("old decision changed" grind_cpp "urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.1))\n            {\n                distance = newdistance;" "urand(0, abs(distance - newdistance)) > sPlayerbotAIConfig.sightDistance * 0.2))\n            {\n                distance = newdistance;")
probe("stage 1 scored" grind_cpp "        logGrind(unit, \"(hostile) selected.\");" "        logGrind(unit, \"(hostile) selected.\"); // neighbourScored")
probe("grid search in the score" grind_cpp "    float const assistRadius = sWorld.getConfig(CONFIG_FLOAT_CREATURE_FAMILY_ASSISTANCE_RADIUS);" "    Cell::VisitAllObjects(bot, searcher, 30.0f);\n    float const assistRadius = sWorld.getConfig(CONFIG_FLOAT_CREATURE_FAMILY_ASSISTANCE_RADIUS);")
probe("impure policy" policy "#include <cstdint>" "#include <cstdint>\n#include \"Entities/Player.h\"")
probe("report always" mgr_cpp "if (!sPlayerbotAIConfig.grindNeighbourAware || now < lastReport + 60)" "if (now < lastReport + 60)")

message(STATUS "grind_neighbour source contract passed (${probes} negative probes)")
