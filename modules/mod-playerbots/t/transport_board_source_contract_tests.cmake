forbid_text("${ray_fn}" "getMap(" "map query in the deck ray")
require_text("${wp_h}" "        static bool HitsVesselDeck(GenericTransport* transport, float x, float y, float zTop, float zBottom, float* hitZ);" "deck ray declared")
require_text("${wp_h}" "        static transport_board::DeckProbe ProbeVesselDeck(GenericTransport* transport);" "probe declared")
require_text("${wp_h}" "    namespace transport_board { struct DeckProbe; }" "DeckProbe forward-declared (no include in WorldPosition.h)")

# 4. State: in LastMovement next to S1's state, copied; clear() leaves it (the record lapses by S1's gap rule).
require_text("${lastmove_h}" "#include \"playerbot/TransportBoardPolicy.h\"" "policy header in LastMovement")
require_text("${lastmove_h}" "        transport_edge::State transportEdge;\n        // twow-repo#342 (S3b-0, AiPlayerbot.Path.TransportDeckProbe)" "record next to S1's state")
require_text("${lastmove_h}" "        transport_board::DeckWait transportDeck;" "record member")
region("${lastmove_h}" "        LastMovement(LastMovement& other)" "\n        }\n" copy_body)
require_text("${copy_body}" "transportDeck = other.transportDeck;" "copy of the record")
region("${lastmove_h}" "        void clear()" "\n        }\n" clear_body)
forbid_text("${clear_body}" "transportDeck" "clear() touching the probe record")

# 5. Negative probes: each mutation must change the text and be caught, otherwise the scan is broken.
set(caught 0)
macro(expect_caught original_var what)
  if(probe STREQUAL "${${original_var}}")
    message(FATAL_ERROR "${TAG}: negative probe did not apply: ${what}")
  endif()
  if(NOT e)
    message(FATAL_ERROR "${TAG}: negative probe not caught: ${what} - the scan is broken")
  endif()
  math(EXPR caught "${caught} + 1")
endmacro()

# a) the boarding probe without its switch.
string(REPLACE "if (sPlayerbotAIConfig.pathTransportDeckProbe && !bot->GetTransport()" "if (!bot->GetTransport()" probe "${move_cpp}")
check_probe_gates("${probe}" e)
expect_caught(move_cpp "boarding probe ungated")
# b) the wait-branch probe without its switch.
string(REPLACE "${WAIT_GATE}" "    NoteDeckProbe(ai, transport, entry, dockPosition, true);" probe "${move_cpp}")
check_probe_gates("${probe}" e)
expect_caught(move_cpp "wait probe ungated")
# c) the probe answers the boarding.
string(REPLACE "\nstatic void NoteDeckProbe(" "\nstatic bool NoteDeckProbe(" probe "${move_cpp}")
check_probe_gates("${probe}" e)
expect_caught(move_cpp "probe with an answer")
# d) the boarding block answers what the probe found.
string(REPLACE "${BOARD_ANSWER}" "        return bot->GetTransport() != nullptr;" probe "${move_cpp}")
check_probe_gates("${probe}" e)
expect_caught(move_cpp "boarding answer changed")
# e) a hook keeps the fixed S1 constant.
string(REPLACE "        ${KEY_EXPR});\n    transport_edge::Extra extra;" "        transport_edge::WaitTimeoutMs);\n    transport_edge::Extra extra;" probe "${move_cpp}")
check_callers("${probe}" e)
expect_caught(move_cpp "wait hook with the fixed constant")
# f) the deck ray changes isOnTransport for every caller (S3b-1 allows it only under deckHit).
string(REPLACE "    if (deckHit && HitsVesselDeck(transport, coord_x" "    if (HitsVesselDeck(transport, coord_x" probe "${wp_cpp}")
check_deck_ray_scope("${probe}" e)
expect_caught(wp_cpp "deck ray in isOnTransport")
# g) a boarding decision in UseTransport reads the deck ray.
string(REPLACE "if (sPlayerbotAIConfig.pathTransportDeckProbe && !bot->GetTransport() && (doTeleport || !moved))" "if (sPlayerbotAIConfig.pathTransportDeckProbe && !bot->GetTransport() && (doTeleport || !moved) && !WorldPosition::HitsVesselDeck(transport, botPos.getX(), botPos.getY(), botPos.getZ() + 1.0f, botPos.getZ() - 1.0f, nullptr))" probe "${move_cpp}")
check_deck_ray_callers("${probe}" e)
expect_caught(move_cpp "deck ray in UseTransport's board condition")
# h) the probe counted before the roll (lands in the previous window, the very first one lost).
string(REPLACE "    counters.Account();\n    if (counters.Take())" "    if (counters.Take())" probe "${move_cpp}")
string(REPLACE "    transport_board::Counters& counters = transport_board::SharedCounters();\n    transport_board::Snapshot snapshot;" "    transport_board::Counters& counters = transport_board::SharedCounters();\n    counters.Account();\n    transport_board::Snapshot snapshot;" probe "${probe}")
check_count_order("${probe}" e)
expect_caught(move_cpp "probe counted before the roll")

message(STATUS "transport_board source contract passed (${caught} negative probes caught)")
