# The callers pass the key: both S1 hooks, no fixed constant left in the movement code.
function(check_callers move out_var)
  set(${out_var} "" PARENT_SCOPE)
  occurrences("${move}" "${KEY_EXPR}" n)
  if(NOT n EQUAL 2)
    set(${out_var} "expected 2x the TransportWaitTimeoutMin threshold in the S1 wait / aboard hooks, found ${n}" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${move}" "transport_edge::WaitTimeoutMs" old)
  if(NOT old EQUAL -1)
    set(${out_var} "the fixed S1 constant is still passed in the movement code" PARENT_SCOPE)
    return()
  endif()
  region_of("${move}" "void TraceTransportWait(" "\n}\n" wait_fn)
  region_of("${move}" "void TraceTransportAboard(" "\n}\n" aboard_fn)
  foreach(fn wait_fn aboard_fn)
    string(FIND "${${fn}}" "${KEY_EXPR}" at)
    if(at EQUAL -1)
      set(${out_var} "${fn}: the hook does not pass the key" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

# The probe: behind its switch at exactly two places in UseTransport, and it answers nothing the boarding uses.
function(check_probe_gates move out_var)
  set(${out_var} "" PARENT_SCOPE)
  region_of("${move}" "bool MovementAction::UseTransport(PlayerbotAI* ai, uint32 entry, WorldPosition dockPosition" "\nbool MovementAction::MinimalMove(" use)
  region_of("${use}" "{" "\n}\n" use_body)
  if(use_body STREQUAL "")
    set(${out_var} "UseTransport body not found" PARENT_SCOPE)
    return()
  endif()
  occurrences("${use_body}" "NoteDeckProbe(" calls)
  if(NOT calls EQUAL 2)
    set(${out_var} "expected 2 deck probe calls in UseTransport, found ${calls}" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "if \\(sPlayerbotAIConfig\\.pathTransportDeckProbe[^\n]*\n +NoteDeckProbe\\(ai, " gated "${use_body}")
  list(LENGTH gated n_gated)
  if(NOT n_gated EQUAL 2)
    set(${out_var} "every deck probe call must sit directly under 'if (sPlayerbotAIConfig.pathTransportDeckProbe' (found ${n_gated} of 2)" PARENT_SCOPE)
    return()
  endif()
  foreach(gate WAIT_GATE BOARD_GATE)
    string(FIND "${use_body}" "${${gate}}" at)
    if(at EQUAL -1)
      set(${out_var} "${gate} changed" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # The answers of UseTransport are S1's (true at the exit and after the boarding try, false aboard and while waiting).
  occurrences("${use_body}" "return true;" n_true)
  occurrences("${use_body}" "return false;" n_false)
  if(NOT n_true EQUAL 1 OR NOT n_false EQUAL 2)
    set(${out_var} "UseTransport answers changed (true ${n_true}, false ${n_false}; expected 1 / 2 plus the S3b-1 board answer)" PARENT_SCOPE)
    return()
  endif()
  # Boarding block: the probe after S1's board / board_point line, before the unchanged true answer, no answer of its own.
  region_of("${use_body}" "        bool const moved = MoveOnTransport(ai, transport, doTeleport, edgeTrace ? &rejects : nullptr);" "\n    }\n" board_block)
  string(FIND "${board_block}" "TraceTransportBoard(bot, *edge, moved, doTeleport, rejects," trace_at)
  string(FIND "${board_block}" "${BOARD_GATE}" probe_at)
  string(FIND "${board_block}" "\n${BOARD_ANSWER}" answer_at)
  if(trace_at EQUAL -1 OR probe_at EQUAL -1 OR answer_at EQUAL -1 OR NOT trace_at LESS probe_at OR NOT probe_at LESS answer_at)
    set(${out_var} "the boarding probe must sit after TraceTransportBoard and before the true answer" PARENT_SCOPE)
    return()
  endif()
  occurrences("${board_block}" "return" n_return)
  if(NOT n_return EQUAL 1)
    set(${out_var} "the boarding block must keep its one answer (found ${n_return} 'return')" PARENT_SCOPE)
    return()
  endif()
  # Wait branch: after the debug lines, before S1's attempt hook and its false answer.
  string(FIND "${use_body}" "\"y from docking.\", \"debug move\");\n\n${WAIT_GATE}\n\n    if (edgeTrace)   // twow-repo#342 (S1): state=attempt" wait_at)
  if(wait_at EQUAL -1)
    set(${out_var} "the wait-branch probe must sit between the debug line and S1's attempt hook" PARENT_SCOPE)
    return()
  endif()
  # The probe returns nothing, and nobody reads an answer.
  string(FIND "${move}" "\nstatic void NoteDeckProbe(PlayerbotAI* ai, GenericTransport* transport, uint32 entry, WorldPosition const& dock, bool needStop)\n{" sig)
  if(sig EQUAL -1)
    set(${out_var} "NoteDeckProbe must be a void function" PARENT_SCOPE)
    return()
  endif()
  occurrences("${move}" "NoteDeckProbe(" n_all)
  if(NOT n_all EQUAL 3)
    set(${out_var} "expected NoteDeckProbe defined once and called twice, found ${n_all}" PARENT_SCOPE)
    return()
  endif()
  foreach(use "= NoteDeckProbe(" "return NoteDeckProbe(" "(NoteDeckProbe(" "!NoteDeckProbe(" "&& NoteDeckProbe(" "|| NoteDeckProbe(")
    string(FIND "${move}" "${use}" at)
    if(NOT at EQUAL -1)
      set(${out_var} "the probe's result is used: ${use}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

# The deck ray is used by the probe (S3b-0) and, behind S3b-1's switches only, by isOnTransport (deckHit) and SetOnTransport
# (TransportBoardFix; their gates are pinned by transport_board_fix_source_contract); RandomPointOnTrans never calls it, and
# no boarding code reads the probe.
function(check_deck_ray_scope wp out_var)
  set(${out_var} "" PARENT_SCOPE)
  occurrences("${wp}" "HitsVesselDeck(" n)
  if(NOT n EQUAL 5)
    set(${out_var} "HitsVesselDeck must be defined once, used twice by the probe and once each by the gated S3b-1 deck checks, found ${n}" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${wp}" "${IS_ON_TAIL}" tail)
  if(tail EQUAL -1)
    set(${out_var} "isOnTransport's answer changed (the deck hit only under deckHit, then the static answer)" PARENT_SCOPE)
    return()
  endif()
  region_of("${wp}" "bool WorldPosition::SetOnTransport(" "\n}\n" set_on)
  region_of("${wp}" "WorldPosition WorldPosition::RandomPointOnTrans(GenericTransport* transport, uint32 radius, Player* botForPath" "\n}\n" random_on)
  if(set_on STREQUAL "" OR random_on STREQUAL "")
    set(${out_var} "SetOnTransport / RandomPointOnTrans not found" PARENT_SCOPE)
    return()
  endif()
  foreach(body set_on random_on)
    foreach(word ProbeVesselDeck pathTransportDeckProbe)
      string(FIND "${${body}}" "${word}" at)
      if(NOT at EQUAL -1)
        set(${out_var} "${body}: ${word} changes the boarding point" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  string(FIND "${random_on}" "HitsVesselDeck" rp)
  if(NOT rp EQUAL -1)
    set(${out_var} "random_on: HitsVesselDeck changes the boarding point" PARENT_SCOPE)
    return()
  endif()
endfunction()

# The movement side of the ray scope: no deck ray in the movement code, the probe called once, from NoteDeckProbe only.
function(check_deck_ray_callers move out_var)
  set(${out_var} "" PARENT_SCOPE)
  string(FIND "${move}" "HitsVesselDeck" ray)
  if(NOT ray EQUAL -1)
    set(${out_var} "HitsVesselDeck in the movement code (a boarding decision on the deck ray is S3b-1)" PARENT_SCOPE)
    return()
  endif()
  occurrences("${move}" "ProbeVesselDeck(" n)
  if(NOT n EQUAL 1)
    set(${out_var} "expected 1x ProbeVesselDeck in the movement code (NoteDeckProbe), found ${n}" PARENT_SCOPE)
    return()
  endif()
  region_of("${move}" "\nstatic void NoteDeckProbe(" "\n}\n" note)
  string(FIND "${note}" "WorldPosition::ProbeVesselDeck(transport)" at)
  if(at EQUAL -1)
    set(${out_var} "ProbeVesselDeck called outside NoteDeckProbe" PARENT_SCOPE)
    return()
  endif()
endfunction()

# The probe is counted in its own minute: Roll, then Account, then Take (S1's LogTransportEdge order); no other count.
function(check_count_order move out_var)
  set(${out_var} "" PARENT_SCOPE)
  region_of("${move}" "\nstatic void LogTransportBoardLine(" "\n}\n" log)
  string(FIND "${log}" "if (counters.Roll(uint64(time(nullptr)), snapshot))" roll_at)
  string(FIND "${log}" "\n    counters.Account();\n" account_at)
  string(FIND "${log}" "if (counters.Take())" take_at)
  if(roll_at EQUAL -1 OR account_at EQUAL -1 OR take_at EQUAL -1 OR NOT roll_at LESS account_at OR NOT account_at LESS take_at)
    set(${out_var} "LogTransportBoardLine must Roll, then Account, then Take (a probe counted before the roll lands in the previous window)" PARENT_SCOPE)
    return()
  endif()
  occurrences("${move}" "probes.fetch_add" n_raw)
  occurrences("${move}" "counters.Account();" n_account)
  if(NOT n_raw EQUAL 0 OR NOT n_account EQUAL 1)
    set(${out_var} "the probe must be counted only by LogTransportBoardLine's Account (raw ${n_raw}, Account ${n_account})" PARENT_SCOPE)
    return()
  endif()
endfunction()

