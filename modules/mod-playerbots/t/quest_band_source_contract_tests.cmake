# twow-repo#601 S5a (OB-00 D9 19.10.2026; S5A-DESIGN.md with the answers of OB-00 / OB-10 / OB-30 / CLI-PATH 19.10.2026):
# AiPlayerbot.QuestFirstProgression.BandLadder (0 off, 1 all, 2 odd low guids = cohort B, 3 even = cohort A), the band step
# to the next quest hub of hub-ladder.tsv with a fixed-end trip. Pins:
#  - the pure policy (no game types, no locks, no config, no area ids; Applies never accepts 0),
#  - inert at 0: every new entry reads the switch first or a field only the band path writes; the conf ships 0 and "",
#  - the clock: one SetBandTripEnd site, the end written only in CopyTarget / EndBandTrip / NoteBandTripReplaced, the
#    SetStatus clamp after the gap clamps, the CheckStatus band block after the travel-once clear and before the rest-gate
#    hold, the arrival block before WORK, no failure / retry / extension in the ends (OB-10 Q4: replaced is no failure),
#  - the guards: no refresh, no group copy of a band hub trip, the idle rescue waits for a running trip, never forced, the
#    request's condition cleared after the band setNewTarget,
#  - the entry: after the S1 classification, before the 8.1 count and backoff; P3-a / Z1b win; no counter writes,
#  - the giver filter E (grey, accept rule) / F (DIALOG_STATUS_AVAILABLE only) from the snapshot bit, no value per creature;
#    OB-10 Q1: a giver trip whose quest is taken ends EXPIRED at once (giver_done=), no COOLDOWN; OB-10 Q3: a full log is
#    skipped and counted with its group / elite quests (log_full), nothing dropped,
#  - the loader: fail closed, node by position (nearest within 10 yd, <= 2 yd, same name; CLI-PATH Q10), top-level zones,
#    taxi paths and the roster taxi cheat for flight rows, FNV-1a on the boot line (OB-30 Q9), boot only,
#  - the rescue: second expiry, max(lastBandRescue, lastQuestRescue) window, stamped before the request, the hub taken after
#    the global limiter, the reset and line before the heartbeat; the lines only from the policy, relaxed atomics, no lock.
# Reads only named files below modules/mod-playerbots/src/playerbot (never a glob, never src/modules/Eluna).

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#601 S5a band ladder: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#601 S5a band ladder: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" first_at)
  string(FIND "${text}" "${second}" second_at)
  if(first_at EQUAL -1 OR second_at EQUAL -1 OR NOT first_at LESS second_at)
    message(FATAL_ERROR "#601 S5a band ladder: order (${description}): '${first}' must come before '${second}'")
  endif()
endfunction()

# The part of `text` from `start` up to the first `end` after it (both required).
function(region text start end out)
  string(FIND "${text}" "${start}" start_at)
  if(start_at EQUAL -1)
    message(FATAL_ERROR "#601 S5a band ladder: missing region start: ${start}")
  endif()
  string(SUBSTRING "${text}" ${start_at} -1 rest)
  string(LENGTH "${start}" start_length)
  string(SUBSTRING "${rest}" ${start_length} -1 tail)
  string(FIND "${tail}" "${end}" end_at)
  if(end_at EQUAL -1)
    message(FATAL_ERROR "#601 S5a band ladder: missing region end: ${end}")
  endif()
  math(EXPR length "${start_length} + ${end_at}")
  string(SUBSTRING "${rest}" 0 ${length} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

function(count_text text needle expected description)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" len)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR next "${at} + ${len}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endwhile()
  if(NOT n EQUAL expected)
    message(FATAL_ERROR "#601 S5a band ladder: ${description}: expected ${expected} x '${needle}', found ${n}")
  endif()
endfunction()

