# twow-repo#601 R01 L1 (owner decision D1 19.10.2026, OB-00 D10, AiPlayerbot.ActivityTrace): what a roster bot does with
# its time - one sample a minute per bot, one [BotActivity] line per bot and clock hour, one [BotActivityMin] line a
# minute. Log only: behind the switch, only values the bot holds, no lock, no search. Reads named files only.

# cmake 3.x script mode (Debian trixie builder / CI): policies as in the host cmake 4.x.
cmake_policy(VERSION 3.16)

if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#601 BotActivity: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#601 BotActivity: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#601 BotActivity: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(count_text text needle expected description)
  string(LENGTH "${needle}" len)
  set(n 0)
  set(rest "${text}")
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR at "${at} + ${len}")
    string(SUBSTRING "${rest}" ${at} -1 rest)
  endwhile()
  if(NOT n EQUAL ${expected})
    message(FATAL_ERROR "#601 BotActivity: ${description}: expected ${expected} x '${needle}', found ${n}")
  endif()
endfunction()

# the text of one function: from its signature to the next line that is a lone "}"
function(function_body text signature out_var)
  string(FIND "${text}" "${signature}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "#601 BotActivity: function not found: ${signature}")
  endif()
  string(SUBSTRING "${text}" ${at} -1 rest)
  string(FIND "${rest}" "\n}\n" end)
  if(end EQUAL -1)
    message(FATAL_ERROR "#601 BotActivity: end of function not found: ${signature}")
  endif()
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

read_source("BotActivityPolicy.h" policy)
read_source("TravelMgr.h" travel_h)
read_source("PlayerbotAI.h" ai_h)
read_source("PlayerbotAI.cpp" ai_cpp)
read_source("RandomPlayerbotMgr.cpp" mgr_cpp)
read_source("PlayerbotAIConfig.h" config_h)
read_source("PlayerbotAIConfig.cpp" config_cpp)
read_source("aiplayerbot.conf.dist.in" conf_dist)

# 1. Pure policy: std only, no logging, no lock; the travel status mapping matches TravelMgr.h.
forbid_text("${policy}" "#include \"" "game include in the policy")
forbid_text("${policy}" "sLog" "logging in the policy")
forbid_text("${policy}" "mutex" "a lock in the policy (relaxed atomics only)")
require_text("${policy}" "namespace ai::bot_activity" "policy namespace")
require_text("${policy}" "constexpr std::uint32_t SampleSeconds = 60;" "one sample a minute")
require_text("${policy}" "constexpr std::uint32_t MaxCreditSeconds = 120;" "a longer gap is no kind")
require_text("${policy}" "    return status >= 1 && status <= 4;" "PREPARE..WORK are active")
foreach(status "TRAVEL_STATUS_NONE = 0," "TRAVEL_STATUS_PREPARE = 1," "TRAVEL_STATUS_READY = 2," "TRAVEL_STATUS_TRAVEL = 3,"
    "TRAVEL_STATUS_WORK = 4," "TRAVEL_STATUS_COOLDOWN = 5," "TRAVEL_STATUS_EXPIRED = 6,")
  require_text("${travel_h}" "${status}" "TravelStatus value the policy relies on")
endforeach()
require_text("${policy}" "constexpr float StuckYards = 5.0f;" "stuck below 5 yd")
require_text("${policy}" "constexpr std::uint8_t StatusTravel = 3;" "TRAVEL status")
require_text("${policy}" "constexpr std::uint8_t StatusWork = 4;" "WORK status")
require_order("${policy}" "    if (s.parked)\n        return Kind::Parked;" "    if (!s.alive)\n        return Kind::Dead;" "parked before dead")
require_order("${policy}" "    if (!s.alive)\n        return Kind::Dead;" "    if (s.inCombat)\n        return Kind::Combat;" "dead before combat")
require_order("${policy}" "    if (s.inCombat)\n        return Kind::Combat;" "    if (TravelActive(s.status) && s.dest != Dest::None)" "combat before the target")
# OB-10 review: an active target must not hide a stall
require_text("${policy}" "    return s.status == StatusTravel && !s.taxiFlying && s.moved < StuckYards;" "stuck sample: TRAVEL without moving")
# twow-repo#601 (OB-00 28.10.2026): a RosterFarMove wait is travel, not stuck (contracts.d/activity_far_wait_idle_detail)
require_text("${policy}" "        if (StuckSample(s) && !s.farMoveWaiting)\n            return Kind::Stuck;" "stuck: TRAVEL without moving, no far-move wait")
require_text("${policy}" "            return s.status == StatusWork && !s.combatSinceSample ? Kind::GrindIdle : Kind::Grind;" "grind_idle: WORK without a fight")
require_order("${policy}" "            return Kind::Stuck;" "            return s.status == StatusWork && !s.combatSinceSample" "stuck before grind_idle")
require_order("${policy}" "    if (TravelActive(s.status) && s.dest != Dest::None)" "    if (s.taxiFlying)\n        return Kind::Other;" "the target before a flight")
require_text("${policy}" "std::string line = \"[BotActivity] bot=\"" "hour line tag")
require_text("${policy}" "std::string line = \"[BotActivityMin]\";" "minute line tag")

# 2. The sample: behind the switch, roster bots without a real master, once in UpdateAI before the progress watch.
set(gate "    if (sPlayerbotAIConfig.activityTrace && sRandomPlayerbotMgr.IsPersistentRosterMember(bot->GetGUIDLow()) && !HasRealPlayerMaster())\n        SampleActivity(uint32(time(nullptr)));")
require_text("${ai_cpp}" "${gate}" "the gate")
count_text("${ai_cpp}" "SampleActivity(" 2 "SampleActivity call + definition")
require_order("${ai_cpp}" "${gate}" "    // #421 C: progress watch." "sample before the progress watch")
require_text("${ai_h}" "#include \"playerbot/BotActivityPolicy.h\"" "policy include")
require_text("${ai_h}" "    ai::bot_activity::Clock activityClock;" "per-bot clock")
function_body("${ai_cpp}" "void PlayerbotAI::SampleActivity(uint32 now)" sample)
require_order("${sample}" "    activityClock.NoteCombat(bot->IsInCombat());" "    if (!activityClock.Due(now))\n        return;" "combat noted at every update, before the minute check")
require_order("${sample}" "    if (!activityClock.Due(now))\n        return;" "GetValue<TravelTarget*>(\"travel target\")" "nothing read before the minute is due")
require_text("${sample}" "    state.parked = IsParked();" "parked bots counted apart")
require_text("${sample}" "    state.combatSinceSample = activityClock.TakeCombat();" "combat since the last sample")
require_text("${sample}" "    state.moved = activityClock.Move(bot->GetMapId(), bot->GetPositionX(), bot->GetPositionY());" "yards moved since the last sample")
forbid_text("${sample}" "mutex" "a lock in the sample")
forbid_text("${sample}" "lock_guard" "a lock in the sample")
forbid_text("${sample}" "GetValue<std::list" "a list value (search) in the sample")
require_text("${sample}" "dynamic_cast<QuestTravelDestination*>(destination) ? ai::bot_activity::Dest::Quest" "quest destination")
require_text("${sample}" "dynamic_cast<GrindTravelDestination*>(destination) ? ai::bot_activity::Dest::Grind" "grind destination")
require_text("${sample}" "dynamic_cast<NullTravelDestination*>(destination) ? ai::bot_activity::Dest::None" "null destination is none")
require_text("${sample}" "    ai::bot_activity::Kind const kind = ai::bot_activity::Classify(state);" "classify from the bot's own state")
# the seconds since the last sample go to their (old) hour before that hour's line is written
require_order("${sample}" "activityClock.Add(kind, now)" "activityClock.HourDone(now)" "credit before the hour line")
require_order("${sample}" "activityClock.HourDone(now)" "sLog.outBasic(\"%s\", ai::bot_activity::FormatLine(" "hour line when the hour is done")
require_order("${sample}" "sLog.outBasic(\"%s\", ai::bot_activity::FormatLine(" "activityClock.StartHour(now);" "fresh hour after the line")
# twow-repo#601 quest acceptance (OB-00 27.10.2026): the quest log fill counted only when the hour line is written, from the
# 20 slots (no quest status map walk), and passed to the line.
require_order("${sample}" "activityClock.HourDone(now)" "for (uint16 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)" "quest log counted only for the hour line")
require_order("${sample}" "for (uint16 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)" "sLog.outBasic(\"%s\", ai::bot_activity::FormatLine(" "counted before the line")
require_text("${sample}" "activityClock,\n            questLog, questDone).c_str());" "quest log fields on the hour line")
require_text("${policy}" "        line += \" quest_log=\" + std::to_string(questLog) + \" quest_done=\" + std::to_string(questDone);" "quest_log= quest_done= after gap= (far_wait= is last, #601 28.10.)")

# 3. The minute line: one reporter, switched like ReportBotUpdate, called once per pass.
function_body("${mgr_cpp}" "void ReportBotActivity()" report)
require_order("${report}" "    if (!sPlayerbotAIConfig.activityTrace)" "ai::bot_activity::Global().Take();" "nothing when off")
require_text("${report}" "    if (now < lastReport + 60)\n        return;" "once a minute")
require_text("${report}" "sLog.outBasic(\"%s\", ai::bot_activity::FormatMinuteLine(ai::bot_activity::Global().Take()).c_str());" "minute line")
count_text("${mgr_cpp}" "    ReportBotActivity();" 1 "reporter call")

