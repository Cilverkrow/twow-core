cmake_policy(VERSION 3.16)
# twow-repo#541 (L1): behind AiPlayerbot.Perf.PartialPathReuse (default 0, behaviour change in timing) and
# AiPlayerbot.Perf.PartialPathReuseMs (default 10000, clamp 1000..60000) MovementAction::ResolveMovePath uses the
# path it last built for the same destination again instead of rebuilding it, while the build is younger than the
# limit, lastPath still ends at the stored end point, the bot is on the map of the build, not on a transport and not
# yet at the path's end. The stamp lives in the bot's own LastMovement value. Off: no clock read, no stamp, no
# counter - the rebuild of today. Every existing reuse / keep-old rule and every lastPath reset stays.

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#541 L1: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#541 L1: forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#541 L1: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(function_body text signature out_var)
  string(FIND "${text}" "${signature}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "#541 L1: function not found: ${signature}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "\n}\n" end)
  if(end EQUAL -1)
    message(FATAL_ERROR "#541 L1: function end not found: ${signature}")
  endif()
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

function(region text from to out_var)
  string(FIND "${text}" "${from}" a)
  if(a EQUAL -1)
    message(FATAL_ERROR "#541 L1: region start not found: ${from}")
  endif()
  string(SUBSTRING "${text}" ${a} -1 rest)
  string(FIND "${rest}" "${to}" b)
  if(b EQUAL -1)
    message(FATAL_ERROR "#541 L1: region end not found: ${to}")
  endif()
  string(SUBSTRING "${rest}" 0 ${b} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

read_source("PathReusePolicy.h" policy)
read_source("strategy/actions/MovementActions.cpp" move_cpp)
read_source("strategy/values/LastMovementValue.h" lastmove_h)
read_source("RandomPlayerbotMgr.cpp" rnd_mgr)
read_source("PlayerbotAIConfig.h" config_h)
read_source("PlayerbotAIConfig.cpp" config_cpp)
read_source("aiplayerbot.conf.dist.in" conf_dist)

# 1. Switches: default off / 10000 in code, clamped, documented, appended after the last #541 block member.
require_text("${config_h}" "    bool perfPartialPathReuse = false;  // twow-repo#541 (L1)" "member default off")
require_text("${config_h}" "    uint32 perfPartialPathReuseMs = 10000;  // twow-repo#541 (L1)" "age member default 10000")
require_order("${config_h}" "bool possibleTargetsSharedSearch = false;" "bool perfPartialPathReuse = false;" "appended after the last block member")
require_order("${config_h}" "bool perfPartialPathReuse = false;" "bool persistentActiveRosterMaintenanceMode = false;" "inside the #541 block")
require_text("${config_cpp}" "perfPartialPathReuse = config.GetBoolDefault(\"AiPlayerbot.Perf.PartialPathReuse\", false);" "load default off")
require_text("${config_cpp}" "perfPartialPathReuseMs = ai::path_reuse::ClampMs(config.GetIntDefault(\"AiPlayerbot.Perf.PartialPathReuseMs\", int32(ai::path_reuse::DefaultMs)));" "age load clamped")
require_text("${config_cpp}" "#include \"playerbot/PathReusePolicy.h\"" "policy header in the config")
require_text("${policy}" "constexpr std::uint32_t DefaultMs = 10000;" "default 10 s")
require_text("${policy}" "constexpr std::uint32_t MinMs = 1000;" "lower clamp")
require_text("${policy}" "constexpr std::uint32_t MaxMs = 60000;" "upper clamp")
require_text("${policy}" "return stamped && samePathEnd && sameDestination && sameStartMap && !endReached && !onTransport && ageMs < maxAgeMs;" "all reuse conditions")
require_text("${conf_dist}" "\nAiPlayerbot.Perf.PartialPathReuse = 0\n" "documented off")
require_text("${conf_dist}" "\nAiPlayerbot.Perf.PartialPathReuseMs = 10000\n" "documented age")
require_text("${conf_dist}" "enable only after OB-30 measurement + owner go - nach Abnahme an" "acceptance note")
require_text("${conf_dist}" "a truly better path is found at most PartialPathReuseMs later" "exact behaviour note")

# 2. ResolveMovePath: reuse after the existing reuse test, before any rebuild; stamp only with the switch.
function_body("${move_cpp}" "TravelPath MovementAction::ResolveMovePath(" resolve_body)
require_text("${resolve_body}" "    bool const pathReuse = sPlayerbotAIConfig.perfPartialPathReuse;\n    if (pathReuse)\n    {" "one switch read, reuse block behind it")
require_order("${resolve_body}" "if (!lastMove.lastPath.empty() && lastMove.lastPath.getBack().distance(endPosition) < maxDistChange)" "bool const pathReuse = sPlayerbotAIConfig.perfPartialPathReuse;" "existing reuse test first, unchanged")
require_order("${resolve_body}" "    if (pathReuse)\n    {" "    bool needsLongPath = false;" "reuse decided before the rebuild")
require_order("${resolve_body}" "    if (pathReuse)\n    {" "sTravelNodeMap.getFullPath(" "reuse before the node route")
require_order("${resolve_body}" "    if (pathReuse)\n    {" "startPosition.getPathTo(endPosition, bot)" "reuse before the navmesh path")
region("${resolve_body}" "    if (pathReuse)\n    {" "    bool needsLongPath = false;" reuse_block)
require_text("${reuse_block}" "if (lastMove.pathReuseStamped && !lastMove.lastPath.empty())" "only a stamped, non-empty lastPath")
require_text("${reuse_block}" "ageMs = WorldTimer::getMSTimeDiff(lastMove.pathReuseBuiltMs, WorldTimer::getMSTime());" "wrap-safe age")
require_text("${reuse_block}" "pathEnd.getMapId() == lastMove.pathReuseBack.getMapId() && pathEnd.distance(lastMove.pathReuseBack) < path_reuse::SameEndYards" "lastPath still the stamped path")
require_text("${reuse_block}" "lastMove.pathReuseDest.getMapId() == endPosition.getMapId() && lastMove.pathReuseDest.distance(endPosition) < maxDistChange" "destination unchanged within maxDistChange")
require_text("${reuse_block}" "lastMove.pathReuseStartMap == startPosition.getMapId()" "map change rebuilds")
require_text("${reuse_block}" "pathEnd.getMapId() == startPosition.getMapId() && startPosition.distance(pathEnd) < sPlayerbotAIConfig.targetPosRecalcDistance" "end reached rebuilds")
require_text("${reuse_block}" "bot->GetTransport() != nullptr" "transport rebuilds")
require_text("${reuse_block}" "ageMs, sPlayerbotAIConfig.perfPartialPathReuseMs);" "age limit from the config")
require_text("${reuse_block}" "path_reuse::hits.fetch_add(1, std::memory_order_relaxed);" "hit counted")
require_text("${reuse_block}" "path_reuse::misses.fetch_add(1, std::memory_order_relaxed);" "miss counted")
require_order("${reuse_block}" "path_reuse::hits.fetch_add" "            return lastMove.lastPath;" "hit counted before the return")
require_text("${reuse_block}" "            if (traceEngine)\n                traceEngine->TraceNote(\"M:reuse hit age=%ums\", ageMs);" "reuse token only with the trace")
forbid_text("${reuse_block}" "GetBotAI(" "other bots' values")
forbid_text("${reuse_block}" "static " "static cache")
# Stamp: last step before the return, only with the switch, after the keep-old rule and the fallback point.
require_order("${resolve_body}" "outMovePath = lastMove.lastPath;\n        if (traceEngine)" "    if (pathReuse)\n    {\n        lastMove.pathReuseStamped = true;" "stamp after the keep-old rule")
require_order("${resolve_body}" "        outMovePath.addPoint(endPosition);" "    if (pathReuse)\n    {\n        lastMove.pathReuseStamped = true;" "stamp after the fallback point")
require_text("${resolve_body}" "        lastMove.pathReuseDest = endPosition;\n        lastMove.pathReuseBack = outMovePath.getBack();\n        lastMove.pathReuseStartMap = startPosition.getMapId();\n        lastMove.pathReuseBuiltMs = WorldTimer::getMSTime();\n    }\n\n    return outMovePath;" "complete stamp right before the return")
# The existing rules stay as they are.
require_text("${resolve_body}" "if (!lastMove.lastPath.empty() && !outMovePath.empty() && lastMove.lastPath.getBack().distance(endPosition) <= outMovePath.getBack().distance(endPosition))\n    {\n        outMovePath = lastMove.lastPath;" "keep-old rule unchanged")
require_text("${resolve_body}" "    if (outMovePath.empty())\n        outMovePath.addPoint(endPosition);" "fallback point unchanged")
require_text("${move_cpp}" "#include \"playerbot/PathReusePolicy.h\"" "policy header")
# Only ResolveMovePath touches the stamp.
string(REPLACE "${resolve_body}" "" move_rest "${move_cpp}")
forbid_text("${move_rest}" "pathReuse" "stamp use outside ResolveMovePath")

# 3. Stamp in the bot's own LastMovement: default unset, dropped by clear(), copied by the copy constructor.
require_text("${lastmove_h}" "        bool pathReuseStamped = false;\n        WorldPosition pathReuseDest;\n        WorldPosition pathReuseBack;\n        uint32 pathReuseStartMap = 0;\n        uint32 pathReuseBuiltMs = 0;" "stamp members")
region("${lastmove_h}" "        void clear()" "\n        }\n" clear_body)
require_text("${clear_body}" "pathReuseStamped = false;" "clear() drops the stamp")
require_text("${clear_body}" "lastPath.clear();" "clear() still empties lastPath")
region("${lastmove_h}" "        LastMovement(LastMovement& other)" "\n        }\n" copy_body)
foreach(member pathReuseStamped pathReuseDest pathReuseBack pathReuseStartMap pathReuseBuiltMs)
  require_text("${copy_body}" "${member} = other.${member};" "copy of ${member}")
endforeach()
forbid_text("${lastmove_h}" "std::mutex" "lock in a bot-own value")

# 4. [PathReuse]: gated minute line, world thread, plain call before the PerfMon Init.
function_body("${rnd_mgr}" "void ReportPathReuse()" report_body)
require_text("${report_body}" "if (!sPlayerbotAIConfig.perfPartialPathReuse || now < lastReport + 60)\n        return;" "nothing when off, once a minute")
require_text("${report_body}" "ai::path_reuse::hits.exchange(0, std::memory_order_relaxed);" "hits taken")
require_text("${report_body}" "ai::path_reuse::misses.exchange(0, std::memory_order_relaxed);" "misses taken")
require_text("${report_body}" "sLog.outBasic(\"[PathReuse] hits=%llu misses=%llu max_age_ms=%u\"" "minute line")
function_body("${rnd_mgr}" "void RandomPlayerbotMgr::UpdateAIInternal(uint32 elapsed, bool minimal)" upd_body)
require_order("${upd_body}" "\n    ReportLazyEngineInit();" "\n    ReportPathReuse();" "after [LazyEngineInit]")
require_order("${upd_body}" "\n    ReportPathReuse();" "sPerformanceMonitor.Init(0, 0);" "report before the PerfMon Init")
require_text("${rnd_mgr}" "#include \"playerbot/PathReusePolicy.h\"" "policy header in the manager")

message(STATUS "partial_path_reuse source contract passed")
