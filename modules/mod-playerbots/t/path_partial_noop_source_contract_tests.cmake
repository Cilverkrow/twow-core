require_text("${config_cpp}" "pathPartialNoopReach = std::min(10.0f, std::max(0.5f, config.GetFloatDefault(\"AiPlayerbot.Path.PartialNoop.Reach\", ai::path_fail::PartialNoopDefaultReach)));" "reach clamped")
require_text("${config_cpp}" "pathPartialNoopGap = std::min(100.0f, std::max(1.0f, config.GetFloatDefault(\"AiPlayerbot.Path.PartialNoop.Gap\", ai::path_fail::PartialNoopDefaultGap)));" "gap clamped")
require_text("${conf_dist}" "\nAiPlayerbot.Path.PartialNoop = 0\n" "dist off")
