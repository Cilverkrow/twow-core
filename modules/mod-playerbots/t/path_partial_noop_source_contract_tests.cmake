cmake_policy(VERSION 3.16)
# twow-repo#575 (QFO 41747, CLI-PATH 22.10.2026): AiPlayerbot.Path.PartialNoop, default 0 = old behaviour.
# A partial path whose end the bot already stands at (navmesh island, Tower of Azora turn-in) makes MoveTo2 fail instead
# of a no-op success, so the travel retry / cooldown / #485 turn-in park can run.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#575 PartialNoop: missing ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#575 PartialNoop: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(count_text text needle expected description)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nlen)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR from "${at} + ${nlen}")
    string(SUBSTRING "${rest}" ${from} -1 rest)
  endwhile()
  if(NOT n EQUAL ${expected})
    message(FATAL_ERROR "#575 PartialNoop: expected ${expected}x ${description}, found ${n}")
  endif()
endfunction()

function(region text start_marker end_marker out_var)
  string(FIND "${text}" "${start_marker}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "#575 PartialNoop: region start not found: ${start_marker}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "${end_marker}" len)
  if(len EQUAL -1)
    message(FATAL_ERROR "#575 PartialNoop: region end not found: ${end_marker}")
  endif()
  string(SUBSTRING "${rest}" 0 ${len} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

read_source("PlayerbotAIConfig.h" config_h)
read_source("PlayerbotAIConfig.cpp" config_cpp)
read_source("aiplayerbot.conf.dist.in" conf_dist)
read_source("PathFailPolicy.h" policy)
read_source("strategy/actions/MovementActions.cpp" move_cpp)

# 1. switch default off, bounded tuning, documented off in the dist, echoed.
require_text("${config_h}" "    bool pathPartialNoop = false;" "member default off")
require_text("${config_h}" "    float pathPartialNoopReach = 2.0f;" "reach default")
require_text("${config_h}" "    float pathPartialNoopGap = 5.0f;" "gap default")
require_text("${config_cpp}" "pathPartialNoop = config.GetBoolDefault(\"AiPlayerbot.Path.PartialNoop\", false);" "switch read off")
require_text("${config_cpp}" "pathPartialNoopReach = std::min(10.0f, std::max(0.5f, config.GetFloatDefault(\"AiPlayerbot.Path.PartialNoop.Reach\", ai::path_fail::PartialNoopDefaultReach)));" "reach clamped")
require_text("${config_cpp}" "pathPartialNoopGap = std::min(100.0f, std::max(1.0f, config.GetFloatDefault(\"AiPlayerbot.Path.PartialNoop.Gap\", ai::path_fail::PartialNoopDefaultGap)));" "gap clamped")
require_text("${conf_dist}" "\nAiPlayerbot.Path.PartialNoop = 0\n" "dist off")
require_text("${conf_dist}" "\nAiPlayerbot.Path.PartialNoop.Reach = 2\n" "dist reach")
require_text("${conf_dist}" "\nAiPlayerbot.Path.PartialNoop.Gap = 5\n" "dist gap")
require_text("${config_cpp}" "{\"Path.PartialNoop\", Value(pathPartialNoop)}," "ConfigEcho entry")

# 2. the decision: same map, bot within reach of the path end, path end farther than gap from the target.
region("${policy}" "inline bool IsPartialNoop(" "\n}\n" decide)
require_text("${decide}" "return sameMap && botToPathEnd <= reach && pathEndToTarget > gap;" "decision")
require_text("${policy}" "constexpr float PartialNoopDefaultReach = 2.0f;" "default reach")
require_text("${policy}" "constexpr float PartialNoopDefaultGap = 5.0f;" "default gap")
require_text("${policy}" "inline Counters& PartialNoopCounters() { static Counters counters; return counters; }" "own counters")

# 3. MoveTo2: gated, after the resolved path and its empty check, before the shortcut; fails; logs within budget.
region("${move_cpp}" "bool MovementAction::MoveTo2(" "\nbool MovementAction::" moveto2)
region("${moveto2}" "    if (sPlayerbotAIConfig.pathPartialNoop && !noPath && !bot->GetTransport())\n    {" "\n    }\n" gate)
require_text("${gate}" "WorldPosition const pathEnd = movePath.getBack();" "path end")
require_text("${gate}" "bool const sameMap = pathEnd.getMapId() == startPos.getMapId() && pathEnd.getMapId() == endPos.getMapId();" "same map on both sides")
require_text("${gate}" "if (path_fail::IsPartialNoop(sameMap, sameMap ? startPos.distance(pathEnd) : 0.0f, sameMap ? pathEnd.distance(endPos) : 0.0f,\n                sPlayerbotAIConfig.pathPartialNoopReach, sPlayerbotAIConfig.pathPartialNoopGap))" "decision call")
require_text("${gate}" "            LogPartialNoop(bot, getName(), startPos, endPos, pathEnd);\n            return false;" "fails after the line")
require_order("${moveto2}" "TravelPath movePath = ResolveMovePath(startPos, endPos, mover, lastMove, &noRoute);" "if (sPlayerbotAIConfig.pathPartialNoop" "gate after the resolved path")
require_order("${moveto2}" "    if (movePath.empty())\n        return false;" "if (sPlayerbotAIConfig.pathPartialNoop" "gate after the empty check")
require_order("${moveto2}" "if (sPlayerbotAIConfig.pathPartialNoop" "movePath.makeShortCut(startPos, sPlayerbotAIConfig.reactDistance, bot);" "gate before the shortcut")
count_text("${move_cpp}" "pathPartialNoop" 3 "switch and tuning uses (gate + reach + gap)")
count_text("${move_cpp}" "LogPartialNoop(" 2 "log definition + one call")

region("${move_cpp}" "void LogPartialNoop(Player* bot" "\n}\n" log)
require_text("${log}" "path_fail::Counters& counters = path_fail::PartialNoopCounters();" "own counters in the log")
require_text("${log}" "if (!counters.Take(path_fail::DefaultLinesPerMinute))\n        return;" "line budget")
require_text("${log}" "[MoveTo] summary partial_noop=%u logged=%u" "summary line")
require_text("${log}" "[MoveTo] state=partial_noop bot=%u level=%u action=%s" "detail line")
require_text("${log}" "end_gap=%.1f" "end gap field")

message(STATUS "#575 PartialNoop source contract OK")
