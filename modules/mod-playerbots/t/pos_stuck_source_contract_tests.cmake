# 1. Switch default off, bounded tuning, documented off in the dist, echoed.
function(check_config err config_h config_cpp conf_dist)
  set(e "")
  require_text(e "${config_h}" "    bool pathPosStuck = false;" "member default off")
  require_text(e "${config_h}" "    uint32 pathPosStuckMinutes = 10;" "minutes default")
  require_text(e "${config_h}" "    float pathPosStuckProgress = 5.0f;" "progress default")
  require_text(e "${config_cpp}" "pathPosStuck = config.GetBoolDefault(\"AiPlayerbot.Path.PosStuck\", false);" "switch read off")
  require_text(e "${config_cpp}" "pathPosStuckMinutes = uint32(std::min(120, std::max(2, config.GetIntDefault(\"AiPlayerbot.Path.PosStuck.Minutes\", int(ai::pos_stuck::DefaultMinutes)))));" "minutes clamped")
  require_text(e "${config_cpp}" "pathPosStuckProgress = std::min(50.0f, std::max(1.0f, config.GetFloatDefault(\"AiPlayerbot.Path.PosStuck.Progress\", ai::pos_stuck::DefaultProgress)));" "progress clamped")
  require_text(e "${config_cpp}" "pathPosStuckEpisodeMinutes = uint32(std::min(240, std::max(5, config.GetIntDefault(\"AiPlayerbot.Path.PosStuck.EpisodeMinutes\", int(ai::pos_stuck::DefaultEpisodeMinutes)))));" "episode clamped")
  require_text(e "${config_cpp}" "pathPosStuckRateMinutes = uint32(std::min(240, std::max(5, config.GetIntDefault(\"AiPlayerbot.Path.PosStuck.RateMinutes\", int(ai::pos_stuck::DefaultRateMinutes)))));" "rate clamped")
  require_text(e "${conf_dist}" "\nAiPlayerbot.Path.PosStuck = 0\n" "dist off")
  require_text(e "${conf_dist}" "\nAiPlayerbot.Path.PosStuck.Minutes = 10\n" "dist minutes")
  require_text(e "${conf_dist}" "\nAiPlayerbot.Path.PosStuck.Progress = 5\n" "dist progress")
  require_text(e "${conf_dist}" "\nAiPlayerbot.Path.PosStuck.EpisodeMinutes = 30\n" "dist episode")
  require_text(e "${conf_dist}" "\nAiPlayerbot.Path.PosStuck.RateMinutes = 30\n" "dist rate")
  require_text(e "${config_cpp}" "{\"Path.PosStuck\", Value(pathPosStuck)}," "ConfigEcho switch")
  require_text(e "${config_cpp}" "{\"Path.PosStuck.Minutes\", Value(pathPosStuckMinutes)}," "ConfigEcho minutes")
  set(${err} "${e}" PARENT_SCOPE)
endfunction()

# 2. The policy: excluded clears the window; progress restarts it; the window end never fires during a fight.
function(check_policy err policy)
  set(e "")
  require_text(e "${policy}" "constexpr std::uint32_t DefaultMinutes = 10;" "default minutes")
  require_text(e "${policy}" "constexpr float DefaultProgress = 5.0f;" "default progress")
  region("${policy}" "inline Verdict Observe(" "\n}\n" observe)
  require_text(e "${observe}" "    if (current.excluded)\n    {\n        state.initialized = false;\n        return Verdict::None;\n    }" "excluded clears the window")
  require_text(e "${observe}" "    if (state.refDistance - current.distance >= progress)" "net progress to the target")
  require_text(e "${observe}" "    if (current.now - state.windowStart < windowMs)\n        return Verdict::None;" "window")
  require_text(e "${observe}" "    if (current.combat)\n        return Verdict::None;" "no detect during a fight")
  require_order(e "${observe}" "    if (current.excluded)" "    if (state.refDistance - current.distance >= progress)" "exclusion before progress")
  require_order(e "${observe}" "    if (current.now - state.windowStart < windowMs)" "    if (current.combat)" "the fight check at the window end (fights count in)")
  require_order(e "${observe}" "    if (current.combat)" "    return Verdict::Detect;" "fight check before the detect")
  region("${policy}" "inline Step Escalate(" "\n}\n" escalate)
  require_text(e "${escalate}" "    if (episodes.moved && now - episodes.lastMoveAt < rateMs)\n        return Step::Park;" "moves rate-limited")
  require_text(e "${escalate}" "    if (episodes.count == 0)\n    {\n        episodes.count = 1;\n        return Step::Park;\n    }" "1st episode parks")
  require_text(e "${policy}" "constexpr float AnchorMaxDistance = 300.0f;" "local unstuck stays local")
  # OB-10 review: a move only for a bot that stood; a home bind only on the bot's map and zone.
  require_text(e "${policy}" "constexpr float StillDisplacement = 20.0f;" "stood-still threshold")
  require_text(e "${escalate}" "    if (!mayMove)\n        return Step::Park;" "no move unless the bot stood")
  require_order(e "${escalate}" "    if (episodes.count == 0)" "    if (!mayMove)" "the 1st episode parks before the move gate")
  require_text(e "${observe}" "    state.detectDisplacement = std::sqrt(dx * dx + dy * dy);" "displacement at the detect")
  require_order(e "${observe}" "    state.detectDisplacement = std::sqrt(dx * dx + dy * dy);" "    state.windowX = current.x;\n    state.windowY = current.y;\n    return Verdict::Detect;" "displacement measured before the window restarts")
  require_text(e "${policy}" "    return state.detectDisplacement < StillDisplacement;" "stood still")
  require_text(e "${policy}" "    return bindZoneId != 0 && bindMapId == mapId && bindZoneId == zoneId;" "bind near = own map and zone")
  set(${err} "${e}" PARENT_SCOPE)
endfunction()

# 3. TravelMgr: switch first in CheckStatus (TRAVEL, after the arrival / forced checks, before the turn-in recovery); the
#    population; park every episode; the moves only the anchor and the home bind; bounded lines; the target is left.
function(check_travel err travel_h travel_cpp)
  set(e "")
  require_text(e "${travel_h}" "#include \"PosStuckPolicy.h\"" "policy include")
  require_text(e "${travel_h}" "        void NotePartialNoopHit() { posStuck.Reset(); }" "PartialNoop hit restarts the window")
  require_text(e "${travel_h}" "        pos_stuck::State posStuck;\n        pos_stuck::Episodes posStuckEpisodes;" "per-bot state")
  region("${travel_cpp}" "void TravelTarget::CheckStatus()" "\n}\n" check)
  set(gate "        if (sPlayerbotAIConfig.pathPosStuck && ObservePosStuck())\n            return;")
  require_text(e "${check}" "${gate}" "switch-first gate")
  require_order(e "${check}" "        else if(IsForced()) return;" "${gate}" "gate after the arrival and forced checks")
  require_order(e "${check}" "${gate}" "        if (IsProgressAwareQuestTravel())\n        {\n            switch (ObserveTurnInProgress())" "gate before the turn-in recovery")
  count_text(e "${travel_cpp}" "ObservePosStuck()" 2 "gate call + definition")
  region("${travel_cpp}" "bool TravelTarget::ObservePosStuck()" "\n}\n" body)
  require_text(e "${body}" "observation.excluded = !sRandomPlayerbotMgr.IsPersistentRosterMember(bot->GetGUIDLow()) || ai->HasRealPlayerMaster() ||\n        !bot->IsAlive() || bot->IsTaxiFlying() || bot->GetTransport() || !map || map->Instanceable() ||\n        wPosition->getMapId() != bot->GetMapId() || RestGateValue::Resting(ai) ||
        quest_groups::IsFollower(ai);" "population (twow-repo#627 S7 hook: help-group followers out, the leader stays watched)")
  region("${body}" "    observation.excluded = " "    observation.distance = " excluded_expr)
  require_text(e "${excluded_expr}" "quest_groups::IsFollower(ai);" "S7 hook: the follower in the excluded expression (region found)")
  forbid_text(e "${excluded_expr}" "quest_groups::IsMember(ai)" "S7 hook: only followers are excluded - a leader stuck on its own target is still detected")
  set(leader_block "    if (quest_groups::IsMember(ai) && !quest_groups::IsFollower(ai))\n    {\n        quest_groups::NoteLeaderStuck(ai);\n        posStuck.Reset();\n        return false;\n    }")
  require_order(e "${body}" "sPlayerbotAIConfig.pathPosStuckProgress) != pos_stuck::Verdict::Detect)\n        return false;" "${leader_block}" "S7 hook: only a detect tells the help-group manager (leader_stuck)")
  require_text(e "${body}" "${leader_block}" "S7 hook (CLI-GRP): a leader detect only tells the manager, resets the window and returns")
  require_order(e "${body}" "${leader_block}" "pos_stuck::Step step = pos_stuck::Escalate(" "S7 hook: before the series (no unstuck, no home bind for a leader)")
  require_order(e "${body}" "${leader_block}" "parked = ParkTurnInNow(questId, \"structural_pos_stuck\", false, abandonDue);" "S7 hook: before the park")
  count_text(e "${body}" "NoteLeaderStuck(" 1 "S7 hook: one leader note")
  require_text(e "${body}" "observation.combat = bot->IsInCombat();" "fight flag")
  require_text(e "${body}" "parked = ParkTurnInNow(questId, \"structural_pos_stuck\", false, abandonDue);" "#485 park, not abandonable")
  require_text(e "${body}" "NoteQuestObjectiveFailure();" "objective failure")
  require_text(e "${body}" "SuppressCurrentDestination(parkSeconds * IN_MILLISECONDS);" "target suppressed")
  require_text(e "${body}" "if (step == pos_stuck::Step::Unstuck && !pos_stuck::AnchorUsable(posStuck, observation.mapId, observation.x, observation.y))\n        step = pos_stuck::Step::Teleport;" "unusable anchor -> home bind")
  require_text(e "${body}" "    pos_stuck::MoveResult const moved = pos_stuck::ApplyMove(bot, step, posStuck.anchorX, posStuck.anchorY, posStuck.anchorZ);" "the move through ApplyMove")
  count_text(e "${body}" "ApplyMove(" 1 "one move call")
  require_text(e "${body}" "sPlayerbotAIConfig.pathPosStuckRateMinutes * 60 * IN_MILLISECONDS,\n        pos_stuck::StoodStill(posStuck));" "the series moves only a bot that stood")
  require_text(e "${body}" "    else if (step == pos_stuck::Step::Teleport && moved == pos_stuck::MoveResult::Moved)" "teleport counted only when done")
  require_text(e "${body}" "[PosStuck] state=teleport_skipped bot=%u" "skipped home bind line")
  require_text(e "${body}" "reason=bind_far" "skip reason")
  forbid_text(e "${body}" "TeleportTo" "a teleport in TravelMgr.cpp (the quest-first contract keeps this file free of them)")
  forbid_text(e "${body}" "Rescue" "start-zone rescue (#587)")
  require_text(e "${body}" "bool const lines = counters.Take(pos_stuck::DefaultLinesPerMinute);" "line budget")
  require_text(e "${body}" "    ai::lazy_roll::ReportPosStuckSummary();
    pos_stuck::Counters& counters = pos_stuck::SharedCounters();" "summary rolled through the shared function first (telemetry P0)")
  require_text(e "${travel_cpp}" "[PosStuck] summary detect=%u unstuck=%u teleport=%u logged=%u" "summary line (in ReportPosStuckSummary, telemetry P0)")
  require_text(e "${body}" "[PosStuck] state=detect bot=%u level=%u quest=%u target_entry=%d purpose=%u dist=%.1f minutes=%u map=%u zone=%u x=%.1f y=%.1f z=%.1f" "detect line")
  require_text(e "${body}" "[PosStuck] state=park bot=%u" "park line")
  require_text(e "${body}" "[PosStuck] state=unstuck bot=%u" "unstuck line")
  require_text(e "${body}" "[PosStuck] state=teleport bot=%u" "teleport line")
  count_text(e "${body}" "sLog.outBasic(" 5 "five lines (detect, park, unstuck, teleport, teleport_skipped; the summary moved to ReportPosStuckSummary, telemetry P0)")
  count_text(e "${body}" "        if (lines)\n" 3 "unstuck / teleport / teleport_skipped lines within the budget")
  require_text(e "${body}" "    if (lines)\n        sLog.outBasic(\"[PosStuck] state=park" "park line within the budget")
  require_text(e "${body}" "    if (lines)\n        sLog.outBasic(\"[PosStuck] state=detect" "detect line within the budget")
  require_text(e "${body}" "    TraceQuestCommit(tDestination, \"abandon\", \"pos_stuck\");\n    posStuck.Reset();\n    SetStatus(TravelStatus::TRAVEL_STATUS_EXPIRED);\n    return true;" "target left")
  set(${err} "${e}" PARENT_SCOPE)
endfunction()

# 4. The travel action: a PartialNoop failure restarts the guard's window - after the retry branch, outside CLI-PATH's
#    [PathIsland] region (whose end marker stays intact).
function(check_action err mtt_cpp)
  set(e "")
  set(note "    if (sPlayerbotAIConfig.pathPosStuck && partialNoopHit)\n        target->NotePartialNoopHit();")
  require_text(e "${mtt_cpp}" "${note}" "PartialNoop exclusion")
  require_order(e "${mtt_cpp}" "    else\n        target->DecRetry(true);" "${note}" "after the retry branch")
  require_text(e "${mtt_cpp}" "\n    }\n\n    if (!canMove)\n    {\n        target->IncRetry(true);" "PathIsland region end intact")
  count_text(e "${mtt_cpp}" "NotePartialNoopHit()" 1 "one exclusion call")
  set(${err} "${e}" PARENT_SCOPE)
endfunction()

# 5. The move (PosStuckMove.cpp, the only place the guard moves a bot): Park moves nothing, Unstuck goes to the anchor on the
#    bot's map, every other step to the bot's own home bind without the hearthstone cooldown - only when the bind lies on the
#    bot's map and zone (OB-10 review, #587 rebinds); exactly these two moves.
function(check_move err move_cpp policy)
  set(e "")
  require_text(e "${policy}" "MoveResult ApplyMove(Player* bot, Step step, float x, float y, float z);" "move declaration")
  region("${move_cpp}" "ai::pos_stuck::MoveResult ai::pos_stuck::ApplyMove(Player* bot, Step step, float x, float y, float z)" "\n}\n" move)
  require_text(e "${move}" "    if (!bot || step == Step::Park)\n        return MoveResult::None;" "park moves nothing")
  require_text(e "${move}" "    if (step == Step::Unstuck)\n    {\n        bot->NearTeleportTo(x, y, z, bot->GetOrientation());\n        return MoveResult::Moved;\n    }" "unstuck to the anchor")
  require_text(e "${move}" "    if (!BindNear(bindMapId, bindZoneId, bot->GetMapId(), bot->GetZoneId()))\n        return MoveResult::BindFar;" "far bind skipped")
  require_order(e "${move}" "    if (!BindNear(" "    bot->TeleportToHomebind(0, false);" "bind check before the home bind")
  require_text(e "${move}" "    bot->TeleportToHomebind(0, false);" "home bind, no hearthstone cooldown")
  count_text(e "${move_cpp}" "TeleportTo" 2 "two moves (NearTeleportTo, TeleportToHomebind)")
  forbid_text(e "${move_cpp}" "Rescue" "start-zone rescue (#587)")
  set(${err} "${e}" PARENT_SCOPE)
endfunction()

