cmake_policy(VERSION 3.16)
# twow-repo#594 (OB-00 / OB-10 23.10.2026): AiPlayerbot.Path.PosStuck, the position guard, default 0 = old behaviour.
# A travel target in TRAVEL that the bot gets no closer to within Minutes (fights count in, never fire during one) is
# parked and left; the series escalates to a local unstuck and the home bind, rate-limited. Pinned: switch first, the
# population, no effect during a fight, PartialNoop's cases excluded, bounded lines, no start-zone rescue. Errors are
# collected so the negative probes at the end can reuse the checks; every probe anchor must exist.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text err text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    set(${err} "${${err}}  missing ${description}: ${needle}\n" PARENT_SCOPE)
  endif()
endfunction()

function(forbid_text err text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    set(${err} "${${err}}  forbidden ${description}: ${needle}\n" PARENT_SCOPE)
  endif()
endfunction()

function(require_order err text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    set(${err} "${${err}}  order ${description}: '${first}' must come before '${second}'\n" PARENT_SCOPE)
  endif()
endfunction()

function(count_text err text needle expected description)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" nlen)
  while(TRUE)
    string(FIND "${rest}" "${needle}" at)
    if(at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR from "${at} + ${nlen}")
    string(SUBSTRING "${rest}" ${from} -1 rest)
  endwhile()
  if(NOT n EQUAL ${expected})
    set(${err} "${${err}}  expected ${expected}x ${description}, found ${n}\n" PARENT_SCOPE)
  endif()
endfunction()

# Body from start_marker to the first end_marker after it ("" when the start is missing - the checks then report).
function(region text start_marker end_marker out_var)
  set(body "")
  string(FIND "${text}" "${start_marker}" start)
  if(NOT start EQUAL -1)
    string(SUBSTRING "${text}" ${start} -1 rest)
    string(FIND "${rest}" "${end_marker}" len)
    if(NOT len EQUAL -1)
      string(SUBSTRING "${rest}" 0 ${len} body)
    endif()
  endif()
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

