# 5. Negative probes: each broken variant MUST be rejected by check_shared_search.
function(expect_rejected probe_text label)
  check_shared_search("${probe_text}" probe_err)
  if(probe_err STREQUAL "")
    message(FATAL_ERROR "#541 A32: negative probe not caught (${label}) - the scan is broken")
  endif()
endfunction()
function(make_probe from to out_var)
  string(REPLACE "${from}" "${to}" probe "${calc}")
  if(probe STREQUAL calc)
    message(FATAL_ERROR "#541 A32: probe '${from}' did not apply - pattern drifted")
  endif()
  set(${out_var} "${probe}" PARENT_SCOPE)
endfunction()

