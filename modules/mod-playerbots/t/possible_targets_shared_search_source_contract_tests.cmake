# twow-repo#541 (audit A32, behaviour-changing, owner A/B 09.10.2026): behind
# AiPlayerbot.PossibleTargetsSharedSearch (default 0) the unqualified "possible targets" variants of a bot
# WITHOUT a group filter the bot's OWN unfiltered snapshot "possible targets::{<sight>:1}" (read by
# AttackersValue::AddTargetsOf) instead of searching the grid again. Every snapshot unit passes the grid
# search's own check (AnyUnfriendlyUnitInObjectRangeCheck: CanSeeInWorld, alive, same map instance, in
# range, not friendly) and AcceptUnit again. Grouped bots, the snapshot itself and other ranges keep the
# old search. Switch 0 = old path verbatim.
# Inputs: PB_SOURCE_DIR (src/playerbot), CORE_SOURCE_DIR (core root, for the grid check it reuses).

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#541 A32: missing ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" a)
  string(FIND "${text}" "${second}" b)
  if(a EQUAL -1 OR b EQUAL -1 OR NOT a LESS b)
    message(FATAL_ERROR "#541 A32: order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(function_body text signature out_var)
  string(FIND "${text}" "${signature}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "#541 A32: function not found: ${signature}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "\n}\n" end)
  if(end EQUAL -1)
    message(FATAL_ERROR "#541 A32: end of function not found: ${signature}")
  endif()
  string(SUBSTRING "${rest}" 0 ${end} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

function(a32_need block needle errors_var)
  string(FIND "${block}" "${needle}" o)
  if(o EQUAL -1)
    set(${errors_var} "${${errors_var}} | missing: ${needle}" PARENT_SCOPE)
  endif()
endfunction()

function(a32_forbid block needle errors_var)
  string(FIND "${block}" "${needle}" o)
  if(NOT o EQUAL -1)
    set(${errors_var} "${${errors_var}} | forbidden: ${needle}" PARENT_SCOPE)
  endif()
endfunction()

# "" when <body> is a valid A32 Calculate body, otherwise the reasons.
function(check_shared_search body out_var)
  set(err "")
  set(gate "if (sPlayerbotAIConfig.possibleTargetsSharedSearch && qualifier.empty() && !bot->GetGroup())")
  set(legacy "std::list<Unit*> targets;")
  string(FIND "${body}" "${gate}" g)
  string(FIND "${body}" "${legacy}" l)
  if(g EQUAL -1 OR l EQUAL -1 OR NOT g LESS l)
    set(${out_var} "gate missing or not before the legacy search" PARENT_SCOPE)
    return()
  endif()
  # The qualifier block must stay first (the snapshot reads its range/ignore-validate there).
  string(FIND "${body}" "shouldIgnoreValidate = Qualified::getMultiQualifierInt(qualifier, 1, \":\");" q)
  if(q EQUAL -1 OR NOT q LESS g)
    set(err "${err} | qualifier block missing or after the gate")
  endif()
  math(EXPR len "${l} - ${g}")
  string(SUBSTRING "${body}" ${g} ${len} block)
  a32_need("${block}" "int32 const sharedRange = (int32)sPlayerbotAIConfig.sightDistance;" err)
  a32_need("${block}" "if (sharedRange > 0 && range == (float)sharedRange)" err)
  a32_need("${block}" "const std::vector<std::string> sharedQualifiers = { std::to_string(sharedRange), std::to_string(true) };" err)
  a32_need("${block}" "context->GetValue<std::list<ObjectGuid>>(\"possible targets\", Qualified::MultiQualify(sharedQualifiers, \":\"))" err)
  a32_need("${block}" "if (shared)" err)
  a32_need("${block}" "const std::list<ObjectGuid> sharedGuids = shared->Get();" err)
  a32_need("${block}" "MaNGOS::AnyUnfriendlyUnitInObjectRangeCheck inRange(bot, range);" err)
  a32_need("${block}" "Unit* unit = ai->GetUnit(guid);" err)
  a32_need("${block}" "if (unit && inRange(unit) && AcceptUnit(unit))" err)
  a32_need("${block}" "return results;" err)
  # no second search, no other bot's values, no static cache, no locks, no filtered/other key
  a32_forbid("${block}" "FindPossibleTargets" err)
  a32_forbid("${block}" "Cell::Visit" err)
  a32_forbid("${block}" "GetBotAI(" err)
  a32_forbid("${block}" "PAI_VALUE" err)
  a32_forbid("${block}" "static " err)
  a32_forbid("${block}" "thread_local" err)
  a32_forbid("${block}" "mutex" err)
  a32_forbid("${block}" "std::to_string(false)" err)
  a32_forbid("${block}" "LazyGet" err)
  # legacy path (snapshot itself, grouped bots, switch off) unchanged
  a32_need("${body}" "FindPossibleTargets(bot, targets, rangeCheck);" err)
  a32_need("${body}" "if (unit && (shouldIgnoreValidate || AcceptUnit(unit)))" err)
  a32_need("${body}" "results.push_back(unit->GetObjectGuid());" err)
  set(${out_var} "${err}" PARENT_SCOPE)
endfunction()

