cmake_policy(VERSION 3.16)
# twow-repo#568 strategy diet, group g3 (shaman, paladin, druid). Every fix sits behind its own switch
# AiPlayerbot.Diet.<Key>, default 0 = exactly the old code path. This contract checks per fix: the switch is
# read with default false and documented as 0, the gate is in place, and the old (OFF) path is still there.
if(NOT DEFINED PB_SOURCE_DIR)
  message(FATAL_ERROR "PB_SOURCE_DIR is required")
endif()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "Missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "Forbidden ${description}: ${needle}")
  endif()
endfunction()

function(require_order text first second description)
  string(FIND "${text}" "${first}" first_offset)
  string(FIND "${text}" "${second}" second_offset)
  if(first_offset EQUAL -1 OR second_offset EQUAL -1 OR NOT first_offset LESS second_offset)
    message(FATAL_ERROR "Order ${description}: '${first}' must come before '${second}'")
  endif()
endfunction()

function(region text start_marker end_marker out)
  string(FIND "${text}" "${start_marker}" start)
  if(start EQUAL -1)
    message(FATAL_ERROR "Missing region start: ${start_marker}")
  endif()
  string(SUBSTRING "${text}" ${start} -1 rest)
  string(FIND "${rest}" "${end_marker}" length)
  if(length EQUAL -1)
    message(FATAL_ERROR "Missing region end: ${end_marker}")
  endif()
  string(SUBSTRING "${rest}" 0 ${length} body)
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

function(read_source relative out)
  file(READ "${PB_SOURCE_DIR}/${relative}" content)
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

read_source("PlayerbotAIConfig.h" config_h)
read_source("PlayerbotAIConfig.cpp" config_cpp)
read_source("aiplayerbot.conf.dist.in" config_dist)

# One switch: member defaults to false, read with default false, documented as 0 in the dist config.
function(require_diet_switch member key)
  require_text("${config_h}" "    bool ${member} = false;" "${key} member default off")
  require_text("${config_cpp}" "    ${member} = config.GetBoolDefault(\"AiPlayerbot.Diet.${key}\", false);" "${key} read with default off")
  require_text("${config_dist}" "\nAiPlayerbot.Diet.${key} = 0\n" "${key} = 0 in the dist config")
  forbid_text("${config_dist}" "\nAiPlayerbot.Diet.${key} = 1" "${key} enabled in the dist config")
endfunction()

# ---------------------------------------------------------------------------------------------------------
# D04 (AiPlayerbot.Diet.LevelingDruidWrath): leveling druid Wrath node on the registered trigger name.
require_diet_switch(dietLevelingDruidWrath LevelingDruidWrath)
read_source("strategy/druid/LevelingDruidStrategy.cpp" leveling_druid)
read_source("strategy/triggers/TriggerContext.h" trigger_ctx)
require_text("${trigger_ctx}" "creators[\"enemy out of melee\"] =" "registered trigger name used by the ON path")
forbid_text("${trigger_ctx}" "creators[\"enemy out of melee range\"]" "creator for the old name (the OFF path would no longer be dead)")
region("${leveling_druid}" "void LevelingDruidStrategy::InitCombatTriggers(" "\n}" leveling_combat)
require_text("${leveling_combat}" "sPlayerbotAIConfig.dietLevelingDruidWrath ? \"enemy out of melee\" : \"enemy out of melee range\"," "D04 gate with the old name as OFF path")
require_order("${leveling_combat}" "sPlayerbotAIConfig.dietLevelingDruidWrath" "new NextAction(\"wrath\", ACTION_NORMAL)" "D04 gate on the Wrath node")

# ---------------------------------------------------------------------------------------------------------
# D26 (AiPlayerbot.Diet.ShockCooldownGate): shaman "shock" trigger quiet during the shared shock category cooldown.
require_diet_switch(dietShockCooldownGate ShockCooldownGate)
read_source("strategy/shaman/ShamanTriggers.cpp" shaman_triggers_cpp)
region("${shaman_triggers_cpp}" "bool ShockTrigger::IsActive()" "\n}" shock_trigger)
require_order("${shock_trigger}" "if (sPlayerbotAIConfig.dietShockCooldownGate)" "return SpellTrigger::IsActive() && !ai->HasAnyAuraOf(GetTarget(), \"frost shock\", \"earth shock\", \"flame shock\", NULL) && !HasMaxDebuffs();" "D26 gate before the unchanged old check")
require_text("${shock_trigger}" "if (shockId)" "D26: unknown Earth Shock keeps the old path")
require_text("${shock_trigger}" "bot->HasSpellCooldown(shockId) || bot->HasSpellCategoryCooldown(shockInfo->Category)" "D26: own and category cooldown")
region("${shock_trigger}" "if (sPlayerbotAIConfig.dietShockCooldownGate)" "return SpellTrigger::IsActive()" shock_gate)
forbid_text("${shock_gate}" "return true" "D26: the gate may only suppress, never force the trigger")
region("${shock_gate}" "if (sPlayerbotAIConfig.dietShockCooldownGate)" "if (shockId)" shock_gate_head)
forbid_text("${shock_gate_head}" "return" "D26: a return before the known-spell check (id 0 must keep the old path)")

# ---------------------------------------------------------------------------------------------------------
# D27 (AiPlayerbot.Diet.FireNovaTotem): vanilla "fire nova" nodes cast the learnable Fire Nova Totem.
require_diet_switch(dietFireNovaTotem FireNovaTotem)
read_source("strategy/shaman/ShamanActions.h" shaman_actions_h)
read_source("strategy/shaman/ShamanAiObjectContext.cpp" shaman_ctx)
read_source("strategy/shaman/EnhancementShamanStrategy.cpp" enh_cpp)
read_source("strategy/shaman/ElementalShamanStrategy.cpp" ele_cpp)
read_source("strategy/shaman/RestorationShamanStrategy.cpp" resto_cpp)
read_source("strategy/shaman/ShamanTriggers.h" shaman_triggers_h)
set(fire_nova_choice "new NextAction(sPlayerbotAIConfig.dietFireNovaTotem ? \"fire nova totem\" : \"fire nova\", ACTION_HIGH)")
# New action: self-placed like Magma Totem, never over an active Magma Totem; the old action stays for OFF.
region("${shaman_actions_h}" "class CastFireNovaTotemAction : public CastMeleeSpellAction" "};" fnt_action)
require_text("${fnt_action}" "CastMeleeSpellAction(ai, \"fire nova totem\")" "D27 action casts fire nova totem")
require_text("${fnt_action}" "return \"self target\";" "D27 action placed at the bot")
require_text("${fnt_action}" "!AI_VALUE2(bool, \"has totem\", \"magma totem\")" "D27 never over an active Magma Totem")
require_text("${shaman_actions_h}" "CastFireNovaAction(PlayerbotAI* ai) : CastSpellAction(ai, \"fire nova\") {}" "D27 OFF path action kept")
require_text("${shaman_ctx}" "creators[\"fire nova totem\"] = [](PlayerbotAI* ai) { return new CastFireNovaTotemAction(ai); };" "D27 action creator")
require_text("${shaman_ctx}" "creators[\"fire nova\"] = [](PlayerbotAI* ai) { return new CastFireNovaAction(ai); };" "D27 OFF path creator kept")
require_text("${shaman_ctx}" "ShamanManualTotemStrategy(ai, \"totem fire nova\", \"fire totem\", sPlayerbotAIConfig.dietFireNovaTotem ? \"fire nova totem\" : \"fire nova\")" "D27 manual totem strategy")
# Vanilla blocks switch, TBC blocks untouched.
region("${enh_cpp}" "#ifdef MANGOSBOT_ZERO" "#ifdef MANGOSBOT_ONE" enh_zero)
region("${enh_cpp}" "#ifdef MANGOSBOT_ONE" "#ifdef MANGOSBOT_TWO" enh_one)
region("${enh_zero}" "void EnhancementShamanAoeStrategy::InitCombatTriggers(" "\n}" enh_zero_aoe)
require_text("${enh_zero_aoe}" "\"melee medium aoe\",\n        NextAction::array(0, ${fire_nova_choice}" "D27 enhancement AoE gate")
require_text("${enh_one}" "new NextAction(\"fire nova\", ACTION_HIGH)" "TBC enhancement AoE unchanged")
forbid_text("${enh_one}" "dietFireNovaTotem" "D27 switch outside the vanilla block")
region("${ele_cpp}" "#ifdef MANGOSBOT_ZERO" "#ifdef MANGOSBOT_ONE" ele_zero)
region("${ele_zero}" "void ElementalShamanPvpStrategy::InitCombatTriggers(" "\n}" ele_zero_pvp)
require_text("${ele_zero_pvp}" "\"target of attacker close\",\n        NextAction::array(0, ${fire_nova_choice}" "D27 elemental PvP gate")
# Magma Totem continuer: dropped only under the switch in the vanilla build.
foreach(factory enh_cpp resto_cpp)
  region("${${factory}}" "static bool DietDropMagmaContinuer()" "\n    }" magma_gate)
  require_text("${magma_gate}" "#ifdef MANGOSBOT_ZERO\n        return sPlayerbotAIConfig.dietFireNovaTotem;\n#else\n        return false;\n#endif" "D27 vanilla-only continuer drop (${factory})")
  region("${${factory}}" "static ActionNode* magma_totem(PlayerbotAI* ai)" "\n    }" magma_node)
  require_text("${magma_node}" "return new ActionNode(\"magma totem\"," "D27 creator stays an unconditional new ActionNode (${factory})")
  require_text("${magma_node}" "/*C*/ DietDropMagmaContinuer() ? nullptr : NextAction::array(0, new NextAction(\"fire nova\"), NULL));" "D27 OFF path keeps the fire nova continuer (${factory})")
  require_text("${${factory}}" "creators[\"magma totem\"] = &magma_totem;" "D27 magma node registered (${factory})")
endforeach()
# Fire totem triggers: a placed Fire Nova Totem holds the fire slot only under the switch.
region("${shaman_triggers_h}" "class FireTotemTrigger : public Trigger" "private:" fire_totem_trigger)
region("${shaman_triggers_h}" "class FireTotemAoeTrigger : public Trigger" "};" fire_totem_aoe_trigger)
foreach(trig fire_totem_trigger fire_totem_aoe_trigger)
  require_text("${${trig}}" "!AI_VALUE2(bool, \"has totem\", \"magma totem\") &&" "D27 old checks kept (${trig})")
  require_text("${${trig}}" "(!sPlayerbotAIConfig.dietFireNovaTotem || !AI_VALUE2(bool, \"has totem\", \"fire nova totem\"))" "D27 nova totem holds the slot (${trig})")
endforeach()

message(STATUS "DIET_G3_SOURCE_CONTRACT=PASS")
