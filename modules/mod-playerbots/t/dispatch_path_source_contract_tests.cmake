# 1. Switch: default off in code and conf.
require_text("${config_h}" "    bool perfDispatchPrecomputedPath = false;  // twow-repo#592 (PATH-02 A20)" "member default off")
require_text("${config_cpp}" "perfDispatchPrecomputedPath = config.GetBoolDefault(\"AiPlayerbot.Perf.DispatchPrecomputedPath\", false);" "load default off")
require_text("${conf_dist}" "\nAiPlayerbot.Perf.DispatchPrecomputedPath = 0\n" "documented off")

# 2. Core: the generator takes the path; the first Initialize launches it like MovePath and frees it, every later
#    Initialize (speed change) searches its path to (m_x, m_y, m_z) with m_options as before.
require_text("${pmg_h}" "PointMovementGenerator(uint32 _id, float _x, float _y, float _z, uint32 options, Movement::PointsArray const& path, bool pathFly, bool pathWalk) :" "path constructor")
require_text("${pmg_h}" "m_id(_id), m_x(_x), m_y(_y), m_z(_z), m_o(-10.0f), m_options(options), m_speed(0.0f), m_recalculateSpeed(false)," "path constructor keeps id, target and options, no facing, no speed")
require_text("${pmg_h}" "PointMovementGenerator(uint32 _id, float _x, float _y, float _z, uint32 options, float speed = 0.0f, float finalOrientation = -10.0f) :" "old constructor unchanged")
region("${pmg_cpp}" "void PointMovementGenerator<T>::Initialize(T& unit)" "\n}\n" init)
require_text("${init}" "    if (m_path.size() >= 2)\n    {\n        Movement::MoveSplineInit pathInit(unit, \"PointMovementGenerator<T>::Initialize path\");\n        pathInit.MovebyPath(m_path);\n        pathInit.SetWalk(m_pathWalk);\n        if (m_pathFly)\n            pathInit.SetFly();\n        Movement::PointsArray().swap(m_path);\n        pathInit.Launch();\n        return;\n    }" "path launched once with MovePath's settings, then freed")
require_order("${init}" "        unit.StopMoving();" "if (m_path.size() >= 2)" "stop before the path, as MovePath")
require_order("${init}" "unit.AddUnitState(UNIT_STAT_ROAMING | UNIT_STAT_ROAMING_MOVE);" "if (m_path.size() >= 2)" "roaming state for the path too")
require_order("${init}" "if (m_path.size() >= 2)" "    init.MoveTo(m_x, m_y, m_z, m_options);" "the path search stays for every later init")
region("${pmg_cpp}" "bool PointMovementGenerator<T>::Update(T& unit, uint32 const& /*diff*/)" "\n}\n" update)
require_text("${update}" "        m_recalculateSpeed = false;\n        Initialize(unit);" "speed change re-init unchanged")
require_text("${mm_h}" "void MovePoint(uint32 id, float x, float y, float z, uint32 options, Movement::PointsArray const& pointPath, bool flying, bool walk);" "MotionMaster overload")
region("${mm_cpp}" "void MotionMaster::MovePoint(uint32 id, float x, float y, float z, uint32 options, Movement::PointsArray const& pointPath, bool flying, bool walk)" "\n}\n" mm_path)
require_text("${mm_path}" "Mutate(new PointMovementGenerator<Player>(id, x, y, z, options, pointPath, flying, walk));" "player generator with the path")
require_text("${mm_path}" "Mutate(new PointMovementGenerator<Creature>(id, x, y, z, options, pointPath, flying, walk));" "creature generator with the path")
require_text("${mm_cpp}" "Mutate(new PointMovementGenerator<Player>(id, x, y, z, options, speed, finalOrientation));" "old MovePoint unchanged")
region("${mm_cpp}" "void MotionMaster::MovePath(Movement::PointsArray const& pointPath, uint32 /*moveMode*/, bool flying, bool walk)" "\n}\n" move_path)
require_text("${move_path}" "    init.MovebyPath(pointPath);\n    init.SetWalk(walk);             // walk == false => run speed\n    if (flying)\n        init.SetFly();\n    init.Launch();" "MovePath settings the generator copies")

# 3. DispatchMovement: A20 only for vanilla (MANGOSBOT_ZERO), only with the switch and the point move; then the old
#    MovePoint block is skipped and the path MovePoint comes after the hazard pass and the ground heights, in place of
#    MovePath. Fewer than 2 points: today's MovePoint (MovePath would do nothing).
region("${move_cpp}" "void MovementAction::DispatchMovement(TravelPath movePath, bool generatePath, bool masterWalking)" "\n}\n" dispatch)
require_text("${dispatch}" "bool const pointMove = !generatePath || !bot->IsFreeFlying();" "point move as before")
require_text("${dispatch}" "#ifdef MANGOSBOT_ZERO\n    bool const precomputedPath = pointMove && sPlayerbotAIConfig.perfDispatchPrecomputedPath;" "A20 only with the point move and the switch")
require_text("${dispatch}" "#else\n    bool const precomputedPath = false;\n#endif" "never outside vanilla")
require_text("${dispatch}" "    if (pointMove && !precomputedPath)\n    {\n        WorldPosition movePosition = path.back();" "old MovePoint block skipped only with A20")
require_text("${dispatch}" "WorldPosition const pointTarget = path.back();" "A20 target = the old MovePoint target")
require_order("${dispatch}" "WorldPosition const pointTarget = path.back();" "GeneratePathAvoidingHazards(path);" "target taken before the hazard pass")
region("${dispatch}" "        if (precomputedPath)\n" "#endif" a20)
require_order("${dispatch}" "bot->UpdateAllowedPositionZ(p.x, p.y, p.z);" "        if (precomputedPath)\n" "A20 MovePoint after the ground heights")
require_order("${dispatch}" "        if (precomputedPath)\n" "        mm.MovePath(pointPath, moveMode, false, false);" "A20 in place of MovePath")
require_text("${a20}" "            if (generatePath)\n                moveOptions |= MOVE_PATHFINDING;" "options as the old MovePoint (path search kept for the re-init)")
require_text("${a20}" "            if (pointPath.size() >= 2)\n                mm.MovePoint(pointTarget.getMapId(), pointTarget.getX(), pointTarget.getY(), pointTarget.getZ(), moveOptions,\n                    pointPath, false, false);\n            else\n                mm.MovePoint(pointTarget.getMapId(), pointTarget.getX(), pointTarget.getY(), pointTarget.getZ(), moveOptions);" "path MovePoint with MovePath's flying=false walk=false, else the old MovePoint")
require_text("${a20}" "            WaitForReach(size);\n            return;" "same wait as before, no MovePath after it")
forbid_text("${a20}" "MovePath(" "MovePath after the path MovePoint")

# 4. Diag: one reason per MoveTo2 dispatch, only with the trace on; Follow marks its scope; the bot's own record.
region("${move_cpp}" "bool MovementAction::MoveTo2(const WorldPosition& endPos, bool idle, bool react, bool noPath, bool ignoreEnemyTargets)" "\n}\n" move_to2)
require_text("${move_to2}" "    if (sPlayerbotAIConfig.perfRouteTimeTrace)\n        CountDispatchReason(startPos, endPos, lastMove);\n\n    DispatchMovement(movePath, generatePath, masterWalking);" "reason counted right before the dispatch, trace only")
region("${move_cpp}" "void MovementAction::CountDispatchReason(WorldPosition const& startPos, WorldPosition const& endPos, LastMovement& lastMove)" "\n}\n" reason)
require_order("${reason}" "route_time::Global().AddDispatchReason(route_time::ClassifyDispatch(inFollow, lastMove.dispatchSet, sameMap, targetMoved, moved));" "lastMove.dispatchSet = true;" "classified against the previous dispatch, then recorded")
require_text("${reason}" "lastMove.dispatchTarget = endPos;\n    lastMove.dispatchFrom = startPos;" "record target and start")
region("${move_cpp}" "bool MovementAction::Follow(Unit* target, float distance, float angle)" "\n}\n" follow)
require_order("${follow}" "} const followScope(inFollow);" "    if (!ai->IsSafe(target))
        return MoveTo2(target);" "follow scope before the first return")
require_text("${follow}" "~FollowScope() { flag = previous; }" "follow flag restored")
require_text("${move_h}" "bool inFollow = false;" "follow flag default off")
require_text("${last_move_h}" "            dispatchSet = other.dispatchSet;\n            dispatchTarget = other.dispatchTarget;\n            dispatchFrom = other.dispatchFrom;" "record copied with the value")
region("${last_move_h}" "        void clear()" "\n        }\n" clear)
forbid_text("${clear}" "dispatch" "clear() resetting the dispatch record")
require_text("${node_cpp}" "    ai::route_time::RouteTimes* const routeTimes = routeTimeScope.Times();\n    // PATH-02 diag: the level band of the unit the route is built for ([RouteTime] lv0..lv40).\n    if (routeTimes && unit)\n        routeTimes->band = ai::route_time::LevelBand(unit->GetLevel());" "build band only when timed")

