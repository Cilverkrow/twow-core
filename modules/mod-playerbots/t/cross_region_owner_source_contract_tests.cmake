# twow-repo#563 part 4 (HARM, OB-00 10.11.2026): the commanding player (owner) can stand on another Map object, i.e. be updated on another region
# thread, while the bot runs his chat command on its own thread. Anything that reads or writes the owner's containers (group, spell book,
# inventory, quest map) races with that thread. Pinned here (audit note Y:\tw\evidence\ws-00\563p4\audit-note.md, table B):
#  1. LevelFor asks "do sender and bot share a group" from the bot's side (no read of the sender's Group) and fails closed for the gear score
#     of a sender on another Map object (reason CROSS_REGION, no read of his inventory).
#  2. The container-reading commands (rtsc, summon, invite, join, lfg) are not run for an owner on another Map object (chat and "do" paths).
#  3. Player::AddQuest gets no Player as quest giver from another Map object (it inserts into the giver's quest map).
# Carries negative probes: the old group read and the old AddQuest call must be rejected by the same checkers.

function(read_source path out_var)
  file(READ "${PB_SOURCE_DIR}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(offset EQUAL -1)
    message(FATAL_ERROR "#563 part 4 cross-region owner: missing ${description}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle description)
  string(FIND "${text}" "${needle}" offset)
  if(NOT offset EQUAL -1)
    message(FATAL_ERROR "#563 part 4 cross-region owner: ${description} must not appear: ${needle}")
  endif()
endfunction()

function(slice text begin_marker end_marker out_var)
  string(FIND "${text}" "${begin_marker}" b)
  string(FIND "${text}" "${end_marker}" e)
  if(b EQUAL -1 OR e EQUAL -1 OR NOT b LESS e)
    message(FATAL_ERROR "#563 part 4 cross-region owner: cannot find ${begin_marker}")
  endif()
  math(EXPR len "${e} - ${b}")
  string(SUBSTRING "${text}" ${b} ${len} piece)
  set(${out_var} "${piece}" PARENT_SCOPE)
endfunction()

# LevelFor never reads the sender's Group; it asks the bot's own group.
function(level_for_reads_no_sender_group text out_var)
  set(ok TRUE)
  string(FIND "${text}" "from->GetGroup()" pos)
  if(NOT pos EQUAL -1)
    set(ok FALSE)
  endif()
  string(FIND "${text}" "bot->GetGroup()" own)
  if(own EQUAL -1)
    set(ok FALSE)
  endif()
  set(${out_var} ${ok} PARENT_SCOPE)
endfunction()

# AddQuest never gets the raw requester as giver.
function(add_quest_giver_guarded text out_var)
  set(ok TRUE)
  string(REGEX MATCH "AddQuest\\([ ]*qInfo,[ ]*requester[ ]*\\)" raw "${text}")
  if(NOT "${raw}" STREQUAL "")
    set(ok FALSE)
  endif()
  set(${out_var} ${ok} PARENT_SCOPE)
endfunction()

# --- negative probes ---
level_for_reads_no_sender_group("Group* group = from->GetGroup();\nif (group && !ignoreGroup)" probe_group_old)
if(probe_group_old)
  message(FATAL_ERROR "#563 part 4 cross-region owner: negative probe failed - the sender's Group read was accepted")
endif()
level_for_reads_no_sender_group("Group* botGroup = bot->GetGroup();\nif (botGroup && botGroup->IsMember(from->GetObjectGuid()))" probe_group_new)
if(NOT probe_group_new)
  message(FATAL_ERROR "#563 part 4 cross-region owner: positive probe failed - the bot-side group test was rejected")
endif()
add_quest_giver_guarded("        bot->AddQuest( qInfo, requester);" probe_quest_old)
if(probe_quest_old)
  message(FATAL_ERROR "#563 part 4 cross-region owner: negative probe failed - AddQuest(qInfo, requester) was accepted")
endif()
add_quest_giver_guarded("        bot->AddQuest(qInfo, QuestGiverObject(bot, requester));" probe_quest_new)
if(NOT probe_quest_new)
  message(FATAL_ERROR "#563 part 4 cross-region owner: positive probe failed - the guarded AddQuest was rejected")
endif()

# --- 1. security ---
read_source("PlayerbotSecurity.cpp" sec)
read_source("PlayerbotSecurity.h" sec_h)
slice("${sec}" "PlayerbotSecurityLevel PlayerbotSecurity::LevelFor(" "bool PlayerbotSecurity::CheckLevelFor(" level_for)
level_for_reads_no_sender_group("${level_for}" level_for_ok)
if(NOT level_for_ok)
  message(FATAL_ERROR "#563 part 4 cross-region owner: LevelFor must test group membership from the bot's side (bot->GetGroup()), not read from->GetGroup()")
endif()
require_text("${level_for}" "botGroup->IsMember(from->GetObjectGuid())" "bot-side membership test")
string(FIND "${level_for}" "!SameMapObject(bot, from)" fail_pos)
string(FIND "${level_for}" "GetEquipGearScore(from, false, false)" gs_pos)
if(fail_pos EQUAL -1 OR gs_pos EQUAL -1 OR NOT fail_pos LESS gs_pos)
  message(FATAL_ERROR "#563 part 4 cross-region owner: the cross-region fail-closed return must come before the sender's gear score is read")
endif()
require_text("${level_for}" "DenyReason::PLAYERBOT_DENY_CROSS_REGION" "fail-closed reason")
require_text("${sec_h}" "PLAYERBOT_DENY_CROSS_REGION" "reason in the enum")
slice("${sec}" "bool PlayerbotSecurity::CheckLevelFor(" "std::string text = out.str();" reply)
require_text("${reply}" "case DenyReason::PLAYERBOT_DENY_CROSS_REGION:" "reply text for the new reason (its own case: the GEARSCORE case would read the sender's inventory)")

# --- 2. command list ---
read_source("OwnerContainerCommandPolicy.h" policy)
foreach(word rtsc summon invite join lfg)
  require_text("${policy}" "\"${word}\"" "container-reading command word ${word}")
endforeach()
require_text("${policy}" "learnSpell" "rtsc spell book write named")
require_text("${policy}" "ConvertToRaid" "invite group write named")
read_source("PlayerbotAI.cpp" ai_cpp)
slice("${ai_cpp}" "void PlayerbotAI::HandleCommands()" "void PlayerbotAI::QueueChatCommand" drain)
require_text("${drain}" "auto crossRegionRestricted = " "restriction lambda")
require_text("${drain}" "!SameMapObject(bot, directiveOwner)" "same-Map-object test")
require_text("${drain}" "ai::owner_cmd::IsContainerReadingCommand(text)" "policy applied")
require_text("${drain}" "ChatHelper::parseValue(\"command\", text)" "link commands are unwrapped before the test")
string(REGEX MATCHALL "if \\(crossRegionRestricted\\(holder\\)\\)" gate_calls "${drain}")
list(LENGTH gate_calls n_gates)
if(NOT n_gates EQUAL 2)
  message(FATAL_ERROR "#563 part 4 cross-region owner: expected the gate on the directive path and on the chat path (2), found ${n_gates}")
endif()
require_text("${drain}" "[ChatCmd] cross-region command restricted" "counter log line")

# --- 3. AddQuest giver ---
read_source("strategy/actions/AcceptQuestAction.cpp" accept)
add_quest_giver_guarded("${accept}" accept_ok)
if(NOT accept_ok)
  message(FATAL_ERROR "#563 part 4 cross-region owner: AcceptQuestAction must not pass the raw requester to Player::AddQuest (use QuestGiverObject)")
endif()
string(REGEX MATCHALL "AddQuest\\(qInfo, QuestGiverObject\\(bot, requester\\)\\)" guarded "${accept}")
list(LENGTH guarded n_guarded)
if(NOT n_guarded EQUAL 3)
  message(FATAL_ERROR "#563 part 4 cross-region owner: expected 3 guarded AddQuest calls in AcceptQuestAction, found ${n_guarded}")
endif()
require_text("${accept}" "requester && (requester == bot || SameMapObject(bot, requester)) ? requester : nullptr" "giver only from the bot's own Map object")
