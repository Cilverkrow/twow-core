# cmake 3.x script mode (Debian trixie / CI): without a policy version TRUE in while()/if() (CMP0012) and
# empty list elements (CMP0007) behave as in cmake 2.x; the host cmake 4.x has them NEW already.
cmake_policy(VERSION 3.16)
if (NOT DEFINED TW_CORE_ROOT)
  message(FATAL_ERROR "TW_CORE_ROOT is required")
endif()

# twow-repo#597 (TICK-01, PR pair T2 "terrain idle cleanup"): TerrainInfo::GetGrid loads grids lazily without a grid
# reference, so the CleanupTerrain pass (every 60 s per terrain, world thread) freed every lazily loaded grid and the
# next height/LOS query reloaded it from disk. TerrainCleanup.IdleMinutes (default 0) keeps ref-0 grids that were used
# within that time, TerrainCleanup.MaxGridsPerTick (default 0) caps the frees per tick. Both 0: today's decisions in
# today's order, one call per pass, and GetGrid neither loads nor stores a stamp; no clock read anywhere.
# Decisions: t/terrain_cleanup_597_test.cpp.

function(read_source path out_var)
  file(READ "${TW_CORE_ROOT}/${path}" text)
  string(REPLACE "\r" "" text "${text}")
  set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(require_text text needle label)
  string(FIND "${text}" "${needle}" offset)
  if (offset EQUAL -1)
    message(FATAL_ERROR "#597: missing ${label}: ${needle}")
  endif()
endfunction()

function(forbid_text text needle label)
  string(FIND "${text}" "${needle}" offset)
  if (NOT offset EQUAL -1)
    message(FATAL_ERROR "#597: forbidden ${label}: ${needle}")
  endif()
endfunction()

# The text from start up to and including the next end marker after it.
function(extract_body text start end out_var)
  string(FIND "${text}" "${start}" from)
  if (from EQUAL -1)
    message(FATAL_ERROR "#597: missing function start: ${start}")
  endif()
  string(SUBSTRING "${text}" ${from} -1 rest)
  string(LENGTH "${start}" start_len)
  string(SUBSTRING "${rest}" ${start_len} -1 after)
  string(FIND "${after}" "${end}" to)
  if (to EQUAL -1)
    message(FATAL_ERROR "#597: missing end marker after ${start}: ${end}")
  endif()
  string(LENGTH "${end}" end_len)
  math(EXPR total "${start_len} + ${to} + ${end_len}")
  string(SUBSTRING "${rest}" 0 ${total} body)
  set(${out_var} "${body}" PARENT_SCOPE)
endfunction()

function(count_text text needle out_var)
  set(n 0)
  set(rest "${text}")
  string(LENGTH "${needle}" len)
  while (TRUE)
    string(FIND "${rest}" "${needle}" at)
    if (at EQUAL -1)
      break()
    endif()
    math(EXPR n "${n} + 1")
    math(EXPR skip "${at} + ${len}")
    string(SUBSTRING "${rest}" ${skip} -1 rest)
  endwhile()
  set(${out_var} ${n} PARENT_SCOPE)
endfunction()

read_source("src/game/World.h" world_h)
read_source("src/game/World.cpp" world_cpp)
read_source("src/game/Maps/GridMap.h" grid_h)
read_source("src/game/Maps/GridMap.cpp" grid_cpp)
read_source("src/game/Maps/GridDefines.h" grid_defines)
read_source("src/game/Maps/TerrainCleanupPolicy.h" policy)
read_source("src/mangosd/mangosd.conf.dist.in" dist)
read_source("CMakeLists.txt" cmake)

# 1. Switches: declared, read with default 0, documented with default 0 next to CleanupTerrain.
require_text("${world_h}" "CONFIG_UINT32_TERRAIN_CLEANUP_IDLE_MINUTES," "config enum entry IdleMinutes")
require_text("${world_h}" "CONFIG_UINT32_TERRAIN_CLEANUP_MAX_GRIDS_PER_TICK," "config enum entry MaxGridsPerTick")
require_text("${world_cpp}" "setConfigMinMax(CONFIG_UINT32_TERRAIN_CLEANUP_IDLE_MINUTES, \"TerrainCleanup.IdleMinutes\", 0, 0, 1440);" "IdleMinutes default 0, bound 1440")
require_text("${world_cpp}" "setConfig(CONFIG_UINT32_TERRAIN_CLEANUP_MAX_GRIDS_PER_TICK, \"TerrainCleanup.MaxGridsPerTick\", 0);" "MaxGridsPerTick default 0")
require_text("${policy}" "constexpr uint32_t MAX_IDLE_MINUTES = 1440;" "policy bound equal to the config bound")
require_text("${dist}" "#    TerrainCleanup.IdleMinutes\n#    TerrainCleanup.MaxGridsPerTick\n" "config documentation")
require_text("${dist}" "\nTerrainCleanup.IdleMinutes = 0\nTerrainCleanup.MaxGridsPerTick = 0\n" "documented default 0, 0")
require_text("${dist}" "#        Default: 0, 0 (today's behaviour)\n" "documented default line")
require_text("${dist}" "Live runs CleanupTerrain = 0 as the immediate measure (OB-00" "live measure documented")
require_text("${dist}" "They matter only with CleanupTerrain = 1 (with GridUnload = 0 or 1)." "when the switches matter")
require_text("${dist}" "Known and unchanged: the free takes no lock" "unlocked free documented")
require_text("${dist}" "runs regardless of CleanupTerrain; with CleanupTerrain = 0 it frees all grids" "startup purge documented")
require_text("${dist}" "Last use = a terrain query through TerrainInfo::GetGrid (height,\n#                         water, area, ...); LOS-only vmap use (Map::isInLineOfSight) does not count." "what counts as a use (only GetGrid stamps)")
require_text("${dist}" "at most this many grids freed per terrain (map) and world tick; each map terrain has\n#                         its own budget" "MaxGridsPerTick budget is per terrain")
forbid_text("${dist}" "height/LOS query on it" "LOS documented as a use (LOS does not call GetGrid)")
forbid_text("${dist}" "grids freed per world tick" "MaxGridsPerTick documented as a global per-tick bound")
require_text("${dist}" "\nCleanupTerrain = 1\n" "CleanupTerrain dist default unchanged")

# 2. Policy off path: today's rule (loaded, ref 0) with IdleMinutes 0, no budget with MaxGridsPerTick 0, today's order.
require_text("${policy}" "constexpr uint32_t GRIDS_PER_SIDE = 64;" "grid table side")
require_text("${grid_defines}" "#define MAX_NUMBER_OF_GRIDS      64" "MAX_NUMBER_OF_GRIDS equal to GRIDS_PER_SIDE")
require_text("${policy}" "        if (!loaded || ref != 0)\n            return false;\n        if (idleMinutes == 0)\n            return true;\n" "ShouldFree off path = today's rule")
require_text("${policy}" "        return maxPerTick == 0 || freed < maxPerTick;" "MaxGridsPerTick 0 = unlimited")
require_text("${policy}" "        return idleMinutes != 0;" "stamp only with IdleMinutes > 0")
require_text("${policy}" "        return timerPassed || resumePending;" "scan on the timer (today) or an open capped pass")
require_text("${policy}" "            uint32_t const x = i % GRIDS_PER_SIDE;\n            uint32_t const y = i / GRIDS_PER_SIDE;" "y-outer / x-inner order")

# 3. GetGrid: the only stamp is behind the switch; off, no load and no store of the stamp.
extract_body("${grid_cpp}" "GridMap* TerrainInfo::GetGrid(const float x, const float y)\n{" "\n}\n" get_grid)
require_text("${get_grid}" "    if (terrain_cleanup::StampEnabled(s_cleanupIdleMinutes.load(std::memory_order_relaxed)))\n        StampGridUse(uint32(gx), uint32(gy));\n" "GetGrid stamp behind the switch")
count_text("${get_grid}" "StampGridUse(" stamp_calls)
if (NOT stamp_calls EQUAL 1)
  message(FATAL_ERROR "#597: GetGrid must call StampGridUse exactly once, behind the switch (found ${stamp_calls})")
endif()
foreach (needle ".store(" "m_GridLastUse" "m_useClockSec" "sLog" "sWorld.getConfig")
  forbid_text("${get_grid}" "${needle}" "in GetGrid outside StampGridUse")
endforeach()
string(FIND "${get_grid}" "StampGridUse(" stamp_at)
string(FIND "${get_grid}" "GridMap* pMap = m_GridMaps[gx][gy];" map_at)
if (map_at EQUAL -1 OR NOT stamp_at LESS map_at)
  message(FATAL_ERROR "#597: GetGrid stamps before the grid lookup / load")
endif()

# Every StampGridUse call (GetGrid, Unload) sits directly behind the switch; nothing else stamps.
count_text("${grid_cpp}" "StampGridUse(" stamp_all)
if (NOT stamp_all EQUAL 3)
  message(FATAL_ERROR "#597: expected StampGridUse definition + 2 guarded calls (found ${stamp_all})")
endif()
count_text("${grid_cpp}" "if (terrain_cleanup::StampEnabled(s_cleanupIdleMinutes.load(std::memory_order_relaxed)))\n" guards)
if (NOT guards EQUAL 2)
  message(FATAL_ERROR "#597: expected 2 switch guards in front of StampGridUse (found ${guards})")
endif()
require_text("${grid_cpp}" "            if (terrain_cleanup::StampEnabled(s_cleanupIdleMinutes.load(std::memory_order_relaxed)))\n                StampGridUse(x, y);\n" "Unload stamp behind the switch")
count_text("${grid_cpp}" "m_GridLastUse[x][y]" last_use_refs)
if (NOT last_use_refs EQUAL 2)
  message(FATAL_ERROR "#597: m_GridLastUse[x][y] only in StampGridUse and the guarded CleanUpGrids read (found ${last_use_refs})")
endif()
extract_body("${grid_cpp}" "void TerrainInfo::StampGridUse(const uint32 x, const uint32 y)\n{" "\n}\n" stamp_fn)
require_text("${stamp_fn}" "    if (x >= MAX_NUMBER_OF_GRIDS || y >= MAX_NUMBER_OF_GRIDS)\n        return;\n" "stamp range check (fail closed)")
require_text("${stamp_fn}" "    if (terrain_cleanup::NeedsStamp(lastUse.load(std::memory_order_relaxed), nowSec))\n        lastUse.store(nowSec, std::memory_order_relaxed);\n" "at most one store per grid and second")
count_text("${stamp_fn}" ".store(" stamp_stores)
if (NOT stamp_stores EQUAL 1)
  message(FATAL_ERROR "#597: StampGridUse has exactly one guarded store (found ${stamp_stores})")
endif()

# 4. CleanUpGrids: policy decisions, today's free sequence, timer reset only when the pass is through.
extract_body("${grid_cpp}" "void TerrainInfo::CleanUpGrids(const uint32 diff)\n{" "\n}\n" cleanup)
require_text("${cleanup}" "    if (!terrain_cleanup::ScanThisTick(i_timer.Passed(), m_cleanupResume))\n        return;\n" "scan gate")
require_text("${cleanup}" "terrain_cleanup::RunPass(m_cleanupCursor, maxGridsPerTick," "pass through the policy")
require_text("${cleanup}" "uint32 const lastUse = terrain_cleanup::StampEnabled(idleMinutes) ? m_GridLastUse[x][y].load(std::memory_order_relaxed) : 0;" "stamps read only with the switch on")
require_text("${cleanup}" "return terrain_cleanup::ShouldFree(m_GridMaps[x][y] != nullptr, m_GridRef[x][y], idleMinutes, nowSec, lastUse);" "decision through the policy")
require_text("${cleanup}" "            m_GridMaps[x][y] = nullptr;\n            // delete grid data if reference count == 0\n            pMap->unloadData();\n            delete pMap;\n" "today's free sequence")
require_text("${cleanup}" "VMAP::VMapFactory::createOrGetVMapManager()->unloadMap(m_mapId, int(x), int(y));" "vmap tile unload")
require_text("${cleanup}" "MMAP::MMapFactory::createOrGetMMapManager()->unloadMap(m_mapId, int(x), int(y));" "mmap tile unload")
require_text("${cleanup}" "    if (!pass.done)\n    {\n        // twow-repo#597: TerrainCleanup.MaxGridsPerTick reached, the rest waits for the next tick\n        m_cleanupCursor = pass.nextCursor;\n        m_cleanupResume = true;\n        return;\n    }\n\n    m_cleanupCursor = 0;\n    m_cleanupResume = false;\n    i_timer.Reset();\n" "timer reset only after a full pass")
count_text("${cleanup}" "i_timer.Reset();" resets)
if (NOT resets EQUAL 1)
  message(FATAL_ERROR "#597: CleanUpGrids resets the timer once, after a full pass (found ${resets})")
endif()
count_text("${cleanup}" "return;" returns)
if (NOT returns EQUAL 2)
  message(FATAL_ERROR "#597: CleanUpGrids returns early only at the scan gate and for an open pass (found ${returns})")
endif()
require_text("${cleanup}" "    m_useClockMs += diff;\n" "terrain clock from the tick diff")
# The only log line and the only clock reads in CleanUpGrids are the guarded [TerrainCleanup] diagnostic of
# the T1 pair (PerformanceLog.TerrainTrace, t/check_tick_diag_597_contract.cmake). They are cut out here, so the
# checks below (no sLog, no clock) still hold for the rest of the body.
set(diag_start "    bool const trace = sWorld.getConfig(CONFIG_BOOL_PERFLOG_TERRAIN_TRACE);\n    uint64 const traceStartUs = trace ? tick_diag::NowUs() : 0;\n")
set(diag_line "    uint32 const freedGrids = pass.freed;\n    if (trace && freedGrids)\n        sLog.out(LOG_PERFORMANCE, \"[TerrainCleanup] map=%u freed_grids=%u ms=%.1f\", m_mapId, freedGrids,\n            (tick_diag::NowUs() - traceStartUs) / 1000.0);\n\n    if (!pass.done)\n")
require_text("${cleanup}" "${diag_start}" "guarded [TerrainCleanup] clock (T1)")
require_text("${cleanup}" "${diag_line}" "[TerrainCleanup] line only when on, after the pass, before the open-pass branch (T1)")
string(REPLACE "${diag_start}" "" cleanup "${cleanup}")
string(REPLACE "${diag_line}" "    if (!pass.done)\n" cleanup "${cleanup}")
forbid_text("${cleanup}" "sLog" "log line in CleanUpGrids besides the guarded [TerrainCleanup] line")
forbid_text("${cleanup}" "trace" "other TerrainTrace use in CleanUpGrids")
require_text("${grid_cpp}" "// Known and unchanged: the delete below takes no lock against GetGrid readers on other threads." "unlocked delete documented")

# 5. Switch latch: world thread, once per tick, only on a change; never sWorld.getConfig on the query path.
# The bot module also calls sTerrainMgr.Update once at startup (TravelMgr::LoadQuestTravelTable), outside the
# CleanupTerrain gate in World::Update, so the latch itself checks CleanupTerrain: 0 latches 0, 0.
require_text("${grid_cpp}" "    bool const cleanupTerrain = sWorld.getConfig(CONFIG_BOOL_CLEANUP_TERRAIN);\n    TerrainInfo::SetCleanupSwitches(cleanupTerrain ? sWorld.getConfig(CONFIG_UINT32_TERRAIN_CLEANUP_IDLE_MINUTES) : 0,\n        cleanupTerrain ? sWorld.getConfig(CONFIG_UINT32_TERRAIN_CLEANUP_MAX_GRIDS_PER_TICK) : 0);\n" "latch in TerrainManager::Update, gated by CleanupTerrain")
count_text("${grid_cpp}" "SetCleanupSwitches(" latch_calls)
if (NOT latch_calls EQUAL 2)
  message(FATAL_ERROR "#597: SetCleanupSwitches definition + the one gated call in TerrainManager::Update (found ${latch_calls})")
endif()
count_text("${grid_cpp}" "CONFIG_UINT32_TERRAIN_CLEANUP_" config_reads)
if (NOT config_reads EQUAL 2)
  message(FATAL_ERROR "#597: the TerrainCleanup.* config is read only in TerrainManager::Update (found ${config_reads})")
endif()
require_text("${grid_cpp}" "std::atomic<uint32> TerrainInfo::s_cleanupIdleMinutes(0);" "IdleMinutes cache starts at 0")
require_text("${grid_cpp}" "std::atomic<uint32> TerrainInfo::s_cleanupMaxGridsPerTick(0);" "MaxGridsPerTick cache starts at 0")
require_text("${grid_cpp}" "m_GridLastUse[i][k].store(0, std::memory_order_relaxed);" "stamps start at 0")
require_text("${grid_h}" "static std::atomic<uint32> s_cleanupIdleMinutes;" "cached switch declared")
# The latch stores exactly the (clamped) config values and nothing else: a latch that stored a literal would make
# GetGrid stamp with TerrainCleanup.IdleMinutes = 0. The clamp keeps 0 at 0.
extract_body("${grid_cpp}" "void TerrainInfo::SetCleanupSwitches(uint32 idleMinutes, uint32 maxGridsPerTick)\n{" "\n}\n" latch)
require_text("${latch}" "{\n    // stored only on a change: GetGrid reads s_cleanupIdleMinutes on every map thread\n    idleMinutes = terrain_cleanup::ClampIdleMinutes(idleMinutes);\n    if (s_cleanupIdleMinutes.load(std::memory_order_relaxed) != idleMinutes)\n        s_cleanupIdleMinutes.store(idleMinutes, std::memory_order_relaxed);\n    if (s_cleanupMaxGridsPerTick.load(std::memory_order_relaxed) != maxGridsPerTick)\n        s_cleanupMaxGridsPerTick.store(maxGridsPerTick, std::memory_order_relaxed);\n}\n" "latch stores only the clamped config values")
count_text("${latch}" ".store(" latch_stores)
if (NOT latch_stores EQUAL 2)
  message(FATAL_ERROR "#597: SetCleanupSwitches has exactly 2 stores (found ${latch_stores})")
endif()
foreach (cache "s_cleanupIdleMinutes" "s_cleanupMaxGridsPerTick")
  count_text("${grid_cpp}" "${cache}.store(" cache_stores)
  if (NOT cache_stores EQUAL 1)
    message(FATAL_ERROR "#597: ${cache} is written only by SetCleanupSwitches (found ${cache_stores} stores)")
  endif()
  forbid_text("${grid_h}" "${cache}.store(" "cache store in GridMap.h")
endforeach()
require_text("${policy}" "        return idleMinutes > MAX_IDLE_MINUTES ? MAX_IDLE_MINUTES : idleMinutes;" "clamp keeps 0 at 0")
# The latch runs only with CleanupTerrain = 1, so with CleanupTerrain = 0 the caches stay 0 (no stamps).
require_text("${world_cpp}" "    if (getConfig(CONFIG_BOOL_CLEANUP_TERRAIN))\n        sTerrainMgr.Update(diff);\n" "TerrainManager::Update gated by CleanupTerrain")
count_text("${world_cpp}" "sTerrainMgr.Update(" terrain_updates)
if (NOT terrain_updates EQUAL 1)
  message(FATAL_ERROR "#597: sTerrainMgr.Update is called once, behind CleanupTerrain (found ${terrain_updates})")
endif()

# 6. No clock read, no shared_mutex.
foreach (clock "steady_clock" "system_clock" "getMSTime" "WorldTimer::" "NowUs" "time(nullptr)" "time(NULL)")
  forbid_text("${policy}" "${clock}" "clock read in TerrainCleanupPolicy.h")
  forbid_text("${get_grid}" "${clock}" "clock read in GetGrid")
  forbid_text("${stamp_fn}" "${clock}" "clock read in StampGridUse")
  forbid_text("${cleanup}" "${clock}" "clock read in CleanUpGrids")
endforeach()
foreach (src "${policy}" "${grid_h}" "${grid_cpp}")
  forbid_text("${src}" "shared_mutex" "std::shared_mutex")
endforeach()

